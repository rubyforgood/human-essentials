<% content_for :title, "Send broadcast announcement" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Announcements",
        subtitle: "Messages shown to every bank." %>
</div>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/card", padded: false do %>

          <div class="px-5 py-4">
            <div class='flex justify-end mb-4'>
              <%= new_button_to new_admin_broadcast_announcement_path, {text: "New Announcement"} %>
            </div>
            <table class="data-table">
              <thead>
                <tr>
                  <th class="w-50">Announcement</th>
                  <th>More info</th>
                  <th>Sent by</th>
                  <th>Expiration</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @broadcast_announcements.reverse.each do |broadcast_announcement| %>
                  <%= render broadcast_announcement %>
                <% end %>
              </tbody>
            </table>

          </div>
  <% end %>
</div>
