<% content_for :title, "Send broadcast announcement" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Announcements",
        subtitle: "Messages shown to every bank.",
        actions: essentials_link_button("New announcement", new_admin_broadcast_announcement_path,
          variant: :primary, icon: "bi-plus-lg") %>

  <%= render "shared/essentials/card", padded: false do %>

    <% if @broadcast_announcements.any? %>
      <%# Edge to edge, in a scroll region: the `px-5 py-4` wrapper inset it 21px from the card.
          `w-50` was Bootstrap's 50% utility, defined nowhere in Tailwind v4. %>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
        <table class="data-table">
          <caption>Announcements shown to every organization</caption>
          <thead>
            <tr>
              <th scope="col">Announcement</th>
              <th scope="col">More info</th>
              <th scope="col">Sent by</th>
              <th scope="col" class="date">Expiration</th>
              <th scope="col" class="cell-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @broadcast_announcements.reverse.each do |broadcast_announcement| %>
              <%= render broadcast_announcement %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-5 py-4">
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "No announcements yet",
              body: "An announcement shows on every organization's dashboard until it expires.",
              action: essentials_link_button("New announcement", new_admin_broadcast_announcement_path, variant: :primary, icon: "bi-plus-lg") %>
      </div>
    <% end %>
  <% end %>
</div>
