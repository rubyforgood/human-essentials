<tr id="<%= dom_id broadcast_announcement %>">
  <td><%= broadcast_announcement.message %></td>
  <td><%= link_to  broadcast_announcement.link, broadcast_announcement.link %></td>
  <td><%= broadcast_announcement.user&.name || "N/A" %></td>
  <td><%= broadcast_announcement.expiry %>
    <% if broadcast_announcement.expired? %>
      <%= essentials_status_pill("Expired", tone: :danger, icon: "bi-clock-history") %>
    <% end %>
  </td>
  <td class="cell-actions">
    <div class="flex justify-end gap-1.5">
      <%= essentials_row_icon_link "Edit", edit_admin_broadcast_announcement_path(broadcast_announcement), icon: "bi-pencil" %>
      <%= essentials_row_icon_action "Delete", admin_broadcast_announcement_path(broadcast_announcement), method: :delete, icon: "bi-trash", tone: :danger,

            confirm: "Are you sure?" %>
    </div>
  </td>
</tr>
