<tr id="base-item-row-<%= base_item_row.to_param %>">
  <td><%= base_item_row.name %></td>
  <td class="text-right"><%= base_item_row.item_count %></td>
  <td class="text-right">
    <div class="flex justify-end gap-1.5">
      <%= essentials_link_button "View", admin_base_item_path(base_item_row), variant: :ghost, size: :sm, icon: "bi-eye" %>
      <%= essentials_link_button "Edit", edit_admin_base_item_path(base_item_row), variant: :ghost, size: :sm, icon: "bi-pencil" %>
    </div>
  </td>
</tr>
