<tr id="base-item-row-<%= base_item_row.to_param %>">
  <td><%= base_item_row.name %></td>
  <td class="numeric"><%= base_item_row.item_count %></td>
  <td class="cell-actions">
    <div class="flex justify-end gap-1.5">
      <%= essentials_row_icon_link "View", admin_base_item_path(base_item_row), icon: "bi-eye" %>
      <%= essentials_row_icon_link "Edit", edit_admin_base_item_path(base_item_row), icon: "bi-pencil" %>
    </div>
  </td>
</tr>
