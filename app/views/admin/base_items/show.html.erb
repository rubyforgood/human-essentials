<% content_for :title, "Base Items - #{@base_item.name}" %>

<div class="px-4 pt-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Base item",
        subtitle: @base_item.name,
        back: {path: admin_base_items_path, label: "Back to base items"},
        actions: capture {
          concat essentials_link_button("Edit", edit_admin_base_item_path(@base_item),
                   variant: :primary, icon: "bi-pencil")
        } %>
</div>

<div class="space-y-6 px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/card", title: "Details" do %>
    <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-slate-600">Name</dt>
        <dd class="mt-0.5 text-sm text-slate-900"><%= @base_item.name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-600">Size</dt>
        <dd class="mt-0.5 text-sm text-slate-900"><%= optional_data_text(@base_item.size) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-600">Partner key</dt>
        <dd class="mt-0.5 text-sm text-slate-900"><%= optional_data_text(@base_item.partner_key) %></dd>
      </div>
    </dl>
  <% end %>

  <%= render "shared/essentials/card", title: "Items created from this base item", padded: false do %>
    <% if @items.any? %>
      <div class="table-scroll">
        <table class="data-table">
          <caption>Every organization's own item that maps onto this base item</caption>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Organization</th>
            </tr>
          </thead>
          <tbody>
            <% @items.each do |item| %>
              <tr id="item-row-<%= item.to_param %>">
                <td class="font-medium text-slate-900"><%= item.name %></td>
                <td><%= item.organization.name %> (id: <%= item.organization.id %>)</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-5 py-4">
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "No items yet",
              body: "No organization has created an item from this base item." %>
      </div>
    <% end %>
  <% end %>
</div>
