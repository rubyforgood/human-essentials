<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Base Items - #{@base_item.name}" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Base Item details</h1>
<p class="mt-1 text-sm text-slate-600">for <%= @base_item.name %></p>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>

<!-- Main content -->
<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <!-- Default box -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-5 py-4">
            <h2 class="text-base font-semibold text-slate-900">Size: <%= @base_item.size || "no size provided" %></h2>
          </div>
          <div class="px-5 py-4">
            <h3 class="text-sm font-semibold text-slate-900">Items created from this Base Item</h3>
            <table class="data-table">
              <thead>
              <tr>
                <th>Name</th>
                <th>Organization</th>
              </tr>
              </thead>
              <tbody>
              <% @items.each do |item| %>
                <tr id="item-row-<%= item.to_param %>">
                  <td><%= item.name %></td>
                  <td><%= item.organization.name %> (id: <%= item.organization.id %>)</td>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
