<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Edit - Items - #{@base_item.name} - Inventory" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Editing Base Item</h1>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <!-- left column -->
      <div class="min-w-0">
        <!-- jquery validation -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-5 py-4">
            <h3 class="text-sm font-semibold text-slate-900">Update <%= @base_item.name %></h3>
          </div>

          <!-- form start -->
          <div class="px-5 py-4">
            <%= essentials_form_for [:admin, @base_item], html: {class: 'form-horizontal'}, url: admin_base_item_path(@base_item) do |f| %>
              <%= render partial: "form", object: f %>
              </div>

              <div class="border-t border-slate-200 px-5 py-3">
                <%= submit_button %>
              </div>
              </div>
            <% end %>

            </div>
    </div>

  </div>
</section>
