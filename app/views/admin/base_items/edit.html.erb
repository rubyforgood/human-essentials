<% content_for :title, "Edit - Base Items" %>
<div class="px-4 pt-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Edit base item",
        subtitle: @base_item.name,
        back: {path: admin_base_items_path, label: "Back to base items"} %>
</div>

<div class="max-w-2xl px-4 py-6 sm:px-6 lg:px-8">
  <%= essentials_error_summary(@base_item) %>

  <%= render "shared/essentials/card" do %>
    <%= essentials_form_for [:admin, @base_item], url: admin_base_item_path(@base_item) do |f| %>
      <%= render partial: "form", object: f %>

      <div class="mt-6 flex items-center gap-2 border-t border-slate-200 pt-5">
        <%= submit_button %>
        <%= essentials_link_button "Cancel", admin_base_items_path, variant: :ghost, size: :md %>
      </div>
    <% end %>
  <% end %>
</div>
