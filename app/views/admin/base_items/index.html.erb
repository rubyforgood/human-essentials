<% content_for :title, "Base Items - Inventory" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Base items",
        subtitle: "The shared catalogue every organization's items map onto." %>

  <%= render "shared/essentials/card", padded: false,
        footer: essentials_pagination_footer(@paginated_base_items) do %>
          <%# Edge to edge, in a scroll region: this was a `px-5 py-4` wrapper
              inside a `padded: false` card, which inset the table 21px from it. %>
          <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
            <table class="data-table">
  <caption>Base items and how many organization items map onto each</caption>
              <thead>
              <tr>
                <%# "Child Items" was here twice, against a row of three cells -- so the header had
                    four columns and the body three, and the actions landed under the *second*
                    Child Items rather than under Actions. Found while marking the actions column
                    for pinning, which is what a column-count mismatch shows up as. %>
                <th>Name</th>
                <th scope="col" class="numeric">Child Items</th>
                <th scope="col" class="cell-actions">Actions</th>
              </tr>
              </thead>
              <tbody>
              <%= render partial: "base_item_row", collection: @paginated_base_items %>
              </tbody>
            </table>
          </div>
  <% end %>
</div>
