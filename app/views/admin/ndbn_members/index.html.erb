<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Community - NDBN Member Upload" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">NDBN Member Upload</h1>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <!-- left column -->
      <div class="min-w-0">
        <!-- jquery validation -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-5 py-4">
            <h2 class="text-base font-semibold text-slate-900">Upload NDBN Members</h2>
          </div>
           <!-- form start -->
          <div class="px-5 py-4">
            <div class="grid gap-6">
              <p>The Current NDBN member list is found at
                <a
                  href="https://docs.google.com/spreadsheets/d/1DRXeG206M0kgtUYT9lpD8fyEWRO7-a6m/edit?pli=1#gid=1068714915.">this link.</a>
                Export the list as CSV and remove the initial 'Updated' row before uploading.</p>
            </div>
            <%= form_with(url: upload_csv_admin_ndbn_members_path) do |form| %>
              <div class="grid gap-6">
                <%= form.label :member_file, "Select CSV File to Upload" %>
              </div>
              <%= form.file_field :member_file, required: true, accept: "text/csv" %>
              <%= submit_button({ text: "Upload" }) %>
            <% end %>
          </div>
        </div>

      </div>
    </div>

  </div>

  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <!-- Default box -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="px-5 py-4">
            <table class="data-table">
              <thead>
                <tr>
                  <th>NDBN Member Number</th>
                  <th>Member Name</th>
                </tr>
              </thead>
              <tbody>
                <%- ndbn_members.each do |member| %>
                  <tr>
                    <td><%= member.ndbn_member_id %></td>
                    <td><%= member.account_name %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
