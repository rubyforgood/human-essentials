<% content_for :title, "Partners - #{@partner.name} - #{@partner.organization.name}" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Edit partner",
        subtitle: @partner.name,
        back: {path: admin_partners_path, label: "Back to partners"} %>
</div>

<%= essentials_form_for @partner, url: admin_partner_path do |f| %>
<div class="max-w-3xl px-4 py-6 sm:px-6 lg:px-8">
  <%= essentials_error_summary(@partner) %>
  <%= render "shared/essentials/card" do %>
    <%#
      Plain `f.input`, no blocks. These three used to pass a block containing `f.input_field`,
      which replaces the wrapper's input and so skips the whole pipeline: the fields had no
      `aria-required`, no `aria-invalid`, no `aria-describedby` and no inline error, and they
      carried a hand-copied version of the wrapper's class string that could not follow it.
      design.md names this as the mistake and says it had already been found three times.
    %>
    <%= f.input :name, label: "Name" %>
    <%= f.input :email, label: "E-mail" %>
    <%= f.input :send_reminders, label: "Send reminders?", as: :boolean %>

    <div class="mt-6 flex items-center gap-2 border-t border-slate-200 pt-5">
      <%= submit_button %>
      <%= essentials_link_button "Cancel", admin_partners_path, variant: :ghost, size: :md %>
    </div>
  <% end %>
</div>
<% end %>
