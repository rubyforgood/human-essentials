<% content_for :title, "Partners - #{@partner.name} - #{@partner.organization.name}" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Edit partner",
        subtitle: @partner.name,
        back: {path: admin_partners_path, label: "Back to partners"} %>
</div>

<%= essentials_form_for @partner, url: admin_partner_path do |f| %>
<div class="max-w-3xl px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/card" do %>
              <%= f.input :name, label: "Name" do %>
                <%= f.input_field :name, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
              <% end %>
              <%= f.input :email, label: "E-mail" do %>
                <%= f.input_field :email, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
              <% end %>
              <%= f.input :send_reminders, label: "Send reminders?" do %>
                <%# No custom id: simple_form's label points at the generated one, so overriding
                    the field's id left the label pointing at nothing and the control unlabelled. %>
                <%= f.check_box :send_reminders, {class: "size-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"}, "true", "false" %>
              <% end %>

      <div class="mt-6 flex items-center gap-2 border-t border-slate-200 pt-5">
        <%= submit_button %>
        <%= essentials_link_button "Cancel", admin_partners_path, variant: :ghost, size: :md %>
      </div>
  <% end %>
</div>
<% end %>
