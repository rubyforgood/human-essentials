<% content_for :title, "Partners" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Partners",
        subtitle: "Partner agencies across all organizations." %>

  <%= render "shared/essentials/card", padded: false do %>
          <%# Edge to edge, in a scroll region: this was a `px-5 py-4` wrapper
              inside a `padded: false` card, which inset the table 21px from it. %>
          <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <% if @partners.any? %>
              <table class="data-table">
  <caption>Partner agencies across all organizations</caption>
                <thead>
                <tr>
                  <th>Name</th>
                  <th>Organization</th>
                  <th scope="col" class="cell-actions">Actions</th>
                </tr>
                </thead>
                <tbody>
                <% @partners.each do |partner| %>
                  <tr>
                    <td><%= partner.name %></td>
                    <td><%= partner.organization&.name %></td>
                    <td class="cell-actions">
                      <div class="flex justify-end gap-1.5">
                        <%= essentials_row_icon_link "View", admin_partner_path(partner), icon: "bi-eye" %>
                        <%= essentials_row_icon_link "Edit", edit_admin_partner_path(partner), icon: "bi-pencil" %>
                      </div>
                    </td>
                <% end %>
                </tr>
                </tbody>
              </table>
          <% else %>
            <%= render "shared/essentials/empty_state", kind: :cold_start,
                  title: "No partners yet",
                  body: "Partner agencies appear here once a bank invites them. Banks create their own partners." %>
          <% end %>
          </div>
  <% end %>
</div>
