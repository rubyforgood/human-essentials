<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Partners" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Partners</h1>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <!-- Default box -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="px-5 py-4">
            <table class="data-table">
              <thead>
              <tr>
                <th>Name</th>
                <th>Organization</th>
                <th class="text-right">Actions</th>
              </tr>
              </thead>
              <tbody>
              <% @partners.each do |partner| %>
                <tr>
                  <td><%= partner.name %></td>
                  <td><%= partner.organization&.name %></td>
                  <td class="text-right">
                    <div class="flex justify-end gap-1.5">
                      <%= essentials_link_button "View", admin_partner_path(partner), variant: :ghost, size: :sm, icon: "bi-eye" %>
                      <%= essentials_link_button "Edit", edit_admin_partner_path(partner), variant: :ghost, size: :sm, icon: "bi-pencil" %>
                    </div>
                  </td>
              <% end %>
              </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
