<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Partners - #{@partner.name} - #{@partner.organization.name}" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Partner Information</h1>
<p class="mt-1 text-sm text-slate-600">for <%= @partner.name %></p>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <!-- Default box -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-5 py-4">
            <h2 class="text-base font-semibold text-slate-900"></h2>
          </div>
          <div class="px-5 py-4">
            <table class="data-table">
              <thead>
              <tr>
                <th>Partner Name</th>
                <th>Essentials Bank</th>
                <th>Partner Email</th>
              </tr>
              </thead>
              <tbody>
                <tr>
                  <td><%= @partner.name %></td>
                  <td><%= @partner.organization.name %></td>
                  <td><%= @partner.email %></td>
                </tr>

              </tbody>
            </table>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>
