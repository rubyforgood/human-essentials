<% content_for :title, "Partners - #{@partner.name}" %>

<%#
  Same shape as the barcode page: one row of a table doing a description list's job. It also had
  an empty <h2> as the card header.
%>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Partner",
        subtitle: @partner.name,
        back: {path: admin_partners_path, label: "Back to partners"},
        actions: capture {
          concat essentials_link_button("Edit", edit_admin_partner_path(@partner),
                   variant: :primary, icon: "bi-pencil")
        } %>

  <%= render "shared/essentials/card", title: "Partner information" do %>
    <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-slate-600">Partner name</dt>
        <dd class="mt-0.5 text-sm text-slate-900"><%= @partner.name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-600">Essentials bank</dt>
        <dd class="mt-0.5 text-sm text-slate-900"><%= @partner.organization.name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-600">Partner email</dt>
        <dd class="mt-0.5 text-sm text-slate-900">
          <%= mail_to @partner.email, class: "font-medium link-brand" %>
        </dd>
      </div>
    </dl>
  <% end %>
</div>
