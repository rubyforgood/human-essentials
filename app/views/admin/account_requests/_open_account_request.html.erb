<tr>
  <td class="date"><%= open_account_request.created_at&.strftime("%m/%d/%Y") %></td>
  <td>
    <span class="font-medium text-slate-900"><%= open_account_request.organization_name %></span>
    <% if open_account_request.organization_website.present? %>
      <br><span class="text-slate-500"><%= open_account_request.organization_website %></span>
    <% end %>
  </td>
  <td><%= open_account_request.request_details %></td>
  <td><%= essentials_status_pill(open_account_request.status.humanize, tone: :info, icon: "bi-hourglass-split") %></td>
  <td>
    <%= open_account_request.name %>
    <br><span class="text-slate-500"><%= open_account_request.email %></span>
  </td>
  <td class="text-right">
    <div class="inline-flex flex-wrap justify-end gap-2">
      <%# Both open the same dialog; the params say which decision it is. %>
      <button type="button" class="<%= essentials_button_classes(variant: :ghost_danger, size: :sm, ) %>"
              data-action="click->account-request-decision#open"
              data-account-request-decision-id-param="<%= open_account_request.id %>"
              data-account-request-decision-decision-param="reject"
              data-account-request-decision-organization-param="<%= open_account_request.organization_name %>">
        <i class="bi-slash-circle" aria-hidden="true"></i> Reject
      </button>
      <button type="button" class="<%= essentials_button_classes(variant: :ghost, size: :sm) %>"
              data-action="click->account-request-decision#open"
              data-account-request-decision-id-param="<%= open_account_request.id %>"
              data-account-request-decision-decision-param="close"
              data-account-request-decision-organization-param="<%= open_account_request.organization_name %>">
        <i class="bi-x-lg" aria-hidden="true"></i> Close
      </button>
    </div>
  </td>
</tr>
