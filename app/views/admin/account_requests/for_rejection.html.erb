<% content_for :title, "Reject account request" %>

<%#
  Reached from the link in the account request notification email, which carries a token.
  The page had no h1 at all in the success branch -- only a content_for :title -- so there
  was nothing on the page naming what it was.
%>
<div class="px-4 py-6 sm:px-6 lg:px-8"
     data-controller="account-request-decision"
     data-account-request-decision-reject-url-value="<%= reject_admin_account_requests_path %>"
     data-account-request-decision-close-url-value="<%= close_admin_account_requests_path %>">
  <%= render "shared/essentials/page_header",
        title: "Reject account request",
        back: {path: admin_account_requests_path, label: "Back to account requests"} %>

  <% if @account_request %>
    <%= render "shared/essentials/card", padded: false do %>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
        <table class="data-table">
          <caption>The account request named by this link</caption>
          <thead>
            <tr>
              <th class="date">Date submitted</th>
              <th>Organization</th>
              <th>Request details</th>
              <th>Status</th>
              <th>Contact</th>
              <th scope="col" class="cell-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <%= render partial: "open_account_request", object: @account_request %>
          </tbody>
        </table>
      </div>
    <% end %>

    <%= render "decision_dialog" %>
  <% else %>
    <%= render "shared/essentials/card" do %>
      <%= render "shared/essentials/empty_state", kind: :no_results,
            title: "That account request could not be found",
            body: "The link may have expired, or the request may already have been decided.",
            action: capture { essentials_link_button("Back to account requests", admin_account_requests_path, variant: :secondary) } %>
    <% end %>
  <% end %>
</div>
