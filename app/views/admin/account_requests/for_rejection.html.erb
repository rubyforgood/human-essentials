<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Reject Account Request" %>
      </div>
    </div>
  </div>
</section>

<% if @account_request %>

  <section>
    <div class="px-4 py-6 sm:px-6 lg:px-8">
      <div class="grid gap-6">
        <div class="min-w-0">
          <!-- Default box -->
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="px-5 py-4">
              <table class="data-table" id="open-account-requests">
                <thead>
                <tr>
                  <th>Date Submitted</th>
                  <th>Organization Details</th>
                  <th>Request details</th>
                  <th>Request status</th>
                  <th>Contact Details</th>
                  <th class="text-right">Actions</th>
                </tr>
                </thead>
                <tbody>
                <%= render partial: 'open_account_request', object: @account_request %>
              </table>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <%= render partial: 'rejection_modal' %>
<% else %>
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Account Request not found!</h1>
<% end %>
