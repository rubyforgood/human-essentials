<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Account Requests" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Open Account Requests</h1>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <!-- Default box -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="px-5 py-4">
            <table class="data-table" id="open-account-requests">
              <thead>
              <tr>
                <th>Date Submitted</th>
                <th>Organization Details</th>
                <th>Request details</th>
                <th>Request status</th>
                <th>Contact Details</th>
                <th class="text-right">Actions</th>
              </tr>
              </thead>
              <tbody>
              <%= render partial: 'open_account_request', collection: @open_account_requests %>
            </table>
          </div>
          <div class="border-t border-slate-200 px-5 py-3">
            <%= paginate @open_account_requests, param_name: 'open_page' %>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<%= render partial: 'rejection_modal' %>

<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Closed Account Requests</h1>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <!-- Default box -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="px-5 py-4">
            <table class="data-table" id="closed-account-requests">
              <thead>
              <tr>
                <th>Organization Details</th>
                <th>Request details</th>
                <th>Contact Details</th>
                <th>Request status</th>
                <th>Date Confirmed</th>
                <th>Rejection Reason</th>
              </tr>
              </thead>
              <tbody>
              <% @closed_account_requests.each do |account_request| %>
                <tr>
                  <td>
                    <%= account_request.organization_name %>
                    <br><%= account_request.organization_website %>
                  </td>
                  <td><%= account_request.request_details %></td>
                  <td><%= account_request.name %>
                    <br><%= account_request.email %>
                  </td>
                  <td><%= account_request.status.titleize %></td>
                  <td><%= account_request.confirmed_at&.strftime("%m/%d/%Y") || "N/A" %></td>
                  <td><%= account_request.rejection_reason %></td>
              <% end %>
              </tr>
              </tbody>
            </table>
          </div>
          <div class="border-t border-slate-200 px-5 py-3">
            <%= paginate @closed_account_requests, param_name: 'close_page' %>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
