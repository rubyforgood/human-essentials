<% content_for :title, "Admin - Barcode Items" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%#
    `modal_button_to` takes Font Awesome names and maps them to Bootstrap Icons; an unmapped
    name silently becomes `bi-dot`, so the icon here is "plus" rather than the "plus-lg" it
    ends up rendering.
  %>
  <%= render "shared/essentials/page_header",
        title: "Barcode items",
        subtitle: "Global barcodes, shared by every organization.",
        actions: modal_button_to("#newBarcode", {text: "New barcode", icon: "plus", size: "md", type: "primary"}) %>

  <%= render "shared/essentials/filter_bar", url: admin_barcode_items_path, frame: "admin-barcode-items-results" do %>
    <div class="min-w-0">
      <%= filter_select(label: "Base item", scope: :barcodeable_id, collection: @items,
            key: :id, value: :name, selected: @selected_barcodeable_id) %>
    </div>
    <%# Same control and same label as the non-admin page: scanning a barcode into the box is the
        fastest way to answer "is this one already registered", which is the question this screen
        exists for. It was the only filter genuinely missing here -- a base item filter was already
        present above, and `by_base_item_partner_key` would have duplicated it. %>
    <div class="min-w-0">
      <%= filter_text(label: "Barcode (boop it!)", scope: :by_value, selected: @selected_barcode_value) %>
    </div>
  <% end %>
  <%= turbo_frame_tag "admin-barcode-items-results", target: "_top", data: {turbo_action: "advance"} do %>

    <%= render "shared/essentials/card", padded: false,
          footer: essentials_pagination_footer(@paginated_barcode_items) do %>
      <% if @barcode_items.blank? %>
        <%= render "shared/essentials/empty_state",
              kind: essentials_filtered? ? :no_results : :cold_start,
              title: essentials_filtered? ? "No barcodes match those filters" : "No global barcodes yet",
              body: essentials_filtered? ? "Clear the filters to see every global barcode." : "A global barcode maps a scan to a base item, for every organization at once." %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Global barcodes</caption>
            <thead>
              <tr>
                <th scope="col">Item type</th>
                <th scope="col" class="quantity">Quantity in the box</th>
                <th scope="col">Barcode</th>
                <th scope="col" class="cell-actions">Actions</th>
              </tr>
            </thead>
            <tbody><%= render partial: "barcode_item_row", collection: @paginated_barcode_items %></tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>

<%= render partial: "admin/barcode_items/barcode_modal", locals: {remote: false, url: admin_barcode_items_path} %>
