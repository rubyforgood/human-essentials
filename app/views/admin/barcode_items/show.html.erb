<% content_for :title, "Admin - Inventory - Barcode Items - #{@barcode_item.value}" %>

<%# A two-column table with one row was a description list wearing a table. %>
<div class="px-4 pt-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Barcode item",
        subtitle: @barcode_item.item.name,
        back: {path: admin_barcode_items_path, label: "Back to barcode items"},
        actions: capture {
          concat essentials_link_button("Edit", edit_admin_barcode_item_path(@barcode_item),
                   variant: :primary, icon: "bi-pencil")
        } %>
</div>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/card", title: "Barcode information" do %>
    <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-slate-600">Item</dt>
        <dd class="mt-0.5 text-sm text-slate-900"><%= @barcode_item.item.name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-600">Quantity</dt>
        <dd class="mt-0.5 text-sm text-slate-900"><%= @barcode_item.quantity %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-600">Barcode</dt>
        <dd class="mt-0.5 font-mono text-sm text-slate-900"><%= @barcode_item.value %></dd>
      </div>
    </dl>
  <% end %>
</div>
