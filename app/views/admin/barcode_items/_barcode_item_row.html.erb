<tr>
  <td><%= barcode_item_row.barcodeable.name %></td>
  <td><%= barcode_item_row.quantity %></td>
  <td><%= barcode_item_row.value %></td>
  <td class="text-right">
    <div class="flex justify-end gap-1.5">
      <%= essentials_link_button "View", admin_barcode_item_path(barcode_item_row), variant: :ghost, size: :sm, icon: "bi-eye" %>
      <%= essentials_link_button "Edit", edit_admin_barcode_item_path(barcode_item_row), variant: :ghost, size: :sm, icon: "bi-pencil" %>
      <%= essentials_action_button "Delete", admin_barcode_item_path(barcode_item_row), method: :delete,
            variant: :ghost_danger, size: :sm, icon: "bi-trash",

            confirm: confirm_delete_msg(barcode_item_row.item.name) %>
    </div>
  </td>
</tr>
