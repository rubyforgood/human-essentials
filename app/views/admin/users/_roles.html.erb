<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <!-- left column -->
      <div class="min-w-0">
        <!-- jquery validation -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-5 py-4">
            <h3 class="text-sm font-semibold text-slate-900"><%= user.display_name %> - Roles</h3>
          </div>

          <!-- form start -->
          <div class="px-5 py-4">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Role Type</th>
                  <th>Resource</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% user.roles.each do |role| %>
                  <tr>
                    <td><%= role.title %></td>
                    <td>
                      <%= role.resource&.name || "Super Admin" %> <%= role.resource&.id ? "(id: #{role.resource&.id})" : "" %>
                    </td>
                    <td class="text-right">
                      <%= delete_button_to admin_user_remove_role_path(user, role_id: role.id),
                                           confirm: "Are you sure you want to remove this role?" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
            <div data-controller="double-select" data-double-select-url-value="<%= resource_ids_admin_users_url %>">
            <h3 class="text-sm font-semibold text-slate-900">Add role</h3>
            <%# Both selects had a bare <label> with no `for`, so neither was named. %>
            <%= form_tag admin_user_add_role_path(user) do %>
              <div class="form-inputs">
                <div class="mb-4">
                  <%= label_tag :resource_type, "Type", class: "block text-sm font-medium text-slate-700" %>
                  <%= select_tag :resource_type, options_for_select(Role::TITLES.invert),
                        class: "mt-1.5 #{EssentialsUiHelper::FILTER_CONTROL_CLASSES}",
                        data: {"double-select-target": "source", action: "double-select#sourceChanged"} %>
                </div>
                <div class="mb-4">
                  <%= label_tag :resource_id, "Resource", class: "block text-sm font-medium text-slate-700" %>
                  <%= select_tag :resource_id, [],
                        class: "mt-1.5 #{EssentialsUiHelper::FILTER_CONTROL_CLASSES}",
                        data: {"double-select-target": "destination"} %>
                </div>
              </div>
              <%= submit_tag "Add role", class: essentials_button_classes(variant: :secondary) %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>
</section>
