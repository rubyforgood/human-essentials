<% content_for :title, "New user" %>

<%#
  The role picker is two dependent selects: choosing a role type fetches the resources that
  role can be scoped to. Both had a bare <label> with no `for`, so neither select was named.
%>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Add a user",
        back: {path: admin_users_path, label: "Back to users"} %>

  <%= essentials_form_for @user, url: admin_users_path do |f| %>
    <%= render "shared/essentials/card",
          footer: capture { submit_button } do %>
      <%= essentials_error_summary(@user) %>

      <%= render "admin/users/user_form_fields", f: f %>

      <div data-controller="double-select hide-by-source-val"
           data-double-select-url-value="<%= resource_ids_admin_users_url %>"
           data-hide-by-source-val-values-to-hide-value="<%= Role::ROLES_WITHOUT_RESOURCE.to_json %>">
        <div class="mb-4">
          <%= label_tag :resource_type, "Role type", class: "block text-sm font-medium text-slate-700" %>
          <%= select_tag :resource_type, options_for_select(Role::TITLES.invert),
                class: EssentialsUiHelper::SELECT_CLASSES,
                "aria-controls": "admin_user_resource_field",
                data: {
                  "double-select-target": "source",
                  "hide-by-source-val-target": "source",
                  action: "hide-by-source-val#sourceChanged double-select#sourceChanged"
                } %>
        </div>

        <%# A super admin has no resource to be scoped to, so this question only applies to the
            other three role types -- revealed under the one that decides it. `shown` is read from
            the same constant the controller is handed, so the two cannot disagree. %>
        <%= render "shared/essentials/conditional_reveal", id: "admin_user_resource_field",
              shown: Role::ROLES_WITHOUT_RESOURCE.exclude?(Role::TITLES.invert.values.first),
              data: {"hide-by-source-val-target": "destination"} do %>
          <%= label_tag :resource_id, "Resource", class: "block text-sm font-medium text-slate-700" %>
          <%= select_tag :resource_id, [],
                class: EssentialsUiHelper::SELECT_CLASSES,
                data: {"double-select-target": "destination"} %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
