<% if @users.any? %>
  <%# In a scroll region like every other table, and meeting the card's edges. %>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
  <table class="data-table">
    <caption>Users across all organizations</caption>
    <thead>
      <tr>
        <th>Roles</th>
        <th>Name</th>
        <th>Email</th>
        <th scope="col" class="cell-actions">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td>
            <%= user.roles.map { |role| "#{role.name} (#{role.resource&.name.presence || "N/A"})" }.compact.uniq.sort.join(", ") %>
          </td>
          <td><%= user.display_name %></td>
          <td><%= user.email %></td>
          <td class="cell-actions">
            <div class="flex justify-end gap-1.5">
              <% if user.invitation_sent_at.present? %>
                <%= essentials_row_icon_action "Re-send invite", admin_user_resend_invitation_path(user), method: :post, icon: "bi-envelope",
                      confirm: "Re-send an invitation to #{user.preferred_name}?" %>
              <% end %>
              <%= essentials_row_icon_link "Edit", edit_admin_user_path(user), icon: "bi-pencil" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
<% else %>
  <%= render "shared/essentials/empty_state", kind: :no_results,
        title: "No users match this search",
        body: "Try a different name or email address, or clear the search to see everyone." %>
<% end %>
