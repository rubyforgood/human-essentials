<% content_for :title, "Users" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Users",
        subtitle: "Everyone with an account." %>

  <%= render "shared/essentials/card", padded: false,
        footer: essentials_pagination_footer(@users) do %>
          <div class="border-b border-slate-200 px-5 py-4">
            <%= form_for_filterrific @filterrific, remote: true, html: { id: 'filterrific-form' } do |f| %>
              <div class="flex flex-wrap items-center justify-between gap-4">
                <div class="min-w-0">
                  <%= f.label :search_name, "Search By User Name" %>
                  <%= f.text_field(:search_name, class: "filterrific-periodically-observed block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none") %>
                </div>
                <div class="min-w-0">
                  <%= f.label :search_email, "Search By Email" %>
                  <%= f.text_field(:search_email, class: "filterrific-periodically-observed block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none") %>
                </div>
                <div class="min-w-0">
                  <%# Was `float-right`, and the button was wrapped in an `<h2>` -- a heading whose
                      whole content is a button, which put a level-2 heading in the middle of a
                      filter bar and announced the button as one. Neither is needed. %>
                  <div class="flex justify-end">
                    <%= new_button_to new_admin_user_path, {text: "Invite user"} %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
    <%# No padding here: the partial's own table meets the card's edges, and a `px-5 py-4` wrapper
        inset it 21px so the row hover and the rule under the headings both stopped short. %>
    <div id="filterrific_results">
      <%= render(partial: "list", locals: {users: @users}) %>
    </div>
  <% end %>
</div>
