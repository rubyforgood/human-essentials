<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Edit - User - #{@user.display_name}" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Editing User <%= @user.display_name %></h1>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <!-- left column -->
      <div class="min-w-0">
        <!-- jquery validation -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-5 py-4">
            <h5 class="text-base font-semibold text-slate-900">Update <%= @user.display_name %>
            </h5>
          </div>

          <!-- form start -->
          <div class="px-5 py-4">
            <%= essentials_form_for @user, url: admin_user_path, html: {id: "quickForm"} do |f| %>
              <div class="form-inputs">
                <%= render 'admin/users/user_form_fields', f: f %>
              </div>
              </div>

              <div class="border-t border-slate-200 px-5 py-3">
                <%= submit_button %>
              </div>
            <% end %>
            </div>

      </div>
    </div>

  </div>
</section>

<% unless @user == current_user %>
  <%= render partial: 'roles', object: @user, as: :user %>
<% end %>
