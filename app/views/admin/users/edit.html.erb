<% content_for :title, "Edit - User - #{@user.display_name}" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Edit user",
        subtitle: @user.display_name,
        back: {path: admin_users_path, label: "Back to users"} %>
</div>

<div class="max-w-3xl px-4 py-6 sm:px-6 lg:px-8">
          <%= essentials_form_for @user, url: admin_user_path, html: {id: "quickForm"} do |f| %>
    <%= render "shared/essentials/card" do %>
              <div class="form-inputs">
                <%= render 'admin/users/user_form_fields', f: f %>
              </div>
    <% end %>

    <%= essentials_form_actions do %>
      <%= submit_button %>
      <%= essentials_link_button "Cancel", admin_users_path, variant: :ghost, size: :md %>
    <% end %>
  <% end %>
</div>

<% unless @user == current_user %>
  <%= render partial: 'roles', object: @user, as: :user %>
<% end %>
