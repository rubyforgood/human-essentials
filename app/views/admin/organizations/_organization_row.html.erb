<tr>
  <td><%= organization_row.name %></td>
  <td><%= link_to organization_row.email, "mailto:#{organization_row.email}" %></td>
  <td class="date"><%= organization_row.created_at.strftime("%F") %></td>
  <td class="cell-actions">
    <div class="flex justify-end gap-1.5">
      <%= essentials_row_icon_link "View", admin_organization_path(organization_row.id), icon: "bi-eye" %>
      <%= essentials_row_icon_link "Edit", edit_admin_organization_path(organization_row.id), icon: "bi-pencil" %>
      <% unless Organization.count <= 1 %>
        <%= essentials_row_icon_action "Delete", admin_organization_path(organization_row.id), method: :delete, icon: "bi-trash", tone: :danger,

              confirm: confirm_delete_msg(organization_row.name) %>
      <% end %>
    </div>
  </td>
</tr>
