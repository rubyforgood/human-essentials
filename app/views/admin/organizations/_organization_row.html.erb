<tr>
  <td><%= organization_row.name %></td>
  <td><%= link_to organization_row.email, "mailto:#{organization_row.email}" %></td>
  <td class="date"><%= organization_row.created_at.strftime("%F") %></td>
  <td class="text-right">
    <div class="flex justify-end gap-1.5">
      <%= essentials_link_button "View", admin_organization_path(organization_row.id), variant: :ghost, size: :sm, icon: "bi-eye" %>
      <%= essentials_link_button "Edit", edit_admin_organization_path(organization_row.id), variant: :ghost, size: :sm, icon: "bi-pencil" %>
      <% unless Organization.count <= 1 %>
        <%= essentials_action_button "Delete", admin_organization_path(organization_row.id), method: :delete,
              variant: :ghost, size: :sm, icon: "bi-trash",
              class: "text-rose-700 hover:bg-rose-50",
              confirm: confirm_delete_msg(organization_row.name) %>
      <% end %>
    </div>
  </td>
</tr>
