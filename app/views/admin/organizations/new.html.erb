<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "New - Organizations" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">New Organization</h1>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>

<%= essentials_form_for @organization, url: admin_organizations_path do |f| %>

  <section>
    <div class="px-4 py-6 sm:px-6 lg:px-8">
      <div class="grid gap-6">
        <!-- left column -->
        <div class="min-w-0">
          <!-- jquery validation -->
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

            <div class="border-b border-slate-200 px-5 py-4">
              <h3>Create New Organization</h3>
            </div>
            <!-- form start -->
            <div class="px-5 py-4">

              <div class="form-inputs">
                <%= f.hidden_field :account_request_id, value: @organization.account_request_id %>

                <%= f.input :name, required: true, autofocus: true %>
                <%= f.input :url, as: :url, placeholder: "http://www.example.com" %>
                <%= f.input :email %>
                <%= f.input :street %>
                <%= f.input :city %>
                <%= f.input :state, collection: us_states, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none", placeholder: "state" %>
                <%= f.input :zipcode %>
                <%= render 'shared/deadline_day_fields', parent_form: f, parent_object: @organization %>
                <%= f.simple_fields_for :account_request do |account_request| %>
                  <%= account_request.input :ndbn_member, label: 'NDBN Membership' do %>
                    <%= account_request.association :ndbn_member, label_method: :full_name, value_method: :id, label: false %>
                  <% end %>
                <% end %>
                <%= f.rich_text_area :default_email_text %>
                <%= f.input :logo %>
                <p class="help-block">Logo should be a 4:1 ratio of width / height (default image is 763 x 188
                  pixels).
                  Only jpeg/png format is supported.
                </p>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Add a user</h1>
                <%= f.simple_fields_for :user, @user do |user| %>
                  <%= render 'admin/users/user_form_fields', f: user %>
                <% end %>

              </div>
            </div>

            <div class="border-t border-slate-200 px-5 py-3">
              <%= submit_button %>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
<% end %>
