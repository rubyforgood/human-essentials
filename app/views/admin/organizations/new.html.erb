<% content_for :title, "New - Organizations" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "New organization",
        subtitle: "A bank, and the first user who administers it.",
        back: {path: admin_organizations_path, label: "Back to organizations"} %>

<div class="max-w-3xl">
  <%= essentials_error_summary(@organization) %>

  <%= essentials_form_for @organization, url: admin_organizations_path do |f| %>
    <%= render "shared/essentials/card" do %>
      <%= f.hidden_field :account_request_id, value: @organization.account_request_id %>

      <%= f.input :name, required: true, autofocus: true %>
      <%= f.input :url, as: :url, placeholder: "http://www.example.com" %>
      <%= f.input :email %>
      <%# One definition of an address field, shared with the six other screens that collect one.
          These four carried no labels at all, so they were titled from the column names --
          "Street", "Zipcode" -- against "Street address" and "Zip code" on the bank's own form. %>
      <%= f.input :street, **address_field(:street) %>
      <%= f.input :city, **address_field(:city) %>
      <%= f.input :state, **address_field(:state) %>
      <%= f.input :zipcode, **address_field(:zip) %>
      <%= render "shared/deadline_day_fields", parent_form: f, parent_object: @organization %>
      <%= f.simple_fields_for :account_request do |account_request| %>
        <%= account_request.association :ndbn_member, label: "NDBN membership",
              label_method: :full_name, value_method: :id %>
      <% end %>
      <%# Wrapped in f.input so the trix editor has a label. A bare rich_text_area renders a
          trix-editor with role=textbox and no accessible name. %>
      <%= f.input :default_email_text, label: "Default email text" do %>
        <%= f.rich_text_area :default_email_text %>
      <% end %>
      <%= f.input :logo, hint: "A 4:1 ratio of width to height; the default is 763 by 188 pixels. JPEG or PNG." %>

      <%# Was an <h1>, which gave the page two of them. The page header owns the only h1. %>
      <fieldset class="mt-6 border-t border-slate-200 pt-5">
        <legend class="text-base font-semibold text-slate-900">First user</legend>
        <p class="mb-4 text-sm text-slate-600">The person who will administer this organization.</p>
        <%= f.simple_fields_for :user, @user do |user| %>
          <%= render "admin/users/user_form_fields", f: user %>
        <% end %>
      </fieldset>
    <% end %>

    <%= essentials_form_actions do %>
      <%= submit_button %>
      <%= essentials_link_button "Cancel", admin_organizations_path, variant: :ghost, size: :md %>
    <% end %>
  <% end %>
</div>
</div>
