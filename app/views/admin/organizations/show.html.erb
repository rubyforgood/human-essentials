<%#
  The same three partials as `organizations/show`, seen by a super admin. Kept in step with it --
  including the single page wrapper, which is what puts the design system's 24px between the
  heading and the first card.
%>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "organizations/header", link_path: @header_link %>

  <div class="space-y-6">
    <%= render "organizations/details" %>
    <%= render "users/organization_users_table" %>
  </div>
</div>
