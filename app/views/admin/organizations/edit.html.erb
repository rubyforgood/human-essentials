<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Edit - Organizations - #{@organization.name}" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Editing</h1>
<p class="mt-1 text-sm text-slate-600"><%= @organization.name %></p>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>

<%= essentials_form_for @organization, url: admin_organization_path do |f| %>
  <section>
    <div class="px-4 py-6 sm:px-6 lg:px-8">
      <div class="grid gap-6">
        <!-- left column -->
        <div class="min-w-0">
          <!-- jquery validation -->
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

            <div class="border-b border-slate-200 px-5 py-4">
              <h3>Update record for <%= @organization.name %></h3>
            </div>
            <!-- form start -->
            <div class="px-5 py-4">

              <div class="form-inputs">
                <%= f.input :name, required: true, autofocus: true do %>
                  <span class="input-group-text"><i class="bi-person"></i></span>
                  <%= f.input_field :name, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
                <% end %>
                <%= f.input :url, as: :url, placeholder: "http://www.example.com" do %>
                  <span class="input-group-text"></span>
                  <%= f.input_field :url, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
                <% end %>
                <%= f.input :email do %>
                  <span class="input-group-text"><i class="bi-envelope"></i></span>
                  <%= f.input_field :email, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
                <% end %>

                <%= f.input :address do %>
                  <span class="input-group-text"></span>
                  <%= f.input_field :street, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none", placeholder: "street" %>
                  <%= f.input_field :city, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none", placeholder: "city" %>
                  <%= f.input_field :state, collection: us_states, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none", placeholder: "state" %>
                  <%= f.input_field :zipcode, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none", placeholder: "zipcode" %>
                <% end %>

                <%= render 'shared/deadline_day_fields', parent_form: f, parent_object: @organization %>

                <%= f.input :intake_location, :collection => @organization.storage_locations.active.alphabetized, :label_method => :name, :value_method => :id, :label => "Default Intake Location", :include_blank => true %>

                <%= f.input :invitation_text, label: "Custom Partner Invitation Message" do %>
                  <%= f.text_area :invitation_text, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
                <% end %>

                <%= f.input :default_email_text, label: "Default Text Included In Distribution Emails" do %>
                  <%= f.rich_text_area :default_email_text %>
                <% end %>

                <%= f.input :logo do %>

                  <% if @organization.logo.attached? %>
                    <div>
                      <p>
                        <%= image_tag @organization.logo %>
                      </p>
                      <p>
                        <a href="#showTheLogo" class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" data-action="click->dialog#open">
                          View Original
                        </a>
                      </p>
                      <div id="showTheLogo" class="modal fade">
                        <div class="">
                          <%= image_tag @organization.logo, class: "thumbnail" %>
                          <button type="button" class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" onclick="this.closest('dialog').close()">Close</button>
                        </div>
                      </div>
                    </div>
                    <label class="control-label">Update Logo</label>
                  <% end %>

                  <%= f.input_field :logo, as: :file %>
                  <p class="help-block">
                    Logo should be a 4:1 ratio of width / height (default image is 763 x 188 pixels).
                    Only jpeg/png format is supported.
                  </p>

                <% end %>
              </div>
            </div>

            <div class="border-t border-slate-200 px-5 py-3">
              <%= submit_button %>
            </div>
          </div>
        </div>

      </div>
    </div>
<% end %>
</section>
