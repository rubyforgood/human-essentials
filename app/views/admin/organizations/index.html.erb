<% content_for :title, "Admin - Organizations" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Organizations",
        subtitle: "Every bank using Human Essentials." %>

  <%= render "shared/essentials/card", padded: false do %>
          <div class="border-b border-slate-200 px-5 py-4">
            <%= form_for_filterrific @filterrific, remote: true do |f| %>
              <div class="flex flex-wrap items-center justify-between gap-4">
                <div class="min-w-0">
                  <%= f.label :search_name, "Search By Organization Name" %>
                  <%= f.text_field(:search_name, class: "filterrific-periodically-observed block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none") %>
                </div>
                <div class="min-w-0">
                  <%= render_filterrific_spinner %>
                </div>
                <div class="min-w-0">
                  <%# `float-right` here, and the button was the only thing in the cell. A flex row
                      that pushes its one child to the end does the same job and stays in flow. %>
                  <div class="flex justify-end">
                    <%= new_button_to new_admin_organization_path, {text: "New organization"} %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
          <div id="filterrific_results">
            <%= render( partial: 'list', locals: { organizations: @organizations }) %>
          </div>
  <% end %>
</div>
