<% content_for :title, "Admin dashboard" %>

<%#
  The super admin dashboard. Every number on it is "in the last week" except the organization
  total, so each stat says its own period rather than leaving the reader to assume.

  Two "View All Orders" links pointed at href="#": this app has no orders, and the links went
  nowhere. They are gone rather than restyled.
%>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Dashboard",
        subtitle: "Activity across every organization on the platform." %>

  <%
    stats = [
      {label: "Donations", period: "Last 7 days", value: @donation_count, icon: "bi-box-seam", tone: :brand},
      {label: "Distributions", period: "Last 7 days", value: @distribution_count, icon: "bi-truck", tone: :info},
      {label: "Requests", period: "Last 7 days", value: @request_count, icon: "bi-file-text", tone: :success},
      {label: "Organizations", period: "All time", value: @organization_count, icon: "bi-bank", tone: :warning}
    ]
  %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <% stats.each do |stat| %>
      <div class="card-surface flex items-center gap-3 p-5">
        <%= essentials_icon_tile(stat[:icon], tone: stat[:tone]) %>
        <div class="min-w-0">
          <p class="text-sm font-medium text-slate-600"><%= stat[:label] %></p>
          <p class="text-2xl font-bold tracking-tight text-slate-900"><%= number_with_delimiter(stat[:value]) %></p>
          <p class="text-xs text-slate-500"><%= stat[:period] %></p>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <%# The count moved out of `actions:` and into the subtitle, where the sibling card below
        already puts its explanatory line. It was wrong three ways there: a count is not a status,
        a status is not an action, and `@recent_users.count` returned the `.limit(20)` cap rather
        than the total -- "20 new users" with 23 signed up. See essentials_recent_subtitle. %>
    <%= render "shared/essentials/card",
          title: "Recently added users",
          subtitle: essentials_recent_subtitle(@recent_users.length, total: @recent_users_total, noun: "users"),
          footer: capture { essentials_link_button("View all users", admin_users_path, variant: :secondary, size: :sm) } do %>
      <% if @recent_users.any? %>
        <ul class="divide-y divide-slate-100">
          <% @recent_users.each do |user| %>
            <li class="flex items-center gap-3 py-2.5 first:pt-0 last:pb-0">
              <%= image_tag gravatar_url(user.email, 32), alt: "", class: "h-8 w-8 shrink-0 rounded-full" %>
              <%= link_to recently_added_user_display_text(user), edit_admin_user_path(user),
                    class: "min-w-0 flex-1 truncate text-sm font-medium text-brand-700 hover:text-brand-800" %>
              <span class="shrink-0 text-xs text-slate-500"><%= time_ago_in_words(user.created_at) %> ago</span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "shared/essentials/empty_state", kind: :all_clear,
              title: "No new users this week" %>
      <% end %>
    <% end %>

    <%# This list is not capped, so its count was correct -- and exactly the length of the list
        directly below it, which is the redundancy the `<tfoot>` totals were dropped for. What the
        card never said is the period, so that is what the subtitle carries. %>
    <%= render "shared/essentials/card",
          title: "Recently added organizations",
          subtitle: essentials_recent_subtitle(@recent_organizations.length),
          footer: capture { essentials_link_button("View all organizations", admin_organizations_path, variant: :secondary, size: :sm) } do %>
      <% if @recent_organizations.any? %>
        <ul class="divide-y divide-slate-100">
          <% @recent_organizations.each do |org| %>
            <li class="flex items-center gap-3 py-2.5 first:pt-0 last:pb-0">
              <%= link_to org.name, admin_organization_path(org.id),
                    class: "min-w-0 flex-1 truncate text-sm font-medium text-brand-700 hover:text-brand-800" %>
              <span class="shrink-0 text-xs text-slate-500"><%= time_ago_in_words(org.created_at) %> ago</span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "shared/essentials/empty_state", kind: :all_clear,
              title: "No new organizations this week" %>
      <% end %>
    <% end %>
  </div>

  <div class="mt-6 grid gap-6">
    <%= render "shared/essentials/card",
          title: "Top 10 uses of \"Other\"",
          subtitle: "Items banks had to file under Other -- candidates for a new base item.",
          padded: false,
          footer: capture { essentials_link_button("View all items", admin_base_items_path, variant: :secondary, size: :sm) } do %>
      <% if @top_10_other.any? %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Item names most often filed under the Other base item</caption>
            <thead>
              <tr>
                <th>Name</th>
                <th class="numeric">Occurrences</th>
              </tr>
            </thead>
            <tbody>
              <% @top_10_other.each do |name, occurrences| %>
                <tr>
                  <td><%= name %></td>
                  <td class="numeric"><%= number_with_delimiter(occurrences) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <%= render "shared/essentials/empty_state", kind: :all_clear,
              title: "Nothing filed under Other" %>
      <% end %>
    <% end %>

    <%= render "shared/essentials/card", title: "Recently active users", padded: false do %>
      <% if @active_users.any? %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Users who made a request in the last week</caption>
            <thead>
              <tr>
                <th>User</th>
                <th>Email</th>
                <th>Organization</th>
                <th class="date">Last active</th>
              </tr>
            </thead>
            <tbody>
              <% @active_users.each do |user| %>
                <tr>
                  <td><%= user.display_name %></td>
                  <td><%= user.email %></td>
                  <td><%= user.organization&.name %></td>
                  <td class="date"><%= time_ago_in_words(user.last_request_at) %> ago</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <%= render "shared/essentials/empty_state", kind: :all_clear,
              title: "Nobody has been active this week" %>
      <% end %>
    <% end %>
  </div>
</div>
