<% content_for :title, "Questions" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Questions and answers",
        subtitle: "The FAQ shown to banks and partners.",
        actions: essentials_link_button("Write a new question and answer", new_admin_question_path, variant: :primary, icon: "bi-plus-lg") %>

  <% if @bank_questions.blank? %>
    <%= render "shared/essentials/card" do %>
      <%= render "shared/essentials/empty_state", kind: :cold_start,
            title: "No questions yet",
            body: "Questions you write here appear in the in-app help for banks and partners.",
            action: essentials_link_button("Write a new question and answer", new_admin_question_path, variant: :primary, icon: "bi-plus-lg") %>
    <% end %>
  <% else %>
    <div class="space-y-4" data-controller="disclosure">
      <% @bank_questions.each do |question| %>
        <%= render "shared/essentials/disclosure",
              panel_id: "collapse#{question.id}",
              title: question.title,
              actions: capture {
                concat essentials_link_button("Edit", edit_admin_question_path(question), variant: :ghost, size: :sm, icon: "bi-pencil")
                concat essentials_action_button("Delete", admin_question_path(question), method: :delete,
                         variant: :ghost_danger, size: :sm, icon: "bi-trash",
                         confirm: confirm_delete_msg(question.title))
              } do %>
          <%= question.answer %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
