<%= essentials_error_summary(f.object) %>

<%= render "shared/essentials/card", title: "FAQ Entry" do %>
<div class="px-5 py-4">
  <div class="form-inputs">
    <%= f.input :title %>
    <div class="font-bold mb-2">Answer</div>
    <%= f.input :answer, label: "Answer" do %>
      <%= f.rich_text_area :answer %>
    <% end %>
  </div>
</div>
<div class="border-t border-slate-200 px-5 py-3">
  <%= submit_button %>
</div>
<% end %>
