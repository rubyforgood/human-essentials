<% content_for :title, "Purchase - #{current_organization.name}" %>
<% inactive = @purchase.has_inactive_item? %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%#
    The same two actions the donation page has carried for years, and this one never did -- stock
    bought is stock that can go out, and a purchase receipt is the same document as a donation
    receipt. "Start a distribution" copies this purchase's line items and its storage location into
    a new distribution, through `Distribution#copy_from_purchase`; before this the button could not
    exist, because `copy_line_items` hardcoded a donation.
  %>
  <%= render "shared/essentials/page_header",
        title: "Purchase",
        subtitle: "From #{@purchase.purchased_from_view} on #{@purchase.issued_at.to_fs(:distribution_date)}.",
        back: {path: purchases_path, label: "Back to purchases"},
        actions: capture {
          concat essentials_link_button("Print", print_purchase_path(@purchase, format: :pdf), variant: :secondary, icon: "bi-printer")
          concat essentials_link_button("Start a distribution", new_distribution_path(purchase_id: @purchase.id, storage_location_id: @purchase.storage_location_id), variant: :primary, icon: "bi-plus-lg")
        } %>

  <div class="space-y-6">
    <% if inactive %>
      <%= render "shared/essentials/callout", tone: :warning, role: "status" do %>
        <p class="font-semibold">This purchase cannot be corrected or deleted</p>
        <p class="mt-1">
        Purchases can only be changed while all of their items are active. To delete this
        purchase or make a correction,
        reactivate these items: <%= @purchase.inactive_items.map(&:name).join(", ") %>
        </p>

      <% end %>
    <% end %>

    <%= render "shared/essentials/card", title: "Details" do %>
      <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <dt class="text-xs font-medium text-slate-500">Date of purchase</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= @purchase.issued_at.to_fs(:distribution_date) %> (entered: <%= @purchase.created_at.to_fs(:distribution_date) %>)</dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-slate-500">Vendor</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= @purchase.purchased_from_view %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-slate-500">Storage location</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= @purchase.storage_view %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-slate-500">Amount spent</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= dollar_value(@purchase.amount_spent_in_cents) %></dd>
        </div>
        <div class="sm:col-span-2 lg:col-span-4">
          <dt class="text-xs font-medium text-slate-500">Comment</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= @purchase.comment.presence || "—" %></dd>
        </div>
      </dl>
    <% end %>

    <%= render "shared/essentials/card", title: "Items purchased", padded: false do %>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
        <table class="data-table">
          <caption>Items in this purchase</caption>
          <thead>
            <tr>
              <th scope="col">Item</th>
              <th scope="col" class="quantity">Quantity</th>
            </tr>
          </thead>
          <tbody><%= render partial: "purchase_item_row", collection: @line_items %></tbody>
        </table>
      </div>
    <% end %>

    <% unless inactive %>
      <div class="flex flex-wrap items-center gap-2">
        <%= essentials_link_button "Make a correction", edit_purchase_path(@purchase), variant: :secondary, icon: "bi-pencil" %>
        <% if current_user.has_cached_role?(Role::ORG_ADMIN, current_organization) %>
          <%= essentials_action_button "Delete", purchase_path(@purchase), method: :delete,
                variant: :ghost_danger, icon: "bi-trash",
                confirm: "Are you sure you want to permanently remove this purchase?" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
