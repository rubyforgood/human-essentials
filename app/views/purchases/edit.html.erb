<% content_for :title, "Edit Purchase - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Editing purchase",
        subtitle: "From #{@purchase.purchased_from_view}.",
        back: {path: purchases_path, label: "Back to purchases"} %>

  <% if @audit_performed_and_finalized %>
    <%= render "shared/essentials/callout", tone: :warning, role: "status", wrapper_class: "mb-6" do %>
      You’ve had an audit since this purchase was started. In the case that you are correcting a typo, rather than recording that the physical amounts being purchased have changed,
      you’ll need to make an adjustment to the inventory as well.

    <% end %>
  <% end %>

  <%= render partial: "purchase_form", object: @purchase %>

  <%= link_to "Add vendor", new_vendor_path, remote: true, id: "new_vendor", class: "hidden", "aria-hidden": true, tabindex: -1 %>
</div>

<%= render partial: "barcode_items/barcode_modal" %>
