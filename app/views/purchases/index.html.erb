<% content_for :title, "Purchases - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Purchases",
        subtitle: "Essentials bought by #{current_organization.name}.",
        actions: capture {
          if @purchases.any?
            concat essentials_link_button("Export", purchases_path(format: :csv, filters: filter_params.merge(date_range: date_range_params)), variant: :secondary, icon: "bi-download")
          end
          concat essentials_link_button("New purchase", new_purchase_path, variant: :primary, icon: "bi-plus-lg")
        } %>

  <%= render "shared/essentials/filter_bar", url: purchases_path do %>
    <% if @storage_locations.present? %>
      <div class="min-w-[13rem]"><%= essentials_filter_select(label: "Storage location", scope: :at_storage_location, collection: @storage_locations, selected: @selected_storage_location) %></div>
    <% end %>
    <% if @vendors.present? %>
      <div class="min-w-[13rem]"><%= essentials_filter_select(label: "Vendor", scope: :from_vendor, collection: @vendors, value: :business_name, selected: @selected_vendor) %></div>
    <% end %>
    <% if @item_categories.present? %>
      <div class="min-w-[13rem]"><%= essentials_filter_options(label: "Category", scope: :by_category, options: @item_categories, selected: @selected_item_category) %></div>
    <% end %>
    <div class="min-w-[15rem]">
      <%= label_tag "filters_date_range", "Purchase date range", class: EssentialsUiHelper::FILTER_LABEL_CLASSES %>
      <%= render partial: "shared/date_range_picker", locals: {css_class: EssentialsUiHelper::FILTER_CONTROL_CLASSES} %>
    </div>
  <% end %>

  <%= render "shared/essentials/card", padded: false,
        footer: capture { concat(render("shared/essentials/pagination", collection: @paginated_purchases)) } do %>
    <% if @paginated_purchases.blank? %>
      <%= render "shared/essentials/empty_state",
            kind: filter_params.present? ? :no_results : :cold_start,
            title: filter_params.present? ? "No purchases match those filters" : "No purchases recorded yet",
            body: filter_params.present? ? "Clear the filters to see every purchase." : "Record essentials your bank has bought so their value is counted in your inventory.",
            action: filter_params.present? ? nil : essentials_link_button("New purchase", new_purchase_path, variant: :primary, icon: "bi-plus-lg") %>
    <% else %>
      <div class="table-scroll">
        <table class="data-table">
          <caption>Purchases, most recent first</caption>
          <thead>
            <tr>
              <th scope="col">Purchases from</th>
              <th scope="col">Storage location</th>
              <th scope="col">Comments</th>
              <th scope="col" class="quantity">Quantity of items</th>
              <th scope="col" class="quantity">Variety of items</th>
              <th scope="col" class="numeric">Amount spent</th>
              <th scope="col" class="numeric">Fair market value</th>
              <th scope="col" class="date">Purchased date</th>
              <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody><%= render partial: "purchase_row", collection: @paginated_purchases %></tbody>
          <tfoot>
            <tr>
              <td colspan="3">Total</td>
              <td class="quantity">
                <%= number_with_delimiter(@paginated_purchases_quantity) %>
                <span class="block text-xs font-normal text-slate-500">this page</span>
                <span id="purchase_quantity" class="mt-1 block"><%= number_with_delimiter(@purchases_quantity) %></span>
                <span class="block text-xs font-normal text-slate-500">all purchases</span>
              </td>
              <td></td>
              <td class="numeric">
                <%= dollar_value(@paginated_purchases_value) %>
                <span class="block text-xs font-normal text-slate-500">this page</span>
                <span class="mt-1 block"><%= dollar_value(@total_value_all_purchases) %></span>
                <span class="block text-xs font-normal text-slate-500">all purchases</span>
              </td>
              <td class="numeric">
                <%= dollar_value(@paginated_fair_market_values) %>
                <span class="block text-xs font-normal text-slate-500">this page</span>
                <span class="mt-1 block"><%= dollar_value(@total_fair_market_values) %></span>
                <span class="block text-xs font-normal text-slate-500">all purchases</span>
              </td>
              <td colspan="2"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% end %>
  <% end %>
</div>
