<% content_for :title, "Pick Ups & Deliveries - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Pick ups & deliveries",
        subtitle: "See when each distribution is due out, or subscribe to this calendar from your own.",
        actions: essentials_link_button("Copy calendar URL", "javascript:void(0)",
                   variant: :secondary, icon: "bi-clipboard",
                   id: "copy-calendar-button", data: {url: hashed_calendar_path}) %>

  <%#
    The toolbar is ours, not FullCalendar's. Its own is three buttons filled `rgb(44,62,80)` at a
    4px radius and 16px text, beside a 28px/400 title -- a page's worth of primary-looking chrome
    for moving the month, on a page whose real action is a quiet secondary. The grid is restyled in
    CSS the way select2 is; these three are cheap to own outright, and owning them means a library
    upgrade cannot silently revert them. See design.md.

    "‹ Prev" and "Next ›" rather than bare chevrons: design.md reserves icon-only for a repeating
    row action, and this is the shape the pager already uses for the same job. The `aria-label`
    extends the visible word rather than replacing it, which is what 2.5.3 asks.
  %>
  <%= render "shared/essentials/card" do %>
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3"
         data-controller="calendar">
      <%# `aria-live`: the buttons change the grid without navigating, so without this nothing
          tells a screen reader which month is now on screen. %>
      <h2 class="text-base font-semibold text-slate-900"
          data-calendar-target="title" aria-live="polite"></h2>

      <div class="flex flex-wrap items-center gap-2">
        <%#
          Month and Week, and no Day: over a year, 22 days had any distribution at all, mean 1.9,
          and 13 of those held exactly one. `aria-pressed` rather than a radio group, because these
          are two buttons that toggle a state rather than a value being submitted.
        %>
        <div class="inline-flex overflow-hidden rounded-lg border border-slate-300"
             role="group" aria-label="Calendar view">
          <% [["month", "Month"], ["week", "Week"]].each_with_index do |(value, label), index| %>
            <%= button_tag label, type: "button",
                  class: "px-3 py-1.5 text-xs font-medium text-slate-700 transition-colors " \
                         "hover:bg-slate-50 aria-pressed:bg-slate-100 aria-pressed:text-slate-900 " \
                         "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 " \
                         "#{"border-l border-slate-300" if index.positive?}",
                  "aria-pressed": "false",
                  data: {calendar_view: value, action: "calendar#switchView",
                         calendar_target: "viewButton"} %>
          <% end %>
        </div>

        <%= button_tag "Today", type: "button",
              class: essentials_button_classes(variant: :secondary, size: :sm),
              data: {action: "calendar#today"} %>
        <%= button_tag type: "button", "aria-label": "Previous month",
              class: essentials_button_classes(variant: :secondary, size: :sm),
              data: {action: "calendar#previous"} do %>
          <i class="bi-chevron-left" aria-hidden="true"></i> Prev
        <% end %>
        <%= button_tag type: "button", "aria-label": "Next month",
              class: essentials_button_classes(variant: :secondary, size: :sm),
              data: {action: "calendar#next"} do %>
          Next <i class="bi-chevron-right" aria-hidden="true"></i>
        <% end %>
      </div>

      <%# FullCalendar renders into here; see calendar_controller.js. %>
      <div id="calendar" class="fc min-h-[36rem] w-full" data-calendar-target="grid"></div>
    </div>
  <% end %>
</div>
