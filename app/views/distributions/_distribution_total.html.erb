<tr>
  <td colspan="5">Total</td>
  <td class="overall-total-items quantity">
    <%= number_with_delimiter(@total_items_paginated_distributions) %> <%= quantity_label %>
    <span class="block text-xs font-normal text-slate-500">this page</span>
    <span class="mt-1 block"><%= number_with_delimiter(@total_items_all_distributions) %> <%= quantity_label %></span>
    <span class="block text-xs font-normal text-slate-500">all distributions</span>
  </td>
  <td class="overall-total-value numeric">
    <%= dollar_value(@total_value_paginated_distributions) %>
    <span class="block text-xs font-normal text-slate-500">this page</span>
    <span class="mt-1 block"><%= dollar_value(@total_value_all_distributions) %></span>
    <span class="block text-xs font-normal text-slate-500">all distributions</span>
  </td>
  <td colspan="5"></td>
</tr>
