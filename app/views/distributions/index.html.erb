<% content_for :title, "Distributions - #{current_organization.name}" %>
<%
  filtered_item_name = @selected_item ? @items.find { |i| i.id == filter_params[:by_item_id].to_i }&.name : nil
  filtered_category_name = @selected_item_category ? @item_categories.find { |ic| ic.id == filter_params[:by_item_category_id].to_i }&.name : nil
  filtered_reporting_category_name = @selected_reporting_category ? @reporting_categories.find { |rc| rc.id == filter_params[:by_reporting_category] }&.name : nil
  quantity_label = filtered_item_name || (filtered_category_name && "in #{filtered_category_name}") || filtered_reporting_category_name || "Items"
%>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Distributions",
        subtitle: "Track what has gone out to partners, and what is still scheduled.",
        actions: capture {
          if @distributions.any?
            # `export_csv: true` rather than `format: :csv`, from main: the controller redirects
            # back here with a flag and the download runs in the background, instead of the browser
            # sitting on a long request with nothing to show. The label stays "Export", which is
            # what every other index page in this app calls it.
            concat essentials_link_button("Export", distributions_path(export_csv: true, filters: filter_params.merge(date_range: date_range_params)), variant: :secondary, icon: "bi-box-arrow-up", data: {filter_export: true})
          end
          concat essentials_link_button("New distribution", new_distribution_path, variant: :primary, icon: "bi-plus-lg")
        } %>

  <%= render "shared/essentials/filter_bar", url: distributions_path, frame: "distributions-results" do %>
    <% if @items.present? %>
      <div class="min-w-0"><%= filter_select(label: "Item", scope: :by_item_id, collection: @items, selected: @selected_item) %></div>
    <% end %>
    <% if @item_categories.present? %>
      <div class="min-w-0"><%= filter_select(label: "Item category", scope: :by_item_category_id, collection: @item_categories, selected: @selected_item_category) %></div>
    <% end %>
    <div class="min-w-0"><%= filter_select(label: "Reporting category", scope: :by_reporting_category, collection: @reporting_categories, selected: @selected_reporting_category) %></div>
    <% if @partners.present? %>
      <div class="min-w-0"><%= filter_select(label: "Partner", scope: :by_partner, collection: @partners, selected: @selected_partner) %></div>
    <% end %>
    <% if @storage_locations.present? %>
      <div class="min-w-0"><%= filter_select(label: "Source inventory", scope: :by_location, collection: @storage_locations, selected: @selected_location) %></div>
    <% end %>
    <div class="min-w-0"><%= filter_select(label: "Status", scope: :by_state, collection: @statuses, key: :last, value: :first, selected: @selected_status) %></div>
    <div class="min-w-0">
      <%= render partial: "shared/date_range_picker" %>
    </div>
  <% end %>
  <%= turbo_frame_tag "distributions-results", target: "_top", data: {turbo_action: "advance"} do %>

    <%#
      The figures the summary report used to live on, on the page that holds the data. They are
      driven by the same filters as the table, which is the point -- the totals describe what you
      are looking at. These were already computed for the table footer that used to sit below.
    %>
    <%= essentials_stats([
          {label: "Distributions", value: number_with_delimiter(@distributions.size)},
          {label: "Items distributed", value: number_with_delimiter(@total_items_all_distributions)},
          {label: "Total value", value: dollar_presentation(@total_value_all_distributions)}
              ], title: "Totals",
           subtitle: essentials_stats_scope(@distributions.size, "distribution")) %>

    <div class="mt-6"></div>

    <%= render "shared/essentials/card", padded: false,
          footer: essentials_pagination_footer(@paginated_distributions) do %>
      <% if @paginated_distributions.blank? %>
        <%= render "shared/essentials/empty_state",
              kind: essentials_filtered? ? :no_results : :cold_start,
              title: essentials_filtered? ? "No distributions #{date_range_label}" : "No distributions yet",
              body: essentials_filtered? ? "Try a wider date range, or clear the filters to see every distribution." : "A distribution records essentials leaving your bank for a partner agency.",
              action: essentials_filtered? ? nil : essentials_link_button("Create your first distribution", new_distribution_path, variant: :primary, icon: "bi-plus-lg") %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Distributions to partner agencies</caption>
            <%#
              Three columns were dropped on 2026-09-04 so this table fits: **source inventory**
              (202px), **shipping cost** (108px) and **comments** (146px). Measured at 1440px, the
              table was 1,521px against 1,118px of visible width and scrolled by 403px; the actions
              column had already come down from 331px to 76px, so the rest had to come out of data.

              Each is still on the distribution's own page, and all three remain in the CSV export --
              this is a decision about what is worth *scanning a list* for, not about what is worth
              recording. Shipping cost also applies to only one of three delivery methods, so it was
              blank on most rows; comments is free text that is usually empty and never scannable in
              a column.
            %>
            <thead>
              <tr>
                <th scope="col" class="pin-col">ID</th>
                <th scope="col" class="name">Partner</th>
                <th scope="col" class="date">Initial allocation</th>
                <th scope="col" class="date">Date of distribution</th>
                <th scope="col" class="quantity">
                  <%= filtered_item_name ? "Total #{filtered_item_name}" : (filtered_category_name ? "Total in #{filtered_category_name}" : (filtered_reporting_category_name ? "Total #{filtered_reporting_category_name}" : "Total items")) %>
                </th>
                <th scope="col" class="numeric">
                  <%= filtered_item_name ? "Value of #{filtered_item_name}" : (filtered_category_name ? "Value of #{filtered_category_name}" : (filtered_reporting_category_name ? "Value of #{filtered_reporting_category_name}" : "Total value")) %>
                </th>
                <th scope="col">Delivery method</th>
                <th scope="col">Status</th>
                <th scope="col" class="cell-actions">Actions</th>
              </tr>
            </thead>
            <tbody><%= render partial: "distribution_row", collection: @paginated_distributions %></tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
