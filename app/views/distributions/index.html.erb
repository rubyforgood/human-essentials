<% content_for :title, "Distributions - #{current_organization.name}" %>
<%
  filtered_item_name = @selected_item ? @items.find { |i| i.id == filter_params[:by_item_id].to_i }&.name : nil
  filtered_category_name = @selected_item_category ? @item_categories.find { |ic| ic.id == filter_params[:by_item_category_id].to_i }&.name : nil
  filtered_reporting_category_name = @selected_reporting_category ? @reporting_categories.find { |rc| rc.id == filter_params[:by_reporting_category] }&.name : nil
  quantity_label = filtered_item_name || (filtered_category_name && "in #{filtered_category_name}") || filtered_reporting_category_name || "Items"
%>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Distributions",
        subtitle: "Essentials sent out to partner agencies.",
        actions: capture {
          if @distributions.any?
            concat essentials_link_button("Export", distributions_path(format: :csv, filters: filter_params.merge(date_range: date_range_params)), variant: :secondary, icon: "bi-download")
          end
          concat essentials_link_button("New distribution", new_distribution_path, variant: :primary, icon: "bi-plus-lg")
        } %>

  <%= render "shared/essentials/filter_bar", url: distributions_path do %>
    <% if @items.present? %>
      <div class="min-w-[13rem]"><%= filter_select(label: "Item", scope: :by_item_id, collection: @items, selected: @selected_item) %></div>
    <% end %>
    <% if @item_categories.present? %>
      <div class="min-w-[13rem]"><%= filter_select(label: "Item category", scope: :by_item_category_id, collection: @item_categories, selected: @selected_item_category) %></div>
    <% end %>
    <div class="min-w-[13rem]"><%= filter_select(label: "Reporting category", scope: :by_reporting_category, collection: @reporting_categories, selected: @selected_reporting_category) %></div>
    <% if @partners.present? %>
      <div class="min-w-[13rem]"><%= filter_select(label: "Partner", scope: :by_partner, collection: @partners, selected: @selected_partner) %></div>
    <% end %>
    <% if @storage_locations.present? %>
      <div class="min-w-[13rem]"><%= filter_select(label: "Source inventory", scope: :by_location, collection: @storage_locations, selected: @selected_location) %></div>
    <% end %>
    <div class="min-w-[13rem]"><%= filter_select(label: "Status", scope: :by_state, collection: @statuses, key: :last, value: :first, selected: @selected_status) %></div>
    <div class="min-w-[15rem]">
      <%= render partial: "shared/date_range_picker", locals: {css_class: EssentialsUiHelper::FILTER_CONTROL_CLASSES} %>
    </div>
  <% end %>

  <%= render "shared/essentials/card", padded: false,
        footer: capture { concat(render("shared/essentials/pagination", collection: @paginated_distributions)) } do %>
    <% if @paginated_distributions.blank? %>
      <%= render "shared/essentials/empty_state",
            kind: essentials_filtered? ? :no_results : :cold_start,
            title: essentials_filtered? ? "No distributions match those filters" : "No distributions yet",
            body: essentials_filtered? ? "Clear the filters to see every distribution." : "A distribution records essentials leaving your bank for a partner agency.",
            action: essentials_filtered? ? nil : essentials_link_button("New distribution", new_distribution_path, variant: :primary, icon: "bi-plus-lg") %>
    <% else %>
      <div class="table-scroll">
        <table class="data-table">
          <caption>Distributions to partner agencies</caption>
          <thead>
            <tr>
              <th scope="col">ID</th>
              <th scope="col">Partner</th>
              <th scope="col" class="date">Initial allocation</th>
              <th scope="col" class="date">Date of distribution</th>
              <th scope="col">Source inventory</th>
              <th scope="col" class="quantity">
                <%= filtered_item_name ? "Total #{filtered_item_name}" : (filtered_category_name ? "Total in #{filtered_category_name}" : (filtered_reporting_category_name ? "Total #{filtered_reporting_category_name}" : "Total items")) %>
              </th>
              <th scope="col" class="numeric">
                <%= filtered_item_name ? "Value of #{filtered_item_name}" : (filtered_category_name ? "Value of #{filtered_category_name}" : (filtered_reporting_category_name ? "Value of #{filtered_reporting_category_name}" : "Total value")) %>
              </th>
              <th scope="col">Delivery method</th>
              <th scope="col" class="numeric">Shipping cost</th>
              <th scope="col">Comments</th>
              <th scope="col">Status</th>
              <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody><%= render partial: "distribution_row", collection: @paginated_distributions %></tbody>
          <tfoot><%= render partial: "distribution_total", locals: {quantity_label: quantity_label} %></tfoot>
        </table>
      </div>
    <% end %>
  <% end %>
</div>
