<% content_for :title, "Distribution to #{@distribution.partner.name} - #{current_organization.name}" %>
<% inactive = @distribution.has_inactive_item? %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%# Both ends of the movement, as on the old page: which inventory it left and who received
      it are equally part of identifying a distribution. %>
  <%= render "shared/essentials/page_header",
        title: "Distribution from #{@distribution.storage_location.name} to #{@distribution.partner.name}",
        subtitle: (@distribution.persisted? ? "Created #{@distribution.created_at.strftime("%m/%d/%Y")}." : nil),
        back: {path: distributions_path, label: "Back to distributions"},
        actions: capture {
          concat essentials_link_button("Print", print_distribution_path(@distribution, format: :pdf), variant: :secondary, icon: "bi-printer")
          if @distribution.scheduled?
            concat essentials_action_button("Distribution complete", picked_up_distribution_path(@distribution), method: :patch, variant: :primary, icon: "bi-check-circle")
          end
          if !inactive && (@distribution.future? || current_user.has_cached_role?(Role::ORG_ADMIN, current_organization))
            concat essentials_link_button("Make a correction", edit_distribution_path(@distribution), variant: :secondary, icon: "bi-pencil")
          end
        } %>

  <div class="space-y-6">
    <% if inactive %>
      <%= render "shared/essentials/callout", tone: :warning, role: "status" do %>
        <p class="font-semibold">This distribution cannot be corrected</p>
        <p class="mt-1">
        Distributions can only be corrected while all of their items are active.
        If you need to make a correction,
        please make the following items active: <%= @distribution.inactive_items.map(&:name).join(", ") %>
        </p>

      <% end %>
    <% end %>

    <%= render "shared/essentials/card", title: "Details" do %>
      <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
        <% {"ID" => @distribution.id.to_s,
            "Source location" => @distribution.storage_location.name,
            "Agency representative" => @distribution.agency_rep,
            "Delivery method" => @distribution.delivery_method.humanize,
            "Shipping cost" => distribution_shipping_cost(@distribution.shipping_cost),
            "Status" => @distribution.state&.humanize,
            "Comments" => @distribution.comment}.each do |label, value| %>
          <div>
            <dt class="text-xs font-medium text-slate-500"><%= label %></dt>
            <dd class="mt-0.5 text-sm text-slate-900"><%= value.presence || "—" %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <%= render "shared/essentials/card", title: "Items distributed", padded: false do %>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
        <table class="data-table">
          <caption>Items in this distribution</caption>
          <thead>
            <tr>
              <th scope="col">Item</th>
              <th scope="col" class="numeric">Value per item</th>
              <th scope="col" class="numeric">Total value</th>
              <th scope="col" class="quantity">Quantity</th>
              <th scope="col" class="quantity">Package count</th>
            </tr>
          </thead>
          <tbody><%= render partial: "distribution_item_row", collection: @line_items %></tbody>
          <tfoot><%= render partial: "distribution_item_total" %></tfoot>
        </table>
      </div>
    <% end %>
  </div>
</div>
