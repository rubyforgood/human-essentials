<tr>
  <td class="font-medium text-slate-900"><%= pickup_day_row.partner.name %></td>
  <td class="date"><%= pickup_day_row.issued_at.strftime("%l:%M %p").strip %></td>
  <td><%= pickup_day_row.storage_location.name %></td>
  <td class="quantity"><%= number_with_delimiter(pickup_day_row.line_items.total) %></td>
  <td>
    <% if pickup_day_row.complete? %>
      <%= essentials_status_pill("Complete", tone: :success, icon: "bi-check-circle") %>
    <% else %>
      <%= essentials_status_pill("Scheduled", tone: :info, icon: "bi-calendar-event") %>
    <% end %>
  </td>
  <td class="cell-actions">
    <div class="flex justify-end gap-1.5">
      <%= essentials_row_icon_link "View", distribution_path(pickup_day_row), icon: "bi-eye" %>
      <% unless pickup_day_row.complete? %>
        <%= essentials_row_icon_action "Distribution complete", picked_up_distribution_path(pickup_day_row), method: :patch, icon: "bi-check-circle" %>
      <% end %>
    </div>
  </td>
</tr>
