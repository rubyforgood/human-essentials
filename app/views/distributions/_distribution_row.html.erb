<% has_inactive_item = @distributions_with_inactive_items.include?(distribution_row.id) %>
<tr class="<%= "bg-amber-50" if distribution_row.id == @highlight_id %> <%= "highlight" if distribution_row.id == @highlight_id %>">
  <td class="font-medium text-slate-900">
    <%= link_to distribution_row.id, distribution_path(distribution_row), class: "text-brand-700 hover:text-brand-800" %>
  </td>
  <td><%= distribution_row.partner.name %></td>
  <td class="date"><%= distribution_row.created_at.strftime("%m/%d/%Y") %></td>
  <td class="date"><%= (distribution_row.issued_at.presence || distribution_row.created_at).strftime("%m/%d/%Y") %></td>
  <td><%= distribution_row.storage_location.name %></td>
  <td class="quantity"><%= number_with_delimiter(@distribution_totals[distribution_row.id].quantity) %></td>
  <td class="numeric"><%= dollar_value(@distribution_totals[distribution_row.id].value) %></td>
  <td><%= distribution_row.delivery_method.humanize %></td>
  <td class="numeric"><%= distribution_shipping_cost(distribution_row.shipping_cost) %></td>
  <td class="notes text-slate-600"><%= distribution_row.comment %></td>
  <td><%= distribution_row.state&.humanize %></td>
  <td class="text-right">
    <div class="flex justify-end gap-1.5 whitespace-nowrap">
      <%= essentials_link_button "View", distribution_path(distribution_row), variant: :ghost, size: :sm, icon: "bi-eye" %>
      <% if distribution_row.request %>
        <%= essentials_link_button "View request", request_path(distribution_row.request), variant: :ghost, size: :sm, icon: "bi-file-text" %>
      <% end %>
      <%= essentials_link_button "Print", print_distribution_path(distribution_row, format: :pdf), variant: :ghost, size: :sm, icon: "bi-printer" %>
      <% unless has_inactive_item %>
        <% if (!distribution_row.complete? && !distribution_row.future?) || current_user.has_cached_role?(Role::ORG_ADMIN, current_organization) %>
          <%= essentials_link_button "Edit", edit_distribution_path(distribution_row), variant: :ghost, size: :sm, icon: "bi-pencil" %>
        <% end %>
        <%= essentials_action_button "Reclaim", distribution_path(distribution_row), method: :delete,
              variant: :ghost_danger, size: :sm, icon: "bi-arrow-counterclockwise",
              confirm: "Are you sure you want to reclaim this distribution to #{distribution_row.partner.name}?" %>
      <% end %>
    </div>
    <% if has_inactive_item %>
      <p class="mt-1 text-xs text-amber-700">
        <i class="bi-exclamation-triangle" aria-hidden="true"></i>
        Has inactive items — cannot be edited or reclaimed
      </p>
    <% end %>
  </td>
</tr>
