<% has_inactive_item = @distributions_with_inactive_items.include?(distribution_row.id) %>
<tr class="<%= "bg-amber-50" if distribution_row.id == @highlight_id %> <%= "highlight" if distribution_row.id == @highlight_id %>">
  <td class="pin-col font-medium text-slate-900">
    <%= link_to distribution_row.id, distribution_path(distribution_row), class: "link-brand" %>
  </td>
  <td class="name"><%= distribution_row.partner.name %></td>
  <td class="date"><%= distribution_row.created_at.strftime("%m/%d/%Y") %></td>
  <td class="date"><%= (distribution_row.issued_at.presence || distribution_row.created_at).strftime("%m/%d/%Y") %></td>
  <td class="quantity"><%= number_with_delimiter(@distribution_totals[distribution_row.id].quantity) %></td>
  <td class="numeric"><%= dollar_value(@distribution_totals[distribution_row.id].value) %></td>
  <td><%= distribution_row.delivery_method.humanize %></td>
  <td>
    <%# "Has inactive items" is a *status*, and it used to sit under the action buttons as a
        49-character sentence. Once cells stopped wrapping that was 299px on one line, holding the
        actions column at 331px on every row. A pill, in the column where status lives. %>
    <span class="inline-flex items-center gap-1.5">
      <%= distribution_row.state&.humanize %>
      <% if has_inactive_item %>
        <%= essentials_status_pill("Inactive items", tone: :warning, icon: "bi-exclamation-triangle") %>
      <% end %>
    </span>
  </td>
  <td class="cell-actions">
    <%#
      No visible "View": the ID cell above is already a link to this distribution, so a View button
      beside it is two controls with one destination. See design.md, Row actions.
    %>
    <%
      editable = (!distribution_row.complete? && !distribution_row.future?) ||
        current_user.has_cached_role?(Role::ORG_ADMIN, current_organization)
      row_items = [
        ({label: "View request", path: request_path(distribution_row.request), icon: "bi-file-text"} if distribution_row.request),
        {label: "Print", path: print_distribution_path(distribution_row, format: :pdf), icon: "bi-printer"},
        ({label: "Edit", path: edit_distribution_path(distribution_row), icon: "bi-pencil"} if !has_inactive_item && editable),
        ({label: "Reclaim", path: distribution_path(distribution_row), icon: "bi-arrow-counterclockwise",
          method: :delete, tone: :danger,
          confirm: "Are you sure you want to reclaim this distribution to #{distribution_row.partner.name}?"} unless has_inactive_item)
      ]
    %>
    <%= render "shared/essentials/row_actions",
          label: "distribution #{distribution_row.id}", items: row_items %>
  </td>
</tr>
