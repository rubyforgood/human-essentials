<%= essentials_form_for distribution,
      data: {controller: "form-input", confirmation_target: "form"},
      html: {class: "storage-location-required"},
      wrapper_mappings: EssentialsUiHelper::WRAPPER_MAPPINGS.merge(datetime: :essentials) do |f| %>
  <div class="space-y-6">
    <%= essentials_error_summary(distribution) %>

    <%= f.simple_fields_for :request do |r| %>
      <%= r.input :id, as: :hidden %>
    <% end %>

    <%= render "shared/essentials/card", title: "Distribution details" do %>
      <div class="grid gap-x-5 sm:grid-cols-2 lg:grid-cols-3">
        <%= f.association :partner, collection: @partner_list, label: "Partner",
              disabled: !!@request, hint: "Which partner is this distribution going to?" %>
        <%# The partner is already set when the distribution comes from a request. Params are
            not sent for disabled fields, so it also goes up as a hidden field. %>
        <% if @request %>
          <%= f.hidden_field :partner_id, value: distribution.partner_id %>
        <% end %>

        <%= f.input :issued_at, as: :datetime, ampm: true, minute_step: 15,
              label: "Distribution date and time", html5: true,
              input_html: {value: date_place_holder&.strftime("%Y-%m-%dT%0k:%M")} %>

        <%= f.input :agency_rep, label: "Agency representative" %>

        <%= render partial: "storage_locations/source", object: f, locals: {include_omitted_items: true} %>
      </div>

      <%= f.input :reminder_email_enabled, as: :boolean, checked_value: true, unchecked_value: false,
            label: "Send email reminder the day before?" %>

      <div class="grid gap-x-5 sm:grid-cols-2" data-controller="distribution-delivery">
        <%= f.input :delivery_method, as: :radio_buttons,
              input_html: {data: {action: "distribution-delivery#toggleShippingCost"}},
              collection: Distribution.delivery_methods.keys, label_method: :humanize,
              label: "Delivery method" %>
        <div id="shipping_cost_div" data-distribution-delivery-target="shippingCost">
          <%= f.input :shipping_cost, label: "Shipping cost", placeholder: "Shipping cost",
                value: number_to_currency(f.object.shipping_cost.to_f, delimiter: "", unit: "") %>
        </div>
      </div>

      <%= f.input :comment, label: "Comment", as: :text, input_html: {rows: 3} %>
    <% end %>

    <%= render "shared/essentials/card",
          title: "Items in this distribution",
          subtitle: distribution.request ? "The requested column shows what the partner asked for." : nil,
          padded: false do %>
      <fieldset class="px-5 py-4">
        <legend class="sr-only">Items in this distribution</legend>
        <div id="distribution_line_items" data-capture-barcode="true" class="line-item-fields">
          <%= render "line_items/line_item_fields", form: f, changes_disallowed: @changes_disallowed %>
        </div>
        <% unless @changes_disallowed %>
          <div class="mt-4">
            <%= add_element_button "Add another item", container_selector: "#distribution_line_items",
                  id: "__add_line_item",
                  class: essentials_button_classes(variant: :secondary, size: :md) do %>
              <%= render "line_items/line_item_fields", form: f, object: LineItem.new %>
            <% end %>
          </div>
        <% end %>
      </fieldset>
    <% end %>

    <div class="flex items-center gap-2">
      <%= f.button :button, "Save", class: essentials_button_classes(variant: :primary, size: :md),
            data: {disable_with: "Saving...", action: "click->confirmation#openModal"} %>
      <%= essentials_link_button "Cancel", distributions_path, variant: :ghost, size: :md %>
    </div>
  </div>
<% end %>

<%# Confirmation dialog. Populated by confirmation_controller.js from
    distributions_controller#validate; see distributions/validate.html.erb for the body. %>
<dialog id="distributionConfirmationModal"
        class="confirm w-full max-w-2xl rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/40"
        aria-labelledby="distributionConfirmationTitle"
        data-confirmation-target="modal"></dialog>
