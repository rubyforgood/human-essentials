<%# Body injected into the confirmation <dialog> by confirmation_controller.js. %>
<div class="flex items-start justify-between gap-3 border-b border-slate-200 px-5 py-4">
  <h2 id="distributionConfirmationTitle" class="text-base font-semibold text-slate-900">Confirm this distribution</h2>
  <button id="modalClose" type="button"
          class="rounded-lg p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
          aria-label="Close dialog"
          onclick="this.closest('dialog').close()">
    <i class="bi-x-lg text-sm" aria-hidden="true"></i>
  </button>
</div>

<div class="max-h-[60vh] overflow-y-auto px-5 py-4">
  <p class="text-sm text-slate-700">
    You are about to create a distribution for
    <span class="font-semibold text-slate-900" data-testid="distribution-confirmation-partner"><%= @dist.partner_name %></span>
    from
    <span class="font-semibold text-slate-900" data-testid="distribution-confirmation-storage"><%= @dist.storage_location.name %></span>.
  </p>

  <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
    <table class="data-table">
      <caption>Items to be distributed</caption>
      <thead>
        <tr>
          <th scope="col">Item name</th>
          <th scope="col" class="quantity">Quantity</th>
        </tr>
      </thead>
      <tbody>
        <% @dist.line_items.each do |line_item| %>
          <tr>
            <td class="font-medium text-slate-900"><%= line_item.name %></td>
            <td class="quantity"><%= number_with_delimiter(line_item.quantity) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <p class="message mt-4 text-sm text-slate-600">
    Please confirm that the list above is what you want to distribute.
  </p>
</div>

<div class="flex flex-wrap justify-end gap-2 border-t border-slate-200 px-5 py-3">
  <button id="modalNo" type="button"
          class="<%= essentials_button_classes(variant: :secondary, size: :md) %>"
          onclick="this.closest('dialog').close()">No, I need to make changes</button>
  <button id="modalYes" type="button"
          class="<%= essentials_button_classes(variant: :primary, size: :md) %>"
          data-action="confirmation#submitForm">Yes, it's correct</button>
</div>
