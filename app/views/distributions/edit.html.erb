<% content_for :title, "Edit Distribution - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Editing distribution",
        subtitle: "To #{@distribution.partner.name}.",
        back: {path: distributions_path, label: "Back to distributions"} %>

  <div class="space-y-4">
    <% if @distribution.issued_at && !@distribution.future? %>
      <div class="flex items-start gap-2 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="alert">
        <i class="bi-exclamation-triangle mt-0.5 shrink-0 text-amber-600" aria-hidden="true"></i>
        <span>
          The current date is past the date this distribution was scheduled for.
          Please be very careful when editing this record;
          the contents should match what was given to the recipient.
        </span>
      </div>
    <% end %>

    <% if @audit_warning %>
      <div class="flex items-start gap-2 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="status">
        <i class="bi-exclamation-triangle mt-0.5 shrink-0 text-amber-600" aria-hidden="true"></i>
        <span>
          You’ve had an audit since this distribution was started.
          In the rare case that you are correcting a typo,
          rather than recording that the physical amounts being distributed have changed,
          you’ll need to make an adjustment to the inventory as well.
        </span>
      </div>
    <% end %>
  </div>

  <div class="mt-6"
       data-controller="confirmation"
       data-confirmation-pre-check-path-value="<%= validate_distributions_path(format: :json) %>">
    <%= render "form", distribution: @distribution, date_place_holder: @distribution.issued_at %>
  </div>
</div>

<%= render partial: "barcode_items/barcode_modal" %>
