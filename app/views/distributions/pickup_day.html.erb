<% content_for :title, "Pick ups for #{@selected_date.strftime("%B %e, %Y")} - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Pick ups for #{@selected_date.strftime("%B %e, %Y").squeeze(" ")}",
        back: {path: schedule_distributions_path, label: "Back to the calendar"} %>

  <div class="space-y-6">
    <%= render "shared/essentials/card", title: "Scheduled distributions", padded: @pick_ups.blank? do %>
      <% if @pick_ups.blank? %>
        <%= render "shared/essentials/empty_state", kind: :all_clear,
              title: "Nothing scheduled for this day" %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Distributions scheduled for <%= @selected_date.strftime("%B %e, %Y").squeeze(" ") %></caption>
            <thead>
              <tr>
                <th scope="col">Partner</th>
                <th scope="col" class="date">Time of distribution</th>
                <th scope="col">Source inventory</th>
                <th scope="col" class="quantity">Total items</th>
                <th scope="col">Status</th>
                <th scope="col" class="cell-actions">Actions</th>
              </tr>
            </thead>
            <tbody><%= render partial: "pickup_day_row", collection: @pick_ups %></tbody>
          </table>
        </div>
      <% end %>
    <% end %>

    <%= render "shared/essentials/card",
          title: "Item totals for #{@selected_date.strftime("%B %e, %Y").squeeze(" ")}",
          padded: @daily_items.blank? do %>
      <% if @daily_items.blank? %>
        <%= render "shared/essentials/empty_state", kind: :all_clear,
              title: "No items going out on this day" %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Total items going out on <%= @selected_date.strftime("%B %e, %Y").squeeze(" ") %></caption>
            <thead>
              <tr>
                <th scope="col">Item</th>
                <th scope="col" class="quantity">Quantity</th>
                <th scope="col" class="quantity">Number of packages</th>
              </tr>
            </thead>
            <tbody><%= render partial: "daily_item_row", collection: @daily_items %></tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
