<%#
  The ONE page header. Every migrated page renders this so the spacing cannot drift.

    render "shared/essentials/page_header", title: "Distributions"
    render "shared/essentials/page_header", title: "New donation",
           back: {path: donations_path, label: "Back to donations"},
           subtitle: "Record essentials coming in from a donor."

  Shape rules, measured rather than eyeballed:
    - back link and title are one block with an 8px gap (`mt-2` on the h1).
    - `items-end` when there is no subtitle, so a 40px CTA sits on the h1 baseline.
    - `items-start` when there is a subtitle, so the CTA cannot be dragged down to the
      subtitle's baseline.
%>
<%
  back ||= nil
  subtitle ||= nil
  actions ||= nil
  wrapper_class ||= "mb-6"
%>
<div class="<%= wrapper_class %>">
  <% if back %>
    <%= link_to back[:path], class: "mb-2 inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" do %>
      <i class="bi-chevron-left text-xs" aria-hidden="true"></i><%= back[:label] %>
    <% end %>
  <% end %>

  <div class="flex flex-wrap justify-between gap-3 <%= subtitle ? "items-start" : "items-end" %>">
    <div class="min-w-0">
      <h1 class="text-2xl font-bold tracking-tight text-slate-900"><%= title %></h1>
      <% if subtitle %>
        <p class="mt-1 text-sm text-slate-600"><%= subtitle %></p>
      <% end %>
    </div>

    <% if actions %>
      <div class="flex flex-wrap items-center gap-2"><%= actions %></div>
    <% end %>
  </div>
</div>
