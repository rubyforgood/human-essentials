<%#
  The date range filter: one trigger showing the current range, opening a popover with the presets
  on one side and a custom range on the other.

  This is the shape Stripe, Shopify, Google Analytics, Metabase and Linear all use, and the reason
  is layout. The previous version put the custom dates inline: choosing "Custom" turned a 64px
  grid cell into a 216px one and added 152px to the filter bar at every width, with an empty
  column beside it above 1360px. A panel is over the page, so it costs no layout at all.

  The wire format is unchanged. The server still receives one filters[date_range] string --
  "June 19, 2026 - September 19, 2026" -- which #selected_interval splits on " - " and parses with
  strptime, plus filters[date_range_label] carrying the preset name. Both are hidden fields now
  rather than a select, because the visible control is a button.

  Locals: label (optional, defaults to "Date range").
%>
<%
  label ||= "Date range"
  presets = date_range_presets
  selected_preset = selected_date_range_preset
  default_preset = presets.key(default_date.split(" - ").map { |d| Date.strptime(d, "%B %d, %Y") })
  start_date, end_date = @selected_date_interval
  wire = "#{start_date.to_fs(:date_picker)} - #{end_date.to_fs(:date_picker)}"
  summary = selected_preset || "#{start_date.to_fs(:date_picker_short)} – #{end_date.to_fs(:date_picker_short)}"
  panel_id = "date-range-panel-#{SecureRandom.uuid}"
%>
<div class="relative min-w-0"
     data-controller="popover date-range"
     data-date-range-presets-value="<%= presets.transform_values { |from, to| [from.iso8601, to.iso8601] }.to_json %>">

  <%= label_tag "filters_date_range_trigger", label, class: EssentialsUiHelper::FILTER_LABEL_CLASSES %>
  <button type="button" id="filters_date_range_trigger"
          class="<%= EssentialsUiHelper::POPOVER_TRIGGER_CLASSES %>"
          aria-haspopup="dialog" aria-expanded="false" aria-controls="<%= panel_id %>"
          data-popover-target="trigger" data-date-range-target="summary"
          data-action="click->popover#toggle">
    <span class="truncate"><%= summary %></span>
    <i class="bi-chevron-down shrink-0 text-slate-400" aria-hidden="true"></i>
  </button>

  <%#
    Hidden with the attribute, not a class: Tailwind's preflight marks [hidden] !important, so it
    cannot lose to a display utility -- which is how the Filter button once stayed visible.
  %>
  <div id="<%= panel_id %>" hidden
       role="dialog" aria-label="Choose a date range"
       data-popover-target="panel"
       class="absolute left-0 z-30 w-[26rem] max-w-[calc(100vw-2rem)] p-3 <%= EssentialsUiHelper::POPOVER_SURFACE_CLASSES %>">
    <div class="grid gap-3 sm:grid-cols-2">
      <ul class="max-h-64 space-y-0.5 overflow-y-auto sm:border-r sm:border-slate-100 sm:pr-3">
        <% presets.each_key do |name| %>
          <li>
            <button type="button"
                    class="w-full rounded-lg px-3 py-1.5 text-left text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 <%= (name == selected_preset) ? "bg-brand-50 font-medium text-brand-800" : "text-slate-700 hover:bg-slate-100" %>"
                    <%= tag.attributes("aria-current": true) if name == selected_preset %>
                    data-action="click->date-range#choosePreset"
                    data-preset="<%= name %>"><%= name %></button>
          </li>
        <% end %>
      </ul>

      <div class="space-y-3">
        <div>
          <%= label_tag "filters_date_range_start", "From", class: EssentialsUiHelper::FILTER_LABEL_CLASSES %>
          <%= date_field_tag "date_range_start", start_date, id: "filters_date_range_start", name: nil,
                class: EssentialsUiHelper::FILTER_CONTROL_CLASSES, autocomplete: "off",
                data: {date_range_target: "start", action: "change->date-range#changeCustom"} %>
        </div>
        <div>
          <%= label_tag "filters_date_range_end", "To", class: EssentialsUiHelper::FILTER_LABEL_CLASSES %>
          <%= date_field_tag "date_range_end", end_date, id: "filters_date_range_end", name: nil,
                class: EssentialsUiHelper::FILTER_CONTROL_CLASSES, autocomplete: "off",
                data: {date_range_target: "end", action: "change->date-range#changeCustom"} %>
        </div>
        <%#
          No Apply and no Cancel. The dates apply themselves, debounced so From-then-To is one
          request, and the panel stays open so the range can be adjusted -- only a preset closes
          it. An end before a start is reordered rather than refused, so there is no error state
          left to display. See design.md.
        %>
        <p class="pt-1 text-xs text-slate-500">Applied as you choose them.</p>
      </div>
    </div>
  </div>

  <%#
    data-filter-label names this for the filter summary chips: a hidden input has no <label> for
    the controller to read. data-default-value is the range the page shows when nobody has chosen
    one, so the chip appears only when the range is genuinely a filter.
  %>
  <%= hidden_field_tag "filters[date_range_label]", selected_preset || "Custom",
        id: "filters_date_range_label", data: {date_range_target: "presetField",
          filter_label: label, default_value: default_preset} %>
  <%= hidden_field_tag "filters[date_range]", wire,
        id: "filters_date_range", data: {date_range_target: "range"} %>
</div>
