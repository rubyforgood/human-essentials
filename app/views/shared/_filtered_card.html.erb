<%#
  A report: a date-range filter above one card of results.

  Locals: filter_url, title, subtitle (optional), footer (optional), id (optional).

  Callers used to pass `gradient:`, `footer_options:` and `type:` as well. This partial has
  never read any of them -- they are AdminLTE vocabulary that outlived the markup -- so they
  have been removed from the call sites rather than left to imply the partial does something
  with them.
%>
<%
  id ||= nil
  title ||= nil
  subtitle ||= nil
  footer ||= nil
%>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header", title: title, subtitle: subtitle %>

  <%#
    The shared filter bar rather than a hand-rolled form, so a report's date filter behaves like
    every other filter in the app: applied on change, into the frame below, with no button.
  %>
  <%= render "shared/essentials/filter_bar", url: filter_url, frame: "report-results", clear: false do %>
    <div class="min-w-0 sm:col-span-2"><%= render partial: "shared/date_range_picker" %></div>
  <% end %>

  <%= turbo_frame_tag "report-results", target: "_top", data: {turbo_action: "advance"} do %>
    <%= render "shared/essentials/card", footer: footer do %>
      <div<%= " id=#{id.to_json.html_safe}".html_safe if id %>>
        <%= yield %>
      </div>
    <% end %>
  <% end %>
</div>
