<%= render "shared/essentials/card", title: "Partner approvals", padded: @partners_awaiting_review.blank? do %>
  <% if @partners_awaiting_review.blank? %>
    <%= render "shared/essentials/empty_state",
          kind: :all_clear,
          title: "No partners waiting for approval",
          body: "New applications will appear here for review." %>
  <% else %>
    <div class="table-scroll">
      <table class="data-table">
        <caption>Partner agencies awaiting review</caption>
        <thead>
          <tr>
            <th scope="col">Partner name</th>
            <th scope="col">Primary contact</th>
            <th scope="col">Primary contact email</th>
            <th scope="col" class="date">Review requested</th>
            <th scope="col"><span class="sr-only">Action</span></th>
          </tr>
        </thead>
        <tbody>
          <% @partners_awaiting_review.each do |partner| %>
            <tr>
              <td class="font-medium text-slate-900"><%= partner.name %></td>
              <td><%= partner.profile.primary_contact_name %></td>
              <td><%= partner.profile.primary_contact_email %></td>
              <td class="date"><%= partner.updated_at.strftime("%B %-d %Y") %></td>
              <td class="text-right">
                <%= essentials_link_button "Review profile",
                      partner_path(partner, anchor: "partner-information"),
                      variant: :secondary, size: :sm, icon: "bi-check2" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
