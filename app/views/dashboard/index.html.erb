<% content_for :title, "Dashboard - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Dashboard",
        subtitle: "What needs your attention at #{current_organization.name}." %>

  <div class="space-y-6">
    <%= render "getting_started_prompt", org_is_set_up: @org_is_set_up %>
    <%= render "announcements" %>
    <%= render "outstanding_requests" %>
    <%= render "partner_approvals" %>
    <%= render "low_inventory_report" %>
  </div>
</div>
