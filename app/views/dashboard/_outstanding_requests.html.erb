<%= render "shared/essentials/card",
      title: "Outstanding requests",
      padded: @outstanding_requests.any? ? false : true,
      actions: link_to("View all requests", requests_path, class: "text-sm font-medium text-brand-700 hover:text-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600") do %>
  <% if @outstanding_requests.empty? %>
    <%= render "shared/essentials/empty_state",
          kind: :all_clear,
          title: "No outstanding requests",
          body: "Every partner request has been actioned." %>
  <% else %>
    <div class="table-scroll">
      <table class="data-table">
        <caption>Partner requests that are still pending or started</caption>
        <thead>
          <tr>
            <th scope="col" class="date">Date</th>
            <th scope="col">Partner</th>
            <th scope="col">Requestor</th>
            <th scope="col">Comments</th>
          </tr>
        </thead>
        <tbody>
          <% @outstanding_requests.each do |request| %>
            <tr>
              <td class="date">
                <%= link_to request.created_at.strftime("%m/%d/%Y"), request,
                      class: "font-medium text-brand-700 hover:text-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" %>
              </td>
              <td class="font-medium text-slate-900"><%= request.partner.name %></td>
              <td><%= request.partner_user&.formatted_email %></td>
              <td class="max-w-prose text-slate-600"><%= request.comments %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
