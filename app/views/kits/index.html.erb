<% content_for :title, "Kits - Inventory - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Kits",
        subtitle: "Bundles of items distributed as a single unit.",
        actions: essentials_link_button("New kit", new_kit_path, variant: :primary, icon: "bi-plus-lg") %>

  <%= render "shared/essentials/filter_bar", url: kits_path, frame: "kits-results" do %>
    <div class="min-w-0"><%= filter_text(label: "Kit name", scope: :by_name, selected: @selected_filter_name) %></div>
    <div class="pb-2"><%= filter_checkbox(label: "Show inactive kits", scope: "include_inactive_items", selected: @selected_filter_name) %></div>
  <% end %>
  <%= turbo_frame_tag "kits-results", target: "_top", data: {turbo_action: "advance"} do %>

    <%= render "shared/essentials/card", padded: false do %>
      <%#
        Kits is the fifth tab of the item catalogue. It keeps its own title and subtitle rather
        than borrowing the items header, because it is also a destination in its own right in the
        sidebar -- clicking "Kits" there and landing on a page headed "Items & inventory" would
        make the sidebar lie. The strip is here so the tab is a way in and a way back out.
      %>
      <%= render "items/catalogue_tabs", current: :kits %>
      <%= render partial: "kits/table" %>
    <% end %>
  <% end %>
</div>
