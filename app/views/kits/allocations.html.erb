<% content_for :title, "Kit allocations - #{@kit.name} - #{current_organization.name}" %>
<% rows = @inventory ? @inventory.all_items.select { |i| i.item_id == @kit.kit_item.id } : @item_inventories.order("id ASC") %>

<div class="px-4 py-6 sm:px-6 lg:px-8" data-controller="kit-allocation">
  <%= render "shared/essentials/page_header",
        title: "Allocate #{@kit.name}",
        subtitle: "Manually increase or decrease the number of kits at a storage location.",
        back: {path: items_path, label: "Back to items"} %>

  <div class="space-y-6">
    <%= render "shared/essentials/card", title: "Current allocations", padded: rows.blank? do %>
      <% if rows.blank? %>
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "This kit is not allocated anywhere yet" %>
      <% else %>
        <div class="table-scroll" id="kit-allocation-table">
          <table class="data-table">
            <caption>Where <%= @kit.name %> is currently allocated</caption>
            <thead>
              <tr>
                <th scope="col">Storage location</th>
                <th scope="col" class="quantity">On hand quantity</th>
              </tr>
            </thead>
            <tbody>
              <% rows.each do |ii| %>
                <% location_id = @inventory ? ii.storage_location_id : ii.storage_location.id %>
                <% location_name = @inventory ? @inventory.storage_location_name(location_id) : ii.storage_location.name %>
                <tr id="storage_location_<%= location_id %>"
                    data-kit-allocation-target="row"
                    data-storage-location-id="<%= location_id %>">
                  <td class="font-medium text-slate-900"><%= location_name %></td>
                  <td class="quantity"><%= number_with_delimiter(ii.quantity) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>

    <%= form_for :kit_adjustment, url: allocate_kit_path(id: @kit.id) do |f| %>
      <%= render "shared/essentials/card",
            title: "Change the allocation",
            subtitle: "Enter a negative quantity to subtract kits, or a plain amount to add them." do %>
        <div class="grid gap-6 lg:grid-cols-2">
          <div class="space-y-4">
            <div>
              <%= f.label :storage_location_id, "Storage location", class: "block text-sm font-medium text-slate-700" %>
              <%= f.collection_select :storage_location_id, @storage_locations, :id, :name,
                    {include_blank: true},
                    class: EssentialsUiHelper::SELECT_CLASSES,
                    data: {kit_allocation_target: "location", action: "change->kit-allocation#locationChanged"} %>
            </div>
            <div>
              <%= f.label :change_by, "Change kit quantity by", class: "block text-sm font-medium text-slate-700" %>
              <%= f.number_field :change_by, value: 0, disabled: true,
                    class: EssentialsUiHelper::FILTER_CONTROL_CLASSES,
                    data: {kit_allocation_target: "changeBy", action: "input->kit-allocation#changeByChanged"} %>
            </div>
          </div>

          <div id="change-summary" class="hidden" data-kit-allocation-target="summary">
            <h3 class="text-sm font-semibold text-slate-900">Allocation change summary</h3>
            <div class="mt-2 overflow-hidden rounded-xl border border-slate-200">
              <table class="data-table">
                <caption>Effect of this allocation on each item</caption>
                <thead>
                  <tr>
                    <th scope="col">Item</th>
                    <th scope="col" class="quantity">Change</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="font-medium text-slate-900"><%= @kit.name %></td>
                    <td class="quantity font-semibold text-slate-500"
                        data-base-quantity="-1" data-kit-allocation-target="preview">0</td>
                  </tr>
                  <% @kit.kit_item.line_items.each do |li| %>
                    <tr>
                      <td><%= li.item.name %></td>
                      <td class="quantity font-semibold text-slate-500"
                          data-base-quantity="<%= li.quantity %>" data-kit-allocation-target="preview">0</td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      <% end %>

      <%= essentials_form_actions do %>
        <%= f.submit "Save", class: essentials_button_classes(variant: :primary, size: :md), data: {disable_with: "Saving..."} %>
        <%= essentials_link_button "Cancel", items_path, variant: :ghost, size: :md %>
      <% end %>
    <% end %>
  </div>
</div>
