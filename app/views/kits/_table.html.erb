<% if @kits.blank? %>
  <%= render "shared/essentials/empty_state", kind: :cold_start,
        title: "No kits yet",
        body: "A kit bundles several items together so they can be distributed as one unit.",
        action: essentials_link_button("New kit", new_kit_path, variant: :primary, icon: "bi-plus-lg") %>
<% else %>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
    <table class="data-table table-items-location">
      <caption>Kits, what they contain and where they are allocated</caption>
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Items</th>
          <th scope="col">Allocations</th>
          <th scope="col" class="cell-actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @kits.each do |kit| %>
          <tr>
            <td class="font-medium text-slate-900">
              <%= kit.name %>
              <%= essentials_status_pill("Inactive", tone: :neutral, icon: "bi-slash-circle") unless kit.active %>
            </td>
            <td>
              <ul class="space-y-0.5 text-sm text-slate-700">
                <% kit.line_items.quantities_by_name.map do |_id, item_hash| %>
                  <li><%= "#{number_with_delimiter(item_hash[:quantity])} #{item_hash[:name]}" %></li>
                <% end %>
              </ul>
            </td>
            <td>
              <% allocations = @inventory.all_items.select { |i| i.item_id == kit.id } %>
              <% if allocations.empty? %>
                <p class="text-sm italic text-slate-500">Not allocated anywhere</p>
              <% else %>
                <ul class="space-y-0.5 text-sm text-slate-700">
                  <% allocations.each do |item| %>
                    <li class="flex justify-between gap-3">
                      <span><%= @inventory.storage_location_name(item.storage_location_id) %></span>
                      <span class="tabular-nums font-medium"><%= number_with_delimiter(item.quantity) %></span>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </td>
            <td class="cell-actions">
              <%#
                A menu, because *which* actions exist depends on `kit.active` -- Deactivate on some
                rows and Reactivate on others, with different labels and different widths. That is
                the varying-set case design.md already says to collapse whatever the count, and this
                table was the last place in the app still breaking it: measured at 1024 its actions
                column was **273px**, the widest of any table that scrolls.

                A kit still allocated to a storage location cannot be deactivated. That action is
                still offered: the server checks and answers with the reason and the next step,
                which is more than a greyed-out item can carry. The pattern from `/items`.
              %>
              <%
                kit_items = [{label: "Modify allocation", path: allocations_kit_path(kit), icon: "bi-sliders"}]
                if kit.active
                  if kit.can_deactivate_or_delete?(@inventory)
                    kit_items << {label: "Deactivate", path: deactivate_kit_path(kit), method: :put,
                                  icon: "bi-slash-circle", tone: :danger, class: "deactivate-kit-button",
                                  confirm: confirm_deactivate_msg(kit.name)}
                  else
                    # Offered even though it will fail, and with no `confirm:` -- the server checks
                    # and answers with the reason and the next step, which is more than a disabled
                    # item can carry. Exactly what `/items` does in the same situation; kits was
                    # the last table still greying the action out instead.
                    kit_items << {label: "Deactivate", path: deactivate_kit_path(kit), method: :put,
                                  icon: "bi-slash-circle", class: "deactivate-kit-button"}
                  end
                else
                  kit_items << {label: "Reactivate", path: reactivate_kit_path(kit), method: :put,
                                icon: "bi-arrow-counterclockwise", class: "reactivate-kit-button",
                                confirm: confirm_reactivate_msg(kit.name)}
                end
              %>
              <%= render "shared/essentials/row_actions", label: kit.name, items: kit_items %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
