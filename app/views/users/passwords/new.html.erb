<% content_for :title, "Forgot your password? - Human Essentials" %>

<h1 class="text-2xl font-bold tracking-tight text-slate-900">Forgot your password?</h1>
<p class="mt-1 text-sm text-slate-600">
  Enter the email you sign in with and we'll send you a link to reset it.
</p>

<%= essentials_form_for(resource, as: resource_name, url: password_path(resource_name), html: {method: :post, class: "mt-6"}) do |f| %>
  <%= f.input :email, autofocus: true, input_html: {autocomplete: "email"} %>
  <%= f.button :submit, "Send reset instructions", class: essentials_button_classes(variant: :primary, size: :md, extra: "w-full") %>
<% end %>

<div class="mt-6 text-sm">
  <%= link_to new_session_path(resource_name), class: "inline-flex items-center gap-1 font-medium text-slate-500 hover:text-slate-700" do %>
    <i class="bi-chevron-left text-xs" aria-hidden="true"></i>Back to log in
  <% end %>
</div>
