<%= render "shared/essentials/modal", id: "add-user-modal",
      title: "Invite a new user to #{current_organization.name}" do %>
  <%= form_tag invite_user_organization_path, class: "space-y-4" do %>
    <div>
      <%= label_tag :name, "Name", class: "block text-sm font-medium text-slate-700" %>
      <%= text_field_tag :name, nil, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES, placeholder: "Name" %>
    </div>
    <div>
      <%= label_tag :email, "Email", class: "block text-sm font-medium text-slate-700" %>
      <%= email_field_tag :email, nil, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES, placeholder: "Email" %>
    </div>
    <%= hidden_field_tag :org, current_organization.id %>

    <div class="flex items-center gap-2 border-t border-slate-200 pt-4">
      <%# `bi-person-plus`, the same glyph as the trigger that opened this dialog and as the one on
          /admin/users. It was `bi-envelope`, which is this app's glyph for sending mail -- and
          three buttons all saying "Invite user" carried three different glyphs between them. %>
      <button type="submit" class="<%= essentials_button_classes(variant: :primary, size: :md) %>" data-disable-with="Sending...">
        <i class="bi-person-plus" aria-hidden="true"></i> Invite user
      </button>
      <button type="button" class="<%= essentials_button_classes(variant: :ghost, size: :md) %>"
              onclick="this.closest('dialog').close()">Cancel</button>
    </div>
  <% end %>
<% end %>
