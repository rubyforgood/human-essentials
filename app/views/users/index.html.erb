<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Users - #{current_organization.name}" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Users</h1>
<p class="mt-1 text-sm text-slate-600">for <%= current_organization.name %></p>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <!-- Default box -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-5 py-4">
          </div>
          <div class="px-5 py-4">
            <table class="data-table">
              <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
              </tr>
              </thead>
              <tbody>
              <% @users.each do |user| %>
                <tr>
                  <td><%= user.display_name %></td>
                  <td><%= user.email %></td>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>

          <div class="border-t border-slate-200 px-5 py-3">
            <%= modal_button_to("#addUserModal", { text: "Invite User to this Organization" }) if can_administrate? %>
          </div>
        </div>

      </div>
    </div>
  </div>
  <%= render "add_user_modal" %>
</section>
