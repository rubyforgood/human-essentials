<% content_for :title, "Users - #{current_organization.name}" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Users",
        subtitle: "Invite someone to help run #{current_organization.name}, or remove their access." %>
</div>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/card", padded: false do %>
          <div class="border-b border-slate-200 px-5 py-4">
          </div>
          <div class="px-5 py-4">
            <% if @users.any? %>
              <table class="data-table">
                <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                </tr>
                </thead>
                <tbody>
                <% @users.each do |user| %>
                  <tr>
                    <td><%= user.display_name %></td>
                    <td><%= user.email %></td>
                  </tr>
                <% end %>
                </tbody>
              </table>
            <% else %>
              <%= render "shared/essentials/empty_state", kind: :cold_start,
                    title: "No users yet",
                    body: "Invite a colleague so they can sign in to this organization." %>
            <% end %>
          </div>

          <div class="border-t border-slate-200 px-5 py-3">
            <%= modal_button_to("#add-user-modal", { text: "Invite user to this organization" }) if can_administrate? %>
          </div>
  <% end %>

  <%= render "add_user_modal" %>
</div>
