<%= render "shared/essentials/card", padded: false do %>
  <div class="border-b border-slate-200 px-5 py-4">
    <h2 class="text-base font-semibold text-slate-900">Users</h2>
</div>

<div class="px-5 py-4">
  <table class="table border">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Email</th>
        <th scope="col">Role</th>
        <th scope="col">Last Sign in</th>
        <th scope="col">Status</th>
        <th scope="col">Reinvite</th>
        <th scope="col"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>

    <tbody>
      <%= render partial: "/users/organization_user",
                 collection: @users,
                 as: :user,
                 locals: { current_organization: current_organization || @organization } %>
    </tbody>
  </table>
</div>

<% if can_administrate? %>
  <div class="border-t border-slate-200 px-5 py-3">
    <%= modal_button_to("#add-user-modal", {text: "Invite user to this organization", class: "float-right"}) %>
  </div>
<% end %>
<% end %>

<%= render "/users/add_user_modal", current_organization: current_organization || @organization %>
