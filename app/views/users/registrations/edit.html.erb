<% content_for :title, "Edit - Users" %>
<div class="px-4 pt-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "My account",
        subtitle: "Your name, email and password.",
        back: {path: dashboard_path_from_current_role, label: "Back to dashboard"} %>
</div>

<%#
  Fixed here: a `collapsed-card` class AdminLTE defined and nothing does now, and the empty
  <button> that used to collapse it -- a control with no label, no icon and no handler. The
  password fields are a fieldset instead, which is what that card was trying to be.

  Every `f.input ... do` block pasted the input classes by hand, which is what the :essentials
  wrapper already does.
%>
<div class="max-w-2xl px-4 py-6 sm:px-6 lg:px-8">
  <% if Rails.env.staging? %>
    <div class="staging-warning mb-4 flex items-start gap-2 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="alert">
      <i class="bi-exclamation-triangle mt-0.5 shrink-0 text-amber-600" aria-hidden="true"></i>
      <span>This is a demo version. Changes to the demo account credentials are not allowed.</span>
    </div>
  <% end %>

  <%= essentials_error_summary(resource) %>

  <%= render "shared/essentials/card", title: current_user.display_name do %>
    <%= essentials_form_for(resource, as: resource_name, url: user_registration_path, html: {method: :put}) do |f| %>
      <%= f.input :name, label: "Name", required: true, autofocus: true %>
      <%= f.input :email, label: "Email" %>
      <%= f.input :current_password, label: "Current password",
            hint: "We need your current password to confirm your changes." %>

      <fieldset class="mt-6 border-t border-slate-200 pt-5">
        <legend class="text-base font-semibold text-slate-900">Change password</legend>
        <p class="mb-4 text-sm text-slate-600">Leave these blank to keep your current password.</p>
        <%= f.input :password, label: "New password" %>
        <%= f.input :password_confirmation, label: "Confirm new password" %>
      </fieldset>

      <div class="mt-6 flex items-center gap-2 border-t border-slate-200 pt-5">
        <% if Rails.env.staging? %>
          <%= _button_to({text: "Save", icon: "floppy-o", type: "success"}, disabled: true) %>
        <% else %>
          <%= submit_button %>
        <% end %>
        <%= essentials_link_button "Cancel", dashboard_path_from_current_role, variant: :ghost, size: :md %>
      </div>
    <% end %>
  <% end %>
</div>
