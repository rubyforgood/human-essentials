<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Edit - Users" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Editing</h1>
<p class="mt-1 text-sm text-slate-600">your profile</p>
        <% if Rails.env.staging? %>
          <div class="staging-warning">
            <p> <strong> You are accessing a demo version which does not allow changes to the demo account credentials </strong> </p>
          </div>
        <% end %>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-5 py-4">
            <h5 class="text-base font-semibold text-slate-900"><%= current_user.display_name %></h5>
          </div>
          <%= essentials_form_for(resource, as: resource_name, url: user_registration_path, html: {method: :put}) do |f| %>

          <div class="px-5 py-4">
            <div class="grid gap-6">
              <div class="min-w-0">
                <%= f.input :name, label: "Name:", required: true, autofocus: true do %>
                  <span class="input-group-text"><i class="bi-person"></i></span>
                  <%= f.input_field :name, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
                <% end %>
                <%= f.input :email, label: "Email:" do %>
                  <span class="input-group-text"><i class="bi-envelope"></i></span>
                  <%= f.input_field :email, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
                <% end %>
                <%= f.input :current_password, label: "Current Password:" do %>
                  <span class="input-group-text"></span>
                  <%= f.input_field :current_password, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
                <% end %>
                <p class="help-block" id="password-confirmation-help"><em>We need your current password to confirm your
                  changes</em></p>

              </div>

              <div class="min-w-0">
                <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm collapsed-card">
                  <div class="border-b border-slate-200 px-5 py-4">
                    <h5 class="m-0">Change Password</h5>
                    <span class="card-tools">
                      <button type="button" class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" data-card-widget="collapse">

                      </button>
                    </span>

                  </div>
                  <div class="px-5 py-4">
                    <p class="help-block" id="password-help">Leave this blank if you don't want to change it</p>

                    <%= f.input :password, label: "New Password:" do %>
                      <span class="input-group-text"><%= fa_icon "lock" %></span>
                      <%= f.input_field :password, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
                    <% end %>
                    <%= f.input :password_confirmation, label: "New Password Confirmation:" do %>
                      <span class="input-group-text"><%= fa_icon "check" %></span>
                      <%= f.input_field :password_confirmation, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
                    <% end %>
                  </div>
                </div>
              </div>

            </div>

          </div>
            <div class="border-t border-slate-200 px-5 py-3">
            <% unless Rails.env.staging? %>
              <%= submit_button %>
              <% else %>
              <%= _button_to({ text: "Save", icon: "floppy-o", type: "success", align: "pull-right" }, disabled: true) %>
              <% end %>
            </div>
          <!-- ./card-body -->

        </div>

      </div>

    </div>
<% end %>
  </div>
</section>
