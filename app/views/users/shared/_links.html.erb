<%# Auth cross-links. Google sign-in lives on the sign-in page itself, not here, so it is
    not repeated as a link on every recovery screen. %>
<%- if !%w[sessions consolidated_logins].include?(controller_name) %>
  <p><%= link_to "Log in", new_session_path(resource_name), class: "font-medium link-brand" %></p>
<% end -%>

<%- if devise_mapping.registerable? && controller_name != "registrations" %>
  <p><%= link_to "Request an account", new_account_request_path, class: "font-medium link-brand" %></p>
<% end -%>

<%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
  <p><%= link_to "Forgot your password?", new_password_path(resource_name), class: "font-medium link-brand" %></p>
<% end -%>
