<% content_for :title, "New - Users - #{current_organization.name}" %>

<%#
  Each field wrapped its own input in a block, which tells simple_form to skip the wrapper --
  so the class string had to be copied in by hand, four times. Without the block the
  :essentials wrapper supplies it.
%>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Add a user to #{current_organization.name}",
        back: {path: users_path, label: "Back to users"} %>

  <%= essentials_form_for(@user) do |f| %>
    <%= render "shared/essentials/card", footer: capture { submit_button } do %>
      <%= essentials_error_summary(@user) %>

      <%= f.input :name, label: "Name", required: true, autofocus: true %>
      <%= f.input :email, label: "Email", required: true %>
      <%= f.input :password, label: "Password", required: true,
            hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length) %>
      <%= f.input :password_confirmation, label: "Confirm password", required: true %>
    <% end %>
  <% end %>
</div>
