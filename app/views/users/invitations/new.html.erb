<% content_for :title, "Send an invitation - Human Essentials" %>

<h1 class="text-2xl font-bold tracking-tight text-slate-900"><%= t "devise.invitations.new.header" %></h1>

<%= essentials_error_summary(resource) %>

<%= essentials_form_for(resource, as: resource_name, url: invitation_path(resource_name), html: {method: :post, class: "mt-6"}) do |f| %>
  <% resource.class.invite_key_fields.each do |field| %>
    <%= f.input field %>
  <% end %>
  <%= f.button :button, t("devise.invitations.new.submit_button"), class: essentials_button_classes(variant: :primary, size: :md, extra: "w-full") %>
<% end %>
