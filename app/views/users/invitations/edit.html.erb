<% content_for :title, "Set your password - Human Essentials" %>

<h1 class="text-2xl font-bold tracking-tight text-slate-900"><%= t "devise.invitations.edit.header" %></h1>
<p class="mt-1 text-sm text-slate-600">
  Welcome to Human Essentials. Before we get started, set a password for yourself.
</p>

<div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
  <p class="text-sm font-medium text-slate-700">A good password is:</p>
  <ul class="mt-2 space-y-1 text-sm text-slate-600">
    <li class="flex gap-2"><i class="bi-check2 mt-0.5 shrink-0 text-emerald-600" aria-hidden="true"></i>Memorable to you</li>
    <li class="flex gap-2"><i class="bi-check2 mt-0.5 shrink-0 text-emerald-600" aria-hidden="true"></i>At least 10 characters long</li>
    <li class="flex gap-2"><i class="bi-check2 mt-0.5 shrink-0 text-emerald-600" aria-hidden="true"></i>A mix of letters, numbers, punctuation and spaces</li>
  </ul>
  <p class="mt-2 text-xs text-slate-500">A line from a poem or a favourite quote works well.</p>
</div>

<%= essentials_error_summary(resource) %>

<%= essentials_form_for(resource, as: resource_name, url: invitation_path(resource_name), html: {method: :put, class: "mt-6"}) do |f| %>
  <%= f.hidden_field :invitation_token %>
  <%= f.input :password, input_html: {autocomplete: "new-password"} %>
  <%= f.input :password_confirmation, label: "Type the same password again", input_html: {autocomplete: "new-password"} %>
  <%= f.button :submit, t("devise.invitations.edit.submit_button"), class: essentials_button_classes(variant: :primary, size: :md, extra: "w-full") %>
<% end %>
