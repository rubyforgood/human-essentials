<tr id="<%= item_row[:item_id] %>">
  <td><%= link_to item_row[:item_name], item_path(item_row[:item_id]) %></td>
  <td><%= item_row[:quantity_start] %></td>
  <td><%= item_row[:quantity_in] %></td>
  <td><%= item_row[:quantity_out] %></td>
  <td><%= item_row[:quantity_adjustment] %></td>
  <td class="<%= 'modal-body-warning-text' if item_row[:change].negative? %>"><%= item_row[:change] %></td>
  <td><%= item_row[:quantity_end] %></td>
</tr>
