<% quantity = @inventory.quantity_for(storage_location: storage_location.id) %>
<tr>
  <td class="pin-col name font-medium text-slate-900">
    <%= link_to storage_location.name, storage_location, class: "link-brand" %>
    <% if storage_location.discarded? %>
      <%= essentials_status_pill("Inactive", tone: :neutral, icon: "bi-slash-circle") %>
    <% end %>
  </td>
  <td class="notes"><%= storage_location.address %></td>
  <td class="numeric"><%= storage_location.square_footage %></td>
  <td><%= storage_location.warehouse_type %></td>
  <td class="quantity"><%= quantity %></td>
  <td class="numeric"><%= number_to_currency(storage_location.inventory_total_value_in_dollars(@inventory)) %></td>
  <td class="cell-actions">
    <%# Three inline, and a third action that was Reactivate, Deactivate or a disabled Deactivate
        depending on the row. The menu keeps `disabled:` and `reason:`, so a location that still
        holds stock still says why -- as sr-only text rather than a hover-only title. %>
    <%= render "shared/essentials/row_actions", label: storage_location.name, items: [
          {label: "Edit", path: edit_storage_location_path(storage_location), icon: "bi-pencil"},
          (if storage_location.discarded?
             {label: "Reactivate", path: storage_location_reactivate_path(storage_location),
              icon: "bi-arrow-counterclockwise", method: :put,
              confirm: confirm_reactivate_msg(storage_location.name)}
           elsif quantity.zero?
             {label: "Deactivate", path: storage_location_deactivate_path(storage_location),
              icon: "bi-slash-circle", method: :put,
              confirm: confirm_deactivate_msg(storage_location.name)}
           else
             # Offered even when it will fail, and with no `confirm:` -- there is nothing to
             # confirm when nothing will happen. The server answers with the reason and the next
             # step. See design.md.
             {label: "Deactivate", path: storage_location_deactivate_path(storage_location),
              icon: "bi-slash-circle", method: :put}
           end)
        ] %>
  </td>
</tr>
