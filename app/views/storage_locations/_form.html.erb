<%# The AdminLTE version nested a second simple_form_for inside the first, which is invalid
    HTML -- the inner <form> silently swallowed the outer one's fields. One form here. %>
<div class="max-w-4xl">
  <%= essentials_error_summary(form) %>

  <%= essentials_form_for form, html: {role: "form"} do |f| %>
    <%= render "shared/essentials/card" do %>
      <%= f.input :name, label: "Name" %>
      <%# Four fields, from `address_field`, the same as the organization form -- see "Address fields"
          in design.md. This was one freeform box until 2026-09-01; the CSV import template still has a
          single `address` column, which `StructuredAddress#address=` splits on the way in, so a bank's
          saved template file is still valid. %>
      <%= f.input :street, **address_field(:street) %>
      <%= f.input :city, **address_field(:city) %>
      <%= essentials_field_row do %>
        <%= f.input :state, **address_field(:state) %>
        <%= f.input :zipcode, **address_field(:zip) %>
      <% end %>
      <%# Both describe the building rather than address it, and neither fills a line. %>
      <%= essentials_field_row do %>
        <%= f.input :square_footage, label: "Square footage" %>
        <%= f.input :warehouse_type, label: "Warehouse type", collection: StorageLocation::WAREHOUSE_TYPES %>
      <% end %>
      <%= f.input :time_zone, label: "Time zone", collection: CalendarService.time_zones %>
    <% end %>

    <%= essentials_form_actions do %>
      <%= f.button :button, "Save", class: essentials_button_classes(variant: :primary, size: :md), data: {disable_with: "Saving..."} %>
      <%= essentials_link_button "Cancel", storage_locations_path, variant: :ghost, size: :md %>
    <% end %>
  <% end %>
</div>
