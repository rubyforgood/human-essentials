<% content_for :title, "Storage Locations - #{@storage_location.name} - Inventory - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: @storage_location.name,
        subtitle: @storage_location.address.presence,
        back: {path: storage_locations_path, label: "Back to storage locations"},
        actions: capture {
          concat essentials_link_button("Edit", edit_storage_location_path(@storage_location), variant: :secondary, icon: "bi-pencil")
          if @storage_location.items.empty?
            concat(button_tag(type: "button", class: essentials_button_classes(variant: :primary), data: {action: "click->dialog#open", dialog_id_param: "csv-import-modal"}) do
              concat tag.i(nil, class: "bi-upload", aria: {hidden: true})
              concat " Import baseline inventory"
            end)
          end
        } %>

  <div class="space-y-6">
    <%= render "shared/essentials/card", title: "Details" do %>
      <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <dt class="text-xs font-medium text-slate-500">Square footage</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= @storage_location.square_footage.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-slate-500">Warehouse type</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= @storage_location.warehouse_type.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-slate-500">Time zone</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= @storage_location.time_zone.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-slate-500">Fair market value</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= number_to_currency @storage_location.inventory_total_value_in_dollars %></dd>
        </div>
      </dl>
    <% end %>

    <%= render "shared/essentials/card", padded: false, card_class: "overflow-visible" do %>
      <div data-controller="tabs">
        <%= render "shared/essentials/tabs", tabs: [
              {id: "inventory", label: "Inventory"},
              {id: "in", label: "Coming in"},
              {id: "out", label: "Going out"}
            ] %>

        <div id="panel-inventory" role="tabpanel" aria-labelledby="tab-inventory" data-tabs-target="panel">
          <%#
            The one filter in the app that sits inside a tab panel rather than above the card:
            it scopes this tab and not the other two, and above the card it would look like it
            scoped all three. design.md allows a table's own filters between a tab strip and its
            first row, and nothing else.

            It applies into a frame, and that is not only for the usual reason. A full reload
            re-renders the tab strip with the first tab selected, because `tabs_controller` falls
            back to whichever tab the server marked -- so this filter only ever worked because
            Inventory happens to be first. Updating a frame leaves the strip alone.
          %>
          <div class="border-b border-slate-200 px-5 pt-4">
            <%= render "shared/essentials/filter_bar",
                  url: storage_location_path(@storage_location),
                  frame: "storage-location-inventory" do %>
              <div class="min-w-0">
                <%= filter_date(scope: :version_date, label: "Show inventory at date",
                      selected: params[:version_date], min: InventoryItem::EARLIEST_VERSION,
                      hint: "Historical data has been collected since #{Date.parse(InventoryItem::EARLIEST_VERSION).strftime("%b %-d, %Y")}.") %>
              </div>
            <% end %>
          </div>

          <%= turbo_frame_tag "storage-location-inventory", target: "_top", data: {turbo_action: "advance"} do %>
            <% rows = @inventory ? @inventory.items_for_location(@storage_location.id, include_omitted: true) : (@legacy_inventory || []) %>
            <% if rows.blank? %>
              <%= render "shared/essentials/empty_state", kind: :cold_start,
                    title: "Nothing stored here yet",
                    body: "Inventory appears once a donation, purchase or audit puts items in this location." %>
            <% else %>
              <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
                <table class="data-table">
                  <caption>
                    <% if params[:version_date].present? %>
                      Items at <%= @storage_location.name %> on <%= params[:version_date].to_date.strftime("%b %-d, %Y") %>
                    <% else %>
                      Items currently at <%= @storage_location.name %>
                    <% end %>
                  </caption>
                  <thead>
                    <tr><th scope="col">Item</th><th scope="col" class="quantity">Quantity</th></tr>
                  </thead>
                  <tbody>
                    <% rows.each do |item| %>
                      <tr>
                        <td><%= link_to item.name, item_path(item.item_id), class: "font-medium text-brand-700 hover:text-brand-800" %></td>
                        <td class="quantity"><%= number_with_delimiter(item.quantity) %></td>
                      </tr>
                    <% end %>
                  </tbody>
                  <tfoot>
                    <tr>
                      <td>Total</td>
                      <td class="quantity">
                        <% if @inventory %>
                          <%= number_with_delimiter(@inventory.quantity_for(storage_location: @storage_location.id)) %>
                        <% elsif @legacy_inventory %>
                          <%= number_with_delimiter(@legacy_inventory.sum(&:quantity)) %>
                        <% else %>
                          <%= number_with_delimiter(@storage_location.size) %>
                        <% end %>
                      </td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            <% end %>
          <% end %>
        </div>

        <% [["in", @items_in, @items_in_total, "coming in to"], ["out", @items_out, @items_out_total, "going out of"]].each do |id, items, total, phrase| %>
          <div id="panel-<%= id %>" role="tabpanel" aria-labelledby="tab-<%= id %>" data-tabs-target="panel" class="hidden">
            <% if items.blank? %>
              <%= render "shared/essentials/empty_state", kind: :all_clear,
                    title: "Nothing #{phrase} this location" %>
            <% else %>
              <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
                <table class="data-table">
                  <caption>Items <%= phrase %> <%= @storage_location.name %></caption>
                  <thead>
                    <tr><th scope="col">Item</th><th scope="col" class="quantity">Quantity</th></tr>
                  </thead>
                  <tbody><%= render partial: "line_item_row", collection: items %></tbody>
                  <tfoot>
                    <tr><td>Total</td><td class="quantity"><%= number_with_delimiter(total) %></td></tr>
                  </tfoot>
                </table>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= render layout: "shared/essentials/csv_import_modal", locals: {
        import_type: "Baseline inventory",
        csv_template_url: storage_location_path(@storage_location, format: :csv),
        csv_import_url: import_inventory_storage_locations_path(storage_location: @storage_location.id)
      } do %>
    <li>Open the CSV file in Excel or your favourite spreadsheet program.</li>
    <li>Enter your quantities for each item.</li>
    <li>Save the file as a CSV.</li>
    <li><strong>Do not change any item name.</strong></li>
  <% end %>
</div>
