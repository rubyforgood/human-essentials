<%# Partner portal shell. Same chrome as layouts/essentials_app with the partner rail. %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <%= render "layouts/essentials_head" %>
</head>
<body id="<%= params.fetch(:controller, '').gsub(/[^\w\d]+/, '_') %>"
      class="<%= params.fetch(:action, '') %> min-h-screen bg-slate-50 font-sans text-slate-900 antialiased">
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <%# The dialog controller lives on the shell so any page can open a <dialog> by id. %>
  <div data-controller="shell dialog trix-toolbar clipped-text table-scroll table-stack">
    <div class="fixed inset-0 z-30 hidden bg-slate-900/40 lg:hidden"
         data-shell-target="scrim"
         data-action="click->shell#closeDrawer"
         aria-hidden="true"></div>

    <div class="flex min-h-screen">
      <%= render "layouts/essentials_partner_sidebar" %>

      <div class="flex min-w-0 flex-1 flex-col">
        <%= render "layouts/essentials_partner_topbar" %>

        <%# `pb-6` on top of the page wrapper's own: the footer is chrome behind a hairline rule, not
            another block in the stack, so the 24px the design system puts between peers reads tight
            against it. 48px total below the last control. %>
        <main id="main-content" tabindex="-1" class="flex-1 pb-6">
          <%= render "shared/essentials/flash" %>
          <%= yield %>
        </main>

        <footer class="border-t border-slate-200 px-4 py-5 text-xs text-slate-500 sm:px-6 lg:px-8">
          Built by <%= link_to "Ruby for Good", "https://rubyforgood.org", class: "font-medium text-brand-700 hover:text-brand-800" %>.
        </footer>
      </div>
    </div>
  </div>

  <div id="modal_new"></div>
  <%# Its own controller scope: it sits outside the shell's controller div, and it listens on
      `document` for clicks rather than containing the triggers, so it does not need to wrap them. %>
  <div data-controller="confirm-dialog">
    <%= render "shared/essentials/confirm_dialog" %>
  </div>
</body>
</html>
