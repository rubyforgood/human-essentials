<%#
  Sidebar rail. Sticky and exactly viewport-height on desktop so the pinned settings item
  sits at the bottom of the SCREEN; an off-canvas drawer below `lg`.
%>
<aside id="essentials-sidebar"
       tabindex="-1"
       data-shell-target="drawer"
       class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-slate-200 bg-white transition-transform duration-200 motion-reduce:transition-none lg:sticky lg:top-0 lg:z-auto lg:h-screen lg:translate-x-0">
  <div class="flex items-center justify-between gap-2 border-b border-slate-200 px-4 py-4">
    <%= link_to dashboard_path_from_current_role, class: "min-w-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" do %>
      <span class="block truncate text-sm font-bold tracking-tight text-slate-900">
        <%= current_organization&.name || "Human Essentials" %>
      </span>
      <span class="block text-xs text-slate-500">Human Essentials</span>
    <% end %>
    <button type="button"
            class="rounded-lg p-1 text-slate-500 hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 lg:hidden"
            aria-label="Close navigation"
            data-action="click->shell#closeDrawer">
      <i class="bi-x-lg text-sm" aria-hidden="true"></i>
    </button>
  </div>

  <nav class="flex flex-1 flex-col overflow-y-auto px-3" aria-label="Main">
    <%# The admin area gets its own destinations. None of the bank navigation applies there,
        and stacking both would be two full navigations in one rail. %>
    <% if essentials_admin_area? %>
      <ul class="mt-3 space-y-0.5">
        <% essentials_admin_nav_items.each do |item| %>
          <%= render "layouts/essentials_nav_link", item: item %>
        <% end %>
      </ul>

      <div class="mt-auto -mx-3 flex h-14 shrink-0 items-center border-t border-slate-200 px-3">
        <ul class="w-full space-y-0.5">
          <%= render "layouts/essentials_nav_link",
                item: EssentialsNavHelper::NavItem.new(label: "Leave admin", path: dashboard_path, active_on: [], icon: "bi-arrow-left") %>
        </ul>
      </div>
    <% else %>
      <%#
        `space-y-4` between every top-level entry, whether it is a group or a lone destination.
        Dashboard and Reports used to share one list at `space-y-0.5` -- the spacing for items
        *inside* a section -- so they clustered while everything else was 16px apart.

        A section is a meaningful grouping, not "the leaves that happen to be next to each other".
        Dashboard is a section of one, and so is Reports.

        Reports sits after the working groups because it is a read-only view of what they hold:
        home, then the work, then views of the work, then the pinned account item. See design.md.
      %>
      <div class="mt-3 space-y-4">
        <ul>
          <%= render "layouts/essentials_nav_link", item: essentials_nav_dashboard %>
        </ul>

        <% essentials_nav_groups.each do |group| %>
          <%= render "layouts/essentials_nav_group", group: group %>
        <% end %>

        <ul>
          <%= render "layouts/essentials_nav_link", item: essentials_nav_reports %>
        </ul>
      </div>

      <%#
        The bottom strip. `h-14` and a full-bleed border so its rule meets the page footer's at
        the same height and runs into the rail's own border-r -- the two read as one band across
        the bottom of the screen. They were 12px apart, which looked like a mistake rather than a
        separation. See design.md.
      %>
      <% if (settings = essentials_nav_settings) %>
        <div class="mt-auto -mx-3 flex h-14 shrink-0 items-center border-t border-slate-200 px-3">
          <ul class="w-full space-y-0.5">
            <%= render "layouts/essentials_nav_link", item: settings %>
          </ul>
        </div>
      <% end %>
    <% end %>
  </nav>
</aside>
