<%#
  Shared <head> for the Ruby for Good design system layouts.

  Loads ONLY tailwind.css. Bootstrap, AdminLTE and the Font Awesome CDNs are deliberately
  absent: two CSS resets in one document is the failure mode this whole migration is
  structured to avoid. Icons here are Bootstrap Icons (`bi-*`), self-hosted, compiled into
  the Tailwind bundle -- an `fa-*` class on one of these pages renders nothing.
%>
<meta charset="utf-8">
<title><%= content_for?(:title) ? yield(:title) : default_title_content %></title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<%= csrf_meta_tags %>
<%= csp_meta_tag if respond_to?(:csp_meta_tag) %>

<%= stylesheet_link_tag "tailwind", media: "all" %>
<%=
  # DO NOT LOAD ANY JAVASCRIPT BEFORE THIS!!!
  javascript_importmap_tags
%>
<%#
  Keep the browser's clock in step with Rails' spoofed clock in tests.

  A system spec that calls travel_to only moves Ruby's clock; anything computed in the
  browser from `new Date()` -- the reminder and deadline dates, for one -- would still be on
  real time, and the two would disagree by however far the spec travelled. Navigate to the
  page under test AFTER spoofing, or the fake timer is initialised with the wrong instant.

  **The instant is in a <meta>, so the script's text is the same in every response.** It used to
  be interpolated into the script. A filter bar applying into a frame with `turbo_action:
  "advance"` makes Turbo merge the response's <head>, even though it renders nothing there, and
  Turbo re-runs any head script whose text is new. So whenever a response was rendered in a later
  second than the page, this ran again mid-filter: `restore()` threw away every timer queued on
  the old clock -- including the animation frame Turbo was awaiting to render the *next* filter --
  and the table stayed on the previous result for good. Specs failed with the filter chip set and
  the table unfiltered, intermittently in CI and in 6 of 8 runs at 8x CPU throttling.
%>
<% if Rails.env.test? %>
  <meta name="test-clock-now" content="<%= Time.now.to_i * 1000 %>">
  <script type="module">
    import sinon from "sinon"
    if (window.fakeTimerClock) {
      window.fakeTimerClock.restore();
    }
    window.fakeTimerClock = sinon.useFakeTimers({
      now: Number(document.querySelector('meta[name="test-clock-now"]').content),
      shouldAdvanceTime: true
    })
  </script>
<% end %>

<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#4f46e5">

<%= raw fullstory_script(current_user: current_user) if Rails.env.production? %>
<%= render "magic_test/support" if Rails.env.test? %>
