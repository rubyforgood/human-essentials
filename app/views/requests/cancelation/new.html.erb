<% content_for :title, "Cancel request from #{@request.partner.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Cancel this request?",
        back: {path: request_path(@request), label: "Back to the request"} %>

  <div class="max-w-2xl space-y-6">
    <div class="flex items-start gap-2 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="alert">
      <i class="bi-exclamation-triangle mt-0.5 shrink-0 text-amber-600" aria-hidden="true"></i>
      <div>
        <p class="font-semibold">This cannot be undone.</p>
        <p class="mt-1">
          You are cancelling the request made for <strong><%= @request.partner.name %></strong>
          by <%= @request.requester.email %> on <%= @request.created_at.to_fs(:distribution_date) %><%= ", with comment: #{@request.comments}" if @request.comments.present? %>.
        </p>
      </div>
    </div>

    <%= render "shared/essentials/card" do %>
      <%= essentials_form_for :cancelation, url: request_cancelation_path(organization: @organization, request_id: @request.id), method: :post do |f| %>
        <%= f.input :reason, label: "Cancellation reason", as: :text, input_html: {rows: 3},
              hint: "This is included in the email notification we send to the partner. Cancellation emails are not sent to deactivated partners." %>

        <div class="mt-6 flex items-center gap-2 border-t border-slate-200 pt-5">
          <%= f.submit "Yes, cancel this request", class: essentials_button_classes(variant: :danger, size: :md), data: {disable_with: "Please wait..."} %>
          <%= essentials_link_button "No, keep it", request_path(@request), variant: :ghost, size: :md %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
