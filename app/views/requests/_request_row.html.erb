<% over_quota = request_row.partner.quota.present? && request_row.total_items.to_i >= request_row.partner.quota %>
<tr>
  <%= render "shared/essentials/selection_cell", record: request_row,
        label: "the request from #{request_row.partner.name} on #{request_row.created_at.strftime("%m/%d/%Y")}" %>
  <td class="pin-col date"><%= request_row.created_at.strftime("%m/%d/%Y") %></td>
  <td class="name font-medium text-slate-900"><%= request_row.partner.name %></td>
  <td>
    <% partner_user = @requests_info.partner_users.find { |pu| pu.id == request_row.partner_user_id } %>
    <%= partner_user&.formatted_email %>
  </td>
  <td class="quantity <%= "font-semibold italic" if over_quota %>">
    <%= number_with_delimiter(request_row.total_items) %>
    <% if request_row.partner.quota.present? %>
      <span class="block text-xs font-normal not-italic text-slate-500">
        limit <%= number_with_delimiter(request_row.partner.quota) %>
      </span>
    <% end %>
  </td>
  <td class="notes text-slate-600"><%= request_row.comments %></td>
  <td>
    <abbr class="no-underline" title="<%= request_row.request_type&.humanize %>"><%= request_row.request_type_label %></abbr>
  </td>
  <td><%= render partial: "status", locals: {status: request_row.status} %></td>
  <td class="cell-actions">
    <%
      row_items = [
        {label: "Print", path: print_picklist_request_path(request_row), icon: "bi-printer"},
        # "Cancel request", as the show page already says, not bare "Cancel": that word means
        # "abandon this form" on 122 pages of this app, and here it destroys a record. A Ruby
        # comment, not an ERB one, because this is inside a code block.
        ({label: "Cancel request", path: new_request_cancelation_path(request_id: request_row.id),
          icon: "bi-x-circle", tone: :danger} unless request_row.status_cancelled? || request_row.status_fulfilled?)
      ]
    %>
    <%# A visible View: nothing else in this row links to the request. %>
    <%= render "shared/essentials/row_actions",
          label: "the request from #{request_row.partner.name}",
          primary: essentials_row_icon_link("View", request_path(request_row), icon: "bi-eye"),
          items: row_items %>
  </td>
</tr>
