<%# Status pill. Colour never alone: each tone carries an icon and the word. %>
<% tone, icon = case status
                when "pending" then [:warning, "bi-hourglass-split"]
                when "started" then [:info, "bi-play-circle"]
                when "fulfilled" then [:success, "bi-check-circle"]
                else [:danger, "bi-x-circle"]
                end %>
<%= essentials_status_pill(status.to_s.humanize, tone: tone, icon: icon) %>
