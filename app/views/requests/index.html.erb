<% content_for :title, "Requests - #{current_organization.name}" %>
<% info = @requests_info %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Requests",
        subtitle: "Review what partners have asked for. Fulfill a request to turn it into a distribution.",
        actions: capture {
          # Two outputs behind one named menu. They were separate buttons, which with the totals
          # summary and the primary made four -- one past what design.md allows, and the only page
          # in the app that broke the rule. "Export" says what is inside; "More actions" would not.
          export_items = []
          if info.requests.any?
            export_items << {label: "Requests as CSV", icon: "bi-filetype-csv",
                             path: requests_path(format: :csv, filters: filter_params.merge(date_range: date_range_params)),
                             link_options: {data: {filter_export: true}}}
          end
          if info.unfulfilled_requests_count > 0
            export_items << {label: "Unfulfilled picklists, PDF (#{info.unfulfilled_requests_count})",
                             icon: "bi-printer",
                             path: print_unfulfilled_requests_path(format: :pdf, filters: filter_params.merge(date_range: date_range_params))}
          end
          if export_items.any?
            concat render("shared/essentials/menu_button", label: "Export", icon: "bi-download", items: export_items)
          end
          if current_user.has_role?(Role::ORG_ADMIN, current_organization)
            concat(button_tag(type: "button", class: essentials_button_classes(variant: :primary), data: {action: "click->dialog#open", dialog_id_param: "new-request"}) do
              concat tag.i(nil, class: "bi-plus-lg", aria: {hidden: true})
              concat " New quantity request"
            end)
          end
        } %>

  <%#
    Selecting rows so several can be acted on at once -- see "Selection" in design.md. The bar
    floats over the list, so the filters and the totals button above it stay put and stay usable.
  %>
  <div data-controller="table-selection">
  <%= render "shared/essentials/filter_bar", url: requests_path, frame: "requests-results",
        actions: (info.requests.any? ? capture {
          concat(button_tag(type: "button", class: essentials_button_classes(variant: :secondary), data: {action: "click->dialog#open", dialog_id_param: "calculate-totals"}) do
            concat tag.i(nil, class: "bi-calculator", aria: {hidden: true})
            concat " Show product totals"
          end)
        } : nil) do %>
    <div class="min-w-0"><%= filter_select(label: "Item", scope: :by_request_item_id, collection: info.items, selected: info.selected_request_item) %></div>
    <div class="min-w-0"><%= filter_select(label: "Partner", scope: :by_partner, collection: info.partners, selected: info.selected_partner) %></div>
    <div class="min-w-0"><%= filter_select(label: "Request type", scope: :by_request_type, collection: info.request_types, key: :last, value: :first, selected: info.selected_request_type) %></div>
    <div class="min-w-0"><%= filter_select(label: "Status", scope: :by_status, collection: info.statuses, key: :last, value: :first, selected: info.selected_status) %></div>
    <div class="min-w-0">
      <%= render partial: "shared/date_range_picker" %>
    </div>
  <% end %>

  <%= render "shared/essentials/selection_bar",
        actions: [{label: "Print picklists", icon: "bi-printer",
                   path: print_picklists_requests_path(format: :pdf)}] %>

  <%= turbo_frame_tag "requests-results", target: "_top", data: {turbo_action: "advance"} do %>

    <%#
      No card title: the page `h1` is already "Requests", and a card repeating it says nothing.

      And no card *actions* either. "Show product totals" had a band of its own here -- **63px** of
      card, rule and all, for one 30px button -- and it is on the filter row now, where there were
      **1,011px** of empty space at 1440. It belongs there twice over: the totals are "across every
      request matching the current filters", so they sit beside the filters that decide them.
    %>
    <%= render "shared/essentials/card", padded: false,
          footer: essentials_pagination_footer(info.paginated_requests) do %>
      <% if info.paginated_requests.blank? %>
        <%= render "shared/essentials/empty_state",
              kind: essentials_filtered? ? :no_results : :all_clear,
              title: essentials_filtered? ? "No requests #{date_range_label}" : "No requests right now",
              body: essentials_filtered? ? "Try a wider date range, or clear the filters to see every request." : "Requests from your partner agencies will appear here." %>
      <% else %>
        <%#
          Selecting rows so several can be acted on at once -- see "Selection" in design.md.
          Freezing the actions column removed the *travel* to a row's actions; this removes the
          *repetition*, for the one thing here that can genuinely be done to a set. `PicklistsPdf`
          already takes a collection, so the picking is the only new part.
        %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Requests from partner agencies</caption>
            <thead>
              <tr>
                <th scope="col" class="select-col">
                  <%# A 24x24 label around a 16x16 box, for the same reason as the row cells. %>
                  <%= label_tag "select_all_requests", class: "flex size-6 cursor-pointer items-center justify-center" do %>
                    <%= check_box_tag "select_all_requests", "1", false,
                          class: "h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-2 focus:ring-brand-500/30",
                          data: {table_selection_target: "all", action: "table-selection#toggleAll"} %>
                    <span class="sr-only">Select all requests on this page</span>
                  <% end %>
                </th>
                <th scope="col" class="date pin-col">Date</th>
                <th scope="col" class="name">Request was sent by</th>
                <th scope="col">Request sender</th>
                <th scope="col" class="quantity">Items requested</th>
                <th scope="col" class="notes">Comments</th>
                <th scope="col">Type</th>
                <th scope="col">Status</th>
                <th scope="col" class="cell-actions">Actions</th>
              </tr>
            </thead>
            <tbody><%= render partial: "request_row", collection: info.paginated_requests %></tbody>
          </table>
        </div>
      <% end %>
    <% end %>

    <%= render "calculate_product_totals" %>
    <%= render "new" if current_user.has_role?(Role::ORG_ADMIN, current_organization) %>
  <% end %>
  </div>
</div>
