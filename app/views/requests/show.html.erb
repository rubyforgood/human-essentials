<% info = @request_info %>
<% request = info.request %>
<% content_for :title, "Request from #{request.partner.name} - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Request from #{request.partner.name}",
        subtitle: "Sent on #{request.created_at.to_fs(:distribution_date)}.",
        back: {path: requests_path, label: "Back to requests"},
        actions: capture {
          concat essentials_link_button("Print", print_picklist_request_path(request), variant: :secondary, icon: "bi-printer")
          if request.distribution
            concat essentials_link_button("View associated distribution", distribution_path(request.distribution), variant: :secondary, icon: "bi-box-arrow-up-right")
          elsif !request.status_cancelled?
            concat essentials_action_button("Fulfill request", start_request_path(request), method: :post, variant: :primary, icon: "bi-check-circle")
          end
          if info.cancellable?
            concat essentials_link_button("Cancel request", new_request_cancelation_path(request_id: request.id),
                     variant: :ghost_danger, icon: "bi-x-circle", )
          end
        } %>

  <div class="space-y-6">
    <%= render "shared/essentials/card", title: "Request details" do %>
      <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <dt class="text-xs font-medium text-slate-500">Request was sent by</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= request.partner.name %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-slate-500">Request sender</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= request.partner_user&.formatted_email || "—" %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-slate-500">Request type</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= request.request_type&.humanize || "—" %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-slate-500">Status</dt>
          <dd class="mt-1"><%= render partial: "status", locals: {status: request.status} %></dd>
        </div>
        <div class="sm:col-span-2 lg:col-span-4">
          <dt class="text-xs font-medium text-slate-500">Comments</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= request.comments.presence || "None" %></dd>
        </div>
      </dl>
    <% end %>

    <%= render "shared/essentials/card", title: "Items requested", padded: false do %>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
        <table class="data-table">
          <caption>Items requested, with inventory on hand</caption>
          <thead>
            <tr>
              <th scope="col">Item</th>
              <th scope="col" class="quantity">Quantity</th>
              <% if info.custom_units %><th scope="col">Units (if applicable)</th><% end %>
              <% if info.default_storage_location %><th scope="col" class="quantity">Default storage location inventory</th><% end %>
              <th scope="col" class="quantity">Total inventory</th>
            </tr>
          </thead>
          <tbody>
            <% info.item_requests.each do |item_request| %>
              <tr>
                <td class="font-medium text-slate-900"><%= item_request.item_name %></td>
                <td class="quantity"><%= number_with_delimiter(item_request.quantity) %></td>
                <% if info.custom_units %>
                  <td><%= item_request.request_unit&.pluralize(item_request.quantity.to_i) %></td>
                <% end %>
                <% if info.default_storage_location %>
                  <% on_hand_for_location = info.inventory.quantity_for(storage_location: info.location&.id, item_id: item_request.item_id) %>
                  <td class="quantity"><%= on_hand_for_location&.positive? ? number_with_delimiter(on_hand_for_location) : "N/A" %></td>
                <% end %>
                <td class="quantity"><%= number_with_delimiter(info.inventory.quantity_for(item_id: item_request.item_id) || 0) %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr>
              <td>Total</td>
              <td class="quantity">
                <%= number_with_delimiter(request.total_items) %>
                <% if request.partner.quota.present? %>
                  <span class="block text-xs font-normal text-slate-500">limit <%= number_with_delimiter(request.partner.quota) %></span>
                <% end %>
              </td>
              <td colspan="3"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% end %>
  </div>
</div>
