<%= render "shared/essentials/modal", id: "calculate-totals", size: :lg,
      title: "Product totals",
      subtitle: "Across every request matching the current filters." do %>
  <% totals = @requests_info.calculate_product_totals.sort_by { |name, _| name.downcase } %>
  <% if totals.empty? %>
    <%= render "shared/essentials/empty_state", kind: :no_results,
          title: "Nothing to total",
          body: "No requests match the current filters." %>
  <% else %>
    <%# tabindex so the list can be scrolled by keyboard -- WCAG 2.1.1. %>
    <div class="max-h-96 overflow-y-auto" tabindex="0">
      <table class="data-table">
        <caption>Total quantity requested per item</caption>
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col" class="quantity">Quantity</th>
          </tr>
        </thead>
        <tbody>
          <% totals.each do |name, quantity| %>
            <tr>
              <td class="font-medium text-slate-900"><%= name %></td>
              <td class="quantity"><%= number_with_delimiter(quantity) %></td>
            </tr>
          <% end %>
        </tbody>
        <%# The button's name promises a total and the breakdown never gave one -- 46 per-item
            figures and no sum. `<tfoot>` totals were dropped from /distributions in the reports
            work, but for a reason that does not carry here: there they duplicated a summary band
            above the same table, and nothing duplicates this. %>
        <tfoot>
          <tr>
            <th scope="row" class="font-semibold text-slate-900">Total</th>
            <td class="quantity font-semibold text-slate-900">
              <%= number_with_delimiter(totals.sum { |_, quantity| quantity }) %>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% end %>
<% end %>
