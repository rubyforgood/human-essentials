<%# The two selects repeat once per row, so a visible label on each would be four labels
    saying the same thing. They carry aria-label instead -- label: false on its own left them
    with no accessible name at all, nine of them on the profile edit page. %>
<%= form.fields_for :served_areas, defined?(object) ? object : nil  do |fsa| %>
  <section class="nested-fields partner_served_area" data-controller="served-area">
    <div class="grid gap-6 mt-2 flex flex-row items-center justify-between">
      <div class='flex flex-col justify-center'>
        <div class='flex flex-row'>
          <span class="pc-name">
            <%= fsa.input :county_id, collection: @counties, prompt: "County or equivalent", include_blank: "",
              label: false,
              input_html: { class: "my-0 pc-county-select", "data-controller": "select2",
                            "aria-label": "County or equivalent" } %>
          </span>
          <div class="mx-2">
            <%= fsa.input :client_share, collection: 1..100, placeholder: "Client Share", label: false, input_html: {
              class: "pc-client-share percentage-selector",
              "aria-label": "Client share, per cent",
              "data-area-served-target": "share", "data-served-area-target": "share",
              "data-action": "change->area-served#calculateClientShareTotal keyup->area-served#calculateClientShareTotal" } %>
          </div>
          <div class="mx-2">
            <%= remove_element_button "Remove", container_selector: "section",
              class: "remove_served_area inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600",
              data: { action: "click->form-input#removeItem:prevent click->served-area#zeroShareValue click->area-served#calculateClientShareTotal",
                      remove_parent_selector: "section", remove_soft: false } %>
          </div>
        </div>
      </div>
    </div>

    <hr class="partner-county-separator">
  </section>
<% end %>
