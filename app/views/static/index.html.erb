<%#
  The landing page. Three kinds of people arrive here and each has a door: someone who runs a
  bank (Request an account), someone at a partner agency (Log in), and someone who needs
  diapers or period supplies and has mistaken the software for the service (the bank finder,
  which is in the hero for exactly that reason -- see ADR 0014).

  The map's lights are the two public directories the bank finder searches, not the banks that
  use Human Essentials, and the caption under it says so. Do not let the copy drift into
  implying otherwise.

  The figures under "A lot of families" are the project's published ones (README.md). They are
  not computed from this database, so they change when the README does.
%>
<% content_for :title, "Human Essentials: the free system behind more than 200 essentials banks" %>
<% content_for :description, "Human Essentials is free inventory software for diaper banks and period supply banks across the United States. Built by volunteers at Ruby for Good." %>
<% map = bank_map %>
<% if map.any? %>
  <% content_for :credits do %>
    Map outline from U.S. Census Bureau cartographic boundary files. Bank locations from the
    National Diaper Bank Network and Alliance for Period Supplies directories, as imported on
    <%= l(map.as_of.to_date, format: :long) %>.
  <% end %>
<% end %>

<%= render "static/header", sections: {
      "How it works" => "#how", "Who uses it" => "#banks", "Who builds it" => "#open", "Questions" => "#questions"
    } %>

<main id="main-content" tabindex="-1">
<div class="night top">
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero-in">
      <div>
        <h1 id="hero-h">The free system behind more than 200 essentials banks.</h1>
        <p class="lede">Human Essentials keeps count of every donation, shelf and distribution for diaper banks and period supply banks across the United States. Volunteers build it. Banks never pay for it.</p>
        <div class="hero-cta">
          <%= link_to "Request an account", new_account_request_path, class: "btn btn-light" %>
          <a class="btn btn-ghost" href="#how">See how it works</a>
        </div>
        <p class="assoc">Provided in association with the National Diaper Bank Network and the Alliance for Period Supplies.</p>
      </div>
      <figure class="map-fig">
        <%= render "static/bank_map", map: map %>
        <% if map.any? %>
          <figcaption>
            <ul class="legend">
              <li class="d"><i></i><span>Diapers</span></li>
              <li class="p"><i></i><span>Period supplies</span></li>
              <li class="b"><i></i><span>Both</span></li>
            </ul>
            <p class="map-note">Each light is one of the <%= number_with_delimiter(map.count) %> banks in the National Diaper Bank Network and Alliance for Period Supplies directories, placed at its home city.</p>
          </figcaption>
        <% end %>
      </figure>
    </div>
  </section>

  <section class="finder" aria-labelledby="finder-l">
    <div class="wrap finder-in">
      <label for="near" id="finder-l">Looking for diapers or period supplies?
        <small>We make the software banks use. A bank near you gives out the supplies.</small>
      </label>
      <%# A plain GET to the bank finder, so it works without JavaScript. Left empty, it opens the finder. %>
      <%= form_with url: bank_finder_path, method: :get, local: true, role: "search" do %>
        <%= text_field_tag :near, nil, autocomplete: "address-level2", placeholder: "City and state, or ZIP code" %>
        <%= button_tag "Find a bank", type: "submit", name: nil, class: "btn btn-light" %>
      <% end %>
    </div>
  </section>
</div>

  <section class="section" id="how" aria-labelledby="how-h">
    <div class="wrap">
      <h2 id="how-h">One count, from the loading dock to the family.</h2>
      <p class="intro">Every bank does the same five things. Human Essentials records each one, so the number on the screen is the number on the shelf.</p>
      <%= render "static/tour" %>
    </div>
  </section>

  <section class="section tint" id="banks" aria-labelledby="banks-h">
    <div class="wrap">
      <h2 id="banks-h">A lot of families are counting on these banks.</h2>
      <dl class="stats">
        <div><dt>banks registered on Human Essentials</dt><dd>200+</dd></div>
        <div><dt>children receiving diapers</dt><dd>3M+</dd></div>
        <div><dt>people receiving period supplies</dt><dd>400K+</dd></div>
        <div><dt>cost to a bank</dt><dd>$0</dd></div>
      </dl>
      <div class="quotes">
        <figure>
          <blockquote>&ldquo;Human Essentials has taken our diaper distribution to the next level. We no longer have to worry about how to track our incoming and outgoing inventory, and having all our products and data tracked in different ways in different documents and systems. Human Essentials has saved us time, money, energy and many, many headaches. The system is extremely intuitive and user-friendly and we are so grateful to have it.&rdquo;</blockquote>
          <figcaption><b>Megan</b>, Sweet Cheeks Diaper Bank</figcaption>
        </figure>
        <figure>
          <blockquote>&ldquo;Finally, an inventory management system designed specifically for the unique needs of diaper banks!&rdquo;</blockquote>
          <figcaption><b>Rachel Alston</b>, PDX Diaper Bank</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="open" aria-labelledby="open-h">
    <div class="wrap open">
      <div>
        <h2 id="open-h">Built in the open, by volunteers.</h2>
        <p class="intro">Human Essentials is made by <a href="https://rubyforgood.org">Ruby for Good</a>, a non-profit whose volunteers write software for organizations doing good. It was first built alongside PDX Diaper Bank.</p>
      </div>
      <dl>
        <div><dt>Free, and hosted for you</dt><dd>No license fee, no per-user price and nothing to install.</dd></div>
        <div><dt>Open source</dt><dd>Every line is public under the MIT license. <a href="https://github.com/rubyforgood/human-essentials">Read the code on GitHub.</a></dd></div>
        <div><dt>A digital public good</dt><dd>Recognized by the Digital Public Goods Alliance.</dd></div>
      </dl>
    </div>
  </section>

  <section class="section tint router" aria-labelledby="router-h">
    <div class="wrap">
      <h2 id="router-h">What brings you here?</h2>
      <ul>
        <li><%= link_to new_account_request_path do %><b>I run an essentials bank</b><span>You collect diapers, period supplies or other essentials and give them out through partner agencies.</span><em>Request an account</em><% end %></li>
        <li><%= link_to new_user_session_path do %><b>I work at a partner agency</b><span>Your bank invites you. Use the email address the invitation was sent to.</span><em>Log in</em><% end %></li>
        <li><%= link_to bank_finder_path do %><b>I need diapers or period supplies</b><span>We make the software banks use; we do not hand out supplies. A bank near you does.</span><em>Find a bank near you</em><% end %></li>
      </ul>
    </div>
  </section>

  <section class="section" id="questions" aria-labelledby="q-h">
    <div class="wrap">
      <h2 id="q-h">Questions banks ask first.</h2>
      <div class="faq">
        <details><summary>Is it really free?</summary><p>Yes. There is no charge to any bank. Volunteers build it and Ruby for Good hosts it.</p></details>
        <details><summary>Who is it for?</summary><p>Diaper banks, period supply banks and other essentials banks that give out supplies through partner agencies. You request an account, and we set your bank up.</p></details>
        <details><summary>I need diapers or period supplies. Can I get them here?</summary><p>Not from us. We make the software that banks use. <%= link_to "Find a bank near you", bank_finder_path %>, and it can tell you which local agencies give out supplies.</p></details>
        <details><summary>I work at a partner agency. How do I get in?</summary><p>Your bank invites you. Once you accept the invitation, <%= link_to "log in", new_user_session_path %> with that email address.</p></details>
        <details><summary>Can we bring the records we already have?</summary><p>Yes. Partners, storage locations with their starting inventory, vendors and donation sites can each be imported from a spreadsheet.</p></details>
        <details><summary>Who can see our data?</summary><p>Your bank's records belong to your bank, and other banks cannot see them. The <%= link_to "privacy policy", privacypolicy_path %> says what we keep and why.</p></details>
      </div>
    </div>
  </section>

  <section class="night cta" aria-labelledby="cta-h">
    <div class="wrap cta-in">
      <div>
        <h2 id="cta-h">Run your bank on Human Essentials.</h2>
        <p>Tell us about your bank and we will set up your account. Questions first? Write to <a href="mailto:info@humanessentials.app">info@humanessentials.app</a>.</p>
      </div>
      <%= link_to "Request an account", new_account_request_path, class: "btn btn-light" %>
    </div>
  </section>
</main>
