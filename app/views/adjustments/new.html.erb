<% content_for :title, "New Adjustment - Inventory - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "New inventory adjustment",
        subtitle: "Manually increase or decrease the amount of inventory at a storage location.",
        back: {path: adjustments_path, label: "Back to adjustments"} %>

  <%= essentials_form_for @adjustment,
        data: {controller: "form-input"},
        html: {class: "storage-location-required", id: "new_adjustment"} do |f| %>
    <div class="space-y-6">
      <%= essentials_error_summary(@adjustment) %>

      <%= render "shared/essentials/card", title: "Where to adjust" do %>
        <div class="max-w-md">
          <%= render partial: "storage_locations/source", object: f, locals: {include_omitted_items: true} %>
        </div>
        <%= f.input :comment, label: "Comment", as: :text, input_html: {rows: 3} %>
      <% end %>

      <%= render "shared/essentials/card",
            title: "Items in this adjustment",
            subtitle: "Enter a negative quantity to subtract that item, or a plain amount to add it.",
            padded: false do %>
        <fieldset class="px-5 py-4">
          <legend class="sr-only">Items in this adjustment</legend>
          <div id="adjustment_line_items" class="line-item-fields" data-capture-barcode="true">
            <%= render "line_items/line_item_fields", form: f %>
          </div>
          <div class="mt-4">
            <%= add_element_button "Add another item", container_selector: "#adjustment_line_items",
                  id: "__add_line_item",
                  class: essentials_button_classes(variant: :secondary, size: :md) do %>
              <%= render "line_items/line_item_fields", form: f, object: LineItem.new %>
            <% end %>
          </div>
        </fieldset>
      <% end %>

      <div class="flex items-center gap-2">
        <%= f.button :button, "Save", class: essentials_button_classes(variant: :primary, size: :md), data: {disable_with: "Saving..."} %>
        <%= essentials_link_button "Cancel", adjustments_path, variant: :ghost, size: :md %>
      </div>
    </div>
  <% end %>
</div>

<%= render partial: "barcode_items/barcode_modal" %>
