<% content_for :title, "Adjustment - Inventory - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Adjustment (#{@adjustment.created_at.strftime("%m/%d/%Y")})",
        back: {path: adjustments_path, label: "Back to adjustments"} %>

  <div class="space-y-6">
    <%= render "shared/essentials/card", title: "Details" do %>
      <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <dt class="text-xs font-medium text-slate-500">Organization</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= @adjustment.organization.name %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-slate-500">Storage location</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= @adjustment.storage_location.name %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-slate-500">Comments</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= @adjustment.comment.presence || "—" %></dd>
        </div>
      </dl>
    <% end %>

    <%= render "shared/essentials/card", title: "Changes made", padded: false do %>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
        <table class="data-table">
          <caption>Items added and removed by this adjustment</caption>
          <thead>
            <tr>
              <th scope="col">Direction</th>
              <th scope="col">Item</th>
              <th scope="col" class="quantity">Quantity</th>
            </tr>
          </thead>
          <tbody>
            <% @adjustment.line_items.each do |line_item| %>
              <% added = line_item.quantity > 0 %>
              <%# Direction was signalled by a green/red row tint alone. It is a pill with an
                  icon and the word now, and the row keeps a soft tint as reinforcement. %>
              <tr class="<%= added ? "positive bg-emerald-50/50" : "negative bg-rose-50/50" %>">
                <td>
                  <%= essentials_status_pill(added ? "Added" : "Removed",
                        tone: added ? :success : :danger,
                        icon: added ? "bi-plus-circle" : "bi-dash-circle") %>
                </td>
                <td class="font-medium text-slate-900"><%= line_item.item.name %></td>
                <td class="quantity"><%= number_with_delimiter(line_item.quantity.abs) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
