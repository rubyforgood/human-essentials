<%= essentials_form_for @audit, data: {controller: "form-input duplicate-items"},
      html: {class: "storage-location-required"} do |f| %>
  <div class="space-y-6">
    <%= essentials_error_summary(@audit) %>

    <%= render "shared/essentials/card", title: "What you are auditing" do %>
      <div class="max-w-md">
        <%= render partial: "storage_locations/source", object: f,
              locals: {label: "Storage location", error: "What storage location are you auditing?", include_omitted_items: true} %>
      </div>
    <% end %>

    <%= render "shared/essentials/card",
          title: "Items in this audit",
          subtitle: "Leave an item out to keep its recorded level unchanged — a partial audit is fine.",
          padded: false do %>
      <%= render "line_items/line_item_table", form: f, id: "audit_line_items", noun: "audit" %>
    <% end %>

    <%= essentials_form_actions do %>
      <%= f.button :button, "Confirm audit", name: "confirm_audit",
            class: essentials_button_classes(variant: :primary, size: :md),
            data: {
              disable_with: "Saving...",
              "duplicate-items-target": "itemSubmitButton",
              confirm: "Are you sure?\n\nPlease note that this audit must also be finalized by someone with organization admin rights before changes to inventory will take place.\n\nWe strongly recommend completing that step before doing any further actions that affect inventory."
            } %>
      <%= f.button :button, "Save progress", name: "save_progress",
            class: essentials_button_classes(variant: :secondary, size: :md),
            data: {disable_with: "Saving...", "duplicate-items-target": "itemSubmitButton"} %>
      <%= essentials_link_button "Cancel", audits_path, variant: :ghost, size: :md %>
    <% end %>
  </div>
<% end %>

<%= render partial: "barcode_items/barcode_modal" %>
