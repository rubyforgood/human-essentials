<p>Some items on your distribution have changed</p>
<ul style="list-style-type:none">
<% if @distribution_changes[:added].present? %>
    <li>Items added</li>
    <ol style="list-style-type:none">
        <% @distribution_changes[:added].each do |item| %>
        <li>
            <p><%= "#{item[:name]}: #{item[:quantity]}" %></p>
        </li>
        <% end %>
    </ol>
    </li>
<% end %>
<% if @distribution_changes[:updates].any? %>
    <li>Items updated</li>
    <ol style="list-style-type:none">
        <% @distribution_changes[:updates].each do |item| %>
        <li>
            <p><%= "#{item[:name]} from #{item[:old_quantity]} to #{item[:new_quantity]}" %></p>
        </li>
        <% end %>
    </ol>
    </li>
<% end %>
<% if @distribution_changes[:removed].any? %>
    <li>Items removed</li>
    <ol style="list-style-type:none">
        <% @distribution_changes[:removed].each do |item| %>
        <li>
            <p><%= item[:name] %></p>
        </li>
        <% end %>
    </ol>
    </li>
<% end %>
</ul>
