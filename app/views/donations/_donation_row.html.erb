<%# The AdminLTE version left three <td> elements unclosed, so the browser nested the
    remaining cells inside them. Flat row here. %>
<tr>
  <td class="font-medium text-slate-900"><%= donation_row.source %></td>
  <td class="date"><%= donation_row.issued_at.strftime("%F") %></td>
  <td><%= donation_row.details %></td>
  <td><%= donation_row.storage_location.name %></td>
  <td class="quantity"><%= number_with_delimiter(donation_row.line_items.total) %></td>
  <td class="numeric"><%= dollar_value(donation_row.money_raised.to_i) %></td>
  <td class="numeric"><%= dollar_value(donation_row.value_per_itemizable) %></td>
  <td class="max-w-prose text-slate-600"><%= truncate donation_row.comment, length: 140, separator: /\w+/ %></td>
  <td class="text-right">
    <div class="flex justify-end gap-1.5">
      <%= essentials_link_button "View", donation_path(donation_row), variant: :ghost, size: :sm, icon: "bi-eye" %>
      <%= essentials_link_button "Print", print_donation_path(donation_row, format: :pdf), variant: :ghost, size: :sm, icon: "bi-printer" %>
    </div>
  </td>
</tr>
