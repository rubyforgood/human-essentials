<% content_for :title, "Donations - #{current_organization.name}" %>
<% info = @donation_info %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Donations",
        subtitle: "Essentials coming in to #{current_organization.name}.",
        actions: capture {
          if info.donations.any?
            concat essentials_link_button("Export", donations_path(format: :csv, filters: filter_params.merge(date_range: date_range_params)), variant: :secondary, icon: "bi-download")
          end
          concat essentials_link_button("New donation", new_donation_path, variant: :primary, icon: "bi-plus-lg")
        } %>

  <%= render "shared/essentials/filter_bar", url: donations_path do %>
    <% if info.storage_locations.present? %>
      <div class="min-w-[13rem]"><%= filter_select(label: "Storage location", scope: :at_storage_location, collection: info.storage_locations, selected: info.selected_storage_location) %></div>
    <% end %>
    <% if info.sources.present? %>
      <div class="min-w-[13rem]"><%= essentials_filter_options(label: "Source", scope: :by_source, options: info.sources, selected: info.selected_source) %></div>
    <% end %>
    <% if info.product_drives.present? %>
      <div class="min-w-[13rem]"><%= filter_select(label: "Product drive", scope: :by_product_drive, collection: info.product_drives, selected: info.selected_product_drive) %></div>
    <% end %>
    <% if info.product_drive_participants.present? %>
      <div class="min-w-[13rem]"><%= filter_select(label: "Product drive participant", scope: :by_product_drive_participant, collection: info.product_drive_participants, value: :business_name, selected: info.selected_product_drive_participant) %></div>
    <% end %>
    <% if info.manufacturers.present? %>
      <div class="min-w-[13rem]"><%= filter_select(label: "Manufacturer", scope: :from_manufacturer, collection: info.manufacturers, selected: info.selected_manufacturer) %></div>
    <% end %>
    <% if info.donation_sites.present? %>
      <div class="min-w-[13rem]"><%= filter_select(label: "Donation site", scope: :from_donation_site, collection: info.donation_sites, key: :id, value: :name, selected: info.selected_donation_site) %></div>
    <% end %>
    <% if info.items.present? %>
      <div class="min-w-[13rem]"><%= filter_select(label: "Item", scope: :by_item_id, collection: info.items, selected: info.selected_item) %></div>
    <% end %>
    <% if info.item_categories.present? %>
      <div class="min-w-[13rem]"><%= essentials_filter_options(label: "Category", scope: :by_category, options: info.item_categories, selected: info.selected_item_category) %></div>
    <% end %>
    <div class="min-w-[15rem]">
      <%= render partial: "shared/date_range_picker", locals: {css_class: EssentialsUiHelper::FILTER_CONTROL_CLASSES} %>
    </div>
  <% end %>

  <%= render "shared/essentials/card", padded: false,
        footer: capture { concat(render("shared/essentials/pagination", collection: info.paginated_donations)) } do %>
    <% if info.paginated_donations.blank? %>
      <%= render "shared/essentials/empty_state",
            kind: essentials_filtered? ? :no_results : :cold_start,
            title: essentials_filtered? ? "No donations match those filters" : "No donations recorded yet",
            body: essentials_filtered? ? "Clear the filters to see every donation." : "Record what comes in from donors, product drives, manufacturers and donation sites.",
            action: essentials_filtered? ? nil : essentials_link_button("New donation", new_donation_path, variant: :primary, icon: "bi-plus-lg") %>
    <% else %>
      <div class="table-scroll">
        <table class="data-table">
          <caption>Donations received, most recent first</caption>
          <thead>
            <tr>
              <th scope="col">Source</th>
              <th scope="col" class="date">Date</th>
              <th scope="col">Details</th>
              <th scope="col">Storage location</th>
              <th scope="col" class="quantity">Quantity of items</th>
              <th scope="col" class="numeric">Money raised</th>
              <th scope="col" class="numeric">In-kind value</th>
              <th scope="col">Comments</th>
              <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody><%= render partial: "donation_row", collection: info.paginated_donations %></tbody>
          <tfoot>
            <tr>
              <td colspan="4">Total</td>
              <td class="quantity">
                <%= number_with_delimiter(info.paginated_donations_quantity) %>
                <span class="block text-xs font-normal text-slate-500">this page</span>
                <span id="donation_quantity" class="mt-1 block"><%= number_with_delimiter(info.donations_quantity) %></span>
                <span class="block text-xs font-normal text-slate-500">all donations</span>
              </td>
              <td class="numeric"><%= dollar_value(info.total_money_raised) %></td>
              <td class="numeric in-kind">
                <%= dollar_value(info.paginated_in_kind_value) %>
                <span class="block text-xs font-normal text-slate-500">this page</span>
                <span class="mt-1 block"><%= dollar_value(info.total_value_all_donations) %></span>
                <span class="block text-xs font-normal text-slate-500">all donations</span>
              </td>
              <td colspan="2"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% end %>
  <% end %>
</div>
