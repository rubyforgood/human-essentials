<% content_for :title, "Donations - #{current_organization.name}" %>
<% info = @donation_info %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Donations",
        subtitle: "Record what donors bring in, and where you put it.",
        actions: capture {
          if info.donations.any?
            concat essentials_link_button("Export", donations_path(format: :csv, filters: filter_params.merge(date_range: date_range_params)), variant: :secondary, icon: "bi-download", data: {filter_export: true})
          end
          concat essentials_link_button("New donation", new_donation_path, variant: :primary, icon: "bi-plus-lg")
        } %>

  <%= render "shared/essentials/filter_bar", url: donations_path, frame: "donations-results" do %>
    <% if info.storage_locations.present? %>
      <div class="min-w-0"><%= filter_select(label: "Storage location", scope: :at_storage_location, collection: info.storage_locations, selected: info.selected_storage_location) %></div>
    <% end %>
    <% if info.sources.present? %>
      <div class="min-w-0"><%= essentials_filter_options(label: "Source", scope: :by_source, options: info.sources, selected: info.selected_source) %></div>
    <% end %>
    <% if info.product_drives.present? %>
      <div class="min-w-0"><%= filter_select(label: "Product drive", scope: :by_product_drive, collection: info.product_drives, selected: info.selected_product_drive) %></div>
    <% end %>
    <% if info.product_drive_participants.present? %>
      <div class="min-w-0"><%= filter_select(label: "Product drive participant", scope: :by_product_drive_participant, collection: info.product_drive_participants, value: :business_name, selected: info.selected_product_drive_participant) %></div>
    <% end %>
    <% if info.manufacturers.present? %>
      <div class="min-w-0"><%= filter_select(label: "Manufacturer", scope: :from_manufacturer, collection: info.manufacturers, selected: info.selected_manufacturer) %></div>
    <% end %>
    <% if info.donation_sites.present? %>
      <div class="min-w-0"><%= filter_select(label: "Donation site", scope: :from_donation_site, collection: info.donation_sites, key: :id, value: :name, selected: info.selected_donation_site) %></div>
    <% end %>
    <% if info.items.present? %>
      <div class="min-w-0"><%= filter_select(label: "Item", scope: :by_item_id, collection: info.items, selected: info.selected_item) %></div>
    <% end %>
    <% if info.item_categories.present? %>
      <div class="min-w-0"><%= essentials_filter_options(label: "Category", scope: :by_category, options: info.item_categories, selected: info.selected_item_category) %></div>
    <% end %>
    <div class="min-w-0">
      <%= render partial: "shared/date_range_picker" %>
    </div>
  <% end %>

  <%= turbo_frame_tag "donations-results", target: "_top", data: {turbo_action: "advance"} do %>
    <%#
      What the donations summary report used to show, on the page that holds the data and driven
      by the same filters. `info` already computed all of it for the table footer that was here.
    %>
    <%= essentials_stats([
          {label: "Donations", value: number_with_delimiter(info.donations.size)},
          {label: "Items received", value: number_with_delimiter(info.donations_quantity), value_id: "donation_quantity"},
          {label: "Money raised", value: dollar_presentation(info.total_money_raised)},
          {label: "In-kind value", value: dollar_presentation(info.total_value_all_donations)}
              ], title: "Totals",
           subtitle: essentials_stats_scope(info.donations.size, "donation")) %>

    <div class="mt-6"></div>

    <%= render "shared/essentials/card", padded: false,
          footer: essentials_pagination_footer(info.paginated_donations) do %>
      <% if info.paginated_donations.blank? %>
        <%= render "shared/essentials/empty_state",
              kind: essentials_filtered? ? :no_results : :cold_start,
              title: essentials_filtered? ? "No donations #{date_range_label}" : "No donations recorded yet",
              body: essentials_filtered? ? "Try a wider date range, or clear the filters to see every donation." : "Record what comes in from donors, product drives, manufacturers and donation sites.",
              action: essentials_filtered? ? nil : essentials_link_button("Record your first donation", new_donation_path, variant: :primary, icon: "bi-plus-lg") %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Donations received, most recent first</caption>
            <thead>
              <tr>
                <%# Date leads, from main (#5599). The frozen column follows the first column
                    rather than the other way round -- `.pin-col` is `left: 0`, so only column one
                    can be pinned -- and a date is a cheaper thing to freeze than a source name,
                    because it is narrower. Source keeps the emphasis that marks the row's subject. %>
                <th scope="col" class="pin-col date">Date</th>
                <th scope="col" class="name">Source</th>
                <th scope="col">Details</th>
                <th scope="col">Storage location</th>
                <th scope="col" class="quantity">Quantity of items</th>
                <th scope="col" class="numeric">Money raised</th>
                <th scope="col" class="numeric">In-kind value</th>
                <th scope="col" class="notes">Comments</th>
                <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody><%= render partial: "donation_row", collection: info.paginated_donations %></tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
