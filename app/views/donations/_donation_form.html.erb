<%= essentials_form_for @donation, data: {controller: "form-input"} do |f| %>
  <div data-controller="donations-modal" class="space-y-6">
    <%= turbo_frame_tag "modal-new" %>
    <%= essentials_error_summary(@donation) %>

    <%= render "shared/essentials/card", title: "Where this donation came from" do %>
      <div class="grid gap-x-5 sm:grid-cols-2 lg:grid-cols-3">
        <%= f.input :source, collection: Donation::SOURCES.values, selected: donation_form.source,
              include_blank: true, label: "Source",
              hint: "What effort or initiative did this donation come from?" %>

        <%= f.association :donation_site, collection: options_with_new(@donation_sites),
              selected: donation_form.donation_site_id, include_blank: true,
              label: "Donation site", hint: "Where was this donation dropped off?",
              input_html: {data: {action: "change->donations-modal#handleNewSelect", url: new_donation_site_path}} %>

        <%= f.association :product_drive, collection: @product_drives,
              selected: donation_form.product_drive_id, include_blank: true,
              label_method: ->(x) { x.try(:name).to_s }, label: "Product drive",
              hint: "Which product drive was this from?" %>

        <%= f.association :product_drive_participant, collection: @product_drive_participants,
              selected: donation_form.product_drive_participant_id, include_blank: true,
              label_method: ->(x) { x.try(:business_name).presence || x.try(:contact_name) },
              label: "Product drive participant", hint: "Which participant was this from?" %>

        <%= f.association :manufacturer, collection: @manufacturers,
              selected: donation_form.manufacturer_id, include_blank: true,
              label_method: ->(x) { x.try(:name).to_s }, label: "Manufacturer",
              hint: "Which manufacturer was this from?" %>
      </div>
    <% end %>

    <%= render "shared/essentials/card", title: "Donation details" do %>
      <div class="grid gap-x-5 sm:grid-cols-2 lg:grid-cols-3">
        <%= f.association :storage_location, collection: @storage_locations, label: "Storage location",
              hint: "Where is it being stored?",
              selected: donation_form.storage_location&.id || default_location(@donation),
              include_blank: true %>

        <%# `as: :money_raised_in_dollars` was on this input in the AdminLTE version and had
            no effect: simple_form ignores `as:` when a block is given, and no
            MoneyRaisedInDollarsInput class has ever existed. Dropping the block exposed that
            -- "No input found for money_raised_in_dollars". It is a plain string input. %>
        <%= f.input :money_raised_in_dollars,
              label: "Money raised",
              input_html: {value: donation_form.money_raised_in_dollars} %>

        <%= f.input :issued_at, label: "Issued on", as: :date, html5: true,
              input_html: {value: donation_form.issued_at} %>
      </div>

      <%= f.input :comment, label: "Comment", as: :text, input_html: {rows: 3, value: donation_form.comment} %>
    <% end %>

    <%= render "shared/essentials/card", title: "Items in this donation", padded: false do %>
      <%= render "line_items/line_item_table", form: f, id: "donation_line_items", noun: "donation", object: donation_form.line_items, changes_disallowed: @changes_disallowed %>
    <% end %>

    <div class="flex items-center gap-2">
      <%= f.button :button, "Save", class: essentials_button_classes(variant: :primary, size: :md), data: {disable_with: "Saving..."} %>
      <%= essentials_link_button "Cancel", donations_path, variant: :ghost, size: :md %>
    </div>
  </div>
<% end %>
