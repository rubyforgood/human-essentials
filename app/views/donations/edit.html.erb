<% source = @original_source.presence || @donation.source %>
<% content_for :title, "Edit - Donations - #{source} - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Editing donation",
        subtitle: "From #{source}, recorded #{@donation.created_at.to_fs(:distribution_date)}.",
        back: {path: donations_path, label: "Back to donations"} %>

  <% if @audit_performed_and_finalized %>
    <%= render "shared/essentials/callout", tone: :warning, role: "status", wrapper_class: "mb-6" do %>
      You’ve had an audit since this donation was started.
      In the case that you are correcting a typo, rather than recording that the physical amounts being donated have changed,
      you’ll need to make an adjustment to the inventory as well.

    <% end %>
  <% end %>

  <%= render partial: "donation_form", object: @previous_input.presence || @donation %>

  <%# Hidden trigger driven by the donations-modal Stimulus controller. %>
  <%= link_to "Add vendor", new_vendor_path, remote: true, id: "new_vendor", class: "hidden", "aria-hidden": true, tabindex: -1 %>
</div>

<%= render partial: "barcode_items/barcode_modal" %>
