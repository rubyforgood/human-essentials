<% content_for :title, "Donation - #{current_organization.name}" %>
<% inactive = @donation.has_inactive_item? %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Donation",
        subtitle: "#{@donation.source} — #{@donation.created_at.to_fs(:distribution_date)}",
        back: {path: donations_path, label: "Back to donations"},
        actions: capture {
          concat essentials_link_button("Print", print_donation_path(@donation, format: :pdf), variant: :secondary, icon: "bi-printer")
          # **The primary is emitted last.** design.md: at most three actions, at most one of them
          # primary, primary last -- a page header's actions are right-aligned, so the last slot is
          # the one the eye lands on. It used to be emitted second, with the record actions after
          # it, which is the opposite of what the comment below has always claimed. Found once
          # `button-audit` stopped working from a hardcoded list of index pages and started visiting
          # the show pages too.
          # Edit and Delete act on the record as a whole, so they belong in the page header --
          # design.md names *Deactivate* as the example. They were at the foot of the page, below
          # the last card, which is where a form's Save goes and not where a record's own actions
          # do.
          #
          # In the overflow rather than beside the primary, for two reasons: the header allows
          # three actions and a menu counts as one, and the last slot belongs to the primary, so a
          # destructive action must not inherit it. "Edit", not "Make a correction" -- thirty
          # places in this app say Edit, and four said the other, which was pre-migration wording
          # carried through the migration rather than chosen.
          unless inactive
            record_actions = [{label: "Edit", path: edit_donation_path(@donation), icon: "bi-pencil"}]
            if current_user.has_cached_role?(Role::ORG_ADMIN, current_organization)
              record_actions << {label: "Delete", path: donation_path(@donation), method: :delete,
                                 icon: "bi-trash", tone: :danger,
                                 confirm: "Are you sure you want to permanently remove this donation?"}
            end
            concat essentials_record_actions(label: "this donation", items: record_actions)
          end
          concat essentials_link_button("Start a distribution", new_distribution_path(donation_id: @donation.id, storage_location_id: @donation.storage_location_id), variant: :primary, icon: "bi-plus-lg")
        } %>

  <div class="space-y-6">
    <% if inactive %>
      <%# The reason edit and delete are unavailable is stated once, up front, rather than
          left to a disabled control the user has to work out for themselves. %>
      <%= render "shared/essentials/callout", tone: :warning, role: "status" do %>
        <%# The wording follows the controls: they say Edit and Delete, so this does too. %>
        <p class="font-semibold">This donation cannot be edited or deleted</p>
        <p class="mt-1">
        Donations can only be changed while all of their items are active. To edit or delete this
        donation, reactivate these items: <%= @donation.inactive_items.map(&:name).join(", ") %>
        </p>

      <% end %>
    <% end %>

    <%= render "shared/essentials/card", title: "Details" do %>
      <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
        <%# "Drive participant" is main's addition (#5598), in the same order it put it there:
            after the donation site, before the storage location. The `.presence || "—"` below is
            what renders it on a donation that came from anywhere else: the helper returns nil
            rather than main's "N/A", so this field reads like the others. %>
        <% {"Date" => @donation.created_at.to_fs(:distribution_date),
            "Source" => @donation.source,
            "Donation site" => @donation.donation_site_view,
            "Drive participant" => drive_participant_view(@donation),
            "Storage location" => @donation.storage_view}.each do |label, value| %>
          <div>
            <dt class="text-xs font-medium text-slate-500"><%= label %></dt>
            <dd class="mt-0.5 text-sm text-slate-900"><%= value.presence || "—" %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <%= render "shared/essentials/card", title: "Items donated", padded: false do %>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
        <table class="data-table">
          <caption>Items in this donation</caption>
          <thead>
            <tr>
              <th scope="col">Item</th>
              <th scope="col" class="quantity">Quantity</th>
              <th scope="col" class="numeric">In-kind value</th>
            </tr>
          </thead>
          <tbody><%= render partial: "donation_item_row", collection: @line_items %></tbody>
          <tfoot>
            <tr>
              <td>Total</td>
              <td class="quantity"><%= number_with_delimiter(@line_items.pluck(:quantity).sum) %></td>
              <td class="numeric"><%= dollar_value(@donation.value_per_itemizable) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% end %>

    <%= render "shared/essentials/card", title: "Comment" do %>
      <div id="donation-comment">
        <% if @donation.comment.present? %>
          <div class="text-sm text-slate-700"><%= simple_format(@donation.comment) %></div>
        <% else %>
          <p class="text-sm italic text-slate-500">None provided</p>
        <% end %>
      </div>
    <% end %>

  </div>
</div>
