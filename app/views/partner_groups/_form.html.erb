<%#
  Locals: submit_btn_options.

  Fixed here: `text-bold` (Tailwind has no such class -- the author meant `font-bold`, so these
  headings were never bold), a `<label>` with a stray `l` attribute and no `for`, `form-horizontal`,
  and section headings marked up as <h2> where they are really the questions their fields ask, so
  they are fieldset legends now.
%>
<div class="max-w-2xl px-4 py-6 sm:px-6 lg:px-8">
  <%= essentials_error_summary(@partner_group) %>

  <%= render "shared/essentials/card" do %>
    <%= essentials_form_for @partner_group do |f| %>
      <%= f.input :name, label: "Name" %>

      <fieldset class="mb-4">
        <legend class="text-sm font-semibold text-slate-900">
          Which item categories can this group request?
        </legend>
        <p class="mt-1 text-sm text-slate-600">
          Members of this group can only request from the categories you tick. Tick none and they
          can request nothing.
        </p>
        <div class="mt-2">
          <%= f.association :item_categories, collection: @item_categories, as: :check_boxes, label: false %>
        </div>
      </fieldset>

      <fieldset class="mb-4" data-controller="checkbox-with-nested-element">
        <legend class="text-sm font-semibold text-slate-900">
          Send deadline reminders every month?
        </legend>
        <%= f.input :send_reminders, as: :boolean, label: "Yes, send reminders",
              input_html: {data: {action: "click->checkbox-with-nested-element#toggleNestedElementVisibility",
                                  "checkbox-with-nested-element-target": "checkbox"}} %>

        <div class="hidden pl-5" data-checkbox-with-nested-element-target="nestedElement">
          <%= render "shared/essentials/callout", tone: :info, role: "note" do %>
            Reminders need a schedule and a deadline day. Fill in both below.
          <% end %>

          <div class="mt-4">
            <%= render "shared/deadline_day_fields", parent_form: f, parent_object: @partner_group %>
          </div>
        </div>
      </fieldset>

      <div class="mt-6 flex items-center gap-2 border-t border-slate-200 pt-5">
        <%= submit_button(submit_btn_options) %>
        <%= essentials_link_button "Cancel", partner_groups_path, variant: :ghost, size: :md %>
      </div>
    <% end %>
  <% end %>
</div>
