<% if @partner_groups.blank? %>
  <%= render "shared/essentials/empty_state", kind: :cold_start,
        title: "No partner groups yet",
        body: "Groups let you set requestable item categories and reminder schedules for several partners at once.",
        action: essentials_link_button("Add your first partner group", new_partner_group_path, variant: :primary, icon: "bi-plus-lg") %>
<% else %>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
    <table class="data-table">
      <caption>Partner groups, their members and reminder settings</caption>
      <thead>
        <tr>
          <th scope="col">Group name</th>
          <th scope="col">Members</th>
          <th scope="col">Requestable item categories</th>
          <th scope="col">Send reminders?</th>
          <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% @partner_groups.each do |pg| %>
          <tr>
            <td class="font-medium text-slate-900"><%= pg.name %></td>
            <td>
              <% if pg.partners.any? %>
                <ul class="space-y-0.5 text-sm text-slate-700">
                  <% pg.partners.each do |partner| %>
                    <li><%= partner.name %></li>
                  <% end %>
                </ul>
              <% else %>
                <span class="text-sm italic text-slate-500">No members</span>
              <% end %>
            </td>
            <td>
              <% if pg.item_categories.present? %>
                <ul class="space-y-0.5 text-sm text-slate-700">
                  <% pg.item_categories.each do |ic| %>
                    <li><%= ic.name %></li>
                  <% end %>
                </ul>
              <% else %>
                <%# "No items requestable" was red italic text alone; it is a pill with an
                    icon and the word now. %>
                <%= essentials_status_pill("No items requestable", tone: :danger, icon: "bi-exclamation-triangle") %>
              <% end %>
            </td>
            <td>
              <% if pg.send_reminders %>
                <%= essentials_status_pill("Yes", tone: :success, icon: "bi-bell") %>
                <% if pg.reminder_schedule.valid? %>
                  <p class="mt-1.5 text-xs text-slate-700">
                    Reminder emails are sent <strong class="font-semibold"><%= pg.reminder_schedule&.show_description %></strong>.
                  </p>
                  <p class="mt-0.5 text-xs text-slate-500">
                    Your next reminder date is <%= pg.reminder_schedule.next_occurrence&.strftime("%a %b %d %Y") %>.
                  </p>
                <% end %>
                <p class="mt-1 text-xs text-slate-700">
                  Deadlines are the <strong class="font-semibold"><%= pg.deadline_day.ordinalize %></strong> after the reminder.
                </p>
                <% if pg.deadline_day && pg.reminder_schedule.valid? %>
                  <p class="mt-0.5 text-xs text-slate-500">
                    The deadline on your next reminder email will be
                    <%= DeadlineService.new(deadline_day: pg.deadline_day, today: pg.reminder_schedule.next_occurrence).next_deadline&.strftime("%a %b %d %Y") %>.
                  </p>
                <% end %>
              <% else %>
                <%= essentials_status_pill("No", tone: :neutral, icon: "bi-bell-slash") %>
              <% end %>
            </td>
            <td class="text-right">
              <%# Delete appeared only on a group with no partners, so the column alternated between
                  two controls and one. Collapsed, and Delete stays in the menu disabled with the
                  reason -- which also answers "why can I not delete this one?", which the row
                  vanishing the button never did. %>
              <%= render "shared/essentials/row_actions", label: pg.name, items: [
                    {label: "Edit", path: edit_partner_group_path(pg), icon: "bi-pencil"},
                    (if pg.partners.none?
                       {label: "Delete", path: partner_group_path(pg), icon: "bi-trash",
                        method: :delete, tone: :danger, confirm: confirm_delete_msg(pg.name)}
                     else
                       {label: "Delete", path: partner_group_path(pg), icon: "bi-trash",
                        method: :delete, tone: :danger, disabled: true,
                        reason: "unavailable while partners still belong to this group"}
                     end)
                  ] %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
