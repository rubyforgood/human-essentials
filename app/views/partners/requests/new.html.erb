<% content_for :title, "New Request - #{current_partner ? current_user.display_name : @partner.name}" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "New request by quantity",
        subtitle: "Choose the items you need, and how many of each.",
        back: {path: partners_requests_path, label: "Back to requests"} %>

<%#
  The submit row sat outside the div holding the fields: a closing div appeared before the form
  block ended. The card partial owns the padding now, so there is one wrapper to balance.
%>
<div
     data-controller="confirmation"
     data-confirmation-pre-check-path-value="<%= validate_partners_requests_path(format: :json) %>">
  <% if @errors.present? %>
    <%= render partial: 'partners/requests/error' %>
  <% end %>

  <%= essentials_form_for @partner_request, url: partners_requests_path(@partner_request),
        html: {role: "form"}, method: :post, data: { controller: 'form-input', confirmation_target: "form" } do |form| %>
    <%= render "shared/essentials/card" do %>
              <%= form.input :comments, label: "Comments", as: :text, input_html: {rows: 3} %>
              <%= hidden_field_tag :partner_id, params[:partner_id] %>

              <table class="data-table">
                <thead>
                <tr>
                  <th>Item requested</th>
                  <th>Quantity</th>
                  <% if Flipper.enabled?(:enable_packs) && (current_partner ? current_partner.organization.request_units.any? : current_organization.request_units.any?) %>
                    <th>Units, if applicable</th>
                  <% end %>
                </tr>
                </thead>
                <tbody class='fields'>
                  <%= render partial: 'item_request', locals: { form: form, item_units: @item_units } %>
                </tbody>
              </table>
              <div>
                <%= add_element_button('Add another item', container_selector: '.fields') do %>
                  <%= render partial: 'item_request', locals: { form: form, item_units: @item_units }, object: @partner_request.item_requests.build %>
                <% end %>
              </div>

            <% end %>

    <%# TODO(chaserx): prevent submission when an item is blank or a quantity is empty. %>
    <%= essentials_form_actions do %>
      <%= form.button :button, "Submit essentials request",
            class: essentials_button_classes(variant: :primary, size: :md),
            data: {action: "click->confirmation#openModal"} %>
      <%= essentials_link_button "Cancel", (current_partner ? partners_requests_path : requests_path),
            variant: :ghost, size: :md %>
    <% end %>
  <% end %>

  <%# Confirmation modal: See confirmation_controller.js for how this gets displayed %>
  <%# and app/controllers/partners/requests_controller.rb#validate for how it gets populated. %>
  <dialog id="partnerRequestConfirmationModal"
    class="confirm w-full max-w-2xl rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/40"
    aria-labelledby="partnerRequestConfirmationTitle"
    data-confirmation-target="modal"></dialog>
</div>
</div>
