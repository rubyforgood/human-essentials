<p class="mt-1 text-sm text-slate-600">for <%= current_user.display_name %></p>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <!-- Default box -->
        <%= render 'request_options_card' if @partner.approved? %>
      </div>
    </div>
  </div>
</section>

<section class="container mx-auto my-8">
  <%= render partial: "/partners/requests/history" %>
</section>
