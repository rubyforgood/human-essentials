<% content_for :title, "Essentials Requests - #{current_user.display_name}" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Essentials requests",
        subtitle: "Requests you have made to your bank." %>
</div>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <%= render 'request_options_card' if @partner.approved? %>
      </div>
    </div>
  </div>
</section>

<section class="container mx-auto my-8">
  <%= render partial: "/partners/requests/history" %>
</section>
