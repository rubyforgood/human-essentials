<%
  options = []
  if current_partner.profile.enable_quantity_based_requests?
    options << {title: "Quantity", body: "Specify a quantity for each product.", path: new_partners_request_path, aria: "Create a request by quantity", icon: "bi-123"}
  end
  if current_partner.profile.enable_child_based_requests?
    options << {title: "Child", body: "Specify the family and child you are requesting for.", path: new_partners_family_request_path, aria: "Create a request for a child or family", icon: "bi-person-arms-up"}
  end
  if current_partner.profile.enable_individual_requests?
    options << {title: "Number of individuals", body: "Specify the number of individuals for each product.", path: new_partners_individuals_request_path, aria: "Create a request by number of individuals", icon: "bi-people"}
  end
%>
<% if options.any? %>
  <%= render "shared/essentials/card", title: "Make a request" do %>
    <div class="grid gap-4 <%= essentials_grid_columns(options.size) %>">
      <% options.each do |option| %>
        <article class="flex flex-col justify-between gap-4 rounded-xl border border-slate-200 p-4">
          <div class="flex gap-3">
            <%= essentials_icon_tile(option[:icon], tone: :brand) %>
            <div class="min-w-0">
              <h3 class="text-sm font-semibold text-slate-900"><%= option[:title] %></h3>
              <p class="mt-0.5 text-sm text-slate-600"><%= option[:body] %></p>
            </div>
          </div>
          <%= essentials_link_button "Create request", option[:path],
                variant: :primary, size: :md, icon: "bi-plus-lg",
                class: "w-full", "aria-label": option[:aria] %>
        </article>
      <% end %>
    </div>
  <% end %>
<% end %>
