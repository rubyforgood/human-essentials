<% content_for :title, "Request - #{current_partner.name}" %>

<%#
  The field labels were `text-2xl font-bold` and their values `text-lg`, so every label was
  larger than the thing it labelled. They are a description list now. `text-gray-400` was also
  the only use of the gray scale in the app, which is slate everywhere else.
%>
<div class="px-4 pt-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Request",
        subtitle: "Submitted #{@partner_request.created_at.localtime.strftime("%d %b %Y at %H:%M")}",
        back: {path: partners_requests_path, label: "Back to requests"} %>
</div>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <% if flash[:success] %>
    <%= render partial: "partners/requests/success" %>
  <% end %>

  <%= render "shared/essentials/card", title: "Request details" do %>
    <dl class="space-y-4">
      <div>
        <dt class="text-sm font-medium text-slate-600">Request ID</dt>
        <dd class="mt-0.5 text-sm text-slate-900"><%= @partner_request.id %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-slate-600">Comments</dt>
        <dd class="mt-0.5 text-sm text-slate-900"><%= optional_data_text(@partner_request.comments) %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-slate-600">Requested items</dt>
        <dd class="mt-0.5">
          <ul class="space-y-1 text-sm text-slate-900">
            <% @partner_request.item_requests.each do |item| %>
              <li>
                <%= item.name %> - <%= item.quantity %>
                <% if Flipper.enabled?(:enable_packs) && item.request_unit %>
                  <%= item.request_unit.pluralize(item.quantity.to_i) %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-slate-600">Submitted</dt>
        <dd class="mt-0.5 text-sm text-slate-900">
          <%= @partner_request.created_at.localtime.strftime("%F %T") %>
        </dd>
      </div>
    </dl>
  <% end %>
</div>
