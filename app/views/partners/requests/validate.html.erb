<%# Body injected into the confirmation <dialog> by confirmation_controller.js. %>
<div class="flex items-start justify-between gap-3 border-b border-slate-200 px-5 py-4">
  <%# All three partner request forms inject this body, so the id they name is defined here. %>
  <h2 id="partnerRequestConfirmationTitle" class="text-base font-semibold text-slate-900">Confirm this request</h2>
  <button id="modalClose" type="button"
          class="rounded-lg p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
          aria-label="Close dialog"
          onclick="this.closest('dialog').close()">
    <i class="bi-x-lg text-sm" aria-hidden="true"></i>
  </button>
</div>

<div class="max-h-[60vh] overflow-y-auto px-5 py-4">
  <% show_units = Flipper.enabled?(:enable_packs) && @partner_request.item_requests.any?(&:request_unit) %>
  <div class="overflow-hidden rounded-xl border border-slate-200">
    <table class="data-table">
      <caption>Items in this request</caption>
      <thead>
        <tr>
          <th scope="col">Item name</th>
          <th scope="col" class="quantity">Total items</th>
          <% if show_units %><th scope="col">Units</th><% end %>
        </tr>
      </thead>
      <tbody>
        <% @partner_request.item_requests.each do |line_item| %>
          <tr>
            <td class="font-medium text-slate-900"><%= line_item.name %></td>
            <td class="quantity"><%= number_with_delimiter(line_item.quantity) %></td>
            <% if show_units %>
              <td><%= line_item.request_unit&.pluralize(line_item.quantity.to_i) %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <p class="message mt-4 text-sm text-slate-600">
    Please confirm that the list above is what you meant to request.
  </p>

  <% if @quota_exceeded %>
    <%= render "shared/essentials/callout", tone: :warning, wrapper_class: "mt-4" do %>
      You are ordering <strong><%= number_with_delimiter(@total_items) %></strong> total items. Are you sure?
    <% end %>
  <% end %>
</div>

<div class="flex flex-wrap justify-end gap-2 border-t border-slate-200 px-5 py-3">
  <button id="modalNo" type="button" class="<%= essentials_button_classes(variant: :secondary, size: :md) %>"
          onclick="this.closest('dialog').close()">No, I need to make changes</button>
  <button id="modalYes" type="button" class="<%= essentials_button_classes(variant: :primary, size: :md) %>"
          data-action="confirmation#submitForm">Yes, it's correct</button>
</div>
