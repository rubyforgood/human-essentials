<% content_for :title, "Families - #{current_partner.name}" %>

<%#
  Fixed here: the children table's <tr> was never closed, ten `style="width: …%"` attributes on
  table headers (which summed to more than 100% in both tables), two action links crammed into
  an <h3> with a `margin-left:10px` inline style, and a bare <dl> with no styling.
%>
<div class="px-4 pt-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Family details",
        subtitle: "#{@family.guardian_first_name} #{@family.guardian_last_name}".strip.presence,
        back: {path: partners_families_path, label: "Back to families"},
        actions: capture {
          concat essentials_link_button("Add child", new_partners_child_path(family_id: @family.id),
                   variant: :secondary, icon: "bi-person-arms-up")
          concat essentials_link_button("Add authorized member",
                   new_partners_authorized_family_member_path(family_id: @family.id),
                   variant: :primary, icon: "bi-person-plus")
        } %>
</div>

<div class="space-y-6 px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/card", title: "Family information" do %>
    <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
      <% [
           ["Guardian first name", @family.guardian_first_name],
           ["Guardian last name", @family.guardian_last_name],
           ["Guardian zip code", @family.guardian_zip_code],
           ["Guardian county", @family.guardian_county],
           ["Guardian phone", @family.guardian_phone],
           ["Case manager", @family.case_manager],
           ["Adults in the home", @family.home_adult_count],
           ["Children aged 5 to 17 in the home", @family.home_child_count],
           ["Children under 5 in the home", @family.home_young_child_count],
           ["Sources of income", @family.sources_of_income.join(", ")],
           ["Guardian employed", @family.guardian_employed ? "Yes" : "No"],
           ["Guardian employment type", @family.guardian_employment_type],
           ["Guardian monthly pay", @family.guardian_monthly_pay],
           ["Guardian health insurance", @family.guardian_health_insurance],
           ["Military family", @family.military ? "Yes" : "No"],
           ["Comments", @family.comments]
         ].each do |label, value| %>
        <div>
          <dt class="text-sm font-medium text-slate-600"><%= label %></dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= optional_data_text(value) %></dd>
        </div>
      <% end %>
    </dl>
  <% end %>

  <%= render "shared/essentials/card", title: "Children", padded: false do %>
    <% if @family.children.any? %>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
        <table class="data-table">
          <caption>Children in this family</caption>
          <thead>
            <tr>
              <th scope="col">First name</th>
              <th scope="col">Last name</th>
              <th scope="col">Date of birth</th>
              <th scope="col">Gender</th>
              <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @family.children.each do |child| %>
              <tr>
                <td class="font-medium text-slate-900"><%= child.first_name %></td>
                <td><%= child.last_name %></td>
                <td class="date"><%= child.date_of_birth %></td>
                <td><%= child.gender %></td>
                <td class="text-right">
                  <div class="flex justify-end gap-1.5">
                    <%= essentials_link_button "View", partners_child_path(child),
                          variant: :ghost, size: :sm, icon: "bi-eye" %>
                    <%= essentials_link_button "Edit", edit_partners_child_path(child),
                          variant: :ghost, size: :sm, icon: "bi-pencil" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-5 py-4">
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "No children yet",
              body: "Add the children this family requests essentials for.",
              action: essentials_link_button("Add child", new_partners_child_path(family_id: @family.id),
                        variant: :primary, icon: "bi-person-arms-up") %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/essentials/card", title: "Authorized to collect", padded: false do %>
    <% if @family.authorized_family_members.any? %>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
        <table class="data-table">
          <caption>People other than the guardian who may collect essentials for this family</caption>
          <thead>
            <tr>
              <th scope="col">First name</th>
              <th scope="col">Last name</th>
              <th scope="col">Date of birth</th>
              <th scope="col" class="notes">Comments</th>
              <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @family.authorized_family_members.each do |member| %>
              <tr>
                <td class="font-medium text-slate-900"><%= member.first_name %></td>
                <td><%= member.last_name %></td>
                <td class="date"><%= member.date_of_birth %></td>
                <td class="notes"><%= member.comments %></td>
                <td class="text-right">
                  <div class="flex justify-end gap-1.5">
                    <%= essentials_link_button "View", partners_authorized_family_member_path(member),
                          variant: :ghost, size: :sm, icon: "bi-eye" %>
                    <%= essentials_link_button "Edit", edit_partners_authorized_family_member_path(member),
                          variant: :ghost, size: :sm, icon: "bi-pencil" %>
                    <%= essentials_action_button "Delete", partners_authorized_family_member_path(member),
                          method: :delete, variant: :ghost_danger, size: :sm, icon: "bi-trash",
                           confirm: "Are you sure?" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-5 py-4">
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "Nobody else authorized",
              body: "Only the guardian can collect essentials for this family.",
              action: essentials_link_button("Add authorized member",
                        new_partners_authorized_family_member_path(family_id: @family.id),
                        variant: :primary, icon: "bi-person-plus") %>
      </div>
    <% end %>
  <% end %>
</div>
