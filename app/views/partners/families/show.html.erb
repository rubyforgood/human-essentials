<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Families - #{current_partner.name}" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Family Details</h1>
<p class="mt-1 text-sm text-slate-600">for <%= current_partner.name %></p>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <div class="card mb-4">
          <h3 class="text-sm font-semibold text-slate-900">Family Information
            <%= link_to 'Add An Authorized Member To This Family', new_partners_authorized_family_member_path(family_id: @family.id), class: "inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600", style: "margin-left:10px;" %>
            <%= link_to 'Add Child To This Family', new_partners_child_path(family_id: @family.id), class: "inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" %></h3>
          <div class="px-5 py-4">
            <dl>
              <dt>Guardian First Name:</dt>
              <dd><%= @family.guardian_first_name %></dd>

              <dt>Guardian Last Name:</dt>
              <dd><%= @family.guardian_last_name %></dd>

              <dt>Guardian Zip Code:</dt>
              <dd><%= @family.guardian_zip_code %></dd>

              <dt>Guardian County:</dt>
              <dd><%= @family.guardian_county %></dd>

              <dt>Guardian Phone:</dt>
              <dd><%= @family.guardian_phone %></dd>

              <dt>Case Manager:</dt>
              <dd><%= @family.case_manager %></dd>

              <dt>Home Adult Count:</dt>
              <dd><%= @family.home_adult_count %></dd>

              <dt>Number of Children Aged 5-17 in the Home:</dt>
              <dd><%= @family.home_child_count %></dd>

              <dt>Number of Children Under Age 5 in the Home:</dt>
              <dd><%= @family.home_young_child_count %></dd>

              <dt>Sources of Income:</dt>
              <dd><%= @family.sources_of_income.join(', ') %></dd>

              <dt>Guardian Employed:</dt>
              <dd><%= @family.guardian_employed ? "Yes" : "No" %></dd>

              <dt>Guardian Employment Type:</dt>
              <dd><%= @family.guardian_employment_type %></dd>

              <dt>Guardian Monthly Pay:</dt>
              <dd><%= @family.guardian_monthly_pay %></dd>

              <dt>Guardian Health Insurance:</dt>
              <dd><%= @family.guardian_health_insurance %></dd>

              <dt>Military Family:</dt>
              <dd><%= @family.military ? "Yes" : "No" %></dd>

              <dt>Comments:</dt>
              <dd><%= @family.comments %></dd>
            </dl>
          </div>
          <div class="border-t border-slate-200 px-5 py-3">
            <%= link_to 'Edit This Family', edit_partners_family_path(@family), class: "inline-flex items-center justify-center gap-1.5 rounded-lg bg-brand-600 px-3.5 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" %>
            <%= link_to 'Back to Families', partners_families_path, class: "inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" %>
            <%= link_to 'Add Child To This Family', new_partners_child_path(family_id: @family.id), class: "inline-flex items-center justify-center gap-1.5 rounded-lg bg-brand-600 px-3.5 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <div class="card mb-4">
          <h3 class="text-sm font-semibold text-slate-900">Children Information</h3>
          <table class="data-table">
            <thead>
            <tr>
              <th style="width: 13.33%">First Name</th>
              <th style="width: 13.33%">Last Name</th>
              <th style="width: 13.33%">Date of Birth</th>
              <th style="width: 45%">Gender</th>
              <th style="width: 15%">Actions</th>
            </tr>
            </thead>
            <tbody>
            <% @family.children.each do |child| %>
              <tr>
                <td><%= child.first_name %></td>
                <td><%= child.last_name %></td>
                <td><%= child.date_of_birth %></td>
                <td><%= child.gender %></td>
                <td><%= link_to 'Edit', edit_partners_child_path(child), class: "inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" %></td>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <div class="card mb-4">
          <h3 class="text-sm font-semibold text-slate-900">Authorized Members for Pick Up</h3>
          <table class="data-table">
            <thead>
            <tr>
              <th style="width: 13.33%">First Name</th>
              <th style="width: 13.33%">Last Name</th>
              <th style="width: 13.33%">Date of Birth</th>
              <th style="width: 45%">Comments</th>
              <th style="width: 15%">Actions</th>
            </tr>
            </thead>
            <tbody>
            <% @family.authorized_family_members.each do |member| %>
              <tr>
                <td><%= member.first_name %></td>
                <td><%= member.last_name %></td>
                <td><%= member.date_of_birth %></td>
                <td><%= member.comments %></td>
                <td>
                  <%= link_to 'Edit', edit_partners_authorized_family_member_path(member), class: "inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" %>
                  <%= link_to 'View', partners_authorized_family_member_path(member), class: "inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" %>
                  <%= link_to 'Delete', partners_authorized_family_member_path(member), class: "inline-flex items-center justify-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium text-rose-700 transition-colors hover:bg-rose-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-600",
                       data: { confirm: "Are you sure?" }, method: :delete %>
                </td>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
