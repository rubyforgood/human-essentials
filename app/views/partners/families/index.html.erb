<% content_for :title, "Families - #{current_partner.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Families",
        subtitle: "The families you serve, and the children in each.",
        actions: capture {
          concat essentials_link_button("Export to CSV", partners_families_path(nil, format: :csv), variant: :secondary, icon: "bi-download")
          concat essentials_link_button("Add new family", new_partners_family_path, variant: :primary, icon: "bi-plus-lg")
        } %>

  <%= render "shared/essentials/card", title: "Filters" do %>
    <%= form_for_filterrific @filterrific, remote: true do |f| %>
      <div class="flex flex-wrap items-end gap-4">
        <div class="min-w-[14rem]">
          <%= f.label :search_guardian_names, "Search by guardian name", class: EssentialsUiHelper::FILTER_LABEL_CLASSES %>
          <%= f.text_field :search_guardian_names, class: "filterrific-periodically-observed #{EssentialsUiHelper::FILTER_CONTROL_CLASSES}" %>
        </div>
        <div class="min-w-[14rem]">
          <%= f.label :search_agency_guardians, "Search by case manager", class: EssentialsUiHelper::FILTER_LABEL_CLASSES %>
          <%= f.text_field :search_agency_guardians, class: "filterrific-periodically-observed #{EssentialsUiHelper::FILTER_CONTROL_CLASSES}" %>
        </div>
        <div class="flex items-center gap-2 pb-2">
          <%= f.check_box :include_archived, class: "filterrific-periodically-observed h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-2 focus:ring-brand-500/30" %>
          <%= f.label :include_archived, "Include archived", class: "text-sm text-slate-700" %>
        </div>
        <div class="pb-2"><%= render_filterrific_spinner %></div>
        <div class="pb-1">
          <%= render "partners/reset_search", filterrific: @filterrific %>
        </div>
      </div>
    <% end %>
  <% end %>

  <div class="mt-6">
    <%= render "shared/essentials/card", padded: false do %>
      <div id="filterrific_results">
        <%= render partial: "partners/families/list", locals: {families: @families} %>
      </div>
    <% end %>
  </div>
</div>
