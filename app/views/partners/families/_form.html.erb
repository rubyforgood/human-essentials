<%#
  Locals: family, submit_label.

  Rewritten from markup whose divs did not balance: the browser recovered by splitting it into
  two <form> elements, leaving the submit button outside the one holding the fields. It worked,
  by accident of the parser's error recovery rather than by design.

  Radio and checkbox groups are fieldsets with legends now. They were a label, a <br> and a run
  of &nbsp; entities, which announces the question once and then nothing that connects the
  options to it.
%>
<div class="max-w-2xl px-4 py-6 sm:px-6 lg:px-8">
  <%= essentials_error_summary(family) %>

  <%= render "shared/essentials/card" do %>
    <%= essentials_form_for family, html: {role: "form"} do |f| %>
      <%= f.input :guardian_first_name, label: "Guardian first name" %>
      <%= f.input :guardian_last_name, label: "Guardian last name" %>
      <%= f.input :guardian_zip_code, label: "Guardian zip code" %>
      <%= f.input :guardian_county, label: "Guardian county" %>
      <%= f.input :guardian_phone, label: "Guardian phone" %>
      <%= f.input :case_manager, label: "Case manager",
            hint: "The person at your agency assigned to this family." %>

      <%= f.input :home_adult_count, label: "Adults living in the home" %>
      <%= f.input :home_child_count, label: "Children aged 5 to 17 living in the home" %>
      <%= f.input :home_young_child_count, label: "Children under 5 living in the home" %>

      <fieldset class="mb-4">
        <legend class="block text-sm font-medium text-slate-700">Sources of income</legend>
        <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
          <% Partners::Family::INCOME_TYPES.each do |value| %>
            <div class="flex items-center gap-2">
              <%= f.check_box :sources_of_income, {multiple: true, id: "sources_of_income_#{value.parameterize}",
                    class: "size-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"}, value, nil %>
              <%= f.label "sources_of_income_#{value.parameterize}", value, class: "text-sm text-slate-700" %>
            </div>
          <% end %>
        </div>
      </fieldset>

      <%= f.input :guardian_employed, as: :radio_buttons, label: "Is the parent or guardian employed?",
            collection: [["Yes", "Yes"], ["No", "No"]] %>
      <%= f.input :guardian_employment_type, as: :radio_buttons, label: "Full-time or part-time?",
            collection: [["Full-Time", "Full-Time"], ["Part-Time", "Part-Time"], ["N/A", "N/A"]] %>
      <%= f.input :guardian_monthly_pay, label: "Guardian's monthly income" %>
      <%= f.input :guardian_health_insurance, as: :radio_buttons, label: "Guardian's health insurance",
            collection: [["Private Insurance", "Private Insurance"], ["Medicaid", "Medicaid"],
                         ["Uninsured", "Uninsured"]] %>
      <%= f.input :military, as: :radio_buttons, label: "Military family",
            collection: [["Yes", true], ["No", false]] %>

      <%= f.input :comments, label: "Comments", as: :text, input_html: {rows: 3} %>
      <%= f.input :archived, as: :boolean, label: "Archived" %>

      <div class="mt-6 flex items-center gap-2 border-t border-slate-200 pt-5">
        <%= f.button :button, submit_label,
              class: essentials_button_classes(variant: :primary, size: :md),
              data: {disable_with: "Saving..."} %>
        <%= essentials_link_button "Cancel", partners_families_path, variant: :ghost, size: :md %>
      </div>
    <% end %>
  <% end %>
</div>
