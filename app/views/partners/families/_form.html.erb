<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <!-- left column -->
      <div class="min-w-0">
        <!-- jquery validation -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

          <!-- form start -->
          <div class="px-5 py-4">
            <%= essentials_form_for family, html: {role: 'form', class: 'form-horizontal'} do |f| %>
              <%= f.input :guardian_first_name, label: "Guardian First Name", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>

              <%= f.input :guardian_last_name, label: "Guardian Last Name", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>

              <%= f.input :guardian_zip_code, label: "Guardian Zip Code", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>

              <%= f.label :guardian_county, "Guardian County" %>
              <%# <i class="bi-question-circle" style="color:blue" title="Hooray!"></i> %>
              <%= f.text_field :guardian_county, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>

              <%= f.label :guardian_phone, "Guardian Phone" %>
              <%# <i class="bi-question-circle" style="color:blue" title="Hooray!"></i> %>
              <%= f.text_field :guardian_phone, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>

              <%= f.label :case_manager, "Case Manager" %>
              <i class="bi-question-circle" style="color:blue" title="Person at the agency who is assigned to this family."></i>
              <%= f.text_field :case_manager, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>

              <%= f.label :home_adult_count, "Number of Adults Living In The Home" %>
              <%= f.number_field :home_adult_count, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>

              <%= f.label :home_child_count, 'How Many Children (5-17) Live In The Home?' %>
              <%= f.number_field :home_child_count, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>

              <%= f.label :home_young_child_count, 'How Many Children (under 5) Live In The Home?' %>
              <%= f.number_field :home_young_child_count, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>

              <%= f.label :sources_of_income, "Sources of Income" %>
              <br>
              <% Partners::Family::INCOME_TYPES.each do |a_value| %>
                   &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<%= f.check_box(:sources_of_income, {multiple: true}, a_value, nil) %>
                <%= f.label "#{a_value}", "#{a_value}" %>
              <% end %>
              <br>

              <%= f.label :guardian_employed, "Is The Parent/Guardian Employed?" %>
              <br>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<%= f.radio_button :guardian_employed, 'Yes' %>
              <%= label :guardian_employed, 'Yes' %>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
              <%= f.radio_button :guardian_employed, 'No' %>
              <%= label :guardian_employed, 'No' %>
              <br>

              <%= f.label :guardian_employment_type, "Guardian Employed Full-Time or Part-Time" %>
              <br>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<%= f.radio_button :guardian_employment_type, 'Full-Time' %>
              <%= label :guardian_employment_type, 'Full-Time' %>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
              <%= f.radio_button :guardian_employment_type, 'Part-Time' %>
              <%= label :guardian_employment_type, 'Part-Time' %>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
              <%= f.radio_button :guardian_employment_type, 'N/A' %>
              <%= label :guardian_employment_type, 'N/A', 'N/A' %>
              <br>

              <%= f.label :guardian_monthly_pay, "Guardian's Monthly Income" %>
              <%# <i class="bi-question-circle" style="color:blue" title="Hooray!"></i> %>
              <%= f.text_field :guardian_monthly_pay, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>

              <%= f.label :guardian_health_insurance, "Guardian's Health Insurance Status" %>
              <br>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<%= f.radio_button :guardian_health_insurance, 'Private Insurance' %>
              <%= label :guardian_health_insurance, 'Private Insurance' %>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
              <%= f.radio_button :guardian_health_insurance, 'Medicaid' %>
              <%= label :guardian_health_insurance, 'Medicaid' %>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
              <%= f.radio_button :guardian_health_insurance, 'Uninsured' %>
              <%= label :guardian_health_insurance, 'Uninsured' %>
              <br>

              <%= f.label :military, "Military Family" %>
              <br>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<%= f.radio_button :military, true %> <strong>Yes</strong>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<%= f.radio_button :military, false %> <strong>No</strong>
              <br>
              <%= f.label :comments %>
              <%= f.text_area :comments, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
              <%= f.label :archived %>
              <%= f.check_box :archived %>
              </div>

              <div class="border-t border-slate-200 px-5 py-3">
                <%= f.submit(class: 'inline-flex items-center justify-center gap-1.5 rounded-lg bg-brand-600 px-3.5 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600') %>
              </div>
            <% end %>
            </div>

      </div>

    </div>

  </div>
</section>
