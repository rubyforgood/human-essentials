<% content_for :title, "Families - #{current_partner.name}" %>

<div class="px-4 pt-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "New request for a child",
        subtitle: "Pick the children you are requesting for.",
        back: {path: partners_requests_path, label: "Back to requests"} %>
</div>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <% if @errors.present? %>
    <%= render partial: "partners/requests/error" %>
  <% end %>

  <%# The filter block used the shared filter bar's shape by hand, and closed a div in the
      middle of the form so the reset link sat outside it. %>
  <%= form_for_filterrific @filterrific do |f| %>
    <div class="mb-4 flex flex-wrap items-end gap-3">
      <div class="min-w-[15rem]">
        <%= f.label :search_families, "Search by guardian name",
              class: EssentialsUiHelper::FILTER_LABEL_CLASSES %>
        <%= f.text_field :search_families,
              class: "filterrific-periodically-observed #{EssentialsUiHelper::FILTER_CONTROL_CLASSES}" %>
      </div>
      <div class="min-w-[15rem]">
        <%= f.label :search_names, "Search by child name",
              class: EssentialsUiHelper::FILTER_LABEL_CLASSES %>
        <%= f.text_field :search_names,
              class: "filterrific-periodically-observed #{EssentialsUiHelper::FILTER_CONTROL_CLASSES}" %>
      </div>
      <div class="flex items-center gap-2 pb-2">
        <%= f.check_box :search_active,
              class: "filterrific-periodically-observed size-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500" %>
        <%= f.label :search_active, "Active children only", class: "text-sm text-slate-700" %>
      </div>
      <div class="flex items-center gap-2 pb-1">
        <%= essentials_link_button "Reset search", reset_filterrific_url, variant: :ghost, size: :md %>
        <%= render_filterrific_spinner %>
      </div>
    </div>
  <% end %>

  <div data-controller="confirmation"
       data-confirmation-pre-check-path-value="<%= validate_partners_family_requests_path(format: :json) %>">
    <%= render "shared/essentials/card", padded: false do %>
      <%= form_with(url: partners_family_requests_path, method: "post", data: {confirmation_target: "form"}) do |f| %>
        <div id="filterrific_results">
          <%= render partial: "partners/family_requests/list", locals: {children: @children} %>
        </div>

        <div class="flex items-center gap-2 border-t border-slate-200 px-5 py-4">
          <%= submit_tag "Submit essentials request",
                class: essentials_button_classes(variant: :primary, size: :md),
                data: {action: "click->confirmation#openModal"} %>
          <%= essentials_link_button "Cancel", partners_requests_path, variant: :ghost, size: :md %>
        </div>
      <% end %>
    <% end %>

    <%# Confirmation modal: see confirmation_controller.js for how it is shown, and
        Partners::FamilyRequestsController#validate for how it is populated. %>
    <dialog id="partnerFamilyRequestConfirmationModal"
            class="confirm w-full max-w-2xl rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/40"
            aria-labelledby="partnerRequestConfirmationTitle"
            data-confirmation-target="modal"></dialog>
  </div>
</div>
