<table class="data-table">
  <thead>
  <tr>
    <th>Guardian</th>
    <th>Child</th>
    <th>Item Needed</th>
    <th>Include This Child?</th>
  </tr>
  </thead>
  <tbody class='fields'>
  <% @children.each_with_index do |child, index| %>
    <tr>
      <td>
        <%= child.family.guardian_first_name %>
        <%= child.family.guardian_last_name %>
      </td>
      <td>
        <%= child.first_name %> <%= child.last_name %>
      </td>
      <td>
        <% if child.requested_item_ids.any? %>
          <%= display_requested_items(current_partner, child) %>
        <% else %>
          <%= "N/A" %>
        <% end %>
      </td>
      <td>
        <div class="flex items-center gap-2">
          <% if child.requested_item_ids.any? %>
            <%= check_box_tag "child-#{child.id}", child.active, child.active,
                              class: "size-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500",
                              id: "child-#{child.id}" %>
                            <label class="text-sm text-slate-700" for="child-<%= child.id %>">
                              <span class="sr-only">Include This Child?</span>
                            </label>
          <% end %>
        </div>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
