<% if @children.blank? %>
  <%= render "shared/essentials/empty_state", kind: :no_results,
        title: "No children match those filters",
        body: "Reset the search to see everyone." %>
<% else %>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
    <table class="data-table">
      <caption>Children your agency serves</caption>
      <thead>
        <tr>
          <th scope="col"><%= sortable "last_name", "Last name" %></th>
          <th scope="col"><%= sortable "first_name", "First name" %></th>
          <th scope="col" class="date"><%= sortable "date_of_birth", "Date of birth" %></th>
          <th scope="col"><%= sortable "active", "Active" %></th>
          <th scope="col">Guardian</th>
          <th scope="col" class="notes">Comments</th>
          <th scope="col" class="cell-actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @children.each do |child| %>
          <tr>
            <td class="font-medium text-slate-900"><%= child.last_name %></td>
            <td><%= child.first_name %></td>
            <td class="date"><%= child.date_of_birth %></td>
            <td>
              <% if child.active %>
                <%= essentials_status_pill("Active", tone: :success, icon: "bi-check-circle") %>
              <% else %>
                <%= essentials_status_pill("Inactive", tone: :neutral, icon: "bi-slash-circle") %>
              <% end %>
            </td>
            <td><%= child.family.guardian_display_name %></td>
            <td class="notes text-slate-600"><%= child.comments %></td>
            <td class="cell-actions">
              <div class="flex justify-end gap-1.5">
                <%= essentials_row_icon_link "View", child, icon: "bi-eye" %>
                <%= essentials_row_icon_link "Edit", edit_partners_child_path(child), icon: "bi-pencil" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
