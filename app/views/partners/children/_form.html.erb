<%#
  Locals: child, submit_label.

  Fields go through `f.input` so the :essentials wrapper owns labels, spacing and errors. The
  old version mixed raw `f.label` + `f.text_field` with `f.input`, laid checkboxes out with
  `&nbsp;` runs and `<br>`, and opened with a stray intersect? expression that printed "true"
  onto the page.
%>
<div class="max-w-2xl px-4 py-6 sm:px-6 lg:px-8">
  <%= essentials_error_summary(child) %>

  <%= render "shared/essentials/card" do %>
    <%= essentials_form_for child, html: {role: "form"} do |f| %>
      <%= f.input :first_name, label: "First name" %>
      <%= f.input :last_name, label: "Last name" %>

      <div class="requestable-items-container mb-4">
        <%= f.label :requested_item_ids, "Items requested",
              class: "block text-sm font-medium text-slate-700" %>
        <%= f.select :requested_item_ids, @requestable_items, {include_hidden: true},
              multiple: true,
              class: "custom-select mt-1.5 #{EssentialsUiHelper::FILTER_CONTROL_CLASSES}",
              data: {controller: "select2", "select2-config-value": "{}"} %>
      </div>

      <%= f.input :date_of_birth, as: :date, start_year: 20.years.ago.year,
            end_year: Time.current.year, label: "Date of birth" %>
      <%= f.input :gender, collection: ["Male", "Female"], label: "Gender" %>

      <%# A checkbox group is a fieldset with a legend, so the question is announced once and
          each box is announced against it. It was a label, a <br> and a run of &nbsp;. %>
      <fieldset class="mb-4">
        <legend class="block text-sm font-medium text-slate-700">Child lives with</legend>
        <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
          <% Partners::Child::CAN_LIVE_WITH.each do |value| %>
            <div class="flex items-center gap-2">
              <%= f.check_box :child_lives_with, {multiple: true, id: "child_lives_with_#{value.parameterize}",
                    class: "size-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"}, value, nil %>
              <%= f.label "child_lives_with_#{value.parameterize}", value, class: "text-sm text-slate-700" %>
            </div>
          <% end %>
        </div>
      </fieldset>

      <%= f.input :race, label: "Race", include_blank: true,
            collection: ["African American", "Caucasian", "Hispanic", "Asian", "American Indian",
                         "Pacific Islander", "Multi-racial", "Other"] %>
      <%= f.input :agency_child_id, label: "Agency child ID" %>
      <%= f.input :health_insurance, as: :radio_buttons, label: "Health insurance",
            collection: ["Private Insurance", "Medicaid", "Uninsured"] %>
      <%= f.input :comments, label: "Comments", as: :text, input_html: {rows: 3} %>

      <%= hidden_field_tag :family_id, child.family.id %>

      <%= f.input :active, as: :boolean, label: "Active" %>
      <%= f.input :archived, as: :boolean, label: "Archived" %>

      <div class="mt-6 flex items-center gap-2 border-t border-slate-200 pt-5">
        <%= f.button :button, submit_label,
              class: essentials_button_classes(variant: :primary, size: :md),
              data: {disable_with: "Saving..."} %>
        <%= essentials_link_button "Cancel", partners_children_path, variant: :ghost, size: :md %>
      </div>
    <% end %>
  <% end %>
</div>
