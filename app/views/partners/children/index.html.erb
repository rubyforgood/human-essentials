<% content_for :title, "Children - #{current_partner.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Children",
        subtitle: "Children your agency serves.",
        actions: essentials_link_button("Export to CSV", partners_children_path(nil, format: :csv), variant: :secondary, icon: "bi-download") %>

  <%= render "shared/essentials/card", title: "Filters" do %>
    <%= form_for_filterrific @filterrific, remote: true do |f| %>
      <div class="flex flex-wrap items-end gap-4">
        <div class="min-w-[14rem]">
          <%= f.label :search_names, "Search by child name", class: EssentialsUiHelper::FILTER_LABEL_CLASSES %>
          <%= f.text_field :search_names, class: "filterrific-periodically-observed #{EssentialsUiHelper::FILTER_CONTROL_CLASSES}" %>
        </div>
        <div class="min-w-[14rem]">
          <%= f.label :search_families, "Search by guardian name", class: EssentialsUiHelper::FILTER_LABEL_CLASSES %>
          <%= f.text_field :search_families, class: "filterrific-periodically-observed #{EssentialsUiHelper::FILTER_CONTROL_CLASSES}" %>
        </div>
        <div class="flex items-center gap-2 pb-2">
          <%= f.check_box :search_active, class: "filterrific-periodically-observed h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-2 focus:ring-brand-500/30" %>
          <%= f.label :search_active, "Show active only", class: "text-sm text-slate-700" %>
        </div>
        <div class="pb-2"><%= render_filterrific_spinner %></div>
        <div class="pb-1">
          <%= link_to "Reset search", reset_filterrific_url, class: essentials_button_classes(variant: :ghost, size: :md) %>
        </div>
      </div>
    <% end %>
  <% end %>

  <div class="mt-6">
    <%= render "shared/essentials/card", padded: false do %>
      <div id="filterrific_results">
        <%= render partial: "partners/children/list", locals: {children: @children} %>
      </div>
    <% end %>
  </div>
</div>
