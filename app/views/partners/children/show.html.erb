<% content_for :title, "Children - #{current_partner.name}" %>

<%#
  Fixed here: five `<td>` elements closed with `</th>`, which the browser silently repairs into
  a different tree; a bare `<dl>` with no styling, so the labels and values ran together; and an
  `<h3>` sitting outside the padded div it titled.
%>
<div class="px-4 pt-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Child details",
        subtitle: "#{@child.first_name} #{@child.last_name}".strip.presence || "Child",
        back: {path: partners_children_path, label: "Back to children"},
        actions: capture {
          concat essentials_link_button("Edit child", edit_partners_child_path(@child),
                   variant: :primary, icon: "bi-pencil")
        } %>
</div>

<div class="space-y-6 px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/card", title: "Child information" do %>
    <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
      <% [
           ["First name", @child.first_name],
           ["Last name", @child.last_name],
           ["Date of birth", @child.date_of_birth],
           ["Gender", @child.gender],
           ["Child lives with", @child.child_lives_with.join(", ")],
           ["Race", @child.race],
           ["Agency child ID", @child.agency_child_id],
           ["Health insurance", @child.health_insurance],
           ["Items needed", display_requested_items(current_partner, @child)],
           ["Comments", @child.comments]
         ].each do |label, value| %>
        <div>
          <dt class="text-sm font-medium text-slate-600"><%= label %></dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= optional_data_text(value) %></dd>
        </div>
      <% end %>
    </dl>
  <% end %>

  <%= render "shared/essentials/card", title: "Requested items", padded: false do %>
    <% if @child.child_item_requests.count > 0 %>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Request date</th>
              <th scope="col">Item ordered</th>
              <th scope="col">Item picked up</th>
              <th scope="col" class="quantity">Quantity ordered</th>
              <th scope="col" class="quantity">Quantity picked up</th>
            </tr>
          </thead>
          <tbody>
            <% @child_item_requests.each do |child_item_request| %>
              <tr>
                <td class="date"><%= child_item_request.created_at.to_date.iso8601 %></td>
                <td><%= fetch_valid_item_name(child_item_request.ordered_item_diaperid) %></td>
                <td>
                  <% if (diaperid = child_item_request.picked_up_item_diaperid) && child_item_request.picked_up? %>
                    <%= fetch_valid_item_name(diaperid) %>
                  <% elsif !child_item_request.picked_up? %>
                    <span class="text-slate-500">Not picked up</span>
                  <% else %>
                    Ordered item
                  <% end %>
                </td>
                <td class="quantity"><%= child_item_request.quantity %></td>
                <td class="quantity">
                  <% if child_item_request.picked_up? %>
                    <%= child_item_request.quantity_picked_up || child_item_request.quantity %>
                  <% else %>
                    <span class="text-slate-500">Not picked up</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-5 py-4">
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "No requests yet",
              body: "Requests made for this child will appear here." %>
      </div>
    <% end %>
  <% end %>
</div>
