<dl class="space-y-3">
  <div>
    <dt class="text-xs font-medium text-slate-500">Email</dt>
    <dd class="mt-0.5 text-sm text-slate-900"><%= @partner.email %></dd>
  </div>
  <div>
    <dt class="text-xs font-medium text-slate-500">Default storage location</dt>
    <dd class="mt-0.5 text-sm text-slate-900"><%= @partner.default_storage_location&.name || "None" %></dd>
  </div>
  <div>
    <dt class="text-xs font-medium text-slate-500">Partner group</dt>
    <dd class="mt-0.5 text-sm text-slate-900"><%= @partner.partner_group&.name || "None" %></dd>
  </div>
  <div>
    <dt class="text-xs font-medium text-slate-500">Receives emails for distributions and reminders</dt>
    <dd class="mt-0.5 text-sm text-slate-900"><%= @partner.send_reminders ? "Yes" : "No" %></dd>
  </div>
  <div>
    <dt class="text-xs font-medium text-slate-500">Notes</dt>
    <dd class="mt-0.5 text-sm text-slate-900"><%= @partner.notes.presence || "—" %></dd>
  </div>
  <div>
    <dt class="text-xs font-medium text-slate-500">Documents</dt>
    <dd class="mt-0.5 text-sm text-slate-900">
      <% if @partner.documents.present? %>
        <ul class="space-y-0.5">
          <% @partner.documents.each do |doc| %>
            <li><%= link_to doc.blob.filename.to_s, rails_blob_path(doc), class: "text-brand-700 hover:text-brand-800" %></li>
          <% end %>
        </ul>
      <% else %>
        None
      <% end %>
    </dd>
  </div>
  <div>
    <dt class="text-xs font-medium text-slate-500">Requestable item categories</dt>
    <dd class="mt-1 text-sm text-slate-900">
      <% if @partner.item_categories.present? %>
        <ul class="ml-4 list-disc space-y-0.5">
          <% @partner.item_categories.each do |ic| %>
            <li><%= ic.name %></li>
          <% end %>
        </ul>
      <% elsif @partner.partner_group.present? %>
        <%= essentials_status_pill("No items requestable", tone: :danger, icon: "bi-exclamation-triangle") %>
      <% else %>
        <%= essentials_status_pill("All items requestable", tone: :info, icon: "bi-check-circle") %>
      <% end %>
    </dd>
  </div>
</dl>
