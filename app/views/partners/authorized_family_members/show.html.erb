<% content_for :title, "Authorized family member - #{current_partner.name}" %>

<div class="px-4 pt-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Authorized family member",
        subtitle: "#{@authorized_family_member.first_name} #{@authorized_family_member.last_name}".strip.presence,
        back: {path: partners_family_path(@authorized_family_member.family), label: "Back to family"},
        actions: capture {
          concat essentials_link_button("Edit", edit_partners_authorized_family_member_path(@authorized_family_member),
                   variant: :primary, icon: "bi-pencil")
        } %>
</div>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/card", title: "Member information" do %>
    <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
      <% [
           ["First name", @authorized_family_member.first_name],
           ["Last name", @authorized_family_member.last_name],
           ["Date of birth", @authorized_family_member.date_of_birth],
           ["Gender", @authorized_family_member.gender],
           ["Comments", @authorized_family_member.comments]
         ].each do |label, value| %>
        <div>
          <dt class="text-sm font-medium text-slate-600"><%= label %></dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= optional_data_text(value) %></dd>
        </div>
      <% end %>
    </dl>
  <% end %>
</div>
