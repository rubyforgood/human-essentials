<div class="max-w-2xl">
  <%= essentials_error_summary(form) %>

  <%= render "shared/essentials/card" do %>
    <%= essentials_form_for form, data: {controller: "checkbox-with-nested-element"} do |f| %>
      <%= f.input :name, label: "Name" %>
      <%= f.input :email, label: "Email" %>
      <%= f.input :default_storage_location_id, label: "Default storage location",
            collection: current_organization.storage_locations.active.alphabetized,
            label_method: :name, value_method: :id, include_blank: true %>
      <%= f.input :partner_group_id, label: "Group", collection: @partner_groups, include_blank: "None" %>

      <div>
        <%= f.input :send_reminders, as: :boolean,
              label: "Do you want this partner to receive emails for distributions and reminders from the system?",
              input_html: {
                id: "send_reminders",
                data: {
                  action: "click->checkbox-with-nested-element#toggleNestedElementVisibility",
                  "checkbox-with-nested-element-target": "checkbox"
                }
              } %>
        <%= render "shared/essentials/callout", tone: :info, role: nil, wrapper_class: "mb-4 hidden",
              data: {checkbox_with_nested_element_target: "nestedElement"} do %>
          <p class="font-semibold">Reminder</p>
          <p class="mt-1">
          Reminders are sent according to the settings of the partner's group or of your
          organization. This won't work unless you have set up at least one.
          </p>

        <% end %>
      </div>

      <%= f.input :quota, label: "Quota" %>
      <%= f.input :notes, label: "Notes", as: :text, input_html: {rows: 3} %>
      <%= f.input :info_for_partner, label: "Partner specific information", as: :text,
            hint: "The partner can see, but cannot change, this information. 500 characters maximum.",
            input_html: {rows: 3, maxlength: 500, "aria-describedby": "info-for-partner-note"} %>

      <div class="mb-4">
        <%# A real <label for>, not a <span>: the file input below is the control it names. %>
        <%= label_tag "partner_documents", "Documents", class: "block text-sm font-medium text-slate-700" %>
        <% if @partner.documents.present? %>
          <ul class="mt-2 space-y-2">
            <% @partner.documents.select(&:persisted?).each do |doc| %>
              <li class="attached-document flex items-center justify-between gap-3 rounded-xl border border-slate-200 p-3"
                  data-document-id="<%= doc.signed_id %>">
                <%= link_to doc.blob.filename.to_s, rails_blob_path(doc),
                      class: "min-w-0 flex-1 truncate font-medium text-brand-700 hover:text-brand-800" %>
                <%= f.hidden_field :documents, multiple: true, value: doc.signed_id %>
                <%= f.button :button, formmethod: :delete, formaction: attachment_path(doc),
                      class: essentials_button_classes(variant: :ghost, size: :sm, extra: "text-rose-700 hover:bg-rose-50"),
                      data: {disable_with: "Please wait..."} do %>
                  <i class="bi-trash" aria-hidden="true"></i>Remove
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
        <%= f.input_field :documents, as: :file, multiple: true,
              id: "partner_documents",
              accept: Partner::ALLOWED_MIME_TYPES.join(","),
              class: "mt-2 block w-full text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-brand-700 hover:file:bg-brand-100" %>
      </div>

      <div class="mt-6 flex items-center gap-2 border-t border-slate-200 pt-5">
        <%= f.button :button, (submit_btn_options[:text] || "Save"),
              class: essentials_button_classes(variant: :primary, size: :md), data: {disable_with: "Saving..."} %>
        <%= essentials_link_button "Cancel", partners_path, variant: :ghost, size: :md %>
      </div>
    <% end %>
  <% end %>
</div>
