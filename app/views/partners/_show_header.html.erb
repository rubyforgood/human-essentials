<%# Impact metrics. Each figure is an icon tile plus a number and a label -- the tile marks
    a stat, which is what these are. %>
<%
  metrics = [
    {icon: "bi-people", tone: :brand, value: total_on_hand(impact_metrics[:families_served] || 0), label: "Families served"},
    {icon: "bi-person-arms-up", tone: :info, value: total_on_hand(impact_metrics[:children_served] || 0), label: "Children served"},
    {icon: "bi-geo-alt", tone: :success, value: total_on_hand(impact_metrics[:family_zipcodes] || 0), label: "Zipcodes served"}
  ]
  metrics << {icon: "bi-speedometer", tone: :warning, value: number_with_delimiter(partner.quota), label: "Monthly limit"} if partner.quota.present?
%>
<div class="grid gap-4 <%= essentials_grid_columns(metrics.size) %>">
  <% metrics.each do |metric| %>
    <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <%= essentials_icon_tile(metric[:icon], tone: metric[:tone]) %>
      <div class="min-w-0">
        <p class="text-2xl font-bold tracking-tight text-slate-900"><%= metric[:value] %></p>
        <p class="text-sm text-slate-600"><%= metric[:label] %></p>
      </div>
    </div>
  <% end %>
</div>

<% if impact_metrics[:family_zipcodes_list].present? %>
  <div class="mt-3">
    <button type="button" class="<%= essentials_button_classes(variant: :secondary, size: :sm) %>"
            data-action="click->dialog#open" data-dialog-id-param="see-zipcodes">
      <i class="bi-geo-alt" aria-hidden="true"></i>See zipcodes
    </button>
  </div>

  <%= render "shared/essentials/modal", id: "see-zipcodes", title: "Serviced zipcodes" do %>
    <ul class="grid grid-cols-3 gap-1 text-sm text-slate-700 sm:grid-cols-4">
      <% impact_metrics[:family_zipcodes_list].each do |zipcode| %>
        <li class="tabular-nums"><%= zipcode %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>
