<% content_for :title, "Partner Agencies - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Partner agencies",
        subtitle: "Organizations that receive essentials from #{current_organization.name}.",
        actions: capture {
          concat(button_tag(type: "button", class: essentials_button_classes(variant: :secondary), data: {action: "click->dialog#open", dialog_id_param: "csv-import-modal"}) do
            concat tag.i(nil, class: "bi-upload", aria: {hidden: true})
            concat " Import partners"
          end)
          if @partners.any?
            concat essentials_link_button("Export", partners_path(format: :csv, filters: filter_params), variant: :secondary, icon: "bi-download")
          end
          concat essentials_link_button("New partner agency", new_partner_path, variant: :primary, icon: "bi-plus-lg")
        } %>

  <%= render "shared/essentials/filter_bar", url: partners_path, auto_submit: true, clear: false do %>
    <div class="min-w-[15rem]">
      <%= filter_grouped_select(label: "Status", scope: :by_status,
            blank: @partner_status_default,
            ungrouped: @partner_status_all,
            groups: {"By status" => @partner_status_options},
            selected: params.dig(:filters, :by_status)) %>
    </div>
  <% end %>

  <%= render "shared/essentials/card", padded: false do %>
    <div data-controller="tabs">
      <%= render "shared/essentials/tabs", tabs: [
            {id: "partners", label: "Partners"},
            {id: "partner-groups", label: "Groups"}
          ] %>
      <%= render partial: "partners_table", locals: {partners: @partners} %>
      <%= render partial: "partner_groups_table" %>
    </div>
  <% end %>

  <%= render layout: "shared/essentials/csv_import_modal", locals: {
        import_type: "Partners", csv_template_url: "/partners_template.csv", csv_import_url: import_csv_partners_path
      } do %>
    <li>Open the CSV file in Excel or your favourite spreadsheet program.</li>
    <li>Delete the sample data and enter your partner agency names and addresses in the matching columns.</li>
    <li>Save the file as a CSV.</li>
  <% end %>
</div>
