<%# locals: (partner:) %>
<div class="flex flex-wrap items-center gap-2">
  <% if partner.approved? %>
    <%= essentials_status_pill("Approved", tone: :success, icon: "bi-check-circle") %>
  <% elsif partner.awaiting_review? %>
    <%= essentials_status_pill("Pending approval", tone: :warning, icon: "bi-hourglass-split") %>
  <% else %>
    <%# The AdminLTE version rendered the approved/pending states as disabled buttons, which
        look like controls you could press. They are statuses, so they are pills. %>
    <%= essentials_action_button "Submit for approval", partners_approval_request_path, method: :post,
          variant: :primary, icon: "bi-send" %>
  <% end %>

  <%= essentials_link_button "Update information", edit_partners_profile_path, variant: :secondary, icon: "bi-pencil" %>
</div>
