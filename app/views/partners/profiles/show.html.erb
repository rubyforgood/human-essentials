<% content_for :title, "My Organization - #{current_partner.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <% if current_partner.status == "recertification_required" %>
    <%= render "shared/essentials/callout", tone: :danger, icon: "bi-exclamation-triangle text-rose-600", wrapper_class: "mb-6" do %>
      Review your application details and submit them for approval.
    <% end %>
  <% end %>

  <%= render "shared/essentials/page_header",
        title: "Profile",
        subtitle: current_partner.name,
        actions: essentials_partner_status_pill(current_partner.status) %>

  <div class="mb-6"><%= render "actions", partner: current_partner %></div>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render partial: "partners/profiles/show/agency_information", locals: {profile: @profile} %>
    <% current_partner.partials_to_show.each do |partial| %>
      <%= render partial: "partners/profiles/show/#{partial}", locals: {profile: @profile} %>
    <% end %>
    <%= render partial: "partners/profiles/show/partner_settings", locals: {profile: @profile} %>
  </div>

  <div class="mt-6"><%= render "actions", partner: current_partner %></div>
</div>
