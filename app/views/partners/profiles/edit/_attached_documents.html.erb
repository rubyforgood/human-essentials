<%= render "shared/essentials/card", title: "Additional documents" do %>
  <% if profile.documents.attached? %>
    <div class="grid gap-6">
      <div class="min-w-0">
        Attached files:
        <ul>
          <% profile.documents.each do |doc| %>
            <li><%= link_to doc.blob['filename'], rails_blob_path(doc), class: "font-semibold" %></li>
          <% end %>
        </ul>
      </div>
      <div class="min-w-0">
        <%= form.input :documents, as: :file, label: "Upload documents", input_html: {multiple: true} %>
      </div>
    </div>
  <% else %>
    <%= form.input :documents, as: :file, label: "Upload documents", input_html: {multiple: true} %>
  <% end %>
<% end %>
