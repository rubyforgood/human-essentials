<%= render "shared/essentials/card", title: "Additional documents" do %>
  <% if profile.documents.attached? %>
    <div class="grid gap-6">
      <div class="min-w-0">
        Attached files:
        <ul>
          <% profile.documents.each do |doc| %>
            <li><%= link_to doc.blob['filename'], rails_blob_path(doc), class: "font-semibold" %></li>
          <% end %>
        </ul>
      </div>
      <div class="min-w-0">
        <%= form.file_field :documents, multiple: true, class: "-file block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
      </div>
    </div>
  <% else %>
    <%= form.file_field :documents, multiple: true, class: "-file block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  <% end %>
<% end %>
