        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-5 py-4">
            <h2 class="text-base font-semibold text-slate-900">Agency Stability</h2>
          </div>
          <div class="px-5 py-4">
            <%= form.input :founded, label: "Year Founded" %>
            <%= form.input :form_990, label: "Form 990 Filed", as: :radio_buttons, wrapper_html: {class: "form-yesno"}, input_html: {class: "radio-yesno"} %>

            <%= render "shared/custom_file_input",
              form_builder: form,
              attachment: profile.proof_of_form_990,
              attachment_name: :proof_of_form_990,
              label_for: "partner_profile_proof_of_form_990",
              label_text: "Form 990" %>

            <%= form.input :program_name, label: "Program Name(s)" %>
            <%= form.input :program_description, label: "Program Description(s)" %>
            <%= form.input :program_age, label: "Agency Age" %>
            <%= form.input :evidence_based, label: "Evidence Based?", as: :radio_buttons, wrapper_html: {class: "form-yesno"}, input_html: {class: "radio-yesno"} %>
            <%= form.input :case_management, label: "Case Management", as: :radio_buttons, wrapper_html: {class: "form-yesno"}, input_html: {class: "radio-yesno"} %>
            <%= form.input :essentials_use, label: "How Are Essentials (e.g. diapers, period supplies) Used In Your Program?", as: :text %>
            <%= form.input :receives_essentials_from_other, label: "Do You Receive Essentials From Other Sources?" %>
            <%= form.input :currently_provide_diapers, label: "Currently Providing Diapers?", as: :radio_buttons, wrapper_html: {class: "form-yesno"}, input_html: {class: "radio-yesno"} %>
          </div>
        </div>
