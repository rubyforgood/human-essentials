<%= render "shared/essentials/card", title: "Area served, by county and client share", padded: false do %>
  <div class="px-5 py-4" data-controller="area-served">
    <%# Was a fieldset with an empty <legend>, which announces a group and names it nothing.
        The heading above already names it, so a plain wrapper is honest. %>
    <div class="mb-8">
      <div id="served_areas">
        <%= render 'served_areas/served_area_fields', form: f %>
      </div>
      <div class="grid gap-6">
        <div>Total is:</div>
        <span id="partners-served-areas-client-share-total" class="min-w-0 numeric" data-area-served-target="total">
          <%= @client_share_total %> %</span>
        <div id="partners-served-areas-client-share-total-warning" class="min-w-0" data-area-served-target="warning">
          The total client share must be either 0 or 100 %.
        </div>
      </div>
      <div class="grid gap-6 links justify-end">
        <%= add_element_button "Add Another County", container_selector: "#served_areas", id: "__add_partner_served_area" do %>
            <%= render 'served_areas/served_area_fields', form: f, object: Partners::ServedArea.new %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
