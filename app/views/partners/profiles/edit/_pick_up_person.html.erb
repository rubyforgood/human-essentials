<%= render "shared/essentials/card", title: "Pick-up person" do %>
  <%= form.input :pick_up_name, label: "Pick Up Person Name" %>
  <%= form.input :pick_up_phone, label: "Pick Up Person's Phone #" %>
  <%= form.input :pick_up_email, label: "Pick Up Person's Email (comma-separated if multiple addresses)", placeholder: "example1@org.com, example2@org.com" %>
<% end %>
