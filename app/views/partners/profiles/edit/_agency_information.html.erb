<%#
  Two cards: the agency itself, and its delivery address if that differs.

  This partial used to close three <div>s and a <section> it never opened -- it was written
  to close its parent's AdminLTE wrappers and open the next one. That left the page one
  </div> ahead, and the browser resolved the mismatch by closing the <form> early: every
  field below this point, including the whole served-areas fieldset and the submit button,
  ended up outside the form. It is self-contained now.
%>
<div class="grid gap-6">
  <%= render "shared/essentials/card", title: "Agency information" do %>
    <%= form.input :name, label: "Agency name" %>
    <%= profile_form.input :agency_type,
    # Symbolize keys, because simple_form will only do an I18n lookup for symbols
    collection: Partners::Profile.agency_types_for_selection,
    label: "Agency type" %>
    <%= profile_form.input :other_agency_type, label: "Other agency type" %>

    <%= render "shared/custom_file_input",
    form_builder: profile_form,
    attachment: profile.proof_of_partner_status,
    attachment_name: :proof_of_partner_status,
    label_for: "partner_profile_proof_of_partner_status",
    label_text: "501(c)(3) IRS Determination Letter or other Proof of Agency Status" %>

    <%= profile_form.input :agency_mission, label: "Agency mission" %>
    <%# One definition of an address field, shared with the six other screens that collect one --
        labels, the state list and the WCAG 1.3.5 autocomplete tokens. See design.md. %>
    <%= profile_form.input :address1, **address_field(:line1) %>
    <%= profile_form.input :address2, **address_field(:line2) %>
    <%= profile_form.input :city, **address_field(:city) %>
    <%= profile_form.input :state, **address_field(:state) %>
    <%= profile_form.input :zip_code, **address_field(:zip) %>
  <% end %>

  <%= render "shared/essentials/card", title: "Program / delivery address (if different)" do %>
    <%= profile_form.input :program_address1, **address_field(:line1) %>
    <%= profile_form.input :program_address2, **address_field(:line2) %>
    <%= profile_form.input :program_city, **address_field(:city) %>
    <%= profile_form.input :program_state, **address_field(:state) %>
    <%= profile_form.input :program_zip_code, **address_field(:zip) %>
  <% end %>
</div>
