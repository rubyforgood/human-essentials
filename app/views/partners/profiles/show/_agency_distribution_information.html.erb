<%= render "shared/essentials/card", title: "Agency distribution information" do %>
    <dl class="space-y-3">
      <dt class="text-xs font-medium text-slate-500">Distribution Times</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.distribution_times %></dd>

      <dt class="text-xs font-medium text-slate-500">New Client Times</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.new_client_times %></dd>

      <dt class="text-xs font-medium text-slate-500">More Docs Required</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.more_docs_required %></dd>
    </dl>
<% end %>
