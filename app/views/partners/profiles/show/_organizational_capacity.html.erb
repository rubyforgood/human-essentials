<div class="mb-4 card">
  <h2 class="border-b border-slate-200 px-5 py-4 text-base font-semibold text-slate-900">Organizational Capacity</h2>
  <div class="px-5 py-4">
    <dl class="space-y-3">
      <dt class="text-xs font-medium text-slate-500">Client Capacity</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.client_capacity %></dd>

      <dt class="text-xs font-medium text-slate-500">Storage Space</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= humanize_boolean_3state(profile.storage_space) %></dd>

      <dt class="text-xs font-medium text-slate-500">Storage Space Description</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.describe_storage_space %></dd>
    </dl>
  </div>
</div>
