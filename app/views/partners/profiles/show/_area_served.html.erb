<%= render "shared/essentials/card", title: "Area served" do %>
    <table>
      <th>County</th><th class="percent">% of Clients in county</th>

      <% if profile.served_areas.load.any? %>
        <%= render partial: "partners/profiles/show/served_area_row", collection: profile.served_areas %>
      <% else %>
        <tr><td><%= "No County Specified" %></td><td class="percent">100 %</td></tr>
      <% end %>
    </table>
<% end %>
