<%# The <dt> and <dd> had no <dl> around them at all, which is what axe reports as `dlitem`. %>
<%= render "shared/essentials/card", title: "Attached documents" do %>

    <dl>
      <dt class="text-xs font-medium text-slate-500">Attached files</dt>
      <% if profile.documents.attached? %>
        <% profile.documents.each do |doc| %>
          <dd class="mt-0.5 text-sm text-slate-900">
            <%= link_to doc.blob["filename"], rails_blob_path(doc),
                  class: "font-medium link-brand" %>
          </dd>
        <% end %>
      <% else %>
        <dd class="mt-0.5 text-sm text-slate-500">No files saved</dd>
      <% end %>
    </dl>
<% end %>
