<%= render "shared/essentials/card", title: "Media information" do %>
    <dl class="space-y-3">
      <dt class="text-xs font-medium text-slate-500">Website</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.website %></dd>

      <dt class="text-xs font-medium text-slate-500">Facebook</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.facebook %></dd>

      <dt class="text-xs font-medium text-slate-500">Twitter</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.twitter %></dd>

      <dt class="text-xs font-medium text-slate-500">Instagram</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.instagram %></dd>

      <dt class="text-xs font-medium text-slate-500">No social media presence</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= humanize_boolean(profile.no_social_media_presence) %></dd>
    </dl>
<% end %>
