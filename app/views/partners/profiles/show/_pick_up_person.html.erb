<%= render "shared/essentials/card", title: "Pick-up person" do %>
    <dl class="space-y-3">
      <dt class="text-xs font-medium text-slate-500">Name</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.pick_up_name %></dd>

      <dt class="text-xs font-medium text-slate-500">Phone</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.pick_up_phone %></dd>

      <dt class="text-xs font-medium text-slate-500">Email</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.pick_up_email %></dd>
    </dl>
<% end %>
