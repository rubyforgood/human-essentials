<div class="mb-4 card">
  <h2 class="border-b border-slate-200 px-5 py-4 text-base font-semibold text-slate-900">Agency Stability</h2>
  <div class="px-5 py-4">
    <dl class="space-y-3">
      <dt class="text-xs font-medium text-slate-500">Year Founded</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.founded %></dd>

      <dt class="text-xs font-medium text-slate-500">Form 990 Filed</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= humanize_boolean_3state(profile.form_990) %></dd>

      <dt class="text-xs font-medium text-slate-500">Form 990</dt>
      <% if profile.proof_of_form_990.attached? %>
        <dd class="mt-0.5 text-sm text-slate-900">Attached
          file: <%= link_to profile.proof_of_form_990.blob['filename'], rails_blob_path(profile.proof_of_form_990), class: "font-medium text-brand-700 hover:text-brand-800" %></dd>
      <% else %>
        <dd class="mt-0.5 text-sm text-slate-900">Form 990 not on file</dd>
      <% end %>

      <dt class="text-xs font-medium text-slate-500">Program Name(s)</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.program_name %></dd>

      <dt class="text-xs font-medium text-slate-500">Program Description(s)</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.program_description %></dd>

      <dt class="text-xs font-medium text-slate-500">Agency Age</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.program_age %></dd>

      <dt class="text-xs font-medium text-slate-500">Case Management</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= humanize_boolean_3state(profile.case_management) %></dd>

      <dt class="text-xs font-medium text-slate-500">Evidence Based</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= humanize_boolean_3state(profile.evidence_based) %></dd>

      <dt class="text-xs font-medium text-slate-500">How Are Essentials (e.g. diapers, period supplies) Used In Your Program?</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.essentials_use %></dd>

      <dt class="text-xs font-medium text-slate-500">Do You Receive Essentials From Other Sources?</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.receives_essentials_from_other %></dd>

      <dt class="text-xs font-medium text-slate-500">Current Providing Diapers</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= humanize_boolean_3state(profile.currently_provide_diapers) %></dd>
    </dl>
  </div>
</div>
