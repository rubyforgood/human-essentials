<%= render "shared/essentials/card", title: "Population served", card_class: "mb-4" do %>
    <dl class="space-y-3">
      <dt class="text-xs font-medium text-slate-500">Clients Have An Income Requirement to Work With You</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= humanize_boolean_3state(profile.income_requirement_desc) %></dd>

      <dt class="text-xs font-medium text-slate-500">Do You Verify The Income Of Your Clients</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= humanize_boolean_3state(profile.income_verification) %></dd>

    </dl>

    <h3 class="mt-5 text-xs font-semibold uppercase tracking-wide text-slate-500">Race and ethnicity of client base</h3>
    <dl class="mt-2 space-y-3">
      <dt class="text-xs font-medium text-slate-500">African American</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.population_black || t(:not_provided) %></dd>

      <dt class="text-xs font-medium text-slate-500">Caucasian</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.population_white || t(:not_provided) %></dd>

      <dt class="text-xs font-medium text-slate-500">Hispanic</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.population_hispanic || t(:not_provided) %></dd>

      <dt class="text-xs font-medium text-slate-500">Asian</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.population_asian || t(:not_provided) %></dd>

      <dt class="text-xs font-medium text-slate-500">American Indian</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.population_american_indian || t(:not_provided) %></dd>

      <dt class="text-xs font-medium text-slate-500">Pacific Islander</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.population_island || t(:not_provided) %></dd>

      <dt class="text-xs font-medium text-slate-500">Multi-racial</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.population_multi_racial || t(:not_provided) %></dd>

      <dt class="text-xs font-medium text-slate-500">Other</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.population_other || t(:not_provided) %></dd>

      <dt class="text-xs font-medium text-slate-500">Zip Codes Served</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.zips_served %></dd>

    </dl>

    <h3 class="mt-5 text-xs font-semibold uppercase tracking-wide text-slate-500">Poverty information of those served</h3>
    <dl class="mt-2 space-y-3">
      <dt class="text-xs font-medium text-slate-500">At FPL or below</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.at_fpl_or_below || t(:not_provided) %></dd>

      <dt class="text-xs font-medium text-slate-500">Above 1-2 times FPL</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.above_1_2_times_fpl || t(:not_provided) %></dd>

      <dt class="text-xs font-medium text-slate-500">Greater than 2 times FPL</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.greater_2_times_fpl || t(:not_provided) %></dd>

      <dt class="text-xs font-medium text-slate-500">Poverty Unknown</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.poverty_unknown || t(:not_provided) %></dd>
    </dl>
<% end %>
