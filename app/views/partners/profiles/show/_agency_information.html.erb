<%= render "shared/essentials/card", title: "Agency information" do %>
    <dl class="space-y-3">
      <dt class="text-xs font-medium text-slate-500">Name</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.partner.name %></dd>

      <dt class="text-xs font-medium text-slate-500">Agency Type</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= t profile.agency_type, scope: :partners_profile %></dd>
      <% if profile.agency_type&.to_sym == :other %>
        <dt class="text-xs font-medium text-slate-500">Other Agency Type</dt>
        <dd class="mt-0.5 text-sm text-slate-900"><%= profile.other_agency_type %></dd>
      <% end %>

      <dt class="text-xs font-medium text-slate-500">Status</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.partner.display_status %></dd>

      <dt class="text-xs font-medium text-slate-500">501(c)(3) IRS Determination Letter or other Proof of Agency Status</dt>
      <% if profile.proof_of_partner_status.attached? %>
        <dd class="mt-0.5 text-sm text-slate-900">Attached
          file: <%= link_to profile.proof_of_partner_status.blob['filename'], rails_blob_path(profile.proof_of_partner_status), class: "font-medium text-brand-700 hover:text-brand-800" %></dd>
      <% else %>
        <dd class="mt-0.5 text-sm text-slate-900">Documentation not on file</dd>
      <% end %>

      <dt class="text-xs font-medium text-slate-500">Agency Mission</dt>
      <dd class="mt-0.5 text-sm text-slate-900"><%= profile.agency_mission %></dd>

      <%# The two <address> elements sat directly inside the <dl>, which is not a permitted
          child. They are the value of a term now, with the <address> inside the <dd>. %>
      <dt class="text-xs font-medium text-slate-500">Address</dt>
      <dd class="mt-0.5 text-sm text-slate-900">
        <address class="not-italic">
          <%= profile.address1 %><br>
          <% if profile.address2.present? %><%= profile.address2 %><br><% end %>
          <%= profile.city %> <%= profile.state %><br>
          <%= profile.zip_code %>
        </address>
      </dd>

      <dt class="text-xs font-medium text-slate-500">Program or delivery address, if different</dt>
      <dd class="mt-0.5 text-sm text-slate-900">
        <address class="not-italic">
          <%= profile.program_address1 %><br>
          <% if profile.program_address2.present? %><%= profile.program_address2 %><br><% end %>
          <%= profile.program_city %> <%= profile.program_state %><br>
          <%= profile.program_zip_code %>
        </address>
      </dd>
    </dl>
<% end %>
