<% content_for :title, "Editing - #{current_partner.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Edit profile",
        subtitle: current_partner.name,
        back: {path: partners_profile_path, label: "Back to profile"},
        actions: essentials_partner_status_pill(current_partner.status) %>

  <%= essentials_form_for current_partner, url: partners_profile_path,
        data: {controller: "form-input"}, html: {role: "form"} do |form| %>
    <%= form.simple_fields_for :profile, current_partner.profile do |profile_form| %>
      <div class="grid gap-6 lg:grid-cols-2">
        <%= render partial: "partners/profiles/edit/agency_information",
              locals: {form: form, profile: current_partner.profile, profile_form: profile_form} %>
        <% current_partner.partials_to_show.each do |partial| %>
          <%= render partial: "partners/profiles/edit/#{partial}",
                locals: {form: profile_form, f: profile_form, profile: current_partner.profile} %>
        <% end %>
        <%= render partial: "partners/profiles/edit/partner_settings",
              locals: {form: profile_form, profile: current_partner.profile} %>
      </div>

      <div class="mt-6 flex items-center gap-2">
        <%= form.submit "Update information", class: essentials_button_classes(variant: :primary, size: :md), data: {disable_with: "Saving..."} %>
        <%= essentials_link_button "Cancel", partners_profile_path, variant: :ghost, size: :md %>
      </div>
    <% end %>
  <% end %>
</div>
