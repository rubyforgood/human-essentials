<%= f.fields_for :profile, profile do |pf| %>
  <% if pf.object.organization.enable_quantity_based_requests? %>
    <div class="mb-4">
      <div class="flex items-start gap-2">
        <%= pf.check_box :enable_quantity_based_requests, as: :boolean, class: "size-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500 mt-0.5" %>
        <%= pf.label :enable_quantity_based_requests, "Enable quantity-based requests", class: "text-sm text-slate-700" %>
      </div>
    </div>
  <% end %>

  <% if pf.object.organization.enable_child_based_requests? %>
    <div class="mb-4">
      <div class="flex items-start gap-2">
        <%= pf.check_box :enable_child_based_requests, as: :boolean, class: "size-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500 mt-0.5" %>
        <%= pf.label :enable_child_based_requests, "Enable child-based requests (unclick if you only do bulk requests)", class: "text-sm text-slate-700" %>
      </div>
    </div>
  <% end %>

  <% if pf.object.organization.enable_individual_requests? %>
    <div class="mb-4">
      <div class="flex items-start gap-2">
        <%= pf.check_box :enable_individual_requests, as: :boolean, class: "size-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500 mt-0.5" %>
        <%= pf.label :enable_individual_requests, "Enable requests by number of individuals", class: "text-sm text-slate-700" %>
      </div>
    </div>
  <% end %>
<% end %>
