<%= f.fields_for :profile, profile do |pf| %>
  <div class="mb-4">
    <%= pf.input :sources_of_funding, label: "Sources of funding", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  </div>

  <div class="mb-4">
    <%= pf.input :sources_of_diapers, label: "How do you currently obtain diapers?", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  </div>

  <div class="mb-4">
    <%= pf.input :essentials_budget, label: "Essentials budget", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  </div>

  <div class="mb-4">
    <%= pf.input :essentials_funding_source, label: "Essentials funding source", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  </div>
<% end %>
