<%= f.fields_for :profile, profile do |pf| %>
  <div class="mb-4">
    <%= pf.input :income_requirement_desc, label: "Clients Have An Income Requirement to Work With You?",
              as: :radio_buttons, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES,
              wrapper_html: {}, input_html: {} %>
  </div>

  <div class="mb-4">
    <%= pf.input :income_verification, label: "Do You Verify The Income Of Your Clients?",
              as: :radio_buttons, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES,
              wrapper_html: {}, input_html: {} %>
  </div>

  <h3 class="pt-3"><strong>Race and ethnicity of client base</strong></h3>

  <div class="mb-4">
    <%= pf.input :population_black, label: "% African American", as: :integer, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :population_white, label: "% Caucasian", as: :integer, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :population_hispanic, label: "% Hispanic", as: :integer, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :population_asian, label: "% Asian", as: :integer, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :population_american_indian, label: "% American Indian", as: :integer, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :population_island, label: "% Pacific Island", as: :integer, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :population_multi_racial, label: "% Multi-racial", as: :integer, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :population_other, label: "% Other", as: :integer, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :zips_served, label: "ZIP codes served", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <h3 class="pt-3"><strong>Poverty information of those served</strong></h3>

  <div class="mb-4">
    <%= pf.input :at_fpl_or_below, label: "% At FPL or Below", as: :integer, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :above_1_2_times_fpl, label: "% Above 1-2 times FPL", as: :integer, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :greater_2_times_fpl, label: "% Greater than 2 times FPL", as: :integer, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :poverty_unknown, label: "% Poverty Unknown", as: :integer, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
<% end %>
