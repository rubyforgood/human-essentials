<%= f.fields_for :profile, profile do |pf| %>
  <div class="mb-4">
    <%= pf.input :founded, label: "Year founded", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  </div>

  <div class="mb-4">
    <%= pf.input :form_990, label: "Form 990 Filed", as: :radio_buttons, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  </div>

  <%= render "shared/custom_file_input",
           form_builder: pf,
           attachment: profile.proof_of_form_990,
           attachment_name: :proof_of_form_990,
           label_for: "partner_profile_proof_of_form_990",
           label_text: "Form 990" %>

  <div class="mb-4">
    <%= pf.input :program_name, label: "Program name(s)", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  </div>

  <div class="mb-4">
    <%= pf.input :program_description, label: "Program description(s)", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  </div>

  <div class="mb-4">
    <%= pf.input :program_age, label: "Agency age", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  </div>

  <div class="mb-4">
    <%= pf.input :evidence_based, label: "Evidence based?", as: :radio_buttons, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  </div>

  <div class="mb-4">
    <%= pf.input :case_management, label: "Case management", as: :radio_buttons, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  </div>

  <div class="mb-4">
    <%= pf.input :essentials_use, label: "How are essentials (e.g. diapers, period supplies) used in your program?", as: :text, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  </div>

  <div class="mb-4">
    <%= pf.input :receives_essentials_from_other, label: "Do you receive essentials from other sources?", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  </div>

  <div class="mb-4">
    <%= pf.input :currently_provide_diapers, label: "Currently providing diapers?", as: :radio_buttons, class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none" %>
  </div>
<% end %>
