<div class="mb-4">
  <%= f.input :name, label: "Agency name", required: true, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
</div>

<%= f.fields_for :profile, profile do |pf| %>
  <div data-controller="hide-by-source-val"
       data-hide-by-source-val-values-to-show-value='["other"]'>
    <div class="mb-4">
      <%= pf.input :agency_type,
        collection: Partners::Profile.agency_types_for_selection,
        label: "Agency type",
        class: EssentialsUiHelper::FILTER_CONTROL_CLASSES,
        input_html: { data: { "hide-by-source-val-target": "source", action: "change->hide-by-source-val#sourceChanged" } } %>
    </div>

    <div class="mb-4" data-hide-by-source-val-target="destination">
      <%= pf.input :other_agency_type, label: "Other agency type", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
    </div>
  </div>

  <%= render "shared/custom_file_input",
           form_builder: pf,
           attachment: profile.proof_of_partner_status,
           attachment_name: :proof_of_partner_status,
           label_for: "partner_profile_proof_of_partner_status",
           label_text: "501(c)(3) IRS Determination Letter or other Proof of Agency Status" %>

  <div class="mb-4">
    <%= pf.input :agency_mission, as: :text, label: "Agency mission", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :address1, label: "Address (line 1)", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :address2, label: "Address (line 2)", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :city, label: "City", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :state, label: "State", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :zip_code, label: "Zip Code", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
<% end %>
