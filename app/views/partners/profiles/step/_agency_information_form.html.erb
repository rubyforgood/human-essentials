<div class="mb-4">
  <%= f.input :name, label: "Agency name", required: true, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
</div>

<%= f.fields_for :profile, profile do |pf| %>
  <div data-controller="hide-by-source-val"
       data-hide-by-source-val-values-to-show-value='["other"]'>
    <div class="mb-4">
      <%= pf.input :agency_type,
        collection: Partners::Profile.agency_types_for_selection,
        label: "Agency type",
        class: EssentialsUiHelper::FILTER_CONTROL_CLASSES,
        input_html: { "aria-controls": "other_agency_type_field",
                      data: { "hide-by-source-val-target": "source", action: "change->hide-by-source-val#sourceChanged" } } %>
    </div>

    <%# Only asked for when the agency type is Other, so it is revealed under the question that
        makes it necessary. It also used to render visible and be hidden by the controller on
        `connect()`, so it flashed on every load; `shown` is read on the server now. %>
    <%= render "shared/essentials/conditional_reveal", id: "other_agency_type_field",
          shown: profile.agency_type == "other",
          data: {"hide-by-source-val-target": "destination"} do %>
      <%= pf.input :other_agency_type, label: "Other agency type", wrapper_html: {class: "mb-0"},
            class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
    <% end %>
  </div>

  <%= render "shared/custom_file_input",
           form_builder: pf,
           attachment: profile.proof_of_partner_status,
           attachment_name: :proof_of_partner_status,
           label_for: "partner_profile_proof_of_partner_status",
           label_text: "501(c)(3) IRS Determination Letter or other Proof of Agency Status" %>

  <div class="mb-4">
    <%= pf.input :agency_mission, as: :text, label: "Agency mission", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <%# `address_field` supplies the label, the state list and the autocomplete token, so this form
      and the six others that collect an address cannot drift apart. **State was a free text box
      here** while the organization form has offered a 52-option select all along, and no field on
      any of them carried `autocomplete` -- WCAG 1.3.5. See design.md. %>
  <div class="mb-4">
    <%= pf.input :address1, **address_field(:line1), class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :address2, **address_field(:line2), class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :city, **address_field(:city), class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :state, **address_field(:state), class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :zip_code, **address_field(:zip), class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
<% end %>
