<%= f.fields_for :profile, profile do |pf| %>
  <div class="mb-4">
    <%= pf.input :program_address1, label: "Address (line 1)", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :program_address2, label: "Address (line 2)", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :program_city, label: "City", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :program_state, label: "State", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :program_zip_code, label: "Zip code", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
<% end %>
