<%= f.fields_for :profile, profile do |pf| %>
  <div class="mb-4">
    <%= pf.input :pick_up_name, label: "Pick up person name", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :pick_up_phone, label: "Pick up person's phone #", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :pick_up_email, label: "Pick up person's email", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
<% end %>
