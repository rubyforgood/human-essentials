<%= f.fields_for :profile, profile do |pf| %>
  <h3 class="pt-3"><strong>Executive director</strong></h3>

  <div class="mb-4">
    <%= pf.input :executive_director_name, label: "Executive director name", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :executive_director_phone, label: "Executive director phone", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :executive_director_email, label: "Executive director email", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <h3 class="pt-3"><strong>Primary contact</strong></h3>

  <div class="mb-4">
    <%= pf.input :primary_contact_name, label: "Primary contact name", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :primary_contact_phone, label: "Primary contact phone", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :primary_contact_mobile, label: "Primary contact cell", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
  <div class="mb-4">
    <%= pf.input :primary_contact_email, label: "Primary contact email", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
<% end %>
