<%= f.fields_for :profile, profile do |pf| %>
  <div class="mb-4">
    <%= pf.input :website, label: "Website", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :facebook, label: "Facebook", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :twitter, label: "Twitter", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :instagram, label: "Instagram", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <div class="flex items-start gap-2">
        <%= pf.check_box :no_social_media_presence, as: :boolean, class: "size-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500 mt-0.5" %>
        <%= pf.label :no_social_media_presence, "No social media presence", class: "text-sm text-slate-700" %>
      </div>
  </div>
<% end %>
