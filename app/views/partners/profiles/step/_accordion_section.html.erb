<%# locals: (f:, partner:, section_id:, section_title:, partial_name:, sections_with_errors:) %>
<%#
  No icon. `bi-sliders` was passed for 10 of the 13 sections, so it marked nothing and only
  three headings differed -- decoration that reads as meaning and is not.
%>
<% open = section_with_errors?(section_id, sections_with_errors) %>

<%#
  heading: "h2" so the set of sections is navigable by heading, which is what makes an accordion
  of this length usable with a screen reader.
%>
<%= render "shared/essentials/disclosure",
      panel_id: section_id,
      title: section_title,
      open: open,
      heading: "h2",
      badge: (open ? essentials_status_pill("Needs attention", tone: :danger, icon: "bi-exclamation-triangle") : nil) do %>
  <%#
    A section is opened on load precisely because it has errors, so the pill says why.
  %>
  <%= render "partners/profiles/step/#{partial_name}_form", f: f, partner: partner, profile: partner.profile %>
<% end %>
