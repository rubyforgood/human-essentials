<%= f.fields_for :profile, profile do |pf| %>
  <div class="mb-4">
    <%= pf.input :client_capacity, label: "Client capacity", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :storage_space, label: "Storage space", as: :radio_buttons, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>

  <div class="mb-4">
    <%= pf.input :describe_storage_space, label: "Storage space description", class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
  </div>
<% end %>
