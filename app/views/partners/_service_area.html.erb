<%#
  Where a partner serves: what they declare, and where their families actually are.

  Two answers to one question used to sit at opposite ends of this page -- the declared counties in
  a bare unstyled <table> inside the profile block at y=2733, the observed zipcodes as a figure at
  y=206. The point of holding them together is the comparison, so the card *states* it in its
  subtitle rather than laying out two facts and leaving the reader to do the arithmetic. The first
  version of this card did the latter, in two columns, one of which was 273px tall and held a single
  number.

  Stacked rather than columned on purpose: a table of counties and a list of zipcodes are not
  parallel shapes and were never going to balance. Full width also lets a county name like
  "Berkshire County, Massachusetts" sit on one line.

  Locals: partner, impact_metrics
%>
<%
  # Sorted by share, so the county most of their clients are in reads first.
  served_areas = Partners::ServedArea.includes(:county)
    .where(partner_profile: partner.profile)
    .reject { |area| area.county.blank? }
    .sort_by { |area| -area.client_share.to_f }

  # Already five-digit, deduplicated and sorted by the model -- see Partner#family_zipcodes_list.
  zipcodes = (impact_metrics || {})[:family_zipcodes_list] || []
  # Measured across this bank: max 13, median 8 per partner, so the list almost always fits whole and
  # the dialog never has to open. It truncates only when that saves something -- the first cut was a
  # flat first(12), which for a partner with 13 rendered "and 1 more", hiding a single zipcode behind
  # a dialog to save one line.
  shown_zipcodes = (zipcodes.size <= 16) ? zipcodes : zipcodes.first(12)
  hidden_zipcodes = zipcodes.size - shown_zipcodes.size

  summary = [
    served_areas.any? ? "They serve #{pluralize(served_areas.size, "county")}." : "No counties recorded yet.",
    zipcodes.any? ? "Their families live in #{pluralize(zipcodes.size, "zip code")}." : "No families registered yet."
  ].join(" ")
%>
<%= render "shared/essentials/card", title: "Service area", subtitle: summary do %>
  <% if served_areas.any? %>
    <table class="data-table">
      <%# Visually hidden, per design.md: every table says what it lists. %>
      <caption>Counties <%= partner.name %> serves, and the share of their clients in each</caption>
      <thead>
        <tr>
          <th scope="col">County</th>
          <th scope="col" class="percent">Client share</th>
        </tr>
      </thead>
      <tbody>
        <% served_areas.each do |area| %>
          <tr>
            <td><%= area.county.name %></td>
            <%# "26 %" with the space, which is how both served-area forms already render a share. %>
            <td class="percent"><%= area.client_share %> %</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-sm italic text-slate-500">
      This partner has not recorded the counties they serve.
    </p>
  <% end %>

  <% if zipcodes.any? %>
    <div class="<%= "mt-5 border-t border-slate-200 pt-5" if served_areas.any? %>">
      <%# Sentence case, and the same weight the Contact information card gives "Executive director".
          Not the uppercase eyebrow this slot attracts -- design.md has no exception for small text. %>
      <h3 class="text-sm font-semibold text-slate-900">Family zipcodes</h3>
      <p class="mt-0.5 text-xs text-slate-500">Lowest to highest.</p>
      <%#
        A bordered box each, because the complaint was that a space-separated run of digits gives
        nothing to say where one code ends and the next begins.

        Square corners, no tone, no control -- which is what keeps it out of the way of the two
        chip-shaped things this app already has. Both are `rounded-full`: a status pill, which
        carries a tone colour and which design.md defines as *a state*, and a filter chip, which
        carries an "x" and means a filter you can remove. A square uncoloured box that does nothing
        when clicked is a third thing and reads as one.

        `font-mono`, the same treatment barcode values get: a code you read a character at a time.

        An aligned grid was recommended first and withdrawn. Measured at the real card width, 1144px
        fits twelve five-digit codes across, so thirteen rendered 12 x 2 -- one row stretched by
        `1fr` with ~90px between neighbours, and the thirteenth orphaned. Columns only help a list
        long enough to wrap into a block, and at a median of 8 per partner this one never is.
      %>
      <ul class="mt-2 flex flex-wrap gap-1.5">
        <% shown_zipcodes.each do |zipcode| %>
          <li class="rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-mono text-xs tabular-nums text-slate-700"><%= zipcode %></li>
        <% end %>
      </ul>
      <% if hidden_zipcodes.positive? %>
        <button type="button" class="mt-2 text-sm font-medium text-brand-700 underline hover:text-brand-800"
                data-action="click->dialog#open" data-dialog-id-param="see-zipcodes">
          and <%= pluralize(hidden_zipcodes, "more") %>
        </button>
      <% end %>
    </div>
  <% end %>
<% end %>

<%# Only when the list was too long to show in full -- otherwise there is nothing behind it. %>
<% if hidden_zipcodes.positive? %>
  <%= render "shared/essentials/modal", id: "see-zipcodes", title: "Zip codes their families live in" do %>
    <ul class="flex flex-wrap gap-1.5">
      <% zipcodes.each do |zipcode| %>
        <li class="rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-mono text-xs tabular-nums text-slate-700"><%= zipcode %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>
