<div id="panel-partners" role="tabpanel" aria-labelledby="tab-partners" data-tabs-target="panel">
  <div class="border-b border-slate-200 px-5 py-4">
    <%= render partial: "statuses", object: @partner_status_counts, as: :status_counts %>
  </div>

  <% if partners.blank? %>
    <%= render "shared/essentials/empty_state",
          kind: filter_params.present? ? :no_results : :cold_start,
          title: filter_params.present? ? "No partners match that status" : "No partner agencies yet",
          body: filter_params.present? ? "Choose Active above to see everyone." : "Partner agencies are the organizations you distribute essentials to.",
          action: filter_params.present? ? nil : essentials_link_button("New partner agency", new_partner_path, variant: :primary, icon: "bi-plus-lg") %>
  <% else %>
    <div class="data-table">
      <table class="data-table">
        <caption>Partner agencies and their current status</caption>
        <thead>
          <tr>
            <th scope="col">Partner</th>
            <th scope="col">Email</th>
            <th scope="col">Group</th>
            <th scope="col" class="quantity">Quota</th>
            <th scope="col">Status</th>
            <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "partner_row", collection: partners %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
