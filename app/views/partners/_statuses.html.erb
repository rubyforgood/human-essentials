<%#
  Status filter strip. Each status is a link that filters the list; the active one is
  marked with aria-current as well as colour.
%>
<% current_filtered_status = params.dig(:filters, :by_status) %>
<ul id="partner-status" class="flex flex-wrap items-center gap-2">
  <li>
    <%= link_to partners_path,
          "aria-current": (current_filtered_status.nil? ? "true" : nil),
          class: "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 #{current_filtered_status.nil? ? "filtering bg-brand-100 text-brand-800" : "bg-slate-100 text-slate-700 hover:bg-slate-200"}" do %>
      <i class="bi-list-ul" aria-hidden="true"></i><%= @active_partner_count %> Active
    <% end %>
  </li>

  <% current_organization.partners.statuses.keys.each do |status| %>
    <% partner_count = status_counts[status] || 0 %>
    <% config = PartnersHelper::ESSENTIALS_PARTNER_STATUS[status] || {tone: :neutral, icon: "bi-question-circle"} %>
    <% active = status == current_filtered_status %>
    <li>
      <% if partner_count.zero? %>
        <%# Nothing to filter to, so this is a count rather than a control. %>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-50 px-3 py-1 text-xs font-medium text-slate-400">
          <i class="<%= config[:icon] %>" aria-hidden="true"></i><%= partner_count %> <%= status.humanize %>
        </span>
      <% else %>
        <%= link_to partners_path(filters: {by_status: status}),
              "aria-current": (active ? "true" : nil),
              class: "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 #{active ? "filtering bg-brand-100 text-brand-800" : "#{EssentialsUiHelper::PILL_TONES.fetch(config[:tone])} hover:brightness-95"}" do %>
          <i class="<%= config[:icon] %>" aria-hidden="true"></i><%= partner_count %> <%= status.humanize %>
        <% end %>
      <% end %>
    </li>
  <% end %>
</ul>
