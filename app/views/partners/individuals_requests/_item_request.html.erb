<%= form.fields_for :items, defined?(object) ? object : nil  do |field| %>
  <tr>
    <td>
      <%= field.label :item_id, "Item Requested", {class: 'sr-only'} %>
      <%= field.select :item_id, @requestable_items, {include_blank: 'Select an item'}, {class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none"} %>

    </td>
    <td>
      <%= field.label :person_count, "Number of Individuals", {class: 'sr-only'} %>
      <%= field.number_field :person_count, as: :integer, label: false, step: 1, min: 1, class: EssentialsUiHelper::FILTER_CONTROL_CLASSES %>
    </td>
      <td><%= remove_element_button "Remove", container_selector: "tr" %></td>
  </tr>
<% end %>
