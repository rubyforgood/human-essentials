<% content_for :title, "New user - #{current_partner.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Invite a new user",
        subtitle: "They will be able to sign in and make requests on behalf of #{current_partner.name}.",
        back: {path: partners_users_path, label: "Back to users"} %>

  <div class="max-w-2xl">
    <%= essentials_error_summary(@user) %>

    <%= render "shared/essentials/card" do %>
      <%#
        essentials_form_for, not form_for with hand-rolled label/text_field pairs: going through
        simple_form is what gives these fields the required marker, aria-required, aria-invalid
        and an error message tied to the input. Hand-rolled, they had none of it.
      %>
      <%= essentials_form_for @user, url: partners_users_path, html: {method: :post} do |f| %>
        <%= f.input :name, required: true %>
        <%= f.input :email, required: true %>

        <div class="mt-6 flex items-center gap-2 border-t border-slate-200 pt-5">
          <%= f.button :button, "Send invitation", class: essentials_button_classes(variant: :primary, size: :md),
                data: {disable_with: "Sending..."} %>
          <%= essentials_link_button "Cancel", partners_users_path, variant: :ghost, size: :md %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
