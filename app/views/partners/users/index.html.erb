<% content_for :title, "Users - #{current_partner.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Users",
        subtitle: "People at #{current_partner.name} who can sign in.",
        actions: essentials_link_button("Invite new user", new_partners_user_path, variant: :primary, icon: "bi-envelope") %>

  <%= render "shared/essentials/card", padded: @users.blank? do %>
    <% if @users.blank? %>
      <%= render "shared/essentials/empty_state", kind: :cold_start,
            title: "No users yet",
            body: "Invite a colleague so they can make requests on your agency's behalf.",
            action: essentials_link_button("Invite new user", new_partners_user_path, variant: :primary, icon: "bi-envelope") %>
    <% else %>
      <div class="table-scroll">
        <table class="data-table">
          <caption>Users at <%= current_partner.name %></caption>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Email</th>
              <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr>
                <td class="font-medium text-slate-900"><%= user.display_name %></td>
                <td><%= user.email %></td>
                <td class="text-right">
                  <%= essentials_link_button "Edit", edit_partners_user_path(user), variant: :ghost, size: :sm, icon: "bi-pencil" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
</div>
