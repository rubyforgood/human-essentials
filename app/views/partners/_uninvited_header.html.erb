<%= render "shared/essentials/card", title: "Partner details" do %>
  <%= render "partner_details", partner: partner %>
  <% if partner.deletable? %>
    <div class="mt-4 border-t border-slate-200 pt-4">
      <%= essentials_action_button "Delete partner", partner_path(partner), method: :delete,
            variant: :ghost, size: :sm, icon: "bi-trash", class: "text-rose-700 hover:bg-rose-50",
            confirm: confirm_delete_msg(partner.name) %>
    </div>
  <% end %>
<% end %>
