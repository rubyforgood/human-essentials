<%= render "shared/essentials/card", title: "Your impact", subtitle: "Year-to-date totals." do %>
  <div class="grid gap-4 sm:grid-cols-3">
    <div class="flex items-center gap-3 rounded-xl border border-slate-200 p-4">
      <%= essentials_icon_tile("bi-people", tone: :success) %>
      <div>
        <p class="text-2xl font-bold tracking-tight text-slate-900"><%= number_with_delimiter(@families.count) %></p>
        <p class="text-sm text-slate-600">Families served</p>
      </div>
    </div>

    <div class="flex items-center gap-3 rounded-xl border border-slate-200 p-4">
      <%= essentials_icon_tile("bi-person-arms-up", tone: :success) %>
      <div>
        <p class="text-2xl font-bold tracking-tight text-slate-900"><%= number_with_delimiter(@children.count) %></p>
        <p class="text-sm text-slate-600">Children served</p>
      </div>
    </div>

    <div class="flex items-start gap-3 rounded-xl border border-slate-200 p-4">
      <%= essentials_icon_tile("bi-geo-alt", tone: :success) %>
      <div class="min-w-0">
        <p class="text-2xl font-bold tracking-tight text-slate-900"><%= @families.pluck(:guardian_zip_code).uniq.count %></p>
        <p class="text-sm text-slate-600">Areas served</p>
        <p class="mt-1 break-words text-xs text-slate-500"><%= @families.pluck(:guardian_zip_code).uniq.join(", ") %></p>
      </div>
    </div>
  </div>
<% end %>
