<% content_for :title, "Dashboard - #{@partner.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Dashboard",
        subtitle: @partner.name,
        actions: essentials_partner_status_pill(@partner.status) %>

  <div class="space-y-6">
    <%= render "broadcast_announcement" if @broadcast_announcements.any? %>

    <% if @partner.info_for_partner.present? %>
      <%= render "shared/essentials/card", title: "Information from #{@parent_org.name}" do %>
        <div class="text-sm text-slate-700"><%= @partner.info_for_partner %></div>
      <% end %>
    <% end %>

    <%= render partial: "/partners/requests/request_options_card" if @partner.approved? %>
    <%= render partial: "requests_in_progress" %>

    <%= render partial: "partners/distributions/distribution_section",
          locals: {distributions: @upcoming_distributions,
                   title: "Upcoming distributions", date_header: "Pick up date",
                   item_header: "Items to receive"} %>

    <%= render partial: "partners/distributions/distribution_section",
          locals: {distributions: @distributions,
                   title: "Prior distributions", date_header: "Date received",
                   item_header: "Items received"} %>

    <%= render partial: "family_details" %>
  </div>
</div>
