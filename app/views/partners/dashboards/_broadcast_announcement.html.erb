<%# One icon per card, not one per row -- see design.md and the bank-side partial. %>
<%= render "shared/essentials/card", title: "Announcements from #{@parent_org.name}",
      icon: "bi-megaphone", icon_tone: :warning do %>
  <ul class="divide-y divide-slate-100">
    <% @broadcast_announcements.each do |announcement| %>
      <li class="py-3 first:pt-0 last:pb-0">
        <p class="text-xs font-medium text-slate-500">
          <%= announcement.created_at.strftime(announcement.created_at.year == Date.current.year ? "%B %-d" : "%B %-d %Y") %>
        </p>
        <p class="mt-0.5 text-sm text-slate-700"><%= announcement.message %></p>
        <% if announcement.link.present? %>
          <%# See the bank-side partial: short visible label, accessible name carrying the
              announcement it belongs to. WCAG 2.4.4 with 2.5.3. %>
          <%= link_to "More info", announcement.link,
                aria: {label: "More info about the announcement of #{announcement.created_at.strftime("%B %-d")}"},
                class: "mt-2 inline-flex items-center gap-1 text-sm font-medium link-brand" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
