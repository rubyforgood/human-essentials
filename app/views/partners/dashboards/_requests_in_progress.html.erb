<%= render "shared/essentials/card", title: "Requests in progress", padded: @requests_in_progress.blank? do %>
  <% if @requests_in_progress.blank? %>
    <%= render "shared/essentials/empty_state", kind: :all_clear,
          title: "No requests in progress",
          body: "Requests you submit will appear here until they are fulfilled." %>
  <% else %>
    <div class="table-scroll">
      <table class="data-table">
        <caption>Requests you have submitted that are not yet fulfilled</caption>
        <thead>
          <tr>
            <th scope="col" class="date">Request date</th>
            <th scope="col" class="quantity">Items requested</th>
            <th scope="col">What was requested</th>
            <th scope="col">Comment and sender</th>
          </tr>
        </thead>
        <tbody>
          <% @requests_in_progress.each do |request| %>
            <tr>
              <td class="date font-medium text-slate-900"><%= request.created_at.strftime("%m/%d/%Y") %></td>
              <td class="quantity"><%= number_with_delimiter(request.total_items) %></td>
              <td>
                <div class="flex flex-wrap gap-1.5">
                  <% request.item_requests.each do |item_request| %>
                    <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">
                      <% if Flipper.enabled?(:enable_packs) && item_request.request_unit %>
                        <%= pluralize(item_request.quantity, item_request.request_unit) %> — <%= item_request.item.name %>
                      <% else %>
                        <%= number_with_delimiter(item_request.quantity) %> <%= item_request.item.name %>
                      <% end %>
                    </span>
                  <% end %>
                </div>
              </td>
              <td>
                <% if (comment = request.comments).present? %>
                  <%# The comment was truncated behind a Bootstrap tooltip, which is
                      hover-only and unreachable by keyboard or touch. It is a <details>
                      disclosure now, so the full text is available to everyone. %>
                  <details class="mb-2">
                    <summary class="cursor-pointer text-sm text-slate-700 marker:text-slate-400">
                      <%= truncate(comment, length: 20) %>
                    </summary>
                    <p class="mt-1 max-w-prose text-sm text-slate-600"><%= comment %></p>
                  </details>
                <% end %>
                <%= link_to request.requester.email, "mailto:#{request.requester.email}",
                      class: "text-sm text-brand-700 hover:text-brand-800" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
