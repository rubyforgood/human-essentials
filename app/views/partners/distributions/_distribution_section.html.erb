<%= render "shared/essentials/card", title: title, padded: distributions.blank? do %>
  <% if distributions.blank? %>
    <%= render "shared/essentials/empty_state", kind: :all_clear,
          title: "Nothing here yet",
          body: "#{title} will appear here once your bank schedules them." %>
  <% else %>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
      <table class="data-table">
        <caption><%= title %></caption>
        <thead>
          <tr>
            <th scope="col" class="date"><%= date_header %></th>
            <th scope="col">ID</th>
            <th scope="col" class="quantity">Total items</th>
            <th scope="col"><%= item_header %></th>
            <th scope="col" class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% distributions.each do |dist| %>
            <tr>
              <td class="date font-medium text-slate-900"><%= dist.issued_at.strftime("%m/%d/%Y") %></td>
              <td><%= dist.id %></td>
              <td class="quantity"><%= number_with_delimiter(dist.line_items.total) %></td>
              <td>
                <div class="flex flex-wrap gap-1.5">
                  <% dist.line_items.each do |item| %>
                    <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">
                      <%= number_with_delimiter(item.quantity) %> <%= item.name %>
                    </span>
                  <% end %>
                </div>
              </td>
              <td class="text-right">
                <%= essentials_link_button "Print", print_partners_distribution_path(dist, format: :pdf), variant: :ghost, size: :sm, icon: "bi-printer" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
