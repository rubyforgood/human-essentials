<%= render "shared/essentials/card", title: "Documents" do %>
  <ul class="space-y-2">
    <% partner.documents.select(&:persisted?).each do |doc| %>
      <li class="attached-document flex items-center justify-between gap-3 rounded-xl border border-slate-200 p-3"
          data-document-id="<%= doc.signed_id %>">
        <%= link_to doc.blob.filename.to_s, rails_blob_path(doc),
              class: "min-w-0 flex-1 truncate font-medium text-brand-700 hover:text-brand-800" %>
        <%= essentials_action_button "Remove", attachment_path(doc), method: :delete,
              variant: :ghost_danger, size: :sm, icon: "bi-trash",
              confirm: "Are you sure you want to permanently remove this document?" %>
      </li>
    <% end %>
  </ul>
<% end %>
