<%#
  One repeatable line item row. Rendered only by line_items/_line_item_table, which supplies the
  column headings, the scan bar and the footer -- and, crucially, `grid_class` and `cells`, so a
  row cannot end up with a different column template from the headings above it.

  The JS hooks here are load-bearing: `.line_item_name` and `.quantity` are read by
  utils/donations.js and utils/barcode_items.js, `[data-quantity]` by the barcode lookup, and the
  `section` container selector by the form-input Stimulus controller's remove action.

  Labelling is by width. At `sm` and up the heading row carries the words and each cell's own
  label is hidden; below `sm` the row is stacked, the heading row is gone, and the per-cell labels
  are what name the controls on screen. The controls also carry the word as `aria-label`, which is
  what names them for a screen reader at the width where the visible label is display:none.
%>
<% if local_assigns[:changes_disallowed] %>
  <%= render "shared/essentials/callout", tone: :warning, role: "status", wrapper_class: "m-5" do %>
    This <%= form.object.class.name.downcase %> is too old to edit inventory. You can only change non-inventory fields.
  <% end %>
<% end %>

<%= form.simple_fields_for :line_items, defined?(object) ? object : nil do |field| %>
  <% requested = field.object.requested_item %>
  <%# `items-start`, not `items-center`: a row whose item failed validation grows a message under
      that control, and the neighbouring controls should stay level with the control rather than
      re-centre against the message. %>
  <section class="nested-fields line_item_section grid <%= grid_class %> items-start gap-x-3 gap-y-2 px-5 py-2.5">
    <div class="<%= cells[:item] %> min-w-0">
      <%= field.label :item_id, "Item", class: "mb-1 block text-xs font-medium text-slate-500 sm:hidden" %>
      <%= field.input :item_id,
            disabled: requested.present? || local_assigns[:changes_disallowed],
            collection: @item_labels_with_quantities || @items,
            prompt: "Choose an item",
            include_blank: "",
            label: false,
            wrapper: :essentials_cell_select,
            input_html: {class: "line_item_name", "data-controller": "select2",
                         "aria-label": "Item"} %>
      <% if requested.present? %>
        <%= field.input :item_id, as: :hidden %>
      <% end %>
    </div>

    <% if requested_column %>
      <div class="<%= cells[:requested] %>">
        <span class="mb-1 block text-xs font-medium text-slate-500 sm:hidden" aria-hidden="true">Requested</span>
        <p class="text-sm text-slate-600 sm:py-2 sm:text-right">
          <% if requested&.request_unit.present? %>
            <%= pluralize(requested.quantity, requested.request_unit) %>
          <% elsif requested %>
            <%= requested.quantity %>
          <% else %>
            &mdash;
          <% end %>
        </p>
      </div>
    <% end %>

    <div class="<%= cells[:quantity] %> min-w-0">
      <%= field.label :quantity, "Quantity", class: "mb-1 block text-xs font-medium text-slate-500 sm:hidden" %>
      <%= field.input :quantity, as: :string,
            disabled: local_assigns[:changes_disallowed],
            label: false,
            wrapper: :essentials_cell,
            input_html: {class: "quantity text-right", data: {quantity: ""},
                         inputmode: "numeric", "aria-label": "Quantity"} %>
    </div>

    <%# `self-end` below `sm`: the button shares row 1 with the item's label *and* control, and the
        section is `items-start`, so left alone it lines up with the word rather than the box.
        Aligning to the end of the cell puts its bottom on the control's bottom whatever the label
        is -- an invisible spacer would have done the same thing with a number in it.

        `sm:self-center`, because the labelled button is 28px against the controls' 38px and
        top-aligning a shorter thing next to a taller one reads as a mistake. %>
    <div class="<%= cells[:remove] %> self-end sm:self-center">
      <% unless local_assigns[:changes_disallowed] %>
        <%= remove_element_button "Remove", container_selector: "section" %>
      <% end %>
    </div>
  </section>
<% end %>
