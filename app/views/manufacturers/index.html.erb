<%# No CSV import here. The Import manufacturers button and its modal were removed in 2026:
    none of the feature existed behind them. ManufacturersController does not include Importable,
    Manufacturer has no import_csv, and public/manufacturers.csv was never added -- so submitting
    the form raised. The five other index pages with this modal all have the controller and the
    template. %>
<% content_for :title, "Manufacturers - Community - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Manufacturers",
        subtitle: "Record a donation from a company that gives product directly.",
        actions: essentials_link_button("New manufacturer", new_manufacturer_path, variant: :primary, icon: "bi-plus-lg") %>

  <%= render "shared/essentials/card", padded: false do %>
    <% if @manufacturers.empty? %>
      <%= render "shared/essentials/empty_state", kind: :cold_start,
            title: "No manufacturers yet",
            body: "Add manufacturers so donations made directly by a company can be attributed to them.",
            action: essentials_link_button("Add your first manufacturer", new_manufacturer_path, variant: :primary, icon: "bi-plus-lg") %>
    <% else %>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
        <table class="data-table">
          <caption>Manufacturers and the total items donated by each</caption>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col" class="quantity">Total items donated</th>
              <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody><%= render partial: "manufacturer_row", collection: @manufacturers %></tbody>
        </table>
      </div>
    <% end %>
  <% end %>
</div>
