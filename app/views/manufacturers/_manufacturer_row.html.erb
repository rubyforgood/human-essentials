<tr>
  <td class="font-medium text-slate-900">
    <%= link_to manufacturer_row.name, manufacturer_row, class: "link-brand" %>
  </td>
  <td class="quantity"><%= number_with_delimiter(manufacturer_row&.volume) %></td>
  <td class="cell-actions">
    <div class="flex justify-end gap-1.5">
      <%= essentials_row_icon_link "View", manufacturer_row, icon: "bi-eye" %>
      <%= essentials_row_icon_link "Edit", edit_manufacturer_path(manufacturer_row), icon: "bi-pencil" %>
    </div>
  </td>
</tr>
