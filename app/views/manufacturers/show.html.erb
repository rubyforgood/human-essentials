<% content_for :title, "#{@manufacturer.name} - Manufacturers - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: @manufacturer.name,
        back: {path: manufacturers_path, label: "Back to manufacturers"},
        actions: essentials_link_button("Edit", edit_manufacturer_path(@manufacturer), variant: :secondary, icon: "bi-pencil") %>

  <%= render "shared/essentials/card", title: "Past donations", padded: @manufacturer.donations.blank? do %>
    <% if @manufacturer.donations.blank? %>
      <%= render "shared/essentials/empty_state", kind: :cold_start,
            title: "No donations from this manufacturer yet",
            body: "Donations attributed to #{@manufacturer.name} will be listed here." %>
    <% else %>
      <div class="table-scroll">
        <table class="data-table">
          <caption>Donations from <%= @manufacturer.name %></caption>
          <thead>
            <tr>
              <th scope="col" class="date">Date</th>
              <th scope="col" class="quantity">Volume</th>
              <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @manufacturer.donations.each do |donation| %>
              <tr>
                <td class="date"><%= donation.created_at.strftime("%m/%d/%Y") %></td>
                <td class="quantity"><%= number_with_delimiter(donation.line_items.total) %></td>
                <td class="text-right"><%= essentials_link_button "View donation", donation, variant: :ghost, size: :sm, icon: "bi-eye" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
</div>
