<tr>
  <td class="font-medium text-slate-900"><%= transfer_row.from.name %></td>
  <td><%= transfer_row.to.name %></td>
  <td class="date"><%= transfer_row.created_at.strftime("%F") %></td>
  <td class="max-w-prose text-slate-600"><%= transfer_row.comment.presence || "none" %></td>
  <td class="quantity"><%= number_with_delimiter(transfer_row.line_items.total) %></td>
  <td class="text-right">
    <div class="flex justify-end gap-1.5">
      <%= essentials_link_button "View", transfer_row, variant: :ghost, size: :sm, icon: "bi-eye" %>
      <%= essentials_action_button "Delete", transfer_path(transfer_row.id), method: :delete,
            variant: :ghost, size: :sm, icon: "bi-trash", class: "text-rose-700 hover:bg-rose-50",
            confirm: "Are you sure you want to permanently remove this transfer?" %>
    </div>
  </td>
</tr>
