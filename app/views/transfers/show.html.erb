<% content_for :title, "Transfer - Inventory - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Transfer from #{@transfer.from.name} to #{@transfer.to.name}",
        subtitle: "Recorded #{@transfer.created_at.strftime("%m/%d/%Y")}.",
        back: {path: transfers_path, label: "Back to transfers"} %>

  <%= render "shared/essentials/card", title: "Items moved", padded: false,
        footer: (@transfer.comment.presence && capture { concat(tag.p("Note: #{@transfer.comment}", class: "text-sm text-slate-600")) }) do %>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
      <table class="data-table">
        <caption>Items moved in this transfer</caption>
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col" class="quantity">Quantity</th>
          </tr>
        </thead>
        <tbody>
          <% @line_items.each do |line_item| %>
            <tr>
              <td class="font-medium text-slate-900"><%= line_item.item.name %></td>
              <td class="quantity"><%= number_with_delimiter(line_item.quantity) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <td>Total</td>
            <td class="quantity"><%= number_with_delimiter(@total) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% end %>
</div>
