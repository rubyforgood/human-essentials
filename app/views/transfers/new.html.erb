<% content_for :title, "New Transfer - Inventory - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8"
     data-controller="confirmation"
     data-confirmation-pre-check-path-value="<%= validate_transfers_path(format: :json) %>">
  <%= render "shared/essentials/page_header",
        title: "New transfer",
        subtitle: "Move quantities of inventory from one storage location to another.",
        back: {path: transfers_path, label: "Back to transfers"} %>

  <%= essentials_form_for @transfer,
        data: {controller: "form-input", confirmation_target: "form"},
        html: {class: "storage-location-required", id: "new_transfer"} do |f| %>
    <div class="space-y-6">
      <%= essentials_error_summary(@transfer) %>

      <%= render "shared/essentials/card", title: "Where the inventory is moving" do %>
        <div class="grid gap-x-5 sm:grid-cols-2">
          <%= render partial: "storage_locations/source", object: f,
                locals: {label: "From storage location", error: "Which location are you moving inventory from?", association_field: :from} %>
          <%= f.association :to, collection: @storage_locations, label: "To storage location",
                hint: "Which location is receiving this?" %>
        </div>
        <%= f.input :comment, label: "Comment", as: :text, input_html: {rows: 3} %>
      <% end %>

      <%= render "shared/essentials/card", title: "Items in this transfer", padded: false do %>
        <%= render "line_items/line_item_table", form: f, id: "transfer_line_items", noun: "transfer" %>
      <% end %>

      <%= essentials_form_actions do %>
        <%= f.button :button, "Save", class: essentials_button_classes(variant: :primary, size: :md),
              data: {disable_with: "Saving...", action: "click->confirmation#openModal"} %>
        <%= essentials_link_button "Cancel", transfers_path, variant: :ghost, size: :md %>
      <% end %>
    </div>
  <% end %>

  <%# Confirmation dialog, populated by confirmation_controller.js from
      transfers_controller#validate; body in transfers/_validate_modal. %>
  <dialog id="transferConfirmationModal"
          class="confirm w-full max-w-2xl rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/40"
          aria-labelledby="transferConfirmationTitle"
          data-confirmation-target="modal"></dialog>
</div>

<%= render partial: "barcode_items/barcode_modal" %>
