<% content_for :title, "History - #{current_organization.name}" %>

<%#
  Rebuilt on the design system. The filters were a hand-rolled form inside a card, and the tag
  closing the form block fell after the div closing the card, with two stray empty columns and a
  Title Case header row -- none of which the class-name audit can see, because none of it uses a
  class that no longer exists. It was also the last page still rendering a Filter button.
%>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%# Reached from a record's history, and in no menu. %>
  <%= render "shared/essentials/page_header",
        back: {path: dashboard_path, label: "Back to dashboard"},
        title: "History",
        subtitle: "Every event that changed inventory, most recent first." %>

  <%#
    The row funnel's narrowing, as two fields inside the bar's form rather than two params beside
    it. It arrives by clicking a row rather than by choosing from a menu, so it has no control of
    its own -- but it is a filter, and a reader who cannot see or undo one is stuck: the only way
    back used to be the browser's Back button. As a field it is counted on the Filters button,
    shown as a chip, and cleared by "Clear all" like everything else.

    Two fields, one chip: only the id carries a `data-filter-label`, so the type is not chipped a
    second time, and `data-filter-group` clears the pair together.
  %>
  <% narrowed_to = params[:eventable_id].presence %>
  <% refers_to = capture do %>
    <%= hidden_field_tag :eventable_type, params[:eventable_type],
          id: "events-eventable-type", data: {filter_group: "refers-to"} %>
    <%= hidden_field_tag :eventable_id, narrowed_to, id: "events-eventable-id",
          data: {filter_group: "refers-to", filter_label: "Refers to",
                 filter_display: "#{params[:eventable_type]} #{narrowed_to}".strip} %>
  <% end if narrowed_to %>

  <%= render "shared/essentials/filter_bar", url: events_path, frame: "events-results",
        hidden_fields: refers_to do %>
    <div class="min-w-0"><%= render partial: "shared/date_range_picker" %></div>
    <div class="min-w-0">
      <%= filter_select(label: "Event type", scope: :by_type, collection: Event.types_for_select,
            key: :id, value: :name, selected: params.dig(:filters, :by_type)) %>
    </div>
    <div class="min-w-0">
      <%= filter_select(label: "Storage location", scope: :by_storage_location,
            collection: current_organization.storage_locations,
            selected: params.dig(:filters, :by_storage_location)) %>
    </div>
    <div class="min-w-0">
      <%= filter_select(label: "Item", scope: :by_item, collection: @items,
            selected: params.dig(:filters, :by_item)) %>
    </div>
  <% end %>

  <%= turbo_frame_tag "events-results", target: "_top", data: {turbo_action: "advance"} do %>
    <%= render "shared/essentials/card", padded: false,
          footer: essentials_pagination_footer(@events) do %>
      <% if @events.blank? %>
        <%= render "shared/essentials/empty_state",
              kind: essentials_filtered? ? :no_results : :cold_start,
              title: essentials_filtered? ? "No events #{date_range_label}" : "No inventory events yet",
              body: essentials_filtered? ? "Try a wider date range, or clear the filters to see every event." : "Every donation, distribution, transfer and adjustment is recorded here as it happens." %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Inventory events</caption>
            <thead>
              <tr>
                <th scope="col">User</th>
                <th scope="col">Type</th>
                <th scope="col">Refers to</th>
                <th scope="col" class="date">Date and time</th>
                <th scope="col">From location</th>
                <th scope="col">To location</th>
                <th scope="col">Items</th>
                <th scope="col" class="cell-actions">Actions</th>
              </tr>
            </thead>
            <tbody>
              <%= render partial: "event_row", collection: @events, as: :event,
                    locals: {items: @items, storage_locs: @locations} %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
