<!-- Content Header (Page header) -->
<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "History - #{current_organization.name}" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">History</h1>
<p class="mt-1 text-sm text-slate-600">for <%= current_organization.name %></p>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>
<!-- Main content -->
<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <!-- left column -->
      <div class="min-w-0">
        <!-- jquery validation -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-5 py-4">
            <h3 class="text-base font-semibold text-slate-900">History Filter</h3>
          </div>

          <!-- form start -->
          <div class="px-5 py-4">
            <%= form_tag(events_path, method: :get) do |f| %>
              <div class="grid gap-6">
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                  <%= label_tag "Date Range" %>
                  <%= render partial: "shared/date_range_picker", locals: {css_class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none"} %>
                </div>
                <div class="form-group col-lg-3 col-md-3 col-sm-6 col-xs-12">
                  <%= filter_select(scope: :by_type, collection: Event.types_for_select, key: :id, value: :name,
                                    selected: params.dig(:filters, :by_type)) %>
                </div>
                <div class="form-group col-lg-3 col-md-3 col-sm-6 col-xs-12">
                  <%= filter_select(scope: :by_storage_location, collection: current_organization.storage_locations,
                                    selected:params.dig(:filters, :by_storage_location)) %>
                </div>
                <div class="form-group col-lg-3 col-md-3 col-sm-6 col-xs-12">
                  <%= filter_select(scope: :by_item, collection: @items,
                                    selected:params.dig(:filters, :by_item)) %>
                </div>
              </div>
            </div>
            <div class="border-t border-slate-200 px-5 py-3">
              <%= filter_button %>
              <%= clear_filter_button %>
            </div>
            <% end # form %>
            </div>

      </div>
      <!--/.col (left) -->
      <!-- right column -->
      <div class="min-w-0">

      </div>
      <!--/.col (right) -->
    </div>

  </div>

  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <!-- Default box -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="px-5 py-4">
            <table class="data-table">
              <thead>
              <tr>
                <th>User</th>
                <th>Type</th>
                <th>Refers To</th>
                <th>Date/Time</th>
                <th>From Location</th>
                <th>To Location</th>
                <th>Items</th>
              </tr>
              </thead>
              <tbody>
                <%= render partial: "event_row", collection: @events, as: :event, locals: { items: @items, storage_locs: @locations} %>
              </tbody>
            </table>
          </div>

          <div class="border-t border-slate-200 px-5 py-3">
            <%= paginate @events %>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>
