<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Estimated Distributions by County - #{current_organization.name}" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Estimated Distributions by County for <%= current_organization.name %></h1>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <!-- Default box -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="grid gap-6">
            <div class="min-w-0">
              <div class="description-block border-right">
                <%= essentials_form_for :filters, url: distributions_by_county_report_path(current_organization), method: :get do |f| %>
                  <%= render partial: "shared/date_range_picker", locals: {css_class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none"} %><br>
                  <%= filter_button %>
                <% end %>
              </div>

            </div>
          </div>

          <div class="px-5 py-4">
            <table class="data-table">
              <thead>
              <tr>
                <th>County</th>
                <th class="numeric">Estimated total items</th>
                <th class="numeric">Estimated total market value</th>
              </tr>
              </thead>
              <tbody>
              <% @breakdown.each do |bd| %>
                <tr>
                  <td><%= bd.name %></td>
                  <td class="numeric"><%= number_with_delimiter(bd.quantity) %></td>
                  <td class="numeric"><%= dollar_presentation(bd.value) %></td>
                </tr>
              <% end %>

              </tbody>

            </table>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
