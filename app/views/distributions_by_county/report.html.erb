<% content_for :title, "Distributions by county - #{current_organization.name}" %>

<%#
  Rebuilt on the design system. It was a hand-rolled card inside three nested empty divs, with a
  Title Case <h1>, a <br> between the date filter and its button, and no empty state -- none of
  which the class-name audit can see, because none of it uses a class that no longer exists.

  The rounding caveat sits under the table rather than in the subtitle: it qualifies the figures,
  so it goes where the figures are, as the manufacturer donations report does with its own note.
%>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Estimated distributions by county",
        subtitle: "Counties are estimated from the served areas your partner agencies declared, so a distribution is spread across the counties its partner covers. Items inside kits are counted; the kits themselves are not.",
        back: {path: reports_path, label: "Back to reports"} %>

  <%# No organization argument: the route has no segment for one, so it was appended as a format
      and every filtered view lived at /distributions_by_county/report.1. %>
  <%= render "shared/essentials/filter_bar",
        url: distributions_by_county_report_path,
        frame: "county-results" do %>
    <% if @dbc_info.items.present? %>
      <%# The list is loose items only, which the control cannot show -- so the hint says what
          choosing one counts, rather than an option label carrying it. %>
      <div class="min-w-0"><%= filter_select(label: "Item", scope: :by_item_id, collection: @dbc_info.items, selected: @dbc_info.selected_item, hint: "Counted whether it went out on its own or inside a kit.") %></div>
    <% end %>
    <div class="min-w-0"><%= filter_select(label: "NDBN reporting category", scope: :by_reporting_category, collection: @dbc_info.reporting_categories, selected: @dbc_info.selected_reporting_category) %></div>
    <div class="min-w-0"><%= render partial: "shared/date_range_picker" %></div>
  <% end %>

  <%= turbo_frame_tag "county-results", target: "_top", data: {turbo_action: "advance"} do %>
    <%= render "shared/essentials/card", padded: false,
          footer: (@dbc_info.distributions? ? tag.p("These are estimates. Each county's share is rounded, so totals can differ slightly from other distribution reports.", class: "text-sm text-slate-600") : nil) do %>
      <% if !@dbc_info.distributions? %>
        <%= render "shared/essentials/empty_state",
              kind: :no_results,
              title: "No distributions #{date_range_label}",
              body: "Try a wider date range, or clear the filters to see every distribution. Counties only appear once a partner in them has received a distribution." %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Estimated items and value by county</caption>
            <thead>
              <tr>
                <th scope="col">County</th>
                <th scope="col" class="numeric">Estimated total items</th>
                <th scope="col" class="numeric">Estimated total market value</th>
              </tr>
            </thead>
            <tbody>
              <% @dbc_info.breakdown.each do |bd| %>
                <tr>
                  <td><%= bd.name %></td>
                  <td class="numeric"><%= number_with_delimiter(bd.quantity) %></td>
                  <td class="numeric"><%= dollar_presentation(bd.value) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
