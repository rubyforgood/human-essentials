<li>
  <%# aria-current is what tells a screen reader which page you are on; the styling keys off
      the same attribute so the two cannot disagree. %>
  <% if page.current? %>
    <%= content_tag :span, page, class: "pagination-link", aria: {current: "page"} %>
  <% else %>
    <%= link_to page, url, remote: remote, rel: page.rel, class: "pagination-link", data: {turbo_frame: "_self"},
          aria: {label: "Go to page #{page}"} %>
  <% end %>
</li>
