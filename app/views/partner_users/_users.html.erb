<%= render "shared/essentials/card", title: "Users", padded: false do %>

  <div class="px-5 py-4">
    <% if users.any? %>
      <table class="data-table whitespace-nowrap">
        <thead>
          <%# Sentence case, and `scope="col"` on all four rather than one -- both design.md rules,
              missed here for the same reason as the row actions: nothing audited this page. %>
          <tr>
            <th scope="col">Name and email</th>
            <th scope="col">Last login</th>
            <th scope="col">Invitation status</th>
            <th scope="col" class="cell-actions">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.order(name: :asc).each do |user| %>
            <tr>
              <td>
                <div class='flex flex-col'>
                  <span><%= user.name %></span>
                  <small><%= user.email %></small>
                </div>
              </td>
              <td>
                <small>
                  <% if user.last_sign_in_at.present? %>
                    <%= time_ago_in_words(user.last_sign_in_at) %> ago <small>(<%= user.invitation_sent_at.strftime('%b %d %Y') %>)</small>
                  <% else %>
                    <%= essentials_status_pill("Never", tone: :neutral, icon: "bi-dash-circle") %>
                  <% end %>
                </small>
              </td>
              <%# One helper for both this table and the bank's, rather than recomputing the state
                  from `invitation_accepted_at`. That local version could not tell *accepted* from
                  *joined*, so a user who had signed in read "Accepted" here and "joined" on
                  /organization. The "last invite sent" line stays: it is the detail this screen
                  has that the other does not, and it is what the Resend button acts on. %>
              <td>
                <div class="flex flex-col items-start justify-center">
                  <%= essentials_invitation_status_pill(user) %>
                  <% if user.invitation_accepted_at.nil? && user.invitation_sent_at.present? %>
                    <small class="text-xs text-slate-500">
                      Last invite sent <strong><%= time_ago_in_words(user.invitation_sent_at) %> ago on <%= user.invitation_sent_at.strftime('%b %d %Y') %></strong>
                    </small>
                  <% end %>
                </div>
              </td>
              <%#
                The one table in the app that never went through the row-actions pass, because no
                audit could reach it: `route-targets.rb` put a *user* id in the `:partner_id` slot,
                so this page was `/partners/10/users`, a 404, and every browser audit recorded it as
                "not reached". It kept three stacked `button_to`s in two weights -- two `:secondary`
                and one `:ghost_danger` -- where design.md asks for one weight and a menu, and the
                column measured 264px against 76-198px elsewhere with 38px triggers against 28px.

                Two of the three destroy or reset something, so both keep a confirmation. Resend is
                offered only while the invitation is outstanding, which is the same condition that
                puts "Invited" in the status column beside it.
              %>
              <td class="cell-actions">
                <%= render "shared/essentials/row_actions", label: user.name.presence || user.email, items: [
                      (if user.invitation_accepted_at.nil?
                         {label: "Resend invitation", path: resend_invitation_partner_user_path(partner, user),
                          icon: "bi-envelope", method: :post}
                       end),
                      {label: "Reset password", path: reset_password_partner_user_path(partner, user),
                       icon: "bi-key", method: :post,
                       confirm: "Send #{user.name.presence || user.email} a link to reset their password?"},
                      {label: "Remove access", path: partner_user_path(partner, user),
                       icon: "bi-slash-circle", method: :delete, tone: :danger,
                       confirm: "Remove #{user.name.presence || user.email}'s access to #{partner.name}? They will no longer be able to sign in."}
                    ].compact %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <%= render "shared/essentials/empty_state", kind: :cold_start,
            title: "No users yet",
            body: "Invite someone so this partner can sign in and request items." %>
    <% end %>
  </div>
<% end %>
