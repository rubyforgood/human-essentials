<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Partner | Users" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900"><%= @partner.name %>'s Users</h1>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>

<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="min-w-0">
        <%= render 'users', users: @users, partner: @partner %>
      </div>

      <div class="min-w-0">
        <%= render 'form', user: @user, partner: @partner %>
      </div>
    </div>
  </div>
</section>
