<% content_for :title, "Partner | Users" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Users",
        subtitle: @partner.name,
        back: {path: partner_path(@partner), label: "Back to #{@partner.name}"} %>

  <div class="space-y-6">
  <%= render "users", users: @users, partner: @partner %>
  <%= render "form", user: @user, partner: @partner %>
</div>
</div>
