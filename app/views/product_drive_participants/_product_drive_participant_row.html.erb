<tr>
  <td class="font-medium text-slate-900">
    <%= link_to product_drive_participant_row.business_name.presence || product_drive_participant_row.contact_name.presence || "Unnamed participant",
          product_drive_participant_row, class: "link-brand" %>
  </td>
  <td><%= product_drive_participant_row&.contact_name %></td>
  <td><%= product_drive_participant_row&.phone %></td>
  <td><%= product_drive_participant_row&.email %></td>
  <td class="quantity"><%= number_with_delimiter(product_drive_participant_row&.volume) %></td>
  <td class="cell-actions">
    <div class="flex justify-end gap-1.5">
      <%= essentials_row_icon_link "View", product_drive_participant_row, icon: "bi-eye" %>
      <%= essentials_row_icon_link "Edit", edit_product_drive_participant_path(product_drive_participant_row), icon: "bi-pencil" %>
    </div>
  </td>
</tr>
