<%# One form. The AdminLTE version nested a second simple_form_for inside the first, which
    is invalid HTML -- the inner <form> swallowed the outer one's fields. %>
<div class="max-w-2xl">
  <%= essentials_error_summary(form) %>

  <%= render "shared/essentials/card" do %>
    <%= essentials_form_for form, remote: request.xhr?, html: {role: "form"} do |f| %>
      <%# The "or" requirements here are conditional (presence: if the other is blank), which
          simple_form deliberately does not infer, and `required: true` would set the HTML5
          required attribute and block a valid submission. Stated in the label instead --
          see docs/design-decisions.md.

          No asterisk in the text. These four used to write one by hand, which was harmless while
          the real marker was also a grey glyph and is not now that it is red: two asterisks in
          two colours, one meaning "required" and one meaning "required unless the other one is
          filled in". The parenthetical says the condition, which the asterisk never did. %>
      <%= f.input :business_name, label: "Business name (business or contact name required)" %>
      <%= f.input :contact_name, label: "Contact name (business or contact name required)" %>
      <%= f.input :phone, label: "Phone (phone or email required)" %>
      <%= f.input :email, label: "Email (phone or email required)" %>
      <%= f.input :address, label: "Address" %>
      <%= f.input :comment, label: "Comment", as: :text, input_html: {rows: 3} %>

      <div class="mt-6 flex items-center gap-2 border-t border-slate-200 pt-5">
        <%= f.button :button, "Save", id: "product-drive-participant-submit", class: essentials_button_classes(variant: :primary, size: :md), data: {disable_with: "Saving..."} %>
        <%= essentials_link_button "Cancel", product_drive_participants_path, variant: :ghost, size: :md %>
      </div>
    <% end %>
  <% end %>
</div>
