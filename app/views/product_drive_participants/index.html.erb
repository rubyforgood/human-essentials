<% content_for :title, "Product Drive Participants - Community - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8" data-controller="dialog">
  <%= render "shared/essentials/page_header",
        title: "Product drive participants",
        subtitle: "Businesses and individuals who host or contribute to product drives.",
        actions: capture {
          if @product_drive_participants.any?
            concat essentials_link_button("Export", product_drive_participants_path(format: :csv, filters: filter_params.merge(date_range: date_range_params)), variant: :secondary, icon: "bi-download")
          else
            concat(button_tag(type: "button", class: essentials_button_classes(variant: :secondary), data: {action: "click->dialog#open", dialog_id_param: "csv-import-modal"}) do
              concat tag.i(nil, class: "bi-upload", aria: {hidden: true})
              concat " Import participants"
            end)
          end
          concat essentials_link_button("New participant", new_product_drive_participant_path, variant: :primary, icon: "bi-plus-lg")
        } %>

  <%= render "shared/essentials/card", padded: false do %>
    <% if @product_drive_participants.empty? %>
      <%= render "shared/essentials/empty_state", kind: :cold_start,
            title: "No product drive participants yet",
            body: "Add the businesses and people who run drives for you, so their donations can be credited.",
            action: essentials_link_button("New participant", new_product_drive_participant_path, variant: :primary, icon: "bi-plus-lg") %>
    <% else %>
      <div class="table-scroll">
        <table class="data-table">
          <caption>Product drive participants and the total items each has contributed</caption>
          <thead>
            <tr>
              <th scope="col">Business name</th>
              <th scope="col">Contact name</th>
              <th scope="col">Phone</th>
              <th scope="col">Email</th>
              <th scope="col" class="quantity">Total items</th>
              <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody><%= render partial: "product_drive_participant_row", collection: @product_drive_participants %></tbody>
        </table>
      </div>
    <% end %>
  <% end %>

  <%= render layout: "shared/essentials/csv_import_modal", locals: {
        import_type: "Product drive participants", csv_template_url: "/product_drive_participants.csv", csv_import_url: import_csv_product_drive_participants_path
      } do %>
    <li>Open the CSV file in Excel or your favourite spreadsheet program.</li>
    <li>Delete the sample data and enter the participant names, emails and phone numbers in the matching columns.</li>
    <li>Save the file as a CSV.</li>
  <% end %>
</div>
