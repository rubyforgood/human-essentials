<%# Closes the dialog, then refreshes the select it was opened from and selects the new
    record. $("#modal_new").modal("hide") is gone with the Bootstrap modal. %>
<% flash.discard %>
document.querySelector("#modal_new dialog")?.close();
(function () {
  const select = document.getElementById("donation_product_drive_participant_id");
  if (!select) return;
  select.innerHTML = '<%= j options_from_collection_for_select(current_organization.product_drive_participants, :id, lambda { |p| p.business_name.presence || p.contact_name }) %>';
  const blank = document.createElement("option");
  blank.value = "";
  blank.textContent = "---Create new Participant---";
  select.appendChild(blank);
  select.value = "<%= @product_drive_participant[:id] %>";
  select.dispatchEvent(new Event("change", { bubbles: true }));
})();
