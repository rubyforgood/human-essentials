<% participant = @product_drive_participant %>
<% name = participant.business_name.presence || participant.contact_name.presence || "Participant" %>
<% content_for :title, "#{name} - Product Drive Participants - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: name,
        back: {path: product_drive_participants_path, label: "Back to participants"},
        actions: essentials_link_button("Edit", edit_product_drive_participant_path(participant), variant: :secondary, icon: "bi-pencil") %>

  <div class="space-y-6">
    <%= render "shared/essentials/card", title: "Details" do %>
      <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
        <% {"Contact name" => participant.contact_name, "Phone" => participant.phone, "Email" => participant.email, "Address" => participant.address}.each do |label, value| %>
          <div>
            <dt class="text-xs font-medium text-slate-500"><%= label %></dt>
            <dd class="mt-0.5 text-sm text-slate-900"><%= value.presence || "—" %></dd>
          </div>
        <% end %>
        <% if participant.comment.present? %>
          <div class="sm:col-span-2 lg:col-span-4">
            <dt class="text-xs font-medium text-slate-500">Comment</dt>
            <dd class="mt-0.5 text-sm text-slate-900"><%= participant.comment %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <%= render "shared/essentials/card", title: "Donations", padded: participant.donations.blank? do %>
      <% if participant.donations.blank? %>
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "No donations recorded yet",
              body: "Donations credited to this participant will be listed here." %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Donations from <%= name %></caption>
            <thead>
              <tr>
                <th scope="col" class="date">Date</th>
                <th scope="col" class="quantity">Volume</th>
                <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% participant.donations.each do |donation| %>
                <tr>
                  <td class="date"><%= donation.created_at.strftime("%m/%d/%Y") %></td>
                  <td class="quantity"><%= number_with_delimiter(donation.line_items.total) %></td>
                  <td class="text-right"><%= essentials_link_button "View donation", donation, variant: :ghost, size: :sm, icon: "bi-eye" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
