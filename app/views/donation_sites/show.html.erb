<% content_for :title, "#{@donation_site.name} - Donation Sites - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: @donation_site.name,
        subtitle: @donation_site.address.presence,
        back: {path: donation_sites_path, label: "Back to donation sites"},
        actions: essentials_link_button("Edit", edit_donation_site_path(@donation_site), variant: :secondary, icon: "bi-pencil") %>

  <div class="space-y-6">
    <%= render "shared/essentials/card", title: "Details" do %>
      <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
        <% {"Contact name" => @donation_site.contact_name, "Email" => @donation_site.email, "Phone" => @donation_site.phone}.each do |label, value| %>
          <div>
            <dt class="text-xs font-medium text-slate-500"><%= label %></dt>
            <dd class="mt-0.5 text-sm text-slate-900"><%= value.presence || "—" %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <%= render "shared/essentials/card", title: "Donations received here", padded: @donation_site.donations.blank? do %>
      <% if @donation_site.donations.blank? %>
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "No donations from this site yet",
              body: "Donations recorded against this site will be listed here." %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Donations received at <%= @donation_site.name %></caption>
            <thead>
              <tr>
                <th scope="col">Storage location</th>
                <th scope="col" class="quantity">Quantity of items</th>
                <th scope="col" class="quantity">Variety of items</th>
                <th scope="col">Source</th>
              </tr>
            </thead>
            <tbody>
              <% @donation_site.donations.each do |donation| %>
                <tr>
                  <td><%= donation.storage_location&.name %></td>
                  <td class="quantity"><%= number_with_delimiter(donation.line_items.total) %></td>
                  <td class="quantity"><%= donation.line_items.size %></td>
                  <td><%= donation.source %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
