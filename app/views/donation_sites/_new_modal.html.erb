<%#
  "New donation site" form, loaded into the modal-new Turbo frame from the donation form's
  select. Rendered as a native <dialog> -- see donations_modal_controller.js.
%>
<%= turbo_frame_tag "modal-new" do %>
  <dialog class="w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/40"
          aria-labelledby="new-donation-site-title">
    <div class="flex items-start justify-between gap-3 border-b border-slate-200 px-5 py-4">
      <h2 id="new-donation-site-title" class="text-base font-semibold text-slate-900">New donation site</h2>
      <button type="button" formmethod="dialog"
              class="rounded-lg p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
              aria-label="Close dialog"
              onclick="this.closest('dialog').close()">
        <i class="bi-x-lg text-sm" aria-hidden="true"></i>
      </button>
    </div>

    <div class="px-5 py-4">
      <% flash.each do |key, value| %>
        <% tone = essentials_flash_tone(key) %>
        <% style = essentials_flash_style(tone) %>
        <div class="mb-4 flex items-start gap-2 rounded-2xl border px-4 py-3 text-sm <%= style[:bar] %>"
             role="<%= [:warning, :danger].include?(tone) ? "alert" : "status" %>">
          <i class="<%= style[:icon] %> mt-0.5 shrink-0" aria-hidden="true"></i>
          <span><%= value %></span>
        </div>
      <% end %>

      <%= render partial: "form", object: @donation_site %>
    </div>
  </dialog>
<% end %>
