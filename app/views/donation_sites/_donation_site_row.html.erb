<tr class="<%= local_assigns[:class] %>">
  <td class="font-medium text-slate-900">
    <%= link_to donation_site_row.name, donation_site_row, class: "text-brand-700 hover:text-brand-800" %>
    <%= essentials_status_pill("Inactive", tone: :neutral, icon: "bi-slash-circle") unless donation_site_row.active? %>
  </td>
  <td class="notes"><%= donation_site_row.address %></td>
  <td><%= donation_site_row.contact_name %></td>
  <td><%= donation_site_row.email %></td>
  <td><%= donation_site_row.phone %></td>
  <td class="cell-actions">
    <%# Three inline, and the third changed between Deactivate and Restore depending on the row --
        both reasons to collapse. No visible View: the name in the first cell links to it. %>
    <%= render "shared/essentials/row_actions", label: donation_site_row.name, items: [
          {label: "Edit", path: edit_donation_site_path(donation_site_row), icon: "bi-pencil"},
          (if donation_site_row.active?
             {label: "Deactivate", path: deactivate_donation_site_path(donation_site_row),
              icon: "bi-slash-circle", method: :put,
              confirm: confirm_deactivate_msg(donation_site_row.name)}
           else
             {label: "Restore", path: reactivate_donation_site_path(donation_site_row),
              icon: "bi-arrow-counterclockwise", method: :put,
              confirm: confirm_reactivate_msg(donation_site_row.name)}
           end)
        ] %>
  </td>
</tr>
