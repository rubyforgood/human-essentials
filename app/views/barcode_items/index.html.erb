<% content_for :title, "Barcode Items - Inventory - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Barcode items",
        subtitle: "Barcodes that map a scan to an item and a quantity.",
        actions: capture {
          if @barcode_items.any?
            concat essentials_link_button("Export", barcode_items_path(format: :csv, filters: filter_params.merge(date_range: date_range_params)), variant: :secondary, icon: "bi-download", data: {filter_export: true})
          end
          concat essentials_link_button("New barcode", new_barcode_item_path, variant: :primary, icon: "bi-plus-lg")
        } %>

  <%= render "shared/essentials/filter_bar", url: barcode_items_path, frame: "barcode-items-results" do %>
    <div class="min-w-0"><%= filter_select(label: "Item", scope: :barcodeable_id, collection: @items.alphabetized, key: :id, value: :name, selected: @selected_barcodeable_id) %></div>
    <div class="min-w-0"><%= filter_select(label: "Base item", scope: :by_item_partner_key, collection: @base_items.order("name"), key: :partner_key, value: :name, selected: @selected_partner_key) %></div>
    <div class="min-w-0"><%= filter_text(label: "Barcode (boop it!)", scope: :by_value, selected: @selected_barcode_id) %></div>
  <% end %>
  <%= turbo_frame_tag "barcode-items-results", target: "_top", data: {turbo_action: "advance"} do %>

    <%= render "shared/essentials/card", padded: false,
          footer: essentials_pagination_footer(@paginated_barcode_items) do %>
      <% if @barcode_items.blank? %>
        <%= render "shared/essentials/empty_state",
              kind: essentials_filtered? ? :no_results : :cold_start,
              title: essentials_filtered? ? "No barcodes match those filters" : "No barcodes yet",
              body: essentials_filtered? ? "Clear the filters to see every barcode." : "Register a barcode so scanning a box fills in the item and quantity for you.",
              action: essentials_filtered? ? nil : essentials_link_button("Add your first barcode", new_barcode_item_path, variant: :primary, icon: "bi-plus-lg") %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Registered barcodes</caption>
            <thead>
              <tr>
                <th scope="col">Item type</th>
                <th scope="col" class="quantity">Quantity in the box</th>
                <th scope="col">Barcode</th>
                <th scope="col" class="cell-actions">Actions</th>
              </tr>
            </thead>
            <tbody><%= render partial: "barcode_item_row", collection: @paginated_barcode_items %></tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
