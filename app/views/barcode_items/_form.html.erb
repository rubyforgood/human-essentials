<div class="max-w-2xl">
  <%= essentials_error_summary(form) %>

  <%= essentials_form_for form, html: {role: "form"} do |f| %>
    <%= render "shared/essentials/card" do %>
      <%= f.association :barcodeable, collection: @items, label: "Item" %>
      <%= f.input :quantity, label: "Quantity in the box" %>

      <%# One partial for all three barcode forms -- see shared/essentials/_barcode_scan_field. %>
      <%= render "shared/essentials/barcode_scan_field", f: f,
            hint: "Scan the barcode on the box, or type the digits printed under the bars. " \
                  "Saving links it to the item and quantity above." %>
        <div class="mt-2 hidden overflow-hidden rounded-lg border border-slate-200 bg-slate-900 p-2 text-xs text-white [&_canvas]:hidden [&_canvas.drawingBuffer]:block [&_video]:w-full"
             data-barcode-viewport role="status"></div>
      </div>
    <% end %>

    <%= essentials_form_actions do %>
      <%= f.button :button, "Save", class: essentials_button_classes(variant: :primary, size: :md), data: {disable_with: "Saving..."} %>
      <%= essentials_link_button "Cancel", barcode_items_path, variant: :ghost, size: :md %>
    <% end %>
  <% end %>
</div>
