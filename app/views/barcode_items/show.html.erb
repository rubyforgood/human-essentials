<% content_for :title, "Barcode - Inventory - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: @barcode_item.barcodeable.name,
        back: {path: barcode_items_path, label: "Back to barcode items"},
        actions: essentials_link_button("Edit", edit_barcode_item_path(@barcode_item), variant: :secondary, icon: "bi-pencil") %>

  <%= render "shared/essentials/card", title: "Details" do %>
    <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <dt class="text-xs font-medium text-slate-500">Item type</dt>
        <dd class="mt-0.5 text-sm text-slate-900"><%= @barcode_item.barcodeable.name %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-slate-500">Quantity in the box</dt>
        <dd class="mt-0.5 text-sm text-slate-900"><%= number_with_delimiter(@barcode_item.quantity) %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-slate-500">Barcode</dt>
        <dd class="mt-0.5 font-mono text-sm text-slate-900"><%= @barcode_item.value %></dd>
      </div>
    </dl>
  <% end %>
</div>
