<%#
  "Add new barcode" dialog, opened either by the New barcode button or automatically by
  utils/barcode_items.js when a scanned barcode is not recognised.
%>
<%
  remote = true if defined?(remote).nil? || remote.nil?
  url ||= barcode_items_path
%>
<dialog id="newBarcode"
        class="w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/40"
        aria-labelledby="newBarcodeTitle">
  <div class="flex items-start justify-between gap-3 border-b border-slate-200 px-5 py-4">
    <h2 id="newBarcodeTitle" class="text-base font-semibold text-slate-900">Add new barcode</h2>
    <button type="button"
            class="rounded-lg p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
            aria-label="Close dialog"
            onclick="this.closest('dialog').close()">
      <i class="bi-x-lg text-sm" aria-hidden="true"></i>
    </button>
  </div>

  <%= essentials_form_for BarcodeItem.new, url: url, html: {role: "form"}, remote: remote do |f| %>
    <div class="px-5 py-4">
      <%= f.input :quantity, label: "Quantity in the box" %>
      <%= f.association :barcodeable, collection: @items, label: "Item" %>
      <div data-barcode-scan>
        <div class="relative">
          <%= f.input :value, label: "Barcode", input_html: {class: "pr-10"} %>
          <%# No id. Three partials carried `id="barcode-scanner-btn"` and a donation form renders
              two of them, so the camera drew itself into whichever came first in the document.
              The scanner finds its input and its viewport through [data-barcode-scan] instead. %>
          <button type="button"
                  class="barcode-scanner absolute right-2 top-8 rounded-lg p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
                  aria-label="Scan a barcode with the camera" aria-expanded="false">
            <i class="bi-upc-scan" aria-hidden="true"></i>
          </button>
        </div>
        <div class="mt-2 hidden overflow-hidden rounded-lg border border-slate-200 bg-slate-900 p-2 text-xs text-white [&_canvas]:hidden [&_canvas.drawingBuffer]:block [&_video]:w-full" data-barcode-viewport role="status"></div>
      </div>
      <%# utils/barcode_items.js writes the id of the field that opened this dialog here, so
          it knows which one to fill in on save. %>
      <input type="hidden" value="" id="trigger-field-id">
    </div>

    <div class="flex flex-wrap justify-end gap-2 border-t border-slate-200 px-5 py-3">
      <button type="button" class="<%= essentials_button_classes(variant: :ghost, size: :md) %>"
              onclick="this.closest('dialog').close()">Cancel</button>
      <%= f.button :button, "Save", class: essentials_button_classes(variant: :primary, size: :md), data: {disable_with: "Saving..."} %>
    </div>
  <% end %>
</dialog>
