// The barcode dialog is a native <dialog>; Bootstrap's .modal("hide") is not a function any
// more and threw here, leaving the dialog open over the field it had just filled in.
document.getElementById('newBarcode')?.close();
source_field = $('#trigger-field-id').val();

// Clear out the fields, capturing the quantity and item_id
item_id = $('#barcode_item_barcodeable_id').val();
quantity = $('#barcode_item_quantity').val();
$('#barcode_item_quantity').val('');
$('#barcode_item_barcodeable_id').val('');
$('#barcode_item_value').val('');
$('#trigger-field-id').val('');

// Notify the user, in the flash strip rather than a toastr pop-up.
//
// `toastr.success(...)` here was invisible on a design-system page. The essentials layouts load
// only tailwind.css and no toastr CSS exists in that build -- measured, zero matching rules -- so
// the container came out `position: static` with no background or padding, appended at the foot of
// the document: y=1284 on a 900px viewport, below the fold. The scan worked and said nothing.
//
// Rendered from the same partial the server-side strip uses, so a message raised here is the same
// object as one that arrived with the page.
(function () {
  const region = document.querySelector("[data-flash-region]");
  if (!region) return;
  region.insertAdjacentHTML("beforeend", <%= render("shared/essentials/flash_message", key: "notice", message: "Barcode added to inventory.").to_json.html_safe %>);
})();

// Trigger the capture_entry/barcode_item_lookup functions with a return keypress
// which fills in the item name and quantity, adds new item, and changes focus
return_keypress = $.Event( "keypress", { which: 13 } )
$("input.__barcode_item_lookup").last().trigger(return_keypress);
