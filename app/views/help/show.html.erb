<% content_for :title, "Help - #{current_organization&.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Help",
        subtitle: "Answers to common questions, and how to reach us." %>

  <div class="space-y-6">
    <%= render "shared/essentials/card", title: "Frequently asked questions" do %>
      <%= form_for_filterrific @filterrific, remote: true do |f| %>
        <div class="flex flex-wrap items-end gap-4">
          <div class="min-w-[16rem]">
            <%= f.label :search_title, "Search by question", class: EssentialsUiHelper::FILTER_LABEL_CLASSES %>
            <%= f.text_field :search_title, class: "filterrific-periodically-observed #{EssentialsUiHelper::FILTER_CONTROL_CLASSES}" %>
          </div>
          <div class="pb-2"><%= render_filterrific_spinner %></div>
        </div>
      <% end %>

      <div id="filterrific_results" class="mt-5">
        <%= render partial: "bank_questions" %>
      </div>
    <% end %>

    <%= render "shared/essentials/card", title: "Still need help?" do %>
      <ul class="space-y-3 text-sm text-slate-700">
        <li>
          Have suggestions to help improve the app, or other questions about it?
          <%= link_to "Reach out on Slack", "https://human-essential.slack.com/archives/CG1NL2MRC",
                class: "font-medium text-brand-700 underline hover:text-brand-800" %>.
        </li>
        <li>
          Not a member of the Human Essentials Slack group?
          <%= link_to "Request a login", "https://join.slack.com/t/human-essential/shared_invite/zt-bfa8tymd-d8Ks3Mq000COcRe~nfs~zg",
                class: "font-medium text-brand-700 underline hover:text-brand-800" %>.
        </li>
        <li>
          Still stuck?
          <%= link_to "Submit a support ticket", support_ticket_form_url, target: "_blank", rel: "noopener",
                class: "font-medium text-brand-700 underline hover:text-brand-800" %>
          and we will do our best to follow up by email. Our team meets and triages email on Sundays.
        </li>
      </ul>
    <% end %>
  </div>
</div>
