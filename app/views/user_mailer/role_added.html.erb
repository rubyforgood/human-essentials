<p>Hello <%= @user.display_name %>,</p>

<p>This is a notification that you have been given the following roles in the Human Essentials app:</p>
<ul>
<% @roles.each do |role| %>
  <li><%= role.name.titleize %> for <%= @resource.name %></li>
<% end %>
</ul>

<p>Log in to <%= link_to "Human Essentials", root_url %> to see your new role.</p>
