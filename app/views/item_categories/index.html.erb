<% content_for :title, "Item categories - Items & Inventory - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%#
    The page's primary action follows the tab: on the item list it is "New item", here it is
    "New item category". One place a page's main action ever appears, rather than a button
    tucked between the tab strip and the table. See design.md.
  %>
  <%= render "shared/essentials/page_header",
        title: "Items & inventory",
        subtitle: "What #{current_organization.name} stocks, and how much of it.",
        actions: capture {
          concat essentials_link_button("New item category", new_item_category_path, variant: :primary, icon: "bi-plus-lg")
        } %>

  <%= render "shared/essentials/card", padded: false do %>
    <%= render "items/catalogue_tabs", current: :categories %>

    <% if @item_categories.blank? %>
      <%= render "shared/essentials/empty_state", kind: :cold_start,
            title: "No item categories yet",
            body: "Categories group related items together and make reporting easier.",
            action: essentials_link_button("Add your first item category", new_item_category_path, variant: :primary, icon: "bi-plus-lg") %>
    <% else %>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
        <table class="data-table">
          <caption>Item categories and the items in each</caption>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col" class="notes">Description</th>
              <%# Not `notes`: this cell is a <ul> of links, and clipping it would leave focusable links
                    invisible. A long list of links in a cell needs its own answer -- a count, or
                    "+N more" -- which is recorded in docs/todo.md. %>
                <th scope="col">Items in category</th>
              <th scope="col" class="cell-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @item_categories.each do |item_category| %>
              <tr data-item-category-id="<%= item_category.id %>">
                <td class="font-medium text-slate-900">
                  <%= link_to item_category.name, item_category_path(item_category), class: "text-brand-700 hover:text-brand-800" %>
                </td>
                <td class="notes text-slate-600"><%= item_category.description %></td>
                <%#
                  Three, then a link to the rest.

                  This printed every item, which made the worst row **19 links, 710 characters and
                  439px tall** -- three categories and the table was 979px. `.notes` clipping is not
                  available to a cell of links: clipping would leave focusable anchors invisible,
                  which is a keyboard trap rather than a tidy column.

                  Three is enough to say what kind of category it is, and "+N more" goes to the
                  category page, which lists all of them. See design.md, "A column of links".
                %>
                <td class="wrap">
                  <% shown = item_category.items.order(:name).first(EssentialsUiHelper::ITEM_CATEGORY_PREVIEW_COUNT + 1) %>
                  <% overflow = shown.size > EssentialsUiHelper::ITEM_CATEGORY_PREVIEW_COUNT %>
                  <% if shown.empty? %>
                    <span class="text-sm text-slate-500">&mdash;</span>
                  <% else %>
                    <ul class="space-y-0.5">
                      <% shown.first(EssentialsUiHelper::ITEM_CATEGORY_PREVIEW_COUNT).each do |item| %>
                        <li><%= link_to item.name, item_path(item.id), class: "text-brand-700 hover:text-brand-800" %></li>
                      <% end %>
                      <% if overflow %>
                        <%# The count is the *remaining* items, so it needs the real total rather
                            than the four that were loaded to detect the overflow. %>
                        <li class="pt-0.5">
                          <%= link_to "+#{item_category.items.size - EssentialsUiHelper::ITEM_CATEGORY_PREVIEW_COUNT} more",
                                item_category_path(item_category),
                                class: "text-sm font-medium text-brand-700 hover:text-brand-800" %>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                </td>
                <td class="cell-actions">
                  <div class="flex justify-end gap-1.5">
                    <%= essentials_row_icon_link "View", item_category_path(item_category), icon: "bi-eye" %>
                    <%= essentials_row_icon_link "Edit", edit_item_category_path(item_category.id), icon: "bi-pencil" %>
                    <% if item_category.items.count <= 0 %>
                      <%= essentials_row_icon_action "Delete", item_category_path(item_category.id), method: :delete, icon: "bi-trash", tone: :danger,
                            confirm: confirm_delete_msg(item_category.name) %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
</div>
