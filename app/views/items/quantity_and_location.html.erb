<% content_for :title, "Items, quantity and location - Items & Inventory - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Items & inventory",
        subtitle: "What #{current_organization.name} stocks, and how much of it.",
        actions: capture {
          if @items.any?
            concat essentials_link_button("Export", items_path(format: :csv, include_inactive_items: @include_inactive_items, filters: filter_params.merge(date_range: date_range_params)), variant: :secondary, icon: "bi-download", data: {filter_export: true})
          end
          concat essentials_link_button("New item", new_item_path, variant: :primary, icon: "bi-plus-lg")
        } %>

  <%# Filters under the strip and the frame around the table alone, so the strip is at the same
      height on every catalogue tab and applying a filter cannot re-render it. See design.md. %>
  <%= render "shared/essentials/card", padded: false do %>
    <%= render "items/catalogue_tabs", current: :quantity_and_location %>

    <%= render "shared/essentials/filter_bar", url: quantity_and_location_items_path, in_card: true,
          frame: "items-results" do %>
      <div class="min-w-0"><%= filter_select(label: "NDBN reporting category", scope: :by_reporting_category, collection: Item.reporting_categories_for_select, selected: @selected_reporting_category) %></div>
      <div class="pb-2"><%= filter_checkbox(label: "Also include inactive items", scope: "include_inactive_items", selected: @include_inactive_items) %></div>
    <% end %>

    <%= turbo_frame_tag "items-results", target: "_top", data: {turbo_action: "advance"} do %>
      <%= render partial: "items_quantity_and_location" %>
    <% end %>
  <% end %>
</div>
