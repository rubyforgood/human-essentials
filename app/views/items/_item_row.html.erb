<tr data-item-id="<%= item_row.id %>">
  <td>
    <% if item_row.item_category %>
      <%= link_to item_row.item_category.name, item_category_path(item_row.item_category), class: "font-medium text-brand-700 hover:text-brand-800" %>
    <% end %>
  </td>
  <td class="font-medium text-slate-900">
    <%= link_to item_row.name, item_path(item_row), class: "text-brand-700 hover:text-brand-800" %>
    <%= essentials_status_pill("Inactive", tone: :neutral, icon: "bi-slash-circle") unless item_row.active? %>
  </td>
  <td><%= item_row.reporting_category_humanized %></td>
  <td class="text-slate-600"><%= truncate item_row.additional_info, length: 25 %></td>
  <td class="quantity"><%= item_row.distribution_quantity %></td>
  <td class="numeric"><%= dollar_value(item_row.value_in_cents) %></td>
  <% if Flipper.enabled?(:enable_packs) && current_organization.request_units.present? %>
    <td><%= item_row.request_units.pluck(:name).join(", ") %></td>
  <% end %>
  <td class="text-right">
    <div class="flex flex-wrap justify-end gap-1.5">
      <%= essentials_link_button "View", item_path(item_row), variant: :ghost, size: :sm, icon: "bi-eye" %>
      <%= essentials_link_button "Edit", edit_item_path(item_row), variant: :ghost, size: :sm, icon: "bi-pencil" %>
      <% if item_row.active? %>
        <% if item_row.can_delete?(inventory, kits) %>
          <%= essentials_action_button "Delete", item_path(item_row), method: :delete,
                variant: :ghost, size: :sm, icon: "bi-trash", class: "text-rose-700 hover:bg-rose-50",
                confirm: confirm_delete_msg(item_row.name) %>
        <% elsif item_row.can_deactivate_or_delete?(inventory, kits) %>
          <%= essentials_action_button "Deactivate", deactivate_item_path(item_row), method: :delete,
                variant: :ghost, size: :sm, icon: "bi-slash-circle",
                confirm: confirm_deactivate_msg(item_row.name) %>
        <% else %>
          <%# An item still held in inventory or used by a kit cannot be deactivated. The
              control stays a real disabled <button> so the state reaches assistive tech, and
              the reason is sr-only text rather than a hover-only title. %>
          <%= button_to deactivate_item_path(item_row), method: :delete, disabled: true,
                form_class: "inline-block",
                class: essentials_button_classes(variant: :ghost, size: :sm) do %>
            <i class="bi-slash-circle" aria-hidden="true"></i>Deactivate<span class="sr-only">&nbsp;— unavailable while this item is still in inventory or used by a kit</span>
          <% end %>
        <% end %>
      <% else %>
        <%= essentials_action_button "Restore", restore_item_path(item_row), method: :patch,
              variant: :ghost, size: :sm, icon: "bi-arrow-counterclockwise",
              confirm: confirm_restore_msg(item_row.name) %>
      <% end %>
    </div>
  </td>
</tr>
