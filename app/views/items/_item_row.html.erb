<tr data-item-id="<%= item_row.id %>">
  <td>
    <% if item_row.item_category %>
      <%= link_to item_row.item_category.name, item_category_path(item_row.item_category), class: "font-medium text-brand-700 hover:text-brand-800" %>
    <% end %>
  </td>
  <td class="font-medium text-slate-900">
    <%= link_to item_row.name, item_path(item_row), class: "text-brand-700 hover:text-brand-800" %>
    <%= essentials_status_pill("Inactive", tone: :neutral, icon: "bi-slash-circle") unless item_row.active? %>
  </td>
  <td><%= item_row.reporting_category_humanized %></td>
  <td class="text-slate-600"><%= truncate item_row.additional_info, length: 25 %></td>
  <td class="quantity"><%= item_row.distribution_quantity %></td>
  <td class="numeric"><%= dollar_value(item_row.value_in_cents) %></td>
  <% if Flipper.enabled?(:enable_packs) && current_organization.request_units.present? %>
    <td class="notes"><%= item_row.request_units.pluck(:name).join(", ") %></td>
  <% end %>
  <td class="cell-actions">
    <%
      row_items =
        if !item_row.active?
          [{label: "Edit", path: edit_item_path(item_row), icon: "bi-pencil"},
           {label: "Restore", path: restore_item_path(item_row), icon: "bi-arrow-counterclockwise",
            method: :patch, confirm: confirm_restore_msg(item_row.name)}]
        elsif item_row.can_delete?(inventory, kits)
          [{label: "Edit", path: edit_item_path(item_row), icon: "bi-pencil"},
           {label: "Delete", path: item_path(item_row), icon: "bi-trash", method: :delete,
            tone: :danger, confirm: confirm_delete_msg(item_row.name)}]
        elsif item_row.can_deactivate_or_delete?(inventory, kits)
          [{label: "Edit", path: edit_item_path(item_row), icon: "bi-pencil"},
           {label: "Deactivate", path: deactivate_item_path(item_row), icon: "bi-slash-circle",
            method: :delete, confirm: confirm_deactivate_msg(item_row.name)}]
        else
          # Offered even though it will fail: the server checks and answers with the reason and the
          # next step, which is more than a disabled item can carry.
          #
          # **And no `confirm:` on this branch.** A confirmation guards a destructive act that is
          # about to happen; nothing is about to happen here. Asking "are you sure?" about something
          # that cannot occur, and only revealing that after the answer, is two steps to a dead end.
          [{label: "Edit", path: edit_item_path(item_row), icon: "bi-pencil"},
           {label: "Deactivate", path: deactivate_item_path(item_row), icon: "bi-slash-circle",
            method: :delete}]
        end
    %>
    <%# No visible View: the item's name in this row already links to it. %>
    <%= render "shared/essentials/row_actions", label: item_row.name, items: row_items %>
  </td>
</tr>
