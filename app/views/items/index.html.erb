<% content_for :title, "Items & Inventory - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Items & inventory",
        subtitle: "What #{current_organization.name} stocks, and how much of it.",
        actions: capture {
          if @items.any?
            concat essentials_link_button("Export", items_path(format: :csv, include_inactive_items: @include_inactive_items, filters: filter_params.merge(date_range: date_range_params)), variant: :secondary, icon: "bi-download")
          end
          concat essentials_link_button("New item", new_item_path, variant: :primary, icon: "bi-plus-lg")
        } %>

  <%= render "shared/essentials/filter_bar", url: items_path do %>
    <div class="min-w-0"><%= filter_select(label: "NDBN reporting category", scope: :by_reporting_category, collection: Item.reporting_categories_for_select, selected: @selected_reporting_category) %></div>
    <div class="pb-2"><%= filter_checkbox(label: "Also include inactive items", scope: "include_inactive_items", selected: @include_inactive_items) %></div>
  <% end %>

  <%= render "shared/essentials/card", padded: false do %>
    <div data-controller="tabs">
      <%= render "shared/essentials/tabs", tabs: [
            {id: "item-list", label: "Item list"},
            {id: "item-categories", label: "Item categories"},
            {id: "quantity-location", label: "Items, quantity and location"},
            {id: "item-inventory", label: "Item inventory"},
            {id: "kits", label: "Kits"}
          ] %>

      <%= render partial: "item_list", locals: {items: @items, inventory: @inventory, kits: @kits.active} %>
      <%= render partial: "item_categories", locals: {item_categories: @item_categories} %>
      <%= render partial: "items_quantity_and_location" %>
      <%= render partial: "items_inventory" %>
      <%= render partial: "kits" %>
    </div>
  <% end %>
</div>
