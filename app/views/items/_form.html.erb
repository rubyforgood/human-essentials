<div class="max-w-2xl">
  <%= essentials_error_summary(@item) %>

  <%= render "shared/essentials/card" do %>
    <%= essentials_form_for @item.becomes(Item), remote: request.xhr? do |f| %>
      <%= f.input :name, label: "Name" %>
      <%= f.input :item_category_id, label: "Category", collection: @item_categories,
            hint: "Categories help organize and identify items" %>
      <%= f.input :reporting_category, label: "NDBN reporting category",
            collection: Item.reporting_categories_for_select,
            disabled: !!@item.kit_id, required: !@item.kit_id, hint: @reporting_category_hint %>
      <%= f.input :value_in_dollars, label: "Value per item" %>
      <%= f.input :distribution_quantity, label: "Quantity per individual" %>

      <% if current_user.has_cached_role?(Role::ORG_ADMIN, current_organization) %>
        <%= f.input :on_hand_minimum_quantity, label: "On hand minimum quantity" %>
        <%= f.input :on_hand_recommended_quantity, label: "On hand recommended quantity" %>
      <% end %>

      <%= f.input :package_size, label: "Package size", input_html: {min: 0} %>

      <% if Flipper.enabled?(:enable_packs) && current_organization.request_units.present? %>
        <%= f.association :request_units, as: :check_boxes, label: "Additional custom request units",
              collection: current_organization.request_units,
              checked: selected_item_request_units(@item),
              label_method: :name, value_method: :id %>
      <% end %>

      <%= f.input :visible_to_partners, label: "Item is visible to partners?", as: :boolean %>

      <%= f.input :additional_info, label: "Additional information (bank use only)", as: :text,
            maxlength: 500, hint: "500 character maximum", input_html: {rows: 3} %>

      <div class="mt-6 flex items-center gap-2 border-t border-slate-200 pt-5">
        <%= f.button :button, "Save", class: essentials_button_classes(variant: :primary, size: :md), data: {disable_with: "Saving..."} %>
        <%= essentials_link_button "Cancel", items_path, variant: :ghost, size: :md %>
      </div>
    <% end %>
  <% end %>
</div>
