<% content_for :title, "#{@item.name} - Items - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: @item.name,
        subtitle: @item.item_category&.name,
        back: {path: items_path, label: "Back to items"},
        actions: essentials_link_button("Edit", edit_item_path(@item), variant: :secondary, icon: "bi-pencil") %>

  <div class="space-y-6">
    <%= render "shared/essentials/card", title: "Details" do %>
      <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        <%
          details = {
            "Category" => @item.item_category&.name,
            "NDBN reporting category" => "#{@item.reporting_category_humanized}#{@reporting_category_hint}",
            "Value per item" => dollar_value(@item.value_in_cents || 0),
            "Quantity per individual" => (@item.distribution_quantity || 0).to_s,
            "On hand minimum quantity" => (@item.on_hand_minimum_quantity || 0).to_s,
            "On hand recommended quantity" => (@item.on_hand_recommended_quantity || 0).to_s,
            "Package size" => (@item.package_size || 0).to_s,
            "Visible to partners" => (@item.visible_to_partners ? "Yes" : "No")
          }
          if Flipper.enabled?(:enable_packs)
            details["Custom units"] = @item.request_units&.pluck("item_units.name")&.join("; ")
          end
        %>
        <% details.each do |label, value| %>
          <div>
            <dt class="text-xs font-medium text-slate-500"><%= label %></dt>
            <dd class="mt-0.5 text-sm text-slate-900"><%= value.presence || "—" %></dd>
          </div>
        <% end %>
        <div class="sm:col-span-2 lg:col-span-3">
          <dt class="text-xs font-medium text-slate-500">Additional information (bank use only)</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= @item.additional_info.presence || "—" %></dd>
        </div>
      </dl>
    <% end %>

    <%= render "shared/essentials/card", title: "Where this item is stored",
          padded: @storage_locations_containing.blank? do %>
      <% if @storage_locations_containing.blank? %>
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "Not held at any storage location",
              body: "This item appears here once a donation, purchase or audit puts it into a location." %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Storage locations holding <%= @item.name %></caption>
            <thead>
              <tr>
                <th scope="col">Storage location</th>
                <th scope="col" class="quantity">Quantity</th>
              </tr>
            </thead>
            <tbody>
              <% total = 0 %>
              <% @storage_locations_containing.each do |storage| %>
                <% location_quantity = @inventory ? @inventory.quantity_for(item_id: @item.id, storage_location: storage.id) : storage.item_total(@item) %>
                <% total += location_quantity %>
                <tr>
                  <td class="font-medium text-slate-900">
                    <%= link_to storage.name, storage_location_path(storage), class: "text-brand-700 hover:text-brand-800" %>
                  </td>
                  <td class="quantity"><%= number_with_delimiter(location_quantity) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr>
                <td>Total</td>
                <td class="quantity"><%= number_with_delimiter(total) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% end %>
    <% end %>

    <% if @barcodes_for.present? %>
      <%= render "shared/essentials/card", title: "Barcodes for this item", padded: false do %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Barcodes registered against <%= @item.name %></caption>
            <thead>
              <tr>
                <th scope="col">Barcode value</th>
                <th scope="col" class="quantity">Quantity</th>
              </tr>
            </thead>
            <tbody>
              <% @barcodes_for.each do |barcode_item| %>
                <tr>
                  <td class="font-mono text-xs">
                    <%= link_to barcode_item.value, barcode_item_path(barcode_item), class: "text-brand-700 hover:text-brand-800" %>
                  </td>
                  <td class="quantity"><%= number_with_delimiter(barcode_item.quantity) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
