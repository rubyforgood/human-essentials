<div id="panel-quantity-location" role="tabpanel" aria-labelledby="tab-quantity-location" data-tabs-target="panel" class="hidden">
  <div class="flex justify-end border-b border-slate-200 px-5 py-3">
    <%= essentials_link_button "New item", new_item_path, variant: :secondary, size: :sm, icon: "bi-plus-lg" %>
  </div>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
    <table class="data-table table-items-location">
      <caption>Quantity of each item at each storage location</caption>
      <thead>
        <tr>
          <th scope="col">Name</th>
          <%= render partial: "storage_column", collection: @storages %>
          <th scope="col" class="quantity">Minimum quantity</th>
          <th scope="col" class="quantity">Recommended quantity</th>
          <th scope="col" class="quantity">Total quantity</th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "item_row_quantity_and_storages", collection: @items_by_storage_collection_and_quantity.values, as: :row_item %>
      </tbody>
    </table>
  </div>
</div>
