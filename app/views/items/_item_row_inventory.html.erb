<% row_item = row.last %>
<% below_minimum = quantity_below_minimum?(row_item) %>
<% detail_id = "item-locations-#{row_item[:item_id]}" %>
<tr>
  <td class="w-10">
    <%# The AdminLTE widget put aria-expanded on the <tr> and the affordance on a ::before
        glyph, which no keyboard user could reach. This is a real button.

        The classes were a hand-written near-copy of `ROW_ICON_CLASSES` that dropped `size-7`,
        so it measured **20x28** where design.md requires every control in an actions column to
        be 28x28. `responsive-audit` reported it at every width, but for the wrong reason -- the
        clipped-text controller had made the wrapping cell focusable, and a target's own ancestor
        was counting against its spacing exception. The size was real; the report was not. %>
    <button type="button"
            class="<%= essentials_row_icon_classes %>"
            aria-expanded="false"
            aria-controls="<%= detail_id %>"
            data-action="click->expandable#toggle">
      <span class="sr-only">Show storage locations for <%= row_item[:item_name] %></span>
      <i class="bi-chevron-right text-xs transition-transform" data-expandable-chevron aria-hidden="true"></i>
    </button>
  </td>
  <td class="font-medium text-slate-900">
    <%= link_to row_item[:item_name], item_url(row_item[:item_id]), class: "link-brand" %>
  </td>
  <td class="quantity" data-column="total">
    <% if below_minimum %>
      <span class="inline-flex items-center gap-1.5">
        <span class="font-semibold text-rose-700"><%= number_with_delimiter(row_item[:quantity]) %></span>
        <%= essentials_status_pill("Below minimum", tone: :danger, icon: "bi-exclamation-triangle") %>
      </span>
    <% else %>
      <%= number_with_delimiter(row_item[:quantity]) %>
    <% end %>
  </td>
  <td class="quantity"><%= number_with_delimiter(row_item[:item_on_hand_minimum_quantity]) %></td>
  <td class="quantity"><%= number_with_delimiter(row_item[:item_on_hand_recommended_quantity]) %></td>
</tr>
<tr id="<%= detail_id %>" class="expandable-body hidden bg-slate-50">
  <td colspan="5">
    <ul class="space-y-1 text-sm text-slate-700">
      <% row_item[:locations].each do |location| %>
        <li>
          <%= link_to location[:name], storage_location_url(location[:id]), class: "font-medium link-brand" %>
          — <%= number_with_delimiter(location[:quantity]) %> units
        </li>
      <% end %>
    </ul>
  </td>
</tr>
