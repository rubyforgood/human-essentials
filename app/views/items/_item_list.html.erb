<div id="panel-item-list" role="tabpanel" aria-labelledby="tab-item-list" data-tabs-target="panel">
  <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
    <table id="items-table" class="data-table">
      <caption>Every item this organization stocks</caption>
      <thead>
        <tr>
          <th scope="col">Category</th>
          <th scope="col">Name</th>
          <th scope="col">NDBN reporting category</th>
          <th scope="col">Additional info</th>
          <th scope="col" class="quantity">Quantity per individual</th>
          <th scope="col" class="numeric">Fair market value (per item)</th>
          <% if Flipper.enabled?(:enable_packs) && current_organization.request_units.any? %>
            <th scope="col">Custom request units</th>
          <% end %>
          <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "items/item_row", collection: items, as: :item_row, locals: {inventory: inventory, kits: kits} %>
      </tbody>
    </table>
  </div>
  <%#
    The controller has always computed a paginated collection; this panel rendered the full one
    and never showed a pager, so 51 items at 121px a row made a 6,442px page. See design.md.

    The chrome is inline rather than the card's `footer:` slot because this table is one tab
    panel of five -- a card footer would show the item pager under the Kits tab too.
  %>
  <% if (pager = essentials_pagination_footer(items)) %>
    <div class="border-t border-slate-200 px-5 py-3"><%= pager %></div>
  <% end %>
</div>
