<% content_for :title, "Reports - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Reports",
        subtitle: "#{reports_catalog_count} reports. Most take a date range and export to CSV." %>

  <%#
    Six cards, one per subject, equal height via auto-rows-fr and aligned in a 3x2 grid. The
    icon sits on the card, not on every row: one glyph per card marks the subject, where eleven
    would just be texture. Each report is a name and a short qualifier -- enough that the card
    is not a flat list of links, and not so much that the grid drops below the fold.
  %>
  <div class="grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% reports_catalog.each do |section| %>
      <section id="reports-<%= section.label.parameterize %>"
               class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"
               aria-labelledby="reports-<%= section.label.parameterize %>-heading">
        <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-2.5">
          <div class="flex min-w-0 items-center gap-2">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-700">
              <i class="<%= section.icon %>" aria-hidden="true"></i>
            </span>
            <h2 id="reports-<%= section.label.parameterize %>-heading"
                class="truncate text-sm font-semibold text-slate-900"><%= section.label %></h2>
          </div>
          <span class="shrink-0 text-xs text-slate-400"><%= section.reports.size %></span>
        </div>

        <ul class="mt-1 divide-y divide-slate-100">
          <% section.reports.each do |report| %>
            <li>
              <%= link_to report.path,
                    class: "group block rounded-lg py-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" do %>
                <span class="block text-sm font-medium text-brand-700 group-hover:underline"><%= report.label %></span>
                <span class="block text-xs text-slate-500"><%= report.qualifier %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
