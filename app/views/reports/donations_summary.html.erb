<%= render(
  "shared/filtered_card",
  id: "donations",
  title: "Donations (All Sources)",
  subtitle: @selected_date_range,
  footer_options: { class: "text-center" },
  footer: link_to("See more...", donations_path),
  filter_url: reports_donations_summary_path
) do %>
  <%= new_button_to new_donation_path, {text: "New Donation"} %>
  <p class="text-center text-2xl font-bold tracking-tight text-slate-900">
    <span class="total_received_donations">
      <%= total_received_donations %>
    </span>
    items
    received <%= @selected_date_range_label %>
  </p>
  <h2 class="text-base font-semibold text-slate-900"><%= dollar_presentation(total_received_money_donations) %>
    raised  <%= @selected_date_range_label %></h2>
  <div class="px-5 py-4">
    <h2 class="text-base font-semibold text-slate-900">Recent Donations</h2>
    <%= render partial: "donation", collection: @recent_donations, as: :donation %>
  </div>
<% end %>
</section>
