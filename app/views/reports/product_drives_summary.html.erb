<%= render(
  "shared/filtered_card",
  id: "product_drives",
  title: "Product drives",
  subtitle: @selected_date_range,
  filter_url: reports_product_drives_summary_path,
  footer: link_to("View all product drives", product_drives_path, class: "text-sm font-medium text-brand-700 hover:text-brand-800")
) do %>
  <div class="space-y-5 px-5 py-4">
    <%= essentials_stats([
          {label: "Drives active #{@selected_date_range_label}", value: total_number_of_drives, value_class: "total_drives"},
          {label: "Items received #{@selected_date_range_label}", value: total_received_from_product_drives, value_class: "total_received_donations"},
          {label: "Raised #{@selected_date_range_label}", value: dollar_presentation(total_received_money_donations_from_product_drives), value_class: "total_money_raised"}
        ]) %>

    <div>
      <h2 class="mb-2 text-base font-semibold text-slate-900">Recent donations from product drives</h2>
      <%= render partial: "product_drive", collection: @recent_donations.by_source(:product_drive), as: :donation %>
    </div>
  </div>
<% end %>
