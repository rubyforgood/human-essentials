<% content_for :title, "Itemized donations - Reports - #{current_organization.name}" %>
<%= render(
  "shared/filtered_card",
  id: "purchases",
  title: "Itemized donations",
  subtitle: @selected_date_range,
  padded: false,
  filter_url: reports_itemized_donations_path
) do %>

<% if @itemized_donation_data.empty? %>
  <div class="p-5">
    <%= render "shared/essentials/empty_state", kind: :no_results,
        title: "No itemized donations found",
          body: "Nothing matched the selected date range. Try widening it." %>
  </div>
<% else %>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
    <table class="data-table striped">
      <caption>Donations received in the selected period, by item</caption>
      <thead>
        <tr>
          <th scope="col">Item</th>
          <th scope="col" class="numeric">Total donated</th>
          <th scope="col" class="numeric">Total on hand</th>
        </tr>
      </thead>

      <tbody>
        <% @itemized_donation_data.each do |item| %>
          <tr>
            <td><%= item[:name] %></td>
            <td class="numeric"><%= item[:donated] %></td>
            <td class="numeric"><%= item[:current_onhand] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% end %>
