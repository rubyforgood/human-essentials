<%= render(
  "shared/filtered_card",
  id: "purchases",
  title: "Itemized requests",
  subtitle: @selected_date_range,
  padded: false,
  filter_url: reports_itemized_requests_path
) do %>

  <% if @itemized_request_data.empty? %>
    <div class="p-5">
    <%= render "shared/essentials/empty_state", kind: :no_results,
          title: "No itemized requests found",
            body: "Nothing matched the selected date range. Try widening it." %>
  </div>
  <% else %>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
    <table class="data-table striped">
      <caption>Items requested in the selected period, against what is on hand</caption>
      <thead>
        <tr>
          <th scope="col">Item</th>
          <th scope="col" class="numeric">Total requested</th>
          <th scope="col" class="numeric">Total on hand</th>
        </tr>
      </thead>
      <tbody>
        <% @itemized_request_data.each do |item| %>
          <tr>
            <td>
              <%= item[:name] %>
              <% if item[:unit].present? %>
                (<%= h(item[:unit]) %>)
              <% end %>
            </td>
            <td class="numeric"><%= item[:quantity] %></td>
            <%#
              `table-danger` was Bootstrap's, and nothing defines it now -- so this cell had been
              signalling "below the on-hand minimum" by painting itself a colour that does not
              exist. The warning was invisible on this page and on itemized distributions.

              The treatment is the dashboard's low inventory one, unchanged: the number in rose
              *and* a pill carrying the word and an icon. design.md -- never colour alone. A cell
              tinted red says something is wrong to a sighted reader with normal colour vision and
              nothing to anyone else, which is what this was trying to do before it stopped
              working at all.
            %>
            <td class="quantity">
              <% if item[:below_onhand_minimum] %>
                <span class="inline-flex items-center gap-1.5">
                  <span class="font-semibold text-rose-700"><%= item[:on_hand] || 0 %></span>
                  <%= essentials_status_pill("Below minimum", tone: :danger, icon: "bi-exclamation-triangle") %>
                </span>
              <% else %>
                <%= item[:on_hand] || 0 %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
      </table>
  </div>
  <% end %>
<% end %>
