<%= render(
  "shared/filtered_card",
  id: "purchases",
  title: "Itemized requests",
  subtitle: @selected_date_range,
  padded: false,
  filter_url: reports_itemized_requests_path
) do %>

  <% if @itemized_request_data.empty? %>
    <div class="p-5">
    <%= render "shared/essentials/empty_state", kind: :no_results,
          title: "No itemized requests found",
            body: "Nothing matched the selected date range. Try widening it." %>
  </div>
  <% else %>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
    <table class="data-table striped">
      <thead>
        <tr>
          <th scope="col">Item</th>
          <th scope="col" class="numeric">Total requested</th>
          <th scope="col" class="numeric">Total on hand</th>
        </tr>
      </thead>
      <tbody>
        <% @itemized_request_data.each do |item| %>
          <tr>
            <td>
              <%= item[:name] %>
              <% if item[:unit].present? %>
                (<%= h(item[:unit]) %>)
              <% end %>
            </td>
            <td class="numeric"><%= item[:quantity] %></td>
            <td class="text-right <%= 'table-danger' if item[:below_onhand_minimum] %>">
              <%= item[:on_hand] || 0 %>
            </td>
          </tr>
        <% end %>
      </tbody>
      </table>
  </div>
  <% end %>
<% end %>
