<%= render(
  "shared/filtered_card",
  id: "purchases",
  title: "Purchases",
  subtitle: @selected_date_range,
  footer: link_to("View all purchases", purchases_path, class: "text-sm font-medium text-brand-700 hover:text-brand-800"),
  filter_url: reports_purchases_summary_path
) do %>
  <div class="space-y-5 px-5 py-4">
    <%#
      Six figures that were six consecutive <h2>s, each carrying its label inside the heading
      text ("Total spent on diapers: $412"). They are data, so they are a description list.
    %>
    <%= essentials_stats([
          {label: "Spent #{@selected_date_range_label}", value: dollar_presentation(@summary_struct.amount_spent)},
          {label: "Total items", value: @summary_struct.total_items},
          {label: "Spent on diapers", value: dollar_presentation(@summary_struct.diapers)},
          {label: "Spent on period supplies", value: dollar_presentation(@summary_struct.period_supplies)},
          {label: "Spent on adult incontinence", value: dollar_presentation(@summary_struct.adult_incontinence)},
          {label: "Spent on other", value: dollar_presentation(@summary_struct.other)}
        ]) %>

    <div>
      <h2 class="mb-2 text-base font-semibold text-slate-900">Recent purchases</h2>
      <%= render partial: "purchase", collection: @summary_struct.recent_purchases, as: :purchase %>
    </div>

    <div><%= new_button_to new_purchase_path, {text: "New Purchase"} %></div>
  </div>
<% end %>
