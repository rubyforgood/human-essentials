<%= render(
  "shared/filtered_card",
  id: "purchases",
  title: "Itemized distributions",
  subtitle: @selected_date_range,
  padded: false,
  filter_url: reports_itemized_distributions_path
) do %>

  <% if @itemized_distribution_data.empty? %>
    <div class="p-5">
    <%= render "shared/essentials/empty_state", kind: :no_results,
          title: "No itemized distributions found",
            body: "Nothing matched the selected date range. Try widening it." %>
  </div>
  <% else %>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
    <table class="data-table striped">
      <caption>Distributions in the selected period, by item, against what is on hand</caption>
      <thead>
        <tr>
          <th scope="col">Item</th>
          <th scope="col" class="numeric">Total distributed</th>
          <th scope="col" class="numeric">Total on hand</th>
        </tr>
      </thead>
      <tbody>
        <% @itemized_distribution_data.each do |item| %>
          <tr>
            <td><%= item[:name] %></td>
            <td class="numeric"><%= item[:distributed] %></td>
            <%# `table-danger` was Bootstrap's and is defined nowhere, so this cell had been
                signalling "below the on-hand minimum" with a colour that does not exist. Same
                treatment as the dashboard's low inventory table: the number in rose *and* the
                word, because design.md does not allow colour alone. %>
            <td class="quantity">
              <% if item[:below_onhand_minimum] %>
                <span class="inline-flex items-center gap-1.5">
                  <span class="font-semibold text-rose-700"><%= item[:current_onhand] %></span>
                  <%= essentials_status_pill("Below minimum", tone: :danger, icon: "bi-exclamation-triangle") %>
                </span>
              <% else %>
                <%= item[:current_onhand] %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
      </table>
  </div>
  <% end %>
<% end %>
