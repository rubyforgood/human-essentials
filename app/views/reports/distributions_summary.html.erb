<%= render(
  "shared/filtered_card",
  id: "distributions",
  title: "Distributions",
  subtitle: @selected_date_range,
  footer: link_to("View all distributions", distributions_path, class: "text-sm font-medium text-brand-700 hover:text-brand-800"),
  filter_url: reports_distributions_summary_path
) do %>
  <div class="space-y-5 px-5 py-4">
    <%= essentials_stats([
          {label: "Items distributed #{@selected_date_range_label}", value: total_distributed, value_class: "total_distributed"},
          {label: "Items scheduled for future distribution", value: future_distributed}
        ]) %>

    <div>
      <h2 class="mb-2 text-base font-semibold text-slate-900">Recent distributions</h2>
      <%= render partial: "distribution", collection: @recent_distributions, as: :distribution %>
    </div>

    <div><%= new_button_to new_distribution_path, {text: "New distribution"} %></div>
  </div>
<% end %>
