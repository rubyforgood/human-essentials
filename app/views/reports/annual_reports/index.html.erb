<% content_for :title, "Reports - #{current_organization.name}" %>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Annual survey",
        subtitle: "The yearly figures, one page per year.",
        back: {path: reports_path, label: "Back to reports"} %>
</div>
<div class="space-y-4 px-4 py-6 sm:px-6 lg:px-8">
  <div class="flex items-start gap-2 rounded-2xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900" role="note">
    <i class="bi-info-circle mt-0.5 shrink-0 text-sky-600" aria-hidden="true"></i>
    <span>
      Reports are available at the end of every year.
      <%= @actual_year %> becomes available on <%= available_date %>.
    </span>
  </div>

  <%= render "shared/essentials/card", title: "NDBN annual reports", padded: false do %>
    <% if @years.any? %>
      <ul class="divide-y divide-slate-100">
        <% @years.each do |year| %>
          <li>
            <%= link_to year, reports_annual_report_path(year),
                  class: "block px-5 py-3 text-sm font-medium text-brand-700 transition-colors hover:bg-slate-50 hover:text-brand-800 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-brand-600" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="px-5 py-4">
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "No years yet",
              body: "A year appears here once it has ended." %>
      </div>
    <% end %>
  <% end %>
</div>
