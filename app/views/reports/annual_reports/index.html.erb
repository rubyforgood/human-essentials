<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Reports - #{current_organization.name}" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Reports</h1>
<p class="mt-1 text-sm text-slate-600">for <%= current_organization.name %></p>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>
<section>
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid gap-6">
      <div class="col-md-12 mb-2">
        <h5 class="mb-1">Reports are available at the end of every year.</h5>
        <span class="text-muted"> <%= "#{@actual_year} (available on #{available_date})" %> </span>
      </div>
      <div class="min-w-0">
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-5 py-4">
            <h3 class="text-base font-semibold text-slate-900">NDBN Annual Reports</h3>
          </div>
          <ul class="list-group list-unstyled">
            <% @years.map do |year| %>
              <li class="list-group-item-action"> <%= link_to "#{year}", reports_annual_report_path(year), class: "list-group-item" %> </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
