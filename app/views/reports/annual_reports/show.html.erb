<% content_for :title, "Annual Survey - #{current_organization.name}" %>

<%#
  This page rendered one <h1> per report section inside a loop, so a page could carry a dozen of
  them. The page header owns the only h1; each section is an h2. Spacing was <br> tags and the
  actions were float-right inside a bordered strip.
%>
<div class="px-4 pt-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "#{params[:year]} NDBN annual report",
        subtitle: current_organization.name,
        back: {path: reports_annual_reports_path, label: "Back to annual survey"},
        actions: capture {
          concat refresh_button_to(recalculate_reports_annual_report_path(@year),
                   {text: "Recalculate report"}, method: :post)
          concat download_button_to(reports_annual_report_path(@year, format: :csv),
                   text: "Export report")
        } %>
</div>

<div class="space-y-6 px-4 py-6 sm:px-6 lg:px-8">
  <% @report.each_report do |section_name, entries| %>
    <%= render "shared/essentials/card", title: section_name, padded: false do %>
      <% if entries.blank? %>
        <%= render "shared/essentials/empty_state", kind: :all_clear,
              title: "Nothing recorded for #{section_name}",
              body: "There were no figures in this section for #{params[:year]}." %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption><%= section_name %> figures for <%= params[:year] %></caption>
            <tbody>
              <% entries.each do |entry_name, value| %>
                <tr>
                  <th scope="row" class="font-medium text-slate-900"><%= entry_name %></th>
                  <td><%= value %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
