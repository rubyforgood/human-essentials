<section class="mb-6">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2">
      <div class="min-w-0">
        <% content_for :title, "Annual Survey - #{current_organization.name}" %>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900"><%= "#{params[:year]} NDBN Annual Report" %></h1>
<p class="mt-1 text-sm text-slate-600">for <%= current_organization.name %></p>
      </div>
      <div class="min-w-0">
      </div>
    </div>
  </div>
</section>
<!-- Main content -->
<section>
  <div class="border-t border-slate-200 px-5 py-3">
    <div class="px-5 py-4">
      <span class="float-right">
        <%=
          refresh_button_to(
            recalculate_reports_annual_report_path(@year),
              { text: "Recalculate Report" },
              method: :post
            )
        %>
        <%=
            download_button_to(
              reports_annual_report_path(@year, format: :csv),
              text: "Export Report"
            )
        %>
      </span>
    </div>
  </div>
</section>
<% @report.each_report do |name, entries| %>
  <section>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900"><%= name %></h1><br>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="px-5 py-4">
        <table class="data-table">
          <tbody>
          <% entries.each do |name, value| %>
            <tr>
              <th><%= name %></th>
              <td><%= value %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <br>
<% end %>
