<%= render(
  "shared/filtered_card",
  id: "manufacturers",
  title: "Manufacturer donations",
  subtitle: @selected_date_range,
  filter_url: reports_manufacturer_donations_summary_path,
  footer: link_to("View all manufacturer donations", donations_path(filters: {by_source: "Manufacturer"}), class: "text-sm font-medium text-brand-700 hover:text-brand-800")
) do %>
  <div class="space-y-5 px-5 py-4">
    <%# No caption here: shared/filtered_card already states the period in the page header. %>
    <%= essentials_stats([
          {label: "Items donated",
           value: number_with_delimiter(@recent_donations_from_manufacturers.sum { |d| d.line_items.total }),
           value_class: "total_received_donations"},
          {label: "Manufacturers donating",
           value: pluralize(@recent_donations_from_manufacturers.group_by(&:manufacturer).count, "Manufacturer"),
           value_class: "num_manufacturers_donated"}
        ]) %>

    <div>
      <h2 class="mb-2 text-base font-semibold text-slate-900">Recent manufacturer donations</h2>
      <%= render partial: "manufacturer", collection: @recent_manufacturers, as: :manufacturer %>
    </div>

    <div><%= new_button_to new_donation_path, {text: "New donation"} %></div>
  </div>
<% end %>
