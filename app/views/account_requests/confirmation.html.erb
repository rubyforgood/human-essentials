<div class="mb-6">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Are you ready to get started?</h1>
</div>

<%= render "shared/essentials/card" do %>
  <div class="space-y-2 text-sm text-slate-700">
  <p>Confirm your request to start setting up your account.</p>
  <div class="mt-4">
    <%= essentials_link_button "I'm ready, let's go",
          confirm_account_requests_path(token: @account_request.identity_token),
          variant: :primary, icon: "bi-arrow-right" %>
  </div>
  </div>
<% end %>
