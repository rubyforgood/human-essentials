<div class="mb-6">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Request received</h1>
</div>

<%= render "shared/essentials/card" do %>
  <div class="space-y-2 text-sm text-slate-700">
  <p>
    We have sent instructions for the next steps to
    <strong><%= @account_request.email %></strong>.
  </p>
  <%= render "shared/essentials/callout", tone: :warning, wrapper_class: "mt-4" do %>
    Please check your spam filters for an email from
    <strong>no-reply@humanessentials.app</strong>.
  <% end %>
  </div>
<% end %>
