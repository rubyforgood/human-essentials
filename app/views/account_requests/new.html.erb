<% unless Rails.env.staging? %>
  <div class="account-request">
    <div class="p-3">
      <div class="mb-10">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Request an essentials bank account</h1>
      </div>

      <div class="account-type-choice mb-3 flex items-start gap-2">
        <%= radio_button_tag(:account, :bank, @bank_selected, class: "mt-0.5 h-4 w-4 border-slate-300 text-brand-600 focus:ring-2 focus:ring-brand-500/30") %>
        <%= label_tag(:account_bank, "I am an Essentials Bank. I do NOT distribute diapers/period supplies directly to the public, I distribute them to partner agencies who distribute them to the public.", class: "text-sm text-slate-700") %>
      </div>
      <div class="account-type-choice mb-3 flex items-start gap-2">
        <%= radio_button_tag(:account, :partner, false, class: "mt-0.5 h-4 w-4 border-slate-300 text-brand-600 focus:ring-2 focus:ring-brand-500/30") %>
        <%= label_tag(:account_partner, "I am a Partner Agency to an Essentials Bank. I distribute the diapers/period supplies that I receive from essentials banks directly to the public.", class: "text-sm text-slate-700") %>
      </div>

      <%# Hide #partner_info and #create_bank selections unless radio button selected %>
      <style>
        #partner_info, #create_bank {
          display: none;
        }
        .account-type-choice:has(#account_partner:checked) ~ #partner_info,
        .account-type-choice:has(#account_bank:checked) ~ #create_bank {
          display: block;
        }
      </style>

      <div class="text-sm text-slate-700" id='partner_info'>
        <p class="mt-2">Are you a current partner to diaper and/or period supply banks? If so please go <a href='https://humanessentials.app/users/sign_in'>here</a> to login.</p>
        <p class="mt-2">If you are wishing to receive diapers/period supplies and partner to a local diaper/period supply bank please contact your local bank. They are the only ones able create your account.</p>
        <p class="mt-2">If you are looking for an essentials bank that distributes diapers, please refer to the <a href='https://nationaldiaperbanknetwork.org/member-directory/'>NDBN member directory</a>. If you are, instead, looking for an essentials bank that deals in period supplies, please refer to the <a href='https://allianceforperiodsupplies.org/allied-programs/'>Alliance for Period Supplies directory</a>.</p>
      </div>

      <div class="text-sm text-slate-700" id='create_bank'>
        <p class='p-2 bg-yellow-200'>
          Fill out the details below about your bank to request a free account to use Human Essentials for your organization's essentials bank.
          <br><br>
          <span class="font-semibold">Do you <em>partner</em> with diaper and/or period supply banks? If so please go to the <%= link_to 'partner app', new_user_session_path %> to login.</span>
        </p>

        <%= essentials_form_for(@account_request) do |f| %>
          <%= f.error_notification %>

          <div class="form-inputs">
            <div class="form-inputs">
              <%= f.input :name, autofocus: true %>
            </div>

            <div class="form-inputs">
              <%= f.input :email %>
            </div>

            <div class="form-inputs">
              <%= f.input :organization_name %>
            </div>

            <div class="form-inputs">
              <%= f.input :organization_website, placeholder: "https://www.example.com" %>
            </div>

            <div class="form-inputs">
              <%# f.association renders its own label, so the `for` matches the id it generates.
                  The wrapping f.input produced for="account_request_ndbn_member" against a select
                  whose id is account_request_ndbn_member_id -- the same defect already fixed in
                  organizations/edit.html.erb, and the select was reported as unlabelled. %>
              <%= f.association :ndbn_member, label: "NDBN membership",
                    label_method: :full_name, value_method: :id %>
            </div>

            <div class="form-inputs">
              <%= f.input :request_details, placeholder: 'Tell us more about your organization and how you would use Human Essentials', label: "Request Details (min 50 characters)" %>
            </div>
          </div>

          <div class="my-2">
            <%= recaptcha_tags %>
          </div>

          <div class="border-t border-slate-200 px-5 py-3">
            <%= submit_button({text: 'Submit', icon: nil}) %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <div class="w-[30rem]">
    <%= render "shared/essentials/card", title: "Request an account" do %>
      <div class="space-y-2 text-sm text-slate-700">
        <p>It looks like you are trying to request an account, but this is not the live version of Human Essentials.</p>
        <p>
          To request an account,
          <%= link_to "click here", "https://humanessentials.app/account_requests/new",
                class: "font-medium text-brand-700 hover:text-brand-800" %>
          to head over to the Human Essentials website.
        </p>
      </div>
    <% end %>
  </div>
<% end %>
