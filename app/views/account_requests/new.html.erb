<% content_for :title, "Request an account - Human Essentials" %>
<%# Top-aligned: answering the question reveals the form, and a centred column would throw the
    heading 302px up the page at the moment of the click. %>
<% content_for :auth_align_top, true %>
<% unless Rails.env.staging? %>
  <%
    # Server-rendered, so the right panel is showing before Stimulus boots. A failed submit comes
    # back with the bank answer chosen: the account form carries `account=bank` in a hidden field,
    # and the strong params ignore it.
    chosen = params[:account].presence_in(%w[supplies bank]) || ("bank" if @bank_selected)
    radio_classes = "mt-1 h-4 w-4 shrink-0 border-slate-300 text-brand-600 focus:ring-2 focus:ring-brand-500/30"
    input_classes = EssentialsUiHelper::FILTER_CONTROL_CLASSES.sub("mt-1.5 ", "")
  %>
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Request an account</h1>
  <p class="mt-1 text-sm text-slate-600">Human Essentials is free for diaper banks and essentials banks.</p>

  <%# The question sits outside the account form, because the supplies answer reveals a search
      form of its own and forms cannot nest. %>
  <div class="mt-6" data-controller="radio-reveal">
    <%# Asked as what the visitor wants, not what they are. "Essentials bank" and "partner agency"
        are words for organizations already in the system; somebody looking for diapers is
        neither yet, and kept answering "bank" because the partner answer only said "contact
        your bank". The answer for them comes first, and finds them one. ADR 0014. %>
    <fieldset class="mb-4">
      <legend class="mb-1.5 block text-sm font-medium text-slate-700">What are you looking for?</legend>

      <div class="mb-2 flex items-start gap-2">
        <%= radio_button_tag :account, :supplies, chosen == "supplies", class: radio_classes,
              aria: {controls: "find_bank", describedby: "account_supplies_hint"},
              data: {action: "radio-reveal#toggle"} %>
        <div>
          <%= label_tag :account_supplies, "Diapers or period supplies", class: "py-0.5 text-sm text-slate-700" %>
          <p id="account_supplies_hint" class="text-xs text-slate-500">For the people we serve, or for my family. We'll help you find a bank near you.</p>
        </div>
      </div>

      <%# A field belonging to this one answer, so it is marked: indented and ruled under it. %>
      <%= render "shared/essentials/conditional_reveal", id: "find_bank", shown: chosen == "supplies",
            data: {radio_reveal_target: "panel", radio_reveal_value: "supplies"} do %>
        <%= form_with url: bank_finder_path, method: :get, local: true, role: "search" do %>
          <%= label_tag :near, "City and state, or ZIP code", class: "block text-sm font-medium text-slate-700" %>
          <div class="mt-1.5 flex gap-2">
            <%= text_field_tag :near, nil, class: input_classes, autocomplete: "address-level2",
                  placeholder: "Dayton, OH", required: true %>
            <%= button_tag "Find banks", type: "submit", name: nil,
                  class: essentials_button_classes(variant: :primary, size: :md, extra: "shrink-0") %>
          </div>
        <% end %>
        <p class="mt-2 text-xs text-slate-500">
          Already a partner of a bank? <%= link_to "Log in", new_user_session_path, class: "link-brand font-medium underline" %>.
        </p>
      <% end %>

      <div class="flex items-start gap-2">
        <%= radio_button_tag :account, :bank, chosen == "bank", class: radio_classes,
              aria: {controls: "create_bank", describedby: "account_bank_hint"},
              data: {action: "radio-reveal#toggle"} %>
        <div>
          <%= label_tag :account_bank, "Software to run our bank", class: "py-0.5 text-sm text-slate-700" %>
          <p id="account_bank_hint" class="text-xs text-slate-500">We collect diapers or period supplies and give them out to other organizations.</p>
        </div>
      </div>
    </fieldset>

    <%# The rest of the page, not a field belonging to one answer, so it follows the whole
        question unmarked rather than hanging under the bank radio. %>
    <%= render "shared/essentials/conditional_reveal", id: "create_bank", shown: chosen == "bank",
          marked: false, data: {radio_reveal_target: "panel", radio_reveal_value: "bank"} do %>
      <%= essentials_form_for(@account_request) do |f| %>
        <%= hidden_field_tag :account, "bank", id: nil %>
        <%= essentials_error_summary(@account_request) %>
        <%= f.input :name %>
        <%= f.input :email, input_html: {autocomplete: "email"} %>
        <%= f.input :organization_name %>
        <%= f.input :organization_website, placeholder: "https://www.example.com" %>
        <%# f.association renders its own label, so the `for` matches the id it generates.
            The wrapping f.input produced for="account_request_ndbn_member" against a select
            whose id is account_request_ndbn_member_id -- the same defect already fixed in
            organizations/edit.html.erb, and the select was reported as unlabelled. %>
        <%= f.association :ndbn_member, label: "NDBN membership",
              label_method: :full_name, value_method: :id %>
        <%= f.input :request_details, hint: "At least 50 characters.",
              placeholder: "Tell us about your organization and how you would use Human Essentials",
              input_html: {rows: 4} %>

        <div class="recaptcha-fit mb-6">
          <%= recaptcha_tags %>
        </div>

        <%= f.button :button, "Submit request", class: essentials_button_classes(variant: :primary, size: :md, extra: "w-full"),
              data: {disable_with: "Submitting"} %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%# The auth shell is the card, so this is its heading, not a card of its own. %>
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Request an account</h1>
  <div class="mt-4 space-y-2 text-sm text-slate-700">
    <p>It looks like you are trying to request an account, but this is not the live version of Human Essentials.</p>
    <p>
      To request an account, go to
      <%= link_to "request an account on #{production_host}", production_url("/account_requests/new"),
            class: "font-medium link-brand underline" %>.
    </p>
  </div>
<% end %>
