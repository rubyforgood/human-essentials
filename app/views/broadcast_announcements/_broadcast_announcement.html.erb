<tr id="<%= dom_id broadcast_announcement %>">
  <td><%= broadcast_announcement.message %></td>
  <%# `safe_http_url`, not the design system's link component: this is the vulnerable render site
      on main too, and the guard must not depend on the design system being present. %>
  <% if (href = safe_http_url(broadcast_announcement.link)) %>
    <td><%= link_to href, href, class: "link-brand", rel: "nofollow noopener" %></td>
  <% else %>
    <td class="text-slate-600"><%= broadcast_announcement.link %></td>
  <% end %>
  <td><%= broadcast_announcement.user&.name || "N/A" %></td>
  <td class="date text-left"><%= broadcast_announcement.expiry %>
    <% if broadcast_announcement.expired? %>
      <%= essentials_status_pill("Expired", tone: :danger, icon: "bi-clock-history") %>
    <% end %>
  </td>
  <td class="cell-actions">
    <div class="flex justify-end gap-1.5">
      <%= essentials_row_icon_link "Edit", edit_broadcast_announcement_path(broadcast_announcement), icon: "bi-pencil" %>
      <%= essentials_row_icon_action "Delete", broadcast_announcement, method: :delete, icon: "bi-trash", tone: :danger,

            confirm: "Are you sure?" %>
    </div>
  </td>
</tr>
