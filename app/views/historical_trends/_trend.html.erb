<%#
  The three historical trend pages -- donations, purchases, distributions -- were identical apart
  from a title and a series, and each was a bare Highcharts config with no page header, no card and
  no <h1>. Their controllers had been given `layout "essentials_app"` and marked migrated; the
  views were never touched.

    render "historical_trends/trend", title: title, series: series

  The chart carries no title of its own: the page header is the h1, and the chart repeating it gave
  the page two headings that could drift apart.
%>
<% content_for :title, "#{title} - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%# These three are listed in the reports catalogue and are in no menu, so the hub was the only
      way in and there was no way out. %>
  <%= render "shared/essentials/page_header",
        title: title,
        subtitle: "Cached, so it may be up to 24 hours behind.",
        back: {path: reports_path, label: "Back to reports"} %>

  <%# The window goes in the filter bar, where every other report's date filter goes -- not in the
      header's actions, which is a right-aligned row sized for buttons. %>
  <%= render "shared/essentials/filter_bar", url: request.path, auto_submit: true do %>
    <div class="min-w-0"><%= render partial: "shared/month_range_picker" %></div>
  <% end %>

  <div class="space-y-6">
    <%
      # The window comes from the controller now, and with it the two things a reader has to be
      # told about the *edges* of a monthly chart: whether the last column is still running, and
      # whether anything is dated past it. See `HistoricalTrendService`.
      months = @months.map { |m| m.strftime("%b %Y") }
      short_months = @months.map { |m| m.strftime("%b %y") }
      in_progress = @last_month_in_progress
      # One total per month, summed across every item. The per-item figures are in the table below.
      monthly_totals = Array.new(months.size, 0)
      series.each { |item| item[:data].each_with_index { |value, i| monthly_totals[i] += value.to_i } }
      grand_total = monthly_totals.sum
      # The y axis said "Line items" before. It is the unit these figures are counted in, and it
      # belongs in the tooltip and the subtitle rather than sideways down the left edge.
      unit_label = "line items"
      chart_subtitle = "Every item added together, #{months.first} to #{months.last}."
      chart_subtitle += " #{months.last} is still running." if in_progress
    %>

    <%#
      **One series, not forty-seven.**

      This drew one column series per item, every one of them created `visible: false` -- so the
      page opened with an 850px box, a legend of 47 names and no data at all until you pressed
      "Select all". Pressing it was worse: 47 series across 12 months in a 1034px plot is about
      **1.8px per bar**, keyed by a 191px legend over a ten-colour palette, so five different items
      shared every swatch and the legend could not identify a bar even in principle.

      The chart's job on this page is the month-to-month shape -- how much, and when. "Which item"
      is answered completely by the table directly beneath it, which holds all 47 by month, and a
      top-8 cut would have set a partial answer beside a complete one. See "A chart answers one
      question" in design.md.

      No legend, one colour, and the figure printed on each column so it can be read exactly rather
      than estimated off an axis.
    %>
    <%= render "shared/essentials/card", title: "Total per month", subtitle: chart_subtitle do %>
      <% if grand_total.zero? %>
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "Nothing to chart yet",
              body: "Once there are twelve months of activity, the trend appears here." %>
      <% else %>
        <%
          chart_height = 320
          config = {
            chart: {type: "column", height: chart_height, spacingBottom: 8, style: {fontFamily: "Figtree, system-ui, sans-serif"}},
            title: {text: nil},
            credits: {enabled: false},
            legend: {enabled: false},
            xAxis: {categories: months.each_with_index.map { |m, i| (in_progress && i == months.size - 1) ? "#{m}\nso far" : m },
                    crosshair: true, lineColor: "#E2E8F0", tickColor: "#E2E8F0",
                    labels: {style: {color: "#475569", fontSize: "12px"}}},
            yAxis: {min: 0, title: {text: nil}, gridLineColor: "#E2E8F0",
                    labels: {style: {color: "#475569", fontSize: "12px"}}},
            tooltip: {shared: true, valueSuffix: " #{unit_label}"},
            plotOptions: {column: {borderWidth: 0, borderRadius: 3, color: "#4F46E5", pointPadding: 0.08, groupPadding: 0.12,
                                   dataLabels: {enabled: true, style: {fontSize: "11px", fontWeight: "500", color: "#334155", textOutline: "none"}}}},
            # The month still running is drawn hatched rather than solid, and the word is in the
            # subtitle, the axis label and the table -- never the pattern alone. design.md: never
            # colour alone, and a fill pattern is a colour by another name.
            series: [{name: unit_label.humanize,
                      data: monthly_totals.each_with_index.map { |value, i|
                        (in_progress && i == monthly_totals.size - 1) ? {y: value, color: "#A5B4FC", borderColor: "#4F46E5", borderWidth: 1} : value
                      }}]
          }.to_json
        %>
        <%= render partial: "shared/highcharts",
              locals: {config: config, height: chart_height, label: "#{title}: total per month, last twelve months"} %>
      <% end %>
    <% end %>

    <%#
      The same figures as a table. design.md: a chart is never the only representation of the data,
      because a chart is not readable by a screen reader and not printable in colour. These three
      were the only chart pages in the app and none of them had one, so the rule had nowhere it was
      actually being kept.

      The trend column is the chart the summary above cannot be: 47 items, each with its own shape,
      no legend and no colour spent. See `essentials_sparkline`.
    %>
    <%#
      What the window does *not* include, said out loud. A distribution can be dated ahead of
      itself, and a trend is what happened rather than what is booked -- so those records are out
      of the series by design, and dropping them without a word would make the chart quietly wrong
      for anyone who knows they exist. Zero for donations and purchases, which are recorded after
      the fact, so the callout does not appear on those pages at all.
    %>
    <% if @scheduled_beyond_today.to_i.positive? %>
      <%= render "shared/essentials/callout", tone: :info do %>
        <%= number_with_delimiter(@scheduled_beyond_today) %> line items are scheduled for after
        today and are not counted here. This is what has happened, not what is booked &mdash;
        <%= link_to "the distributions list", distributions_path, class: "font-medium underline" %>
        shows those.
      <% end %>
    <% end %>

    <%= render "shared/essentials/card", padded: false, title: "By item and month" do %>
      <% if series.blank? %>
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "Nothing to show yet",
              body: "Once there is activity, every item appears here with its monthly figures." %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table dense">
            <caption><%= title %>, by item and month</caption>
            <thead>
              <tr>
                <th scope="col">Item</th>
                <th scope="col" class="trend">Trend</th>
                <% short_months.each_with_index do |month, i| %>
                  <%# The month still running is named as such in the header too. A hatched column
                      and a footnote are not enough on their own: this is the cell a reader
                      compares, so the word belongs on the cell. %>
                  <th scope="col" class="quantity">
                    <%= month %><% if in_progress && i == short_months.size - 1 %><span class="block text-[11px] font-normal text-slate-500">so far</span><% end %>
                  </th>
                <% end %>
                <th scope="col" class="quantity">Total</th>
              </tr>
            </thead>
            <tbody>
              <% series.each do |item| %>
                <tr>
                  <th scope="row" class="font-medium text-slate-900"><%= item[:name] %></th>
                  <td class="trend"><%= essentials_sparkline(item[:data], months: months) %></td>
                  <% item[:data].each do |value| %>
                    <td class="quantity"><%= number_with_delimiter(value) %></td>
                  <% end %>
                  <td class="quantity font-medium text-slate-900"><%= number_with_delimiter(item[:data].sum) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr>
                <th scope="row">All items</th>
                <td class="trend"><%= essentials_sparkline(monthly_totals, months: months) %></td>
                <% monthly_totals.each do |value| %>
                  <td class="quantity"><%= number_with_delimiter(value) %></td>
                <% end %>
                <td class="quantity"><%= number_with_delimiter(grand_total) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
