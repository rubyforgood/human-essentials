<%# One tile in the facts row: a label, a value, and any lines beneath it. Blank lines are dropped,
    so a contact with no phone number prints no empty line. %>
<% lines = Array(lines).map(&:to_s).compact_blank %>
<div class="fact">
  <dt><%= label %></dt>
  <dd>
    <p class="fact-primary"><%= lines.first.presence || "—" %></p>
    <% lines.drop(1).each do |line| %>
      <p class="fact-secondary"><%= line %></p>
    <% end %>
  </dd>
</div>
