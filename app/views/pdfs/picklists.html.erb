<% @pdf.requests.each do |request| %>
  <% partner = request.partner %>
  <% profile = partner.profile %>
  <article class="sheet">
    <%= render "pdfs/letterhead", pdf: @pdf %>
    <%= render "pdfs/header", title: "Picklist for #{partner.name}",
          subtitle: "Request #{request.id} · Requested on #{request.created_at.to_fs(:date_picker)}" %>

    <% fields = [["Primary contact", [profile.primary_contact_name, profile.primary_contact_email, profile.primary_contact_phone]]] %>
    <% if profile.pick_up_name.present? %>
      <% fields << ["Pickup person", [profile.pick_up_name, profile.pick_up_email, profile.pick_up_phone]] %>
    <% end %>
    <% if @pdf.organization.ytd_on_distribution_printout %>
      <% fields << ["Items received year-to-date", [number_with_delimiter(partner.quantity_year_to_date)]] %>
    <% end %>
    <% if (quota = @pdf.quota_for(request)) %>
      <% fields << ["Quota", [number_with_delimiter(quota)]] %>
    <% end %>
    <% fields << ["Comments", [request.comments], :wide] %>
    <%= render "pdfs/details", title: "Request details", fields: fields %>

    <%= render "pdfs/line_items", title: "Items requested", table: @pdf.line_item_table(request) %>
  </article>
<% end %>
