<% @pdf.requests.each do |request| %>
  <% partner = request.partner %>
  <% profile = partner.profile %>
  <% table = @pdf.line_item_table(request) %>
  <article class="sheet">
    <%= render "pdfs/letterhead", pdf: @pdf %>
    <%= render "pdfs/title", pdf: @pdf,
          title: partner.name,
          subtitle: "Request #{request.id}",
          figure: table.rows.size,
          figure_label: (table.rows.size == 1) ? "item to pick" : "items to pick" %>

    <dl class="facts">
      <%= render "pdfs/fact", label: "Primary contact",
            lines: [profile.primary_contact_name, profile.primary_contact_email, profile.primary_contact_phone] %>
      <% if profile.pick_up_name.present? %>
        <%= render "pdfs/fact", label: "Pickup person",
              lines: [profile.pick_up_name, profile.pick_up_email, profile.pick_up_phone] %>
      <% end %>
      <%= render "pdfs/fact", label: "Requested on", lines: [request.created_at.to_fs(:date_picker)] %>
      <% if @pdf.organization.ytd_on_distribution_printout %>
        <%= render "pdfs/fact", label: "Items received year-to-date",
              lines: [number_with_delimiter(partner.quantity_year_to_date)] %>
      <% end %>
      <% if (quota = @pdf.quota_for(request)) %>
        <%= render "pdfs/fact", label: "Quota", lines: [number_with_delimiter(quota)] %>
      <% end %>
    </dl>

    <%= render "pdfs/note", body: request.comments %>
    <%= render "pdfs/line_items", table: table, heading: "Items" %>
  </article>
<% end %>
