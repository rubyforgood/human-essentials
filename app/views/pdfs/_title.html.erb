<%# The eyebrow says what the document is, the title says who it is for, and the figure on the
    right is the one number the reader looks for first. %>
<div class="doc-title">
  <div>
    <p class="eyebrow"><%= pdf.document_name %></p>
    <h1><%= title %></h1>
    <% if subtitle.present? %><p class="doc-subtitle"><%= subtitle %></p><% end %>
  </div>
  <% if local_assigns[:figure] %>
    <div class="headline-figure">
      <p class="headline-figure-value"><%= figure %></p>
      <p class="headline-figure-label"><%= figure_label %></p>
    </div>
  <% end %>
</div>
