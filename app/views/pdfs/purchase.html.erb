<% purchase = @pdf.purchase %>
<article class="sheet">
  <%= render "pdfs/letterhead", pdf: @pdf %>
  <%= render "pdfs/header", title: "Purchase from #{purchase.purchased_from_view.presence || "an unnamed vendor"}",
        subtitle: "Purchase #{purchase.id} · Issued on #{purchase.issued_at.to_fs(:date_picker)}" %>

  <% fields = [["Amount spent", [dollar_presentation(purchase.amount_spent_in_cents)]],
               ["Storage location", [purchase.storage_location&.name]],
               ["Comments", [purchase.comment], :wide]] %>
  <%= render "pdfs/details", title: "Details", fields: fields %>

  <%= render "pdfs/line_items", title: "Items purchased", table: @pdf.line_item_table %>
</article>
