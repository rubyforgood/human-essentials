<% donation = @pdf.donation %>
<% donor = @pdf.donor %>
<article class="sheet">
  <%= render "pdfs/letterhead", pdf: @pdf %>
  <%= render "pdfs/header", title: "Donation from #{donor.name.presence || donation.source}",
        subtitle: "Donation #{donation.id} · Issued on #{donation.issued_at.to_fs(:date_picker)}" %>

  <% fields = [["Source", [donation.source]], ["Money raised", [@pdf.money_raised]]] %>
  <% if donor.address.present? || donor.email.present? %>
    <% fields << ["Donor contact", [donor.address, donor.email]] %>
  <% end %>
  <% fields << ["Comments", [donation.comment], :wide] %>
  <%= render "pdfs/details", title: "Details", fields: fields %>

  <%= render "pdfs/line_items", title: "Items received", table: @pdf.line_item_table %>
</article>
