<% content_for :title, "Edit - Organizations - #{@organization.name} - " %>

<%#
  Removed from this page: an inline <style> block that restyled trix-editor with hardcoded hex
  colours, duplicating what app/assets/tailwind/vendor/trix.css already does -- the three other
  pages with a rich text area never had it. Also the hand-rolled header and card, <hr> rules
  between sections, a <label> with no `for`, and `f.input ... do` blocks that pasted the input
  classes the :essentials wrapper supplies.

  The eight sections were <h3>s inside one long form. They are fieldsets with legends, so each
  question is announced against the group it belongs to.
%>
<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Organization settings",
        subtitle: current_organization.name,
        back: {path: dashboard_path, label: "Back to dashboard"} %>

  <% yes_no = [[true, "Yes"], [false, "No"]] %>

  <div class="max-w-3xl">
  <%= essentials_error_summary(current_organization) %>

  <%= essentials_form_for current_organization, data: {controller: "form-input"},
        url: {controller: "organizations", action: "update"} do |f| %>
    <%= render "shared/essentials/card", padded: false do %>

      <%= render "shared/essentials/form_section", title: "Basic information" do %>
        <%# No autofocus: on a form this long it starts focus past the skip link, so a keyboard
          user cannot Tab forward to bypass the navigation. Short single-purpose forms keep it. %>
      <%= f.input :name, required: true %>
        <%# f.association renders its own label, so the `for` matches the id it generates. The
            wrapping f.input produced for="organization_ndbn_member" against a select whose id is
            organization_ndbn_member_id, and named nothing. %>
        <%= f.association :ndbn_member, label: "NDBN membership ID",
              label_method: :full_name, value_method: :id %>
        <%= f.input :url, label: "URL", placeholder: "http://www.example.com" %>
        <%= f.input :email %>

        <%#
          The address, laid out the way every other address in this app is: one visible label per
          field. It was four `input_field`s under a single "Address" span, each carrying its name
          only as a `placeholder` and an `aria-label` -- and a placeholder is not a label, because
          it disappears the moment anything is typed, which is exactly when you want to check what
          the box is for.

          State and Zip share a row. Each of the four used to run the full 726px width of the card,
          which is a lot of box for a two-letter state code, and city/state/zip on one line is how
          a US address is written anyway.
        %>
        <%# Labels, the state list and the autocomplete tokens all come from `address_field`, so
            this form cannot drift from the other six that collect an address. See design.md. %>
        <%= f.input :street, **address_field(:street) %>
        <%= f.input :city, **address_field(:city) %>
        <%= essentials_field_row do %>
          <%= f.input :state, **address_field(:state) %>
          <%= f.input :zipcode, **address_field(:zip) %>
        <% end %>

        <div class="mb-4">
          <%= f.label :logo, "Logo", class: "block text-sm font-medium text-slate-700" %>
          <% if current_organization.logo.attached? %>
            <div class="mt-2 flex items-center gap-3">
              <%= image_tag current_organization.logo, alt: "", class: "h-12 w-auto rounded" %>
              <button type="button" class="<%= essentials_button_classes(variant: :secondary, size: :sm) %>"
                      data-action="click->dialog#open" data-dialog-id-param="showTheLogo">
                View original
              </button>
            </div>
            <dialog id="showTheLogo" aria-label="Organization logo, full size"
                    class="rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/40"
                    data-action="click->dialog#closeOnBackdrop">
              <div class="flex flex-col items-end gap-3 p-5">
                <%= image_tag current_organization.logo, alt: "", class: "max-h-[70vh] w-auto rounded-lg" %>
                <button type="button" class="<%= essentials_button_classes(variant: :secondary, size: :md) %>"
                        data-action="click->dialog#close" data-dialog-id-param="showTheLogo">Close</button>
              </div>
            </dialog>
          <% end %>
          <%= f.input_field :logo, as: :file, id: "organization_logo",
                class: "mt-2 block w-full text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-brand-700 hover:file:bg-brand-100" %>
          <p class="mt-1 text-xs text-slate-500">
            A 4:1 ratio of width to height; the default is 763 by 188 pixels. JPEG or PNG, under 1 MB.
          </p>
        </div>
      <% end %>

      <%= render "shared/essentials/form_section", title: "Storage" do %>
        <%= f.input :intake_location, include_blank: true,
              label: "Default intake location, for donations and purchases",
              collection: current_organization.storage_locations.active.alphabetized,
              label_method: :name, value_method: :id %>
        <%= f.input :default_storage_location, include_blank: true, label: "Default storage location",
              collection: current_organization.storage_locations.active.alphabetized,
              label_method: :name, value_method: :id %>
      <% end %>

      <%= render "shared/essentials/form_section", title: "Partner approval process" do %>
        <%= f.input :one_step_partner_invite, as: :radio_buttons, collection: yes_no,
              label: "Use the one-step partner invite and approve process?",
              label_method: :second, value_method: :first %>
        <%= f.input :invitation_text, label: "Custom partner invitation message", as: :text,
              input_html: {rows: 3} %>
        <div class="mb-4">
          <%= f.label :partner_form_fields, "Partner profile sections",
                class: "block text-sm font-medium text-slate-700" %>
          <%= f.select :partner_form_fields, Organization::ALL_PARTIALS, {include_hidden: true},
                multiple: true,
                class: EssentialsUiHelper::SELECT_CLASSES,
                data: {controller: "select2", "select2-config-value": "{}"} %>
        </div>
      <% end %>

      <%= render "shared/essentials/form_section", title: "What kinds of request can approved partners make?" do %>
        <%= f.input :enable_child_based_requests, as: :radio_buttons, collection: yes_no,
              label: "Child-based requests?", label_method: :second, value_method: :first %>
        <%= f.input :enable_individual_requests, as: :radio_buttons, collection: yes_no,
              label: "Requests by number of individuals needing each item?",
              label_method: :second, value_method: :first %>
        <%= f.input :enable_quantity_based_requests, as: :radio_buttons, collection: yes_no,
              label: "Quantity-based requests?", label_method: :second, value_method: :first %>
        <% if Flipper.enabled?(:enable_packs) %>
          <%= render "shared/essentials/tag_input",
                id: "organization_request_unit_names",
                name: "organization[request_unit_names]",
                label: "Custom request units",
                hint: "Type a unit and press Enter. Use the singular \u2014 pack, not packs. " \
                      "Partners can always request a plain \"unit\".",
                placeholder: "Add a unit\u2026",
                values: current_organization.request_units.map(&:name) %>
        <% end %>
      <% end %>

      <%= render "shared/essentials/form_section", title: "Emails" do %>
        <%= render "shared/deadline_day_fields", parent_form: f, parent_object: current_organization %>
        <%= f.input :reminder_email_text, label: "Additional text for the reminder email",
              hint: "You can use <code>%{partner_name}</code> to include the partner's name.".html_safe do %>
          <%= f.rich_text_area :reminder_email_text, placeholder: "Enter reminder email content..." %>
        <% end %>
        <%= f.input :default_email_text, label: "Distribution email content",
              hint: "You can use <code>%{partner_name}</code>, <code>%{delivery_method}</code>, <code>%{distribution_date}</code> and <code>%{comment}</code>.".html_safe do %>
          <%= f.rich_text_area :default_email_text, placeholder: "Enter distribution email content..." %>
        <% end %>
        <%= f.input :receive_email_on_requests, as: :radio_buttons, collection: yes_no,
              label: "Email me when a partner makes a request?", label_method: :second, value_method: :first %>
      <% end %>

      <%= render "shared/essentials/form_section", title: "Printing" do %>
        <%= f.input :ytd_on_distribution_printout, as: :radio_buttons, collection: yes_no,
              label: "Show year-to-date values on the distribution printout?",
              label_method: :second, value_method: :first %>
        <%= f.input :signature_for_distribution_pdf, as: :radio_buttons, collection: yes_no,
              label: "Include signature lines on the distribution printout?",
              label_method: :second, value_method: :first %>
        <%= f.input :hide_value_columns_on_receipt, as: :radio_buttons, collection: yes_no,
              label: "Hide value columns on the distribution and donation printouts?",
              label_method: :second, value_method: :first %>
        <%= f.input :hide_package_column_on_receipt, as: :radio_buttons, collection: yes_no,
              label: "Hide the package column on the distribution printout?",
              label_method: :second, value_method: :first %>
      <% end %>

      <%= render "shared/essentials/form_section", title: "Exports" do %>
        <%= f.input :include_in_kind_values_in_exported_files, as: :radio_buttons, collection: yes_no,
              label: "Include in-kind value in donation and distribution exports?",
              label_method: :second, value_method: :first %>
        <%= f.input :include_packages_in_distribution_export, as: :radio_buttons, collection: yes_no,
              label: "Include packages in the distribution export?",
              label_method: :second, value_method: :first %>
      <% end %>

      <%= render "shared/essentials/form_section", title: "Annual survey" do %>
        <%= f.input :repackage_essentials, as: :radio_buttons, collection: yes_no,
              label: "Does your bank repackage essentials?", label_method: :second, value_method: :first %>
        <%= f.input :distribute_monthly, as: :radio_buttons, collection: yes_no,
              label: "Does your bank distribute monthly?", label_method: :second, value_method: :first %>
      <% end %>
    <% end %>

    <%= essentials_form_actions do %>
      <%= submit_button %>
      <%= essentials_link_button "Cancel", organization_path, variant: :ghost, size: :md %>
    <% end %>
  <% end %>
</div>
</div>
