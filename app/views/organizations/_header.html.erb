<%#
  Header for an organization page. `link_path` is where "back" goes -- the bank dashboard for
  an organization looking at itself, the admin dashboard for a super admin looking at one of
  many.

  The AdminLTE version carried a breadcrumb whose only real link was "Home"; the back link is
  the design system's equivalent and is the same one destination.
%>
<% content_for :title, "Organizations - #{@organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: @organization.name,
        back: {path: link_path, label: "Back to dashboard"},
        wrapper_class: "mb-0" %>
</div>
