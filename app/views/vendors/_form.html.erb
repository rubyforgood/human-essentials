<%# One form. The AdminLTE version nested a second simple_form_for inside the first, which
    is invalid HTML -- the inner <form> swallowed the outer one's fields. %>
<div class="max-w-4xl">
  <%= essentials_error_summary(form) %>

  <%= essentials_form_for form, remote: request.xhr?, html: {role: "form"} do |f| %>
    <%= render "shared/essentials/card" do %>
      <%= f.input :business_name, label: "Business name" %>
      <%= f.input :contact_name, label: "Contact name" %>
      <%# Two ways of reaching the same person, and neither needs a full-width box. %>
      <%= essentials_field_row do %>
        <%= f.input :phone, label: "Phone" %>
        <%= f.input :email, label: "Email" %>
      <% end %>
      <%= f.input :address, label: "Address" %>
    <% end %>

    <%= essentials_form_actions do %>
      <%= f.button :button, "Save", id: "vendor-submit", class: essentials_button_classes(variant: :primary, size: :md), data: {disable_with: "Saving..."} %>
      <%= essentials_link_button "Cancel", vendors_path, variant: :ghost, size: :md %>
    <% end %>
  <% end %>
</div>
