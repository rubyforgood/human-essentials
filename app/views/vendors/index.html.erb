<% content_for :title, "Vendors - Community - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Vendors",
        subtitle: "Who you buy from. Every purchase names a vendor.",
        actions: capture {
          # Import is not only for seeding an empty list: a bank takes on a batch of these at
          # any point. It used to be the `else` of the Export branch, so the moment there was one
          # row the importer became unreachable -- on four pages out of five. `/partners` had it
          # right and the others match it now: Import always, Export once there is something to
          # export. A Ruby comment, not an ERB one: this is inside `capture { }`.
            concat(button_tag(type: "button", class: essentials_button_classes(variant: :secondary), data: {action: "click->dialog#open", dialog_id_param: "csv-import-modal"}) do
              concat tag.i(nil, class: "bi-upload", aria: {hidden: true})
              concat " Import vendors"
            end)
          if @vendors.any?
            concat essentials_link_button("Export", vendors_path(format: :csv, filters: filter_params.merge(date_range: date_range_params, include_inactive_vendors: @include_inactive_vendors)), variant: :secondary, icon: "bi-download", data: {filter_export: true})
          end
          concat essentials_link_button("New vendor", new_vendor_path, variant: :primary, icon: "bi-plus-lg")
        } %>

  <%= render "shared/essentials/filter_bar", url: vendors_path, frame: "vendors-results" do %>
    <div class="pb-2">
      <%= filter_checkbox(label: "Also include inactive vendors", scope: "include_inactive_vendors", selected: @include_inactive_vendors) %>
    </div>
  <% end %>
  <%= turbo_frame_tag "vendors-results", target: "_top", data: {turbo_action: "advance"} do %>

    <%= render "shared/essentials/card", padded: false do %>
      <% if @vendors.empty? %>
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "No vendors yet",
              body: "Add the businesses you purchase essentials from so purchases can be attributed to them.",
              action: essentials_link_button("Add your first vendor", new_vendor_path, variant: :primary, icon: "bi-plus-lg") %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Vendors and the total items purchased from each</caption>
            <thead>
              <tr>
                <th scope="col" class="pin-col name">Business name</th>
                <th scope="col" class="name">Contact name</th>
                <th scope="col">Phone</th>
                <th scope="col">Email</th>
                <th scope="col" class="quantity">Total items</th>
                <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody><%= render partial: "vendor_row", collection: @vendors %></tbody>
          </table>
        </div>
      <% end %>
    <% end %>

    <%= render layout: "shared/essentials/csv_import_modal", locals: {
          import_type: "Vendors", csv_template_url: "/vendors_template.csv", csv_import_url: import_csv_vendors_path
        } do %>
      <li>Open the CSV file in Excel or your favourite spreadsheet program.</li>
      <li>Delete the sample data and enter your vendor names, emails and phone numbers in the matching columns.</li>
      <li>Save the file as a CSV.</li>
    <% end %>
  <% end %>
</div>
