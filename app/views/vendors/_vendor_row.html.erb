<tr>
  <td class="pin-col name font-medium text-slate-900">
    <%= link_to vendor_row.business_name.presence || "Unnamed vendor", vendor_row, class: "link-brand" %>
    <%= essentials_status_pill("Inactive", tone: :neutral, icon: "bi-slash-circle") unless vendor_row.active? %>
  </td>
  <td class="name"><%= vendor_row&.contact_name %></td>
  <td><%= vendor_row&.phone %></td>
  <td><%= vendor_row&.email %></td>
  <td class="quantity"><%= number_with_delimiter(vendor_row&.volume) %></td>
  <td class="cell-actions">
    <%
      row_items =
        if vendor_row.active?
          if vendor_row&.purchases&.none?
            [{label: "Edit", path: edit_vendor_path(vendor_row), icon: "bi-pencil"},
             {label: "Delete", path: vendor_path(vendor_row), icon: "bi-trash", method: :delete,
              tone: :danger, confirm: confirm_delete_msg(vendor_row.business_name)}]
          else
            [{label: "Edit", path: edit_vendor_path(vendor_row), icon: "bi-pencil"},
             {label: "Deactivate", path: deactivate_vendor_path(vendor_row), icon: "bi-slash-circle",
              method: :put, confirm: confirm_deactivate_msg(vendor_row.business_name)}]
          end
        else
          [{label: "Edit", path: edit_vendor_path(vendor_row), icon: "bi-pencil"},
           {label: "Reactivate", path: reactivate_vendor_path(vendor_row), icon: "bi-arrow-counterclockwise",
            method: :put, confirm: confirm_reactivate_msg(vendor_row.business_name)}]
        end
    %>
    <%# A visible View: nothing else in this row links to the vendor. %>
    <%= render "shared/essentials/row_actions",
          label: vendor_row.business_name.presence || "this vendor",
          primary: essentials_row_icon_link("View", vendor_row, icon: "bi-eye"),
          items: row_items %>
  </td>
</tr>
