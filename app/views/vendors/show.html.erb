<% content_for :title, "#{@vendor.business_name} - Vendors - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: @vendor.business_name.presence || "Vendor",
        back: {path: vendors_path, label: "Back to vendors"},
        actions: essentials_link_button("Edit", edit_vendor_path(@vendor), variant: :secondary, icon: "bi-pencil") %>

  <div class="space-y-6">
    <%= render "shared/essentials/card", title: "Details" do %>
      <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
        <% {"Contact name" => @vendor.contact_name, "Phone" => @vendor.phone, "Email" => @vendor.email, "Address" => @vendor.address}.each do |label, value| %>
          <div>
            <dt class="text-xs font-medium text-slate-500"><%= label %></dt>
            <dd class="mt-0.5 text-sm text-slate-900"><%= value.presence || "—" %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <%= render "shared/essentials/card", title: "Purchases from this vendor", padded: @purchases.blank? do %>
      <% if @purchases.blank? %>
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "No purchases from this vendor yet",
              body: "Purchases recorded against this vendor will be listed here." %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Purchases made from <%= @vendor.business_name %></caption>
            <thead>
              <tr>
                <th scope="col" class="date">Date</th>
                <th scope="col" class="quantity">Volume</th>
                <th scope="col" class="cell-actions">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @purchases.each do |purchase| %>
                <tr>
                  <td class="date"><%= purchase.issued_at.strftime("%m/%d/%Y") %></td>
                  <td class="quantity"><%= number_with_delimiter(purchase.line_items.total) %></td>
                  <td class="cell-actions">
                    <%= essentials_row_icon_link "View purchase", purchase, icon: "bi-eye" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
