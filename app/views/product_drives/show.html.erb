<% content_for :title, "#{@product_drive.name} - Product Drives - #{current_organization.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: @product_drive.name,
        back: {path: product_drives_path, label: "Back to product drives"},
        actions: capture {
          # Exporting this drive's participants is main's (#5596). It arrived as a `card-footer`
          # with a float-right button; an export belongs in the page header here, which is where
          # every index page in this app puts one. Conditional as main had it -- there is nothing
          # to export from a drive with no donations. "Export participants", not plain "Export",
          # because this page could export either thing and the label has to say which.
          if @product_drive.donations.any?
            concat essentials_link_button("Export participants", product_drive_path(@product_drive, format: :csv), variant: :secondary, icon: "bi-box-arrow-up")
          end
          # "Edit", not "Make a correction": thirty places in this app say Edit and four said the
          # other, which was pre-migration wording kept through the migration rather than chosen.
          # "Correction" also asserts the record is wrong, when you may be adding a tag or fixing
          # a date.
          #
          # And Delete is in the overflow rather than last. The header's last slot belongs to the
          # primary action -- design.md -- and with no primary here the most destructive thing on
          # the page was inheriting it. Reported as the buttons looking reversed.
          record_actions = [{label: "Edit", path: edit_product_drive_path(@product_drive), icon: "bi-pencil"}]
          if current_user.has_cached_role?(Role::ORG_ADMIN, current_organization)
            record_actions << {label: "Delete", path: product_drive_path(@product_drive), method: :delete,
                               icon: "bi-trash", tone: :danger,
                               confirm: "Are you sure you want to permanently remove this product drive?"}
          end
          concat essentials_record_actions(label: @product_drive.name, items: record_actions)
        } %>

  <div class="space-y-6">
    <%= render "shared/essentials/card", title: "Details" do %>
      <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <dt class="text-xs font-medium text-slate-500">Tags</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= @product_drive.tags_for_display.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-slate-500">Start date</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= @product_drive.start_date.strftime("%m-%d-%Y") %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-slate-500">End date</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= @product_drive.end_date&.strftime("%m-%d-%Y") || "—" %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-slate-500">Held virtually?</dt>
          <dd class="mt-0.5 text-sm text-slate-900"><%= is_virtual(product_drive: @product_drive) %></dd>
        </div>
      </dl>
    <% end %>

    <%= render "shared/essentials/card", title: "Donations", padded: @product_drive.donations.blank? do %>
      <% if @product_drive.donations.blank? %>
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "No donations from this drive yet" %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Donations credited to <%= @product_drive.name %></caption>
            <thead>
              <tr>
                <th scope="col">Donation ID</th>
                <th scope="col">Participant</th>
                <th scope="col">Storage location</th>
                <th scope="col" class="quantity">Quantity</th>
                <th scope="col" class="numeric">In-kind value</th>
              </tr>
            </thead>
            <tbody>
              <% @product_drive.donations.each do |donation| %>
                <tr>
                  <td><%= link_to donation.id, donation, class: "font-medium text-brand-700 hover:text-brand-800" %></td>
                  <td><%= donation.product_drive_participant&.business_name %></td>
                  <td><%= donation.storage_location.name %></td>
                  <td class="quantity"><%= donation.line_items.count(&:quantity) %></td>
                  <td class="numeric"><%= dollar_value(donation.value_per_itemizable) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>

    <%= render "shared/essentials/card", title: "Participants", padded: @product_drive.product_drive_participants.blank? do %>
      <% if @product_drive.product_drive_participants.blank? %>
        <%= render "shared/essentials/empty_state", kind: :cold_start,
              title: "No participants recorded for this drive yet" %>
      <% else %>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
          <table class="data-table">
            <caption>Participants in <%= @product_drive.name %></caption>
            <thead>
              <tr>
                <th scope="col">Business name</th>
                <th scope="col">Contact name</th>
                <th scope="col">Phone</th>
                <th scope="col">Email</th>
                <th scope="col" class="notes">Address</th>
                <th scope="col" class="quantity">Volume this drive</th>
                <th scope="col" class="quantity">Volume all time</th>
                <th scope="col" class="notes">Comment</th>
              </tr>
            </thead>
            <tbody>
              <% @product_drive.product_drive_participants.each do |participant| %>
                <tr>
                  <td class="font-medium text-slate-900"><%= participant.business_name %></td>
                  <td><%= participant.contact_name %></td>
                  <td><%= participant.phone %></td>
                  <td><%= participant.email %></td>
                  <td class="notes"><%= participant.address %></td>
                  <td class="quantity"><%= number_with_delimiter(participant.volume_by_product_drive(@product_drive.id)) %></td>
                  <td class="quantity"><%= number_with_delimiter(participant.volume) %></td>
                  <td class="notes text-slate-600"><%= participant.comment %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
