<div class="max-w-4xl">
  <%= essentials_error_summary(@product_drive) %>

  <%= essentials_form_for @product_drive, remote: request.xhr? do |f| %>
    <%= render "shared/essentials/card" do %>
      <%= f.input :name, label: "Name" %>
      <%# A date range is the clearest pair there is: the second is read against the first. %>
      <%= essentials_field_row do %>
        <%= f.input :start_date, label: "Start date", as: :date, html5: true %>
        <%= f.input :end_date, label: "End date", as: :date, html5: true %>
      <% end %>
      <%= f.input :tags, collection: @tags, value_method: :name, multiple: true,
            selected: @product_drive.tags.map(&:name),
            input_html: {
              "data-controller": "select2",
              "data-select2-config-value": '{"selectOnClose": "true", "width": "100%", "placeholder":"Add a tag", "tags": "true", "tokenSeparators": [",", "\t"]}'
            } %>
      <%= f.input :virtual, label: "Product drive is virtual?", as: :boolean %>
    <% end %>

    <%= essentials_form_actions do %>
      <%= f.button :button, "Save", class: essentials_button_classes(variant: :primary, size: :md) + " diaper-drive-submit", id: "product_drive_submit", data: {disable_with: "Saving..."} %>
      <%= essentials_link_button "Cancel", product_drives_path, variant: :ghost, size: :md %>
    <% end %>
  <% end %>
</div>
