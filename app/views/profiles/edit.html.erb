<% content_for :title, "Editing - #{@partner.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Edit partner profile",
        subtitle: @partner.name,
        back: {path: partner_path(@partner), label: "Back to #{@partner.name}"} %>

  <%#
  The nesting was wrong here: the `<div class="grid gap-6">` opened inside `simple_fields_for`
  was closed after that block had ended, so the submit row sat outside the fields it submits.
  %>
  <%= essentials_form_for @partner, url: profile_path,
        data: {controller: "form-input"}, html: {role: "form"} do |form| %>
    <div class="space-y-6">
      <%= form.simple_fields_for :profile, @partner.profile do |profile_form| %>
        <%= render partial: "partners/profiles/edit/agency_information",
              locals: {form: form, partner: @partner, profile: @partner.profile, profile_form: profile_form} %>
        <% @partner.partials_to_show.each do |partial| %>
          <%= render partial: "partners/profiles/edit/#{partial}",
                locals: {form: profile_form, f: profile_form, partner: @partner, profile: @partner.profile} %>
        <% end %>
        <%= render partial: "partners/profiles/edit/partner_settings", locals: {form: profile_form} %>
      <% end %>
    </div>

    <%= essentials_form_actions do %>
      <%= form.button :button, "Update information",
            class: essentials_button_classes(variant: :primary, size: :md),
            data: {disable_with: "Saving..."} %>
      <%= essentials_link_button "Cancel", partner_path(@partner), variant: :ghost, size: :md %>
    <% end %>
  <% end %>
</div>
