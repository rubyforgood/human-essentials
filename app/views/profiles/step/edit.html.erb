<% content_for :title, "Editing - #{@partner.name}" %>

<div class="px-4 py-6 sm:px-6 lg:px-8">
  <%= render "shared/essentials/page_header",
        title: "Edit partner profile",
        subtitle: @partner.name,
        back: {path: partner_path(@partner), label: "Back to #{@partner.name}"} %>

  <div data-controller="accordion disclosure">
    <%= essentials_form_for @partner,
          url: profile_path,
          data: { controller: "form-input", accordion_target: "form" },
          html: {role: "form"} do |f| %>

      <div class="accordion grid gap-3" id="accordionExample">
        <%= render 'partners/profiles/step/accordion_section', f: f, partner: @partner, section_id: 'agency_information', section_title: 'Agency information', partial_name: 'agency_information', sections_with_errors: @sections_with_errors %>
        <%= render 'partners/profiles/step/accordion_section', f: f, partner: @partner, section_id: 'program_delivery_address', section_title: 'Program and delivery address', partial_name: 'program_delivery_address', sections_with_errors: @sections_with_errors %>
        <% @partner.partials_to_show.each do |partial| %>
            <%= render 'partners/profiles/step/accordion_section', f: f, partner: @partner, section_id: partial, section_title: partial_display_name(partial), partial_name: partial, sections_with_errors: @sections_with_errors %>
      <% end %>
        <%= render 'partners/profiles/step/accordion_section', f: f, partner: @partner, section_id: 'partner_settings', section_title: 'Settings', partial_name: 'partner_settings', sections_with_errors: @sections_with_errors %>
      </div>

      <%= render 'partners/profiles/step/form_actions', f: f, partner: @partner %>
    <% end %>
  </div>
</div>
