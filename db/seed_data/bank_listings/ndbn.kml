        <ExtendedData>
          <Data name="Member ID:"><value>90001.0</value></Data>
          <Data name="City (Headquarters):"><value>Dayton</value></Data>
          <Data name="State:"><value>OH</value></Data>
          <Data name="Website:"><value>www.pawneediapers.example</value></Data>
          <Data name="Link to Volunteer"><value>https://pawneediapers.example/volunteer</value></Data>
