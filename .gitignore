# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore floo files
.floo
.flooignore

# Ignore system files that we don't want (these are linked in cap)
/public/system
/public/.htaccess

# Ignore ActiveStorage
/storage/**/*

# Ignore database files.
/db/*.sqlite3
/db/*.sqlite3-journal
pdx_db_test
/db/data
dump.rdb

# Ignore all logfiles and tempfiles.
/log/*.log
/tmp
.env
.env.production
.byebug_history

# Ignore locally installed bundled gems
/vendor/bundle

# Ignore compiled assets
/public/assets

# Ignore Rubymine
.idea

# Ignore asdf file
.tool-versions

.rails_routes*
.rake_tasks~
.DS_Store
.ruby-gemset
*.pdf
/spec/example_failures.txt

# Track, don't ignore, RSpec comparison PDFs
!spec/fixtures/files/*.pdf

# Ignore Docker stuff (see issues #503, #603)
Dockerfile
docker-compose.yml
.dockerignore

/public/packs
/public/packs-test
/node_modules
yarn-debug.log*
.yarn-integrity

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore SimpleCov assets
coverage

# Ignore node management configuration file
.nvmrc

/public/packs
/public/packs-test
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity
package-lock.json

# plugin history
.history/

out/

.vscode/
.aider*
.claude

# Tailwind v4 build output. Compiled from app/assets/tailwind/application.css by the
# tailwindcss-rails gem, which hooks assets:precompile, so it is built on deploy.
/app/assets/builds/*
!/app/assets/builds/.keep

# Ad-hoc design preview, served at /design-preview.html in development
/public/design-preview.html
/public/filters-and-batch-together.html
/public/filter-bar-single-and-alignment.html
/public/selection-bar-and-totals.html
/public/tab-filter-placement.html
/public/icon-action-tooltip.html
/public/row-actions-reach.html
/public/shipping-cost-reveal.html
/public/reports-hub-preview.html
/public/reports-options.html
/public/page-actions-options.html
/public/date-picker-options.html
/public/showing-line-options.html
/public/summary-band-options.html
/public/filters-and-summary-options.html
/public/filter-density-options.html
/public/filter-consistency-options.html
/public/pagination-options.html
/public/pagination-designs.html
/public/pagination-count-options.html
/public/scrollbar-repairs.html
/public/form-actions.html
/public/organization-page.html
# Any mockup copied into public/ to be served. The tracked copy lives in docs/mockups/.
/public/*-options.html
/public/request-units.html
/public/mockup.css
/public/row-actions.html
/public/actions-header-and-disabled.html
/public/row-menu-followups.html
/public/barcode-scan-field.html
